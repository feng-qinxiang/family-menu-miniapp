.notice-container {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  gap: 18rpx;
  background: linear-gradient(135deg, var(--pop-soft) 0%, var(--banner-grad-b) 100%);
  border: 1rpx solid var(--pop-mist);
  border-radius: var(--r-md);
  padding: 22rpx;
  margin-bottom: 18rpx;
  box-shadow: var(--sh-soft);
}

.notice-container::after {
  position: absolute;
  z-index: 0;
  right: -44rpx;
  top: -40rpx;
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  background: rgba(232, 71, 42, 0.1);
  content: "";
  pointer-events: none;
}

.notice-mark {
  position: relative;
  z-index: 1;
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 78rpx;
  height: 78rpx;
  border-radius: var(--r-md);
  background: var(--pop);
  color: var(--c-surface);
  font-size: 24rpx;
  font-weight: var(--w-bold);
  box-shadow: var(--sh-pop);
}

.notice-content {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
}

.notice-kicker {
  display: inline-flex;
  margin-bottom: 6rpx;
  padding: 3rpx 10rpx;
  border-radius: var(--r-pill);
  background: rgba(255, 255, 255, 0.68);
  color: var(--pop-deep);
  font-size: var(--fs-tiny);
  font-weight: var(--w-semi);
}

.notice-title {
  font-size: 28rpx;
  font-weight: var(--w-bold);
  color: var(--c-ink);
}

.notice-desc {
  font-size: 22rpx;
  color: var(--c-text-muted);
  margin-top: 4rpx;
}

.notice-action {
  display: inline-flex;
  font-size: 22rpx;
  color: var(--c-surface);
  margin-top: 12rpx;
  padding: 8rpx 18rpx;
  border-radius: var(--r-pill);
  background: var(--c-primary);
  font-weight: var(--w-semi);
}
