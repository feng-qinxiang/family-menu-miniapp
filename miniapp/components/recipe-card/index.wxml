<!-- components/recipe-card/index.wxml -->
<!-- 横向行卡 -->
<view wx:if="{{variant === 'row'}}" class="rc-row tap-scale" bindtap="onTap">
  <image class="rc-row-thumb" src="{{cover}}" mode="aspectFill" />
  <view class="rc-row-mid">
    <view class="rc-row-title ellipsis">{{title}}</view>
    <view class="rc-row-sub" wx:if="{{timeText || metaText}}">
      <text wx:if="{{timeText}}" class="rc-row-sub-i">{{timeText}}</text>
      <text wx:if="{{metaText && metaText !== timeText}}" class="rc-row-sub-i">{{metaText}}</text>
    </view>
  </view>
  <view wx:if="{{showAdd}}" class="rc-row-add tap-scale" catchtap="onAdd">
    <text class="rc-plus">＋</text>
  </view>
</view>

<!-- 纵向大卡 -->
<view
  wx:else
  class="rc-card tap-scale rc-d-{{density}} {{selected ? 'is-on' : ''}}"
  bindtap="onTap"
>
  <view class="rc-ph">
    <image class="rc-ph-img" src="{{cover}}" mode="aspectFill" />
    <view wx:if="{{label}}" class="rc-lbl">{{label}}</view>
    <view wx:if="{{badgeText}}" class="rc-badge {{selected ? 'is-hot' : ''}}">{{badgeText}}</view>
    <view wx:if="{{showFav}}" class="rc-fav {{favorited ? 'on' : ''}}" catchtap="onFav">
      <view class="rc-fav-dot"></view>
    </view>
    <view
      wx:if="{{showAdd && addPlacement === 'corner' && !showFav}}"
      class="rc-add-corner tap-scale"
      catchtap="onAdd"
    >
      <view class="rc-add-plus"></view>
    </view>
  </view>
  <view class="rc-info">
    <view class="rc-name ellipsis">{{title}}</view>
    <view class="rc-meta ellipsis" wx:if="{{metaText}}">{{metaText}}</view>
  </view>
  <view
    wx:if="{{showAdd && addPlacement === 'float'}}"
    class="rc-add-float tap-scale {{selected ? 'is-picked' : ''}}"
    catchtap="onAdd"
  >
    <text class="rc-add-mark">{{addMark}}</text>
  </view>
</view>