/* components/recipe-card — 复用全局 token / .tap-scale / .ellipsis */

/* ============ 纵向大卡 ============ */
.rc-card {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  overflow: hidden;
  border-radius: var(--r-card);
  background: var(--c-surface);
  border: var(--bd-card);
  box-shadow: var(--sh-card);
}

.rc-card.rc-d-home {
  width: 404rpx;
  flex: none;
}

.rc-card.rc-d-grid {
  width: 100%;
}

.rc-card.is-on {
  border-color: var(--pop);
  box-shadow: 0 0 0 4rpx var(--pop-soft), var(--sh-card);
}

.rc-ph {
  position: relative;
  width: 100%;
  height: 288rpx;
  background: var(--paper-2);
}

.rc-d-grid .rc-ph {
  height: 226rpx;
}

.rc-ph-img {
  display: block;
  width: 100%;
  height: 100%;
}

.rc-lbl {
  position: absolute;
  top: 21rpx;
  left: 21rpx;
  z-index: 1;
  padding: 8rpx 18rpx;
  border-radius: var(--r-xs);
  background: rgba(40, 30, 20, 0.55);
  color: var(--c-surface);
  font-size: var(--fs-tiny);
  font-weight: 800;
  letter-spacing: 2rpx;
  line-height: 1.2;
}

.rc-d-grid .rc-lbl {
  top: 17rpx;
  left: 17rpx;
  padding: var(--r-xs) 15rpx;
  font-size: 18rpx;
}

.rc-badge {
  position: absolute;
  top: 15rpx;
  right: 15rpx;
  z-index: 1;
  padding: var(--r-xs) 15rpx;
  border-radius: var(--r-pill);
  background: rgba(40, 30, 20, 0.5);
  color: var(--c-surface);
  font-size: 18rpx;
  font-weight: 800;
  line-height: 1.2;
}

.rc-badge.is-hot {
  background: var(--pop);
  box-shadow: var(--sh-pop);
}

/* 收藏：圆点，不用 emoji 心形 */
.rc-fav {
  position: absolute;
  top: 19rpx;
  right: 19rpx;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
}

.rc-fav-dot {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  border: 3rpx solid var(--ink-deep);
  box-sizing: border-box;
}

.rc-fav.on .rc-fav-dot {
  border-color: var(--pop);
  background: var(--pop);
}

/* home：右上角加菜 */
.rc-add-corner {
  position: absolute;
  top: 19rpx;
  right: 19rpx;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--pop-soft);
}

.rc-add-plus {
  position: relative;
  width: 28rpx;
  height: 28rpx;
}

.rc-add-plus::before,
.rc-add-plus::after {
  position: absolute;
  left: 50%;
  top: 50%;
  background: var(--ink-deep);
  content: '';
}

.rc-add-plus::before {
  width: 28rpx;
  height: 4rpx;
  margin: -2rpx 0 0 -14rpx;
}

.rc-add-plus::after {
  width: 4rpx;
  height: 28rpx;
  margin: -14rpx 0 0 -2rpx;
}

.rc-info {
  padding: 26rpx 28rpx 30rpx;
}

.rc-d-grid .rc-info {
  padding: 24rpx 25rpx 28rpx;
}

.rc-name {
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 800;
  letter-spacing: -0.6rpx;
  line-height: 1.25;
}

.rc-meta {
  margin-top: 16rpx;
  color: var(--mut-strong);
  font-size: var(--fs-cap);
  line-height: 1.3;
}

.rc-d-grid .rc-meta {
  margin-top: 12rpx;
  font-size: 22rpx;
  font-weight: 600;
}

/* recipes：右下角 + / ✓ */
.rc-add-float {
  position: absolute;
  right: 21rpx;
  bottom: 21rpx;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border-radius: var(--r-md);
  background: var(--pop);
  box-shadow: 0 2rpx 4rpx rgba(180, 40, 20, 0.3), var(--sh-pop);
}

.rc-add-mark {
  color: var(--c-surface);
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1;
}

.rc-add-float.is-picked {
  background: var(--pop);
}

/* ============ 横向行卡 ============ */
.rc-row {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 26rpx 0;
  border-bottom: 2rpx solid var(--paper-2);
}

.rc-row-thumb {
  flex: none;
  width: 146rpx;
  height: 146rpx;
  border-radius: var(--r-md);
  background: var(--paper-2);
}

.rc-row-mid {
  flex: 1;
  min-width: 0;
}

.rc-row-title {
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 800;
  letter-spacing: -0.6rpx;
  line-height: 1.25;
}

.rc-row-sub {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  margin-top: 10rpx;
}

.rc-row-sub-i {
  color: var(--mut);
  font-size: 24rpx;
  line-height: 1.3;
}

.rc-row-add {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--r-md);
  background: var(--pop);
  box-shadow: var(--sh-pop);
}

.rc-row-add .rc-plus {
  color: var(--c-surface);
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1;
}