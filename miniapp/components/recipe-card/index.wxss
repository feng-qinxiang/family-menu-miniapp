/* components/recipe-card — 复用全局 token / .tap-scale / .ellipsis */

/* ============ 纵向大卡 ============ */
.rc-card {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  overflow: hidden;
  border-radius: var(--r-card);
  background: var(--c-surface);
  border: var(--bd-card);
  box-shadow: var(--sh-card);
}

.rc-card.rc-d-home {
  width: 404rpx;
  flex: none;
}

.rc-card.rc-d-grid {
  width: 100%;
}

.rc-card.is-on {
  border-color: var(--pop);
  box-shadow: 0 0 0 4rpx var(--pop-soft), var(--sh-card);
}

.rc-ph {
  position: relative;
  width: 100%;
  height: 288rpx;
  background: var(--paper-2);
}

.rc-d-grid .rc-ph {
  height: 226rpx;
}

.rc-ph-img {
  display: block;
  width: 100%;
  height: 100%;
}

.rc-lbl {
  position: absolute;
  top: 21rpx;
  left: 21rpx;
  z-index: 1;
  padding: 8rpx 18rpx;
  border-radius: var(--r-xs);
  background: rgba(40, 30, 20, 0.55);
  color: var(--anchor-contrast);
  font-size: var(--fs-tiny);
  font-weight: 800;
  letter-spacing: 2rpx;
  line-height: 1.2;
}

.rc-d-grid .rc-lbl {
  top: 17rpx;
  left: 17rpx;
  padding: var(--r-xs) 15rpx;
  font-size: var(--fs-mini);   /* 角标按设计规范是 --fs-mini(21)，原来 18 已低于全站最小档 */
}

.rc-badge {
  position: absolute;
  top: 15rpx;
  right: 15rpx;
  z-index: 1;
  padding: var(--r-xs) 15rpx;
  border-radius: var(--r-pill);
  background: rgba(40, 30, 20, 0.5);
  color: var(--anchor-contrast);
  font-size: var(--fs-mini);   /* 角标按设计规范是 --fs-mini(21)，原来 18 已低于全站最小档 */
  font-weight: 800;
  line-height: 1.2;
}

.rc-badge.is-hot {
  background: var(--pop-fill);
  box-shadow: var(--sh-pop);
}

/* 收藏：线框心 / 实心心（SVG，不用 emoji） */
.rc-fav {
  /* 热区 88rpx（视觉是内部 64rpx 白底圆），避免小图标点不中；右上来源角标在收藏模式下隐藏，避免重叠 */
  position: absolute;
  top: 19rpx;
  right: 19rpx;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
}

/* 触控热区 88rpx：白色圆点保持 64rpx，手指更容易点中 */
.rc-fav::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 88rpx;
  height: 88rpx;
  transform: translate(-50%, -50%);
}

.rc-fav-icon {
  width: 34rpx;
  height: 34rpx;
  filter: brightness(0);   /* 未收藏：墨色线框；底圆恒为白色，深色模式无需还原 */
  opacity: .75;
}

.rc-fav.on .rc-fav-icon {
  filter: none;
  opacity: 1;
}

/* 右下角操作，避开左上菜系与右上来源标签。 */
.rc-add-corner {
  position: absolute;
  bottom: 14rpx;
  right: 14rpx;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--c-surface);
  box-shadow: var(--sh-soft);
}
.rc-add-corner.is-picked { background: var(--pine); }
.rc-picked-mark { color: var(--anchor-contrast); font-size: var(--fs-lg); font-weight: 800; }

.rc-add-plus {
  position: relative;
  width: 28rpx;
  height: 28rpx;
}

.rc-add-plus::before,
.rc-add-plus::after {
  position: absolute;
  left: 50%;
  top: 50%;
  background: var(--anchor);
  content: '';
}

.rc-add-plus::before {
  width: 28rpx;
  height: 4rpx;
  margin: -2rpx 0 0 -14rpx;
}

.rc-add-plus::after {
  width: 4rpx;
  height: 28rpx;
  margin: -14rpx 0 0 -2rpx;
}

.rc-info {
  padding: 26rpx 28rpx 30rpx;
}

.rc-d-grid .rc-info {
  padding: 24rpx 25rpx 28rpx;
}

.rc-name {
  white-space: normal;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  word-break: break-all;
  color: var(--ink);
  font-size: calc(32rpx * var(--fs-mul, 1));
  font-weight: 800;
  letter-spacing: 0;
  line-height: 1.25;
}

.rc-meta {
  margin-top: 16rpx;
  color: var(--mut-strong);
  font-size: var(--fs-cap);
  line-height: 1.3;
}

.rc-d-grid .rc-meta {
  margin-top: 12rpx;
  /* 原来是 22rpx，而基线 .rc-meta 是 --fs-cap(23rpx)——同一张卡的同一行差 1rpx，
     首页横滑与菜谱网格并排看就是"字忽大忽小"。回到同一个 token。 */
  font-size: var(--fs-cap);
  font-weight: 600;
}

/* recipes：右下角 + / ✓ */
.rc-add-float {
  position: absolute;
  right: 21rpx;
  bottom: 21rpx;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border-radius: var(--r-md);
  background: var(--pop-fill);
  box-shadow: 0 2rpx 4rpx rgba(180, 40, 20, 0.3), var(--sh-pop);
}

.rc-add-mark {
  color: var(--anchor-contrast);
  font-size: calc(36rpx * var(--fs-mul, 1));
  font-weight: 700;
  line-height: 1;
}

.rc-add-float.is-picked {
  background: var(--pop-fill);
}

/* ============ 横向行卡 ============ */
.rc-row {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 26rpx 0;
  border-bottom: 2rpx solid var(--paper-2);
}

.rc-row-thumb {
  display: block;
  flex: none;
  
  
  border-radius: var(--r-md);
  background: var(--paper-2);
  width: var(--dish-thumb);
  height: var(--dish-thumb);
}

.rc-row-mid {
  flex: 1;
  min-width: 0;
}
.rc-row-main { flex: 1; min-width: 0; display: flex; align-items: center; gap: 28rpx; }
.rc-row-media { flex: none; }

.rc-row-title {
  color: var(--ink);
  font-size: calc(32rpx * var(--fs-mul, 1));
  font-weight: 800;
  letter-spacing: -0.6rpx;
  line-height: 1.25;
}

.rc-row-sub {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  margin-top: 10rpx;
}

.rc-row-sub-i {
  color: var(--mut);
  font-size: calc(25rpx * var(--fs-mul, 1));
  line-height: 1.3;
}

.rc-row-add {
  position: relative;
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--r-md);
  background: var(--pop-fill);
  box-shadow: var(--sh-pop);
}

/* 视觉保持 80rpx，热区撑到 88rpx 触控规范 */
.rc-row-add::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 88rpx;
  height: 88rpx;
  transform: translate(-50%, -50%);
}

.rc-row-add .rc-plus {
  color: var(--anchor-contrast);
  font-size: calc(40rpx * var(--fs-mul, 1));
  font-weight: 600;
  line-height: 1;
}

/* 左图右文用于浏览，整卡底栏用于核对用料与点菜。 */
.rc-row.rc-d-list { display: block; padding: 20rpx; background: var(--c-surface); border: var(--bd-card); border-radius: var(--r-md); }
.rc-d-list.is-on { border-color: var(--pine); }
.rc-d-list .rc-row-main { align-items: flex-start; gap: 20rpx; }
.rc-d-list .rc-row-media { position: relative; width: var(--tile-list-wide); }
.rc-d-list .rc-row-thumb { width: var(--tile-list-wide); height: var(--tile-list-wide); border-radius: var(--r-sm); }
.rc-d-list .rc-row-title { white-space: normal; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.35; word-break: break-all; font-size: var(--fs-lg); font-weight: 600; letter-spacing: 0; }
.rc-row-list-meta { color: var(--mut-strong); font-size: var(--fs-sub); line-height: 1.5; margin-top: 6rpx; }
.rc-row-list-note { color: var(--pine-ink); font-size: var(--fs-cap); line-height: 1.5; margin-top: 4rpx; word-break: break-all; }
.rc-row-details { min-width: 0; margin-top: 6rpx; }
.rc-row-summary, .rc-row-ingredients { font-size: var(--fs-sub); color: var(--mut-strong); line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; word-break: break-all; }
.rc-row-tags { font-size: var(--fs-sub); color: var(--mut-strong); line-height: 1.5; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-top: 4rpx; }
.rc-row-summary { margin-top: 4rpx; -webkit-line-clamp: 1; color: var(--mut); }
.rc-row-ingredients { margin-top: 0; }
.rc-row-footer { display: flex; align-items: center; gap: 12rpx; margin-top: 12rpx; padding-top: 8rpx; border-top: var(--bd-card); }
.rc-row-footer-copy { flex: 1; min-width: 0; }
.rc-row-origin { position: absolute; left: 10rpx; bottom: 10rpx; max-width: calc(100% - 20rpx); padding: 4rpx 10rpx; box-sizing: border-box; border-radius: var(--r-xs); font-size: var(--fs-mini); line-height: 1.4; color: var(--ink-deep); background: var(--c-surface); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.rc-d-list .rc-row-add { position: relative; margin-left: auto; gap: 4rpx; width: 116rpx; padding: 0 8rpx; box-sizing: border-box; height: 60rpx; border: 2rpx solid var(--line); border-radius: var(--r-pill); background: var(--c-surface); box-shadow: none; }
/* 列表里一屏多张卡：点菜用中性色，红色留给页面真主操作 */
.rc-row-add-label { font-size: var(--fs-sub); font-weight: 600; color: var(--ink-deep); }
.rc-d-list .rc-row-add .rc-plus { color: var(--ink-deep); font-size: var(--fs-lg); }
/* 视觉 60rpx，热区仍撑到 88rpx（同 .rx-create 写法） */
.rc-d-list .rc-row-add::after { width: 100%; height: var(--tap-min); }
/* 无底栏时按钮在主区右侧、与信息区底边对齐 */
.rc-row-add--inline { align-self: center; }
.rc-d-list .rc-row-add.is-picked { background: var(--c-accent-soft); border-color: var(--pine); }
.rc-d-list .rc-row-add.is-picked .rc-plus { color: var(--pine-ink); }
.rc-d-list .rc-row-add.is-picked .rc-row-add-label { color: var(--pine-ink); }
.rc-row-stock { color: var(--mut-strong); font-size: var(--fs-sub); line-height: 1.5; word-break: break-all; }
.rc-stock-label { display: inline; margin-right: 8rpx; color: var(--mut-strong); font-size: var(--fs-sub); }
.rc-stock-copy { display: block; }
.rc-row-stock.is-ready { color: var(--pine-ink); }
