<!-- nav-bar · 二级页顶部导航：返回圆按钮 + 居中标题 + 右侧 slot -->
<view class="navbar">
  <view class="navbar-safe" style="height: {{statusBarHeight}}px;"></view>
  <view class="navbar-inner" style="height: {{innerHeight}}px;">
    <view
      wx:if="{{showBack}}"
      class="navbar-back tap-scale"
      hover-class="navbar-back--hover"
      hover-stay-time="80"
      catchtap="onBack"
    >
      <view class="navbar-back-icon"></view>
    </view>
    <view wx:else class="navbar-side"></view>

    <view class="navbar-title-slot">
      <view class="navbar-title ellipsis">{{title}}</view>
    </view>

    <view class="navbar-right" style="padding-right: {{capsulePad}}px;">
      <slot></slot>
    </view>
  </view>
</view>
