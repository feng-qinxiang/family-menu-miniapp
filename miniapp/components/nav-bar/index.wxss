/* nav-bar · 组件特有样式（配色 token 复用 app.wxss 全局变量）*/
.navbar {
  box-sizing: border-box;
  width: 100%;
}
.navbar-safe {
  width: 100%;
  flex: none;
}
.navbar-inner {
  position: relative;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  padding: 0 24rpx;
}

/* 返回圆按钮：浅底白圆 + 细描边 + 墨色箭头（2026-11 由深棕实心减重：它曾是每个二级页最重的元素）。
   白圆自带底色，压在照片 hero 上也看得清；高度跟胶囊行对齐 */
.navbar-back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--c-surface);
  border: 2rpx solid var(--line);
  box-shadow: 0 2rpx 8rpx rgba(60, 40, 20, 0.08);
  box-sizing: border-box;
  flex: none;
  position: relative;
}
/* 触控热区扩到 88rpx：图标仍是 64rpx，但手指更容易点中 */
.navbar-back::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 88rpx;
  height: 88rpx;
  transform: translate(-50%, -50%);
}
.navbar-back--hover { opacity: 0.85; }
.navbar-side { width: 64rpx; height: 64rpx; flex: none; }

/* 返回箭头：纯 CSS 描边三角，避免外部图标依赖 */
.navbar-back-icon {
  width: 18rpx;
  height: 18rpx;
  border-left: 4rpx solid var(--ink);
  border-bottom: 4rpx solid var(--ink);
  transform: translateX(3rpx) rotate(45deg);
  border-radius: 2rpx;
}

/* 标题只在胶囊行里居中，不吃状态栏高度 */
.navbar-title-slot {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  z-index: 1;
}
.navbar-title {
  max-width: 56%;
  text-align: center;
  font-size: calc(32rpx * var(--fs-mul, 1));
  font-weight: 800;
  color: var(--ink);
  letter-spacing: -1rpx;
  pointer-events: none;
}

/* 右侧 slot 容器 */
.navbar-right {
  margin-left: auto;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  min-height: 100%;
  position: relative;
  z-index: 2;
}
