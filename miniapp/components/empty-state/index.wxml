<view class="empty-wrap">
  <view class="empty-visual">
    <view class="empty-steam empty-steam-a"></view>
    <view class="empty-steam empty-steam-b"></view>
    <view class="empty-bowl"></view>
  </view>
  <view class="empty-title">{{title}}</view>
  <view class="empty-desc" wx:if="{{desc}}">{{desc}}</view>
  <view class="empty-action" wx:if="{{actionText}}" bindtap="onAction">{{actionText}} ›</view>
</view>
