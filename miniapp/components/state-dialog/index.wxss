/* state-dialog · 确认弹窗 · 复用 app.wxss 全局 token */
.sd-mask {
  position: fixed;
  inset: 0;
  z-index: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 58rpx;
  background: rgba(20, 14, 8, 0.45);
  backdrop-filter: blur(6rpx);
  -webkit-backdrop-filter: blur(6rpx);
  opacity: 0;
  transition: opacity 0.26s var(--g-power2-out, ease);
}
.sd-mask--show { opacity: 1; }

.sd-dialog {
  width: 100%;
  max-width: 620rpx;
  background: #fff;
  border-radius: 40rpx;
  overflow: hidden;
  box-shadow: 0 40rpx 100rpx rgba(30, 18, 8, 0.4), 0 8rpx 24rpx rgba(30, 18, 8, 0.2);
}
.sd-dialog--in { animation: sdPop 0.35s cubic-bezier(0.2, 0.9, 0.3, 1.3) both; }
.sd-dialog--out { animation: sdOut 0.2s ease both; }
@keyframes sdPop {
  from { opacity: 0; transform: scale(0.9) translateY(16rpx); }
  to { opacity: 1; transform: scale(1) translateY(0); }
}
@keyframes sdOut {
  from { opacity: 1; transform: scale(1); }
  to { opacity: 0; transform: scale(0.94); }
}

.sd-body { padding: 60rpx 52rpx 48rpx; text-align: center; }
.sd-ic {
  position: relative;
  width: 136rpx;
  height: 136rpx;
  margin: 0 auto 36rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.sd-ic::after {
  content: "";
  position: absolute;
  inset: -14rpx;
  border-radius: 50%;
}
.sd-ic--danger { background: var(--pop-soft); }
.sd-ic--danger::after { border: 3rpx solid rgba(232, 71, 42, 0.18); }
.sd-ic--warn { background: #fdf3e2; }
.sd-ic--warn::after { border: 3rpx solid rgba(176, 137, 73, 0.2); }
.sd-ic-glyph { font-size: 70rpx; font-weight: 900; line-height: 1; }
.sd-ic--danger .sd-ic-glyph { color: var(--pop); }
.sd-ic--warn .sd-ic-glyph { color: var(--gold-deep); }

.sd-title {
  font-size: 40rpx;
  font-weight: 900;
  color: var(--ink);
  letter-spacing: -1rpx;
  line-height: 1.25;
}
.sd-desc {
  margin-top: 18rpx;
  font-size: 28rpx;
  color: var(--mut-strong);
  line-height: 1.55;
}

.sd-actions { display: flex; gap: 22rpx; padding: 0 44rpx 44rpx; }
.sd-btn {
  flex: 1;
  box-sizing: border-box;
  height: 100rpx;
  border-radius: 28rpx;
  font-size: 31rpx;
  font-weight: 800;
  letter-spacing: 0.6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.sd-btn--ghost { background: var(--paper-2); color: var(--ink-deep); }
.sd-btn--danger {
  background: var(--pop);
  color: #fff;
  box-shadow: 0 4rpx 8rpx rgba(180, 40, 20, 0.3), 0 20rpx 44rpx rgba(232, 71, 42, 0.4);
}
.sd-btn--warn {
  background: var(--gold-deep);
  color: #fff;
  box-shadow: 0 4rpx 8rpx rgba(140, 100, 40, 0.3), 0 20rpx 44rpx rgba(176, 137, 73, 0.4);
}
