<!-- components/state-empty · 通用空状态：圆形图标 + 标题 + 描述 + 可选 CTA -->
<view class="state-empty se--{{theme}} g-fade-up">
  <view class="se-illu se-illu--{{type}}">
    <!-- 无菜谱 / 通用（pop） -->
    <image wx:if="{{type === 'pop' || type === 'recipes'}}" class="se-icon"
      src="data:image/svg+xml;base64,"
      mode="aspectFit" />
    <!-- 无网络（gray/offline） -->
    <image wx:elif="{{type === 'gray' || type === 'offline'}}" class="se-icon"
      src="data:image/svg+xml;base64,"
      mode="aspectFit" />
    <!-- 无搜索结果（gold/search） -->
    <image wx:elif="{{type === 'gold' || type === 'search'}}" class="se-icon"
      src="data:image/svg+xml;base64,"
      mode="aspectFit" />
    <!-- 兜底 -->
    <image wx:else class="se-icon"
      src="data:image/svg+xml;base64,"
      mode="aspectFit" />
  </view>

  <view class="se-title">{{title}}</view>
  <view wx:if="{{desc}}" class="se-desc">{{desc}}</view>

  <view wx:if="{{cta}}"
    class="se-btn {{ctaStyle === 'ghost' ? 'se-btn--ghost' : 'se-btn--pop'}} tap-scale"
    hover-class="none"
    bindtap="onAction">{{cta}}</view>

  <!-- 自定义底部内容插槽 -->
  <slot></slot>
</view>
