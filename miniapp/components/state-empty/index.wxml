<!-- components/state-empty · 通用空状态：圆形图标 + 标题 + 描述 + 可选 CTA -->
<view class="state-empty se--{{theme}} se--{{size}} g-fade-up">
  <view class="se-illu se-illu--{{type}} g-scale-in g-d1">
    <!-- 无菜谱 / 通用（pop） -->
    <image wx:if="{{type === 'pop' || type === 'recipes'}}" class="se-icon g-float"
      src="data:image/svg+xml;base64,"
      mode="aspectFit" />
    <!-- 业务空态（gray）：与 pop 同形的空盘、中性棕描边——曾与 offline 共用断网图标，
         空菜单/已删帖会被误读成网络故障 -->
    <image wx:elif="{{type === 'gray'}}" class="se-icon g-float"
      src="data:image/svg+xml;base64,"
      mode="aspectFit" />
    <!-- 冰箱空着（fridge）/ 清单空着（basket）：形状取自 lucide 的 refrigerator、shopping-basket，
         描边换成番茄红——原来这两处和「没有菜谱」共用一只空盘，看不出空的是什么 -->
    <image wx:elif="{{type === 'fridge'}}" class="se-icon g-float"
      src="data:image/svg+xml;base64,"
      mode="aspectFit" />
    <image wx:elif="{{type === 'basket'}}" class="se-icon g-float"
      src="data:image/svg+xml;base64,"
      mode="aspectFit" />
    <!-- 无网络（offline） -->
    <image wx:elif="{{type === 'offline'}}" class="se-icon g-float"
      src="data:image/svg+xml;base64,"
      mode="aspectFit" />
    <!-- 无搜索结果（gold/search） -->
    <image wx:elif="{{type === 'gold' || type === 'search'}}" class="se-icon g-float"
      src="data:image/svg+xml;base64,"
      mode="aspectFit" />
    <!-- 兜底 -->
    <image wx:else class="se-icon g-float"
      src="data:image/svg+xml;base64,"
      mode="aspectFit" />
  </view>

  <view class="se-title">{{title}}</view>
  <view wx:if="{{desc}}" class="se-desc">{{desc}}</view>

  <view wx:if="{{cta}}"
    class="se-btn {{ctaStyle === 'ghost' ? 'se-btn--ghost' : 'se-btn--pop'}} tap-scale"
    hover-class="none"
    bindtap="onAction">{{cta}}</view>

  <!-- 自定义底部内容插槽 -->
  <slot></slot>
</view>
