/* ============================================================
   app.wxss · 全局样式系统 v2「精致美食杂志 + 番茄红撞色」
   设计标杆 home-final.html。token 体系见 docs/小程序落地蓝图.md
   兼容层：旧 --c-* 变量重映射到新配色，保证未重做页面不崩。
   ============================================================ */
page {
  /* —— 新 token：配色（由 theme.json 注入，自动跟随系统深浅色；fallback 为浅色）—— */
  --paper: var(--themePaper, #fbf8f3);
  --paper-2: var(--themePaper2, #f0ebe2);
  --ink: var(--themeInk, #2c241b);
  --ink-deep: var(--themeInkDeep, #3a2e23);   /* 深墨文字：深色档（media 块）翻转为浅字色 */
  --anchor: #3a2e23;                           /* 深色锚点卡底（今日菜单卡/餐盘托/选中 chip）：深色档提亮一档，见 media 块 */
  --anchor-contrast: #fbf8f3;                  /* 锚点卡上的恒定浅字（深色档不跟 --paper 翻转） */
  --seg-thumb: var(--c-surface);               /* 分段控件选中滑块：浅色档同卡面；深色档卡面与轨道几乎同色，单独提亮 */
  --mut: var(--themeMut, #716555);
  --mut-2: var(--themeMut2, #b3a795);
  --mut-strong: var(--themeMutStrong, #6b5f50);    /* 强调次要文字（比 --mut 更深一档） */
  --gold: var(--themeGold, #f4d9a8);
  --gold-deep: var(--themeGoldDeep, #806230);   /* 浅底小字用：纸色上 5.35:1（原 #a58145 仅 3.4:1）；深色档见 media 块 */
  --pop: var(--themePop, #c8381f);
  --pop-soft: var(--themePopSoft, #fdece6);
  --pine: var(--themePine, #2f4a3a);
  --wx: #07c160;
  /* 半透明悬浮面板底色（深色模式必须跟着变，否则发白） */
  --glass: var(--themeGlass, rgba(251, 248, 243, 0.92));
  --glass-soft: var(--themeGlassSoft, rgba(251, 248, 243, 0.82));
  --glass-clear: var(--themeGlassClear, rgba(251, 248, 243, 0));

  /* —— 新 token：字体 —— */
  /* 下厨房式：全站无衬线（衬线是杂志配方，已废弃） */
  --serif: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  --sans: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;

  /* —— 新 token：字号标尺（10 级，页面统一引用，勿写死数值）—— */
  --fs-hero-xl: 96rpx;  /* Hero 大标题（照片 hero 主标题） */
  --fs-hero-lg: 72rpx;  /* Hero 大标题（次 hero） */
  --fs-hero-sm: 56rpx;  /* Hero 大标题（小 hero/合规页） */
  --photo-hero-h: 720rpx; /* 照片头：装得下状态栏 + 返回 + 大标题，勿再用 360rpx */
  --hero-body-above-sheet: 96rpx; /* 白卡上推约 50rpx 时，头图正文距底；小于此会贴边 */
  --fs-hero: 64rpx;      /* 兼容旧引用 */
  --fs-h1: 50rpx;        /* 页面主标题（对齐 .page-title / .shead-title） */
  --fs-h2: 36rpx;        /* 区块标题（对齐 .section-title） */
  --fs-lg: 32rpx;        /* 卡片名/强调正文/图标字符 */
  --fs-body: 28rpx;      /* 正文基准 */
  --fs-btn: 29rpx;       /* 按钮文字（.btn 权威值） */
  --fs-sub: 25rpx;       /* 次要说明 */
  --fs-cap: 23rpx;       /* 辅助/标签 */
  --fs-mini: 21rpx;      /* 角标/统计 */
  /* 统计卡的大数字：实测同一个角色写了 46/50/56/64/72 五种，
     并排看就是"长得一样的卡，数字忽大忽小"。统一一档。 */
  --fs-stat: 56rpx;
  /* hero 右下角那枚装饰大数字：实测 366/384/404/408/410/420 都出现过，
     同一角色六种尺寸（且 right 偏移 18/20/26/30 各写一套）。统一一档一个偏移。 */
  --fs-hero-bignum: 420rpx;
  --hero-bignum-right: 26rpx;
  --fs-tiny: 19rpx;      /* 极弱提示（尽量不用） */

  /* —— 新 token：圆角（下厨房式小圆角）—— */
  --r-xs: 8rpx;
  --r-sm: 16rpx;
  --r-md: 24rpx;
  --r-card: 16rpx;      /* 下厨房式卡片圆角（收敛自 28rpx） */
  --r-sheet: 20rpx;     /* 上推 sheet 圆角（收敛自 32rpx） */
  --r-chip: 30rpx;
  --r-pill: 999rpx;
  --dish-thumb: 146rpx;   /* 菜品在列表行里的缩略图边长：点菜/菜单/冰箱/做菜记录共用一个规格 */
  /* 图块规格表。台账实测全站 12 种"正方形图块"取值，逐个看过后**不是一件事**：
     行内菜图、紧凑行、行内小标记、卡片大图、封面格、选择格各有其密度，
     强行并成一个数会改坏版面（周菜单一天两道、买菜清单一行一料）。
     所以这里把**角色**钉住：新页面要放图块，先在这张表里挑角色，别再写裸数值。 */
  --tile-row-sm: 104rpx;  /* 紧凑行图块（周菜单日卡里的两道菜） */
  --tile-chip: 88rpx;     /* 行内小标记（买菜清单条目左侧的料图） */
  --tile-cover: 168rpx;   /* 卡片主图（厨房总控的灶台卡） */
  --tile-grid: 177rpx;    /* 两列封面格（收藏页的帖子封面） */
  --tile-pick: 148rpx;    /* 图片选择网格的一格（菜谱编辑/导入） */
  --tile-img-pick: 132rpx;/* 发帖弹层的选图格（弹层宽度下 3 列的密度，与 --tile-pick 不同角色） */
  --tile-rc: 138rpx;      /* 帖子详情里「关联菜谱」卡的缩略图 */
  --tile-list-wide: 168rpx; /* 左图右文列表：菜谱、记录、采购与厨房菜卡 */
  --tile-list-tall: 220rpx; /* 纵向列表照片，容纳右侧用料与操作 */
  --ctl-x: 48rpx;         /* 圆形删除钮直径（几何件，字形与命中区随大字档等比放大） */
  --tap-min: 88rpx;       /* 全站最小命中区（::after 扩热区用） */
  /* 头像两档：同一个作者在社区列表是 84rpx、点进详情是 92rpx——同一个人换了个头。
     两档各有密度理由，但必须**有名字**，否则下一个页面会写第三个数。 */
  --ava-row: 84rpx;       /* 行内头像（社区列表、我的页成员堆叠） */
  --ava-head: 92rpx;      /* 页头头像（帖子详情、成员详情） */
  --ava-cmt: 72rpx;       /* 评论行小头像 / 成员头像堆叠 */
  --ava-hero: 208rpx;     /* 个人资料里那张大头像（上传位） */
  /* 同一个人的头像在**不同页换了形状**：社区列表是 26rpx 圆角方，点进他那条帖子变成正圆；
     字也一样，同一个"阿"字在社区列表占框宽 43%、在我的页只占 36%、收藏页的小圆点占到 53%。
     头像只有"框宽"一个自由度，所以形状和字都按框宽推：
     圆角 = 框宽 × 0.31（微信自己的头像就是这个比例，也等于现有 26/84、62/200 两处的实测值），
     字号 = 框宽 × 0.4（≥72rpx 的头像都够用；再小的头像堆叠另有 --fs-mini 保底，不套这条）。 */
  --r-ava: 0.31;
  --ava-glyph: 0.4;

  /* —— 新 token：hero 规格（照片 hero 统一高度）—— */
  --hero-h: 862rpx;      /* 照片 hero 统一高度 */
  --hero-h-sm: 620rpx;   /* 小 hero（vip/family 类） */

  /* —— 新 token：大图角色（aspectFill 裁多少由这组数决定）—— */
  /* 实拍菜图以方图为主（assets/dishes 19 张里 16 张是 600×600），
     而旧版面把大图框做成了横长条：社区配图 588×322 只留下方图 55% 的高度，
     菜谱步骤图 515×240 只留 47%——一条鱼、一盘面被拦腰裁掉是最常看到的违和。
     这里按"同一角色一个框比例"收到 ≈4:3（方图纵向裁 25%），
     宽度是各容器自己的（rpx 已按 750 视口归一，所以高度用裸值钉死比例）。 */
  --photo-feed-h: 440rpx;    /* 信息流配图：容器 588rpx 宽 → 1.34 */
  --photo-step-h: 386rpx;    /* 菜谱详情步骤图：容器 515rpx 宽 → 1.33 */
  --photo-focus-h: 494rpx;   /* 做菜模式步骤大图：容器 658rpx 宽 → 1.33 */
  --photo-head-h: 462rpx;    /* 帖子详情头图：容器 616rpx 宽 → 1.33 */

  /* —— 新 token：卡表面的内边距（只有两档，按密度分角色）—— */
  /* 台账实测：同一个卡表面（border-radius 走 --r-card）全站写了 20 多种 padding，
     光"左右"就有 16/18/24/25/26/28/30/31/32/34/35/40/64。多数各有理由（窄列统计卡、
     输入框、弹窗），但**同一屏上相邻的两张卡**用不同值就是纯漂移：
     首页的「许愿池」白卡左右 28、它下面那张深色主卡左右 40——两张卡左边缘对齐、
     里面的文字却错开 6px，并排看就是"没排版"。所以这里只钉"左右"这一个轴。 */
  --pad-card: 28rpx;      /* 标准卡表面的左右内边距（全站默认） */
  --pad-card-sm: 24rpx;   /* 紧凑卡：行内小卡、输入卡、嵌套卡 */
  --page-gutter: 46rpx;

  /* —— 新 token：阴影 / 边框 —— */
  --sh-card: 0 2rpx 10rpx rgba(60, 40, 20, 0.05);   /* 轻量单层阴影（收敛自双层重投影） */
  --sh-soft: 0 4rpx 12rpx rgba(60, 40, 20, 0.06);
  --sh-pop: 0 6rpx 16rpx rgba(200, 56, 31, 0.22);   /* 按钮红影收敛 */
  /* 「抬起来的卡」只有一种投影。实测四个页面各写了一份近似值：
     0 24/50 .1（买菜清单、菜单）、0 26/58 .1（我的）、0 26/58 .12 与 0 30/70 .13（周菜单）——
     同一层级五种写法，并排看就是"有的卡更浮一点"。 */
  --sh-raised: 0 4rpx 12rpx rgba(60, 40, 20, 0.06), 0 24rpx 50rpx rgba(120, 70, 30, 0.10);
  --bd-card: 2rpx solid var(--themeBorderLight, #f1ece2);

  /* —— 扩展 token：语义色（UI 审计收敛，页面勿再写死 hex）—— */
  --pop-deep: #b3381f;        /* 深番茄红：警示文字（渐变深端用 --pop-deep-fill） */
  --pop-fill: var(--pop);           /* 红色实心底（上面放浅字）：浅色档同 --pop；深色档另取更深的红，见 media 块 */
  --pop-deep-fill: var(--pop-deep); /* 红色渐变深端（上面放浅字）：同上 */
  --gold-on-dark: var(--gold);      /* 深底（锚点卡/照片/松绿底）上的金字和金色小图形：浅色档同 --gold；深色档 --gold 变暗金，见 media 块 */
  --pine-ink: var(--pine);          /* 松绿当文字色：浅色档同 --pine；深色档 --pine 当字只有约 2.6:1，见 media 块 */
  --shimmer-hi: rgba(255, 255, 255, 0.5);   /* 骨架屏扫光高光 */
  --pop-mist: #f6cfc4;        /* 浅红描边 */
  --orange: #f0853f;          /* 暖橙：--pop 的渐变伙伴 */
  --success: #3a9d5d;
  --success-light: #7fd29a;
  --cook-bg: var(--themeCookBg, #1a1410);   /* 烹饪模式沉浸底色 */
  /* 沉浸暗底专用恒定色板：--cook-bg 两档都是深色，所以其上的前景/卡底也必须恒定。
     若在这里改用会翻转的 token（--c-border-light 深色档=#333、--ink 深色档=#efefef），
     深色模式下就是「深字压深底」+ 暗底上蹦出白卡片。取值等于浅色档现状，观感不变。 */
  --cook-ink: #f1ece2;        /* 暗底主前景（正文、菜名、按钮文字）*/
  --cook-ink-mut: #b3a795;    /* 暗底次级前景（小标签、说明）*/
  --cook-surface: #2c241b;    /* 暗底上的卡底/药丸底 */
  --cook-line: #d5c9b8;       /* 暗底上的描边图标 */
  --cook-mark: #ffffff;       /* 亮底图标上的指针（时钟针）*/
  --cook-pop: #c8381f;      /* 暗底上的品牌红填充（承载浅色文字，深色档不再提亮）*/
  /* 自定义 tabBar 占位高度：数值来源是 custom-tab-bar/index.wxss 的 8rpx 上内边距 + 96rpx 高 + 24rpx 下内边距，
     改那里必须同步这里（tab 页上的弹层/悬浮按钮要靠它抬到栏上方）*/
  --tabbar-h: calc(env(safe-area-inset-bottom) + 128rpx);
  --line: var(--themeLine, #e8e0d0);          /* 浅分隔线 */
  --line-deep: var(--themeLineDeep, #d5c9b8); /* 深分隔线/描边 */
  --skeleton: var(--themeSkeleton, #efe4d7);  /* 骨架屏统一底色（全站一致） */
  --surface-pressed: #efe9df; /* 按压态底色 */
  --banner-grad-a: #fff7ec;   /* 引导条渐变浅端 */
  --banner-grad-b: #ffe9d9;   /* 引导条渐变深端 */
  --banner-bd: #f5dcbf;       /* 引导条描边 */

  /* —— 扩展 token：分类色板（头像/标签等装饰色）—— */
  --cat-brown: #c9763e;
  --cat-gold: #d4a857;
  --cat-brown-deep: #5a4326;
  --cat-green: #577a5f;
  --cat-green-light: #7aa888;
  --cat-slate: #6b7b8c;
  --cat-purple: #8a6cae;
  --cat-purple-deep: #5a4a8a;
  --cat-purple-light: #9a7fc4;
  --cat-plum: #9a5b8c;
  --cat-plum-deep: #7a5fa0;

  /* —— 兼容层：旧 --c-* 重映射到新配色（未重做页面继续可用且自动套新色）—— */
  --c-primary: #c8381f;
  --c-primary-dark: #c23618;
  --c-primary-soft: #fdece6;
  --c-primary-light: #f7c9bd;
  --c-accent: #2f4a3a;
  --c-accent-soft: var(--themePineSoft, #e7efe9);
  --c-accent-dark: #233a2c;
  --c-gold: #b08949;
  --c-gold-soft: var(--themeGoldSoft, #f9efda);
  --c-gold-dark: #8d6517;
  --c-ink: #2c241b;
  --c-text: #2c241b;
  --c-text-secondary: #716555;
  --c-text-muted: #9a8e7d;
  --c-bg: #fbf8f3;
  --c-bg-warm: #f0ebe2;
  --c-surface: var(--themeSurface, #ffffff);
  --c-surface-soft: var(--themeSurfaceSoft, #fbf8f3);
  --c-border: var(--themeBorder, #e6dccb);
  --c-border-light: var(--themeBorderLight, #f1ece2);
  --c-success: var(--themeSuccess, #2f8f6b);
  --c-success-soft: var(--themeSuccessSoft, #eaf7f1);
  --c-warning: #b08949;
  --c-warning-soft: var(--themeGoldSoft, #f9efda);
  --c-info: var(--themeInfo, #366d9f);
  --c-info-soft: var(--themeInfoSoft, #edf5fc);
  --c-danger: #c8381f;
  --c-danger-soft: #fdece6;
  --c-food-red: #c8381f;
  --c-food-orange: #d4863a;
  --c-food-yellow: #c9a83e;
  --c-food-green: #2f4a3a;
  --c-food-brown: #826044;

  /* 兼容层：旧圆角/阴影/字重/间距 token */
  --r-lg: 24rpx;
  --r-xl: 42rpx;
  --sh-card-hover: 0 14rpx 36rpx rgba(43, 30, 23, 0.12);
  --sh-float: 0 36rpx 80rpx rgba(120, 70, 30, 0.16);
  --sh-primary: 0 16rpx 36rpx rgba(200, 56, 31, 0.4);
  --sh-gold: 0 8rpx 22rpx rgba(176, 137, 73, 0.18);
  --w-bold: 800;
  --w-semi: 700;
  --w-medium: 600;
  --w-regular: 400;
  --sp-xs: 8rpx;
  --sp-sm: 16rpx;
  --sp-md: 24rpx;
  --sp-lg: 32rpx;
  --sp-xl: 44rpx;
  --sp-2xl: 60rpx;
  --anim-fast: 0.15s;
  --anim-normal: 0.25s;
  --anim-slow: 0.4s;
  --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);

  min-height: 100%;
  background: var(--paper);
  color: var(--ink);
  font-size: calc(28rpx * var(--fs-mul, 1));
  line-height: 1.55;
  font-family: var(--sans);
  -webkit-font-smoothing: antialiased;
}

/* ============ 深色模式（官方机制：WXSS 媒体查询；theme.json 变量并不注入 WXSS）============
   2026-09-12 走查实证：var(--themeX, fallback) 永远命中 fallback（探针品红上屏），
   原先"theme.json 自动注入"的认知不成立。此处按官方 @media 方案把深色值直接声明出来：
   1) 覆盖裸 --themeX 层 → 所有 var(--themeX, fallback) 自动解析到深色（值 = theme.json dark 段）；
   2) 字面量 token（theme.json 无对应键）与旧 --c-* 兼容层字面量单独给深色档。 */
@media (prefers-color-scheme: dark) {
  page {
    /* —— 裸 --themeX 层（与 theme.json dark 段同值，改色先改 theme.json 再同步这里）—— */
    --themePaper: #1c1c1c;
    --themePaper2: #2e2e2e;   /* 原 #262626 与卡面 #242424 只差 1.03:1，卡里的输入框、图块底看不见 */
    --themeInk: #efefef;
    --themeInkDeep: #e2e2e2;
    --themeMut: #9a9a96;
    --themeMut2: #757570;
    --themeMutStrong: #c4c0b8;
    --themeSurface: #242424;
    --themeSurfaceSoft: #2a2a2a;
    --themeLine: #333333;
    --themeLineDeep: #3a3a3a;
    --themeBorder: #3a3a3a;
    --themeBorderLight: #333333;
    --themeSkeleton: #2a2a2a;
    --themeCookBg: #111111;
    --themePop: #ff6a4d;
    --themePopSoft: #3a2218;
    --themeGold: #8a6a3a;
    --themeGoldDeep: #c9a35c;
    --themeGoldSoft: #332a1c;
    --themePine: #4e6b58;
    --themePineSoft: #22302a;
    --themeSuccess: #4eae8c;
    --themeSuccessSoft: #1f2f29;
    --themeInfo: #6fa6d6;
    --themeInfoSoft: #1e2a36;
    --themeGlass: rgba(36, 36, 36, 0.92);
    --themeGlassSoft: rgba(36, 36, 36, 0.82);
    --themeGlassClear: rgba(36, 36, 36, 0);

    /* —— 字面量 token 深色档（theme.json 无这些键）—— */
    --anchor: #735a44;       /* 原 #3a2e23 压在 #1c1c1c 上只有 1.29:1，选中 chip/返回键/锚点按钮几乎看不见；提亮后对页面底 2.7:1、对浅字 6.1:1、对浅金 4.7:1（再亮浅金字就不达标） */
    --seg-thumb: #666666;    /* 卡面 #242424 与轨道几乎同色（原 1.03:1），滑块消失；提亮后对轨道 2.4:1、对浅字 5.0:1 */
    --pop-deep: #ff7a5c;     /* 警示红字：原 #d94b30 在卡面上只有 3.7:1；深色档「深」即更亮，卡面 6.1:1 */
    --pop-fill: #c8381f;     /* 红色实心底：--pop（#ff6a4d）上放浅字只有 2.7:1，填充改用品牌原红，浅字 4.9:1 */
    --pop-deep-fill: #a3301b; /* 红色渐变深端：浅字 6.6:1 */
    --gold-on-dark: #f4d9a8;  /* 深色档 --gold（#8a6a3a）压在锚点底上只有约 1.3:1；改用浅金，锚点底上 4.7:1 */
    --pine-ink: #4eae8c;      /* 松绿文字：卡面 5.7:1（与 --themeSuccess 同值） */
    --shimmer-hi: rgba(255, 255, 255, 0.06);   /* 白 .5 扫在 #2a2a2a 骨架上是一道刺眼亮条 */
    --pop-mist: #5a2a1e;
    --surface-pressed: #2e2e2e;
    --banner-grad-a: #2a241c;
    --banner-grad-b: #332a1e;
    --banner-bd: #3a3226;
    --sh-card: 0 2rpx 10rpx rgba(0, 0, 0, 0.3);
    --sh-soft: 0 4rpx 12rpx rgba(0, 0, 0, 0.32);
    --sh-pop: 0 6rpx 16rpx rgba(0, 0, 0, 0.45);
    --bd-card: 2rpx solid #333333;
    --sh-card-hover: 0 14rpx 36rpx rgba(0, 0, 0, 0.5);
    --sh-float: 0 36rpx 80rpx rgba(0, 0, 0, 0.55);
    --sh-primary: 0 16rpx 36rpx rgba(0, 0, 0, 0.5);
    --sh-gold: 0 8rpx 22rpx rgba(0, 0, 0, 0.4);

    /* —— 旧 --c-* 兼容层里直写浅色 hex 的部分 —— */
    --c-primary-soft: #3a2218;
    --c-primary-light: #5a2a1e;
    --c-ink: #efefef;
    --c-text: #efefef;
    --c-text-secondary: #9a9a96;
    --c-text-muted: #757570;
    --c-bg: #1c1c1c;
    --c-bg-warm: #2e2e2e;   /* 同 --themePaper2 */
    --c-gold-soft: #332a1c;
    --c-gold-dark: #c9a35c;
    --c-warning: #c9a35c;
    --c-warning-soft: #332a1c;
    --c-danger-soft: #3a2218;
  }
}

/* 窄屏命中区兜底：88rpx 在宽度 < 375px 的屏上不足 44px（361px 宽只有 42.4px）。
   不用 max(88rpx, 44px)：全站还没用过 CSS 数学函数，真机兼容没验证过；媒体查询 + 变量是本文件已有写法。
   ponytail: 只兜住走 var(--tap-min) 的命中区；直接写死 88rpx 的约 100 处在窄屏仍是 42.4px，改到哪块时顺手换成 token */
@media (max-width: 374px) {
  page { --tap-min: 44px; }
}

/* ============ 大字模式（设置页开关，每页的可见根节点都要挂 .font-lg）============ */
/* 覆盖字号 token：用 var(--fs-*) 引用的文字走下面的 lg 值；
   页面里的静态 rpx 一律写成 calc(Xrpx * var(--fs-mul, 1)) 由本系数放大。
   全站 776 处 font-size 已全部可缩放，新增页面照此惯例，勿再裸写 rpx 字号。
   这里只重定义自定义属性，而自定义属性只向下继承 —— 所以没有单一根的页面
   （并列的 wx:if 状态、seg/body/footbar 这种）在每个顶层节点各挂一份即可，不必包结构。
   漏挂不会白屏也不会报错，只表现为「开了大字这一页照样小字」，
   故由 static-check 第 15 项逐页核对（只接一半、整页没接都判失败）。 */
page.font-lg, .font-lg {
  --fs-mul: 1.15;   /* 静态 rpx 字号的统一放大系数（token 字号有自己的 lg 值） */
  --fs-hero-xl: 110rpx;
  --fs-hero-lg: 82rpx;
  --fs-hero-sm: 64rpx;
  --photo-hero-h: 800rpx;
  --fs-h1: 56rpx;
  --fs-h2: 40rpx;
  --fs-lg: 36rpx;
  --fs-body: 31rpx;
  --fs-btn: 32rpx;
  --fs-sub: 28rpx;
  --fs-cap: 27rpx;   /* 适老：cap/mini 各较标准档 +4rpx（原 +2rpx 偏小） */
  --fs-mini: 25rpx;
  --fs-tiny: 24rpx;
}

/* ============ 通用容器 / 安全区 ============ */
.container {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 22rpx var(--page-gutter) calc(env(safe-area-inset-bottom) + 60rpx);
}
.safe-bottom { padding-bottom: calc(env(safe-area-inset-bottom) + 16rpx); }
.safe-top { padding-top: env(safe-area-inset-top); }

/* ============ 镂空撞色标题（Hero 通用）============ */
/* 实心标题 + 细描边（下厨房式）：不再用透明镂空字，白字在照片 hero 上清晰，
   浅色底页面用 .title-stroke--ink（墨色实心）接管。 */
.title-stroke {
  color: #fbf8f3;   /* 白描边标题：填充恒白，不随深色翻转 */
  -webkit-text-stroke: 1.5rpx rgba(255, 255, 255, 0.55);
  text-shadow: 0 4rpx 16rpx rgba(20, 14, 8, 0.4);
  font-family: var(--sans);
  font-weight: 900;
}
.title-stroke .pop {
  color: var(--pop);
  -webkit-text-stroke: 0;
  text-shadow: none;
}
/* 浅底（paper）实心标题：墨色实心 + 细墨描边，深色模式随 token 自动 */
.title-stroke--ink {
  color: var(--ink);
  -webkit-text-stroke: 1.5rpx rgba(44, 36, 27, 0.3);
  text-shadow: none;
}
/* ============ 紧凑页头（菜谱/社区/冰箱/我的 共用；只有「今日」保留整幅照片 hero）============
   为什么：五个 tab 原来都是「整屏照片 + 红斜体标签 + 超大描边标题」，切 tab 像没切，
   而且首屏被装饰吃光、看不到内容。紧凑页头只做三件事：避让胶囊、给出页名、放一个主操作。
   用法：
   <view class="cpt-head" style="padding-top: {{capsuleTop}};">
     <view class="cpt-row" style="padding-right: {{capsuleRight}};">
       <view class="cpt-titles"><view class="cpt-eyebrow">小字</view><view class="cpt-title">页名</view></view>
       <view class="cpt-action xx-btn tap-scale" bindtap="…">主操作</view>
     </view>
     <view class="cpt-sub">可选一行说明</view>
   </view>
   ⚠ cpt-action 直接挂在可点元素本身上，不要再包一层 view：
     interaction-audit 按类名识别可点元素，空包一层会被报成「可点但无事件」。
   capsuleTop / capsuleRight 来自 utils/capsule.js（全站唯一胶囊实现）。 */
.cpt-head {
  box-sizing: border-box;
  background: var(--paper);
  padding-top: 24rpx;
  padding-left: var(--page-gutter);
  padding-right: var(--page-gutter);
  padding-bottom: 24rpx;
}
.cpt-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 64rpx;
  gap: 16rpx;
}
.cpt-titles { flex: 1; min-width: 0; }
.cpt-eyebrow {
  font-size: var(--fs-cap);
  font-weight: 700;
  letter-spacing: 2rpx;
  color: var(--mut);
  font-style: normal;
}
.cpt-title {
  margin-top: 4rpx;
  font-size: var(--fs-h1);
  font-weight: 900;
  line-height: 1.3;
  color: var(--ink);
  word-break: break-all;
}
.cpt-sub {
  margin-top: 12rpx;
  font-size: var(--fs-sub);
  line-height: 1.5;
  color: var(--mut);
}
.cpt-action { flex-shrink: 0; }
.font-lg .cpt-row { flex-wrap: wrap; }
.font-lg .cpt-titles { flex-basis: 360rpx; }

/* Android 兜底（旧）：纯实心白字 + 多向白描边，仍保留以兼容历史用法 */
.title-shadow {
  color: #fff;
  text-shadow: 0 0 1rpx #fff, 2rpx 0 1rpx #fff, -2rpx 0 1rpx #fff, 0 2rpx 1rpx #fff, 0 -2rpx 1rpx #fff;
  font-weight: 900;
}

/* ============ Section 标题 ============
   与新版页面的 .section-title 同档（36rpx / 800）：不再画左侧竖条、不再把半个标题染红。
   番茄红只留给每屏唯一的主操作；.shead-bar / .pop 节点保留以兼容组件模板，样式上不再显示。 */
.shead {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
  margin: 48rpx 0 22rpx;
}
.shead .shead-main { position: relative; min-width: 0; }
.shead .shead-bar { display: none; }
.shead .eyebrow {
  font-family: var(--sans);
  font-style: normal;
  font-size: var(--fs-cap);
  color: var(--mut-strong);
  font-weight: 600;
}
.shead h2, .shead .shead-title {
  font-size: calc(36rpx * var(--fs-mul, 1));
  font-weight: 800;
  color: var(--ink);
  margin-top: 4rpx;
  line-height: 1.2;
  font-family: var(--sans);
}
.shead .shead-title .pop { color: inherit; }
.shead .seeall {
  font-size: var(--fs-sub);
  color: var(--mut-strong);
  font-weight: 600;
  flex: none;
  padding-bottom: 4rpx;
}

/* ============ 通用 eyebrow / 标题 ============ */
.eyebrow-serif {
  font-family: var(--sans);
  font-style: normal;
  font-size: var(--fs-cap);
  color: var(--mut-strong);
  font-weight: 700;
}

/* ============ 卡片 ============ */
.card {
  box-sizing: border-box;
  padding: var(--pad-card);
  border-radius: var(--r-card);
  background: var(--c-surface);
  border: var(--bd-card);
  box-shadow: var(--sh-card);
}
.card-flat {
  box-sizing: border-box;
  padding: var(--pad-card-sm);
  border-radius: var(--r-card);
  background: var(--paper-2);
}
.card-dark {
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
  padding: var(--pad-card);
  border-radius: var(--r-card);
  background: var(--anchor);
  color: var(--anchor-contrast);
}
.card-dark .deco-circle {
  position: absolute;
  right: -56rpx;
  top: -56rpx;
  width: 268rpx;
  height: 268rpx;
  border-radius: 50%;
  background: rgba(200, 56, 31, 0.16);
}

/* ============ 文字头像配色 ============
   社区里按名字取色（utils/constants.js#avaTone），同一个人在列表、详情、评论里是同一个色；
   红色那档只给家庭成员页按顺序轮用——社区里红色是「点赞 / 发帖」的颜色，头像不抢。
   金色档是浅金底配深字：深色档的 --gold-deep 是亮金，上面放白字只有约 2:1。 */
.ava-pine, .ava-inkdeep, .ava-pop { color: var(--anchor-contrast); }
.ava-pine { background: var(--pine); }
.ava-gold { background: var(--gold-on-dark); color: var(--anchor); }
.ava-inkdeep { background: var(--anchor); }
.ava-pop { background: var(--pop-fill); }

/* ============ 功能入口图标的浅色底 ============
   同一个功能在哪个页面都是同一个色：菜谱 / 收藏 = 红，冰箱 = 蓝，买菜 / 导入 = 绿，周菜单 = 金。
   四个 soft token 深色档各有对应暗色，不用另写。挂在图标外面那层方块上，覆盖它原来的中性底 */
.tint-pop { background: var(--pop-soft); }
.tint-info { background: var(--c-info-soft); }
.tint-pine { background: var(--c-accent-soft); }
.tint-gold { background: var(--c-gold-soft); }

/* ============ 按钮 ============ */
.btn {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 32rpx;
  border-radius: var(--r-card);
  font-size: var(--fs-btn);
  font-weight: 800;
  line-height: 1.2;
}
.btn::after { border: none; }
.btn.disabled { opacity: 0.6; }
.btn-pop {
  background: var(--pop-fill);
  color: #fff;
  box-shadow: var(--sh-pop);
}
.btn-dark { background: var(--anchor); color: var(--anchor-contrast); }
.btn-ghost { background: var(--c-surface); color: var(--ink); border: var(--bd-card); }
/* 三级按钮（2026-11 统一）：主 = .btn-pop（每屏最多一个红色实心）；
   次 = .btn-ghost（白底细描边）；文字 = .btn-text（无底无框，用于「查看全部 ›」这类去处）。
   .btn-dark 仅保留给深底卡片内部，浅底页面不再用深棕实心当第二个主按钮。 */
.btn-text { min-height: var(--tap-min); padding: 0 8rpx; background: transparent; color: var(--pop); font-weight: 700; }
.btn-wx { background: var(--wx); color: #fff; }
.btn-block { width: 100%; }

/* ============ chip 筛选片 ============ */
.chip {
  box-sizing: border-box;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  flex: none;
  /* 触控规范：可点元素高度不低于 88rpx（约 44pt），低于此值手指容易点空 */
  min-height: 88rpx;
  padding: 0 32rpx;
  border-radius: var(--r-chip);
  background: var(--paper-2);
  color: var(--mut-strong);
  font-size: calc(26rpx * var(--fs-mul, 1));
  font-weight: 600;
  white-space: nowrap;
  border: 2rpx solid transparent;
}
.chip.on {
  background: var(--anchor);
  color: var(--anchor-contrast);
  border-color: var(--anchor);
}
.chip .dot { width: 12rpx; height: 12rpx; border-radius: 50%; }

/* ============ 横滑容器 ============ */
.hscroll { width: 100%; white-space: nowrap; }
.hscroll-inner { display: inline-flex; gap: 18rpx; padding: 4rpx 0; }

/* ============ 点按反馈 ============ */
.tap-scale {
  transition: transform 0.18s var(--g-back-out);
}
.tap-scale:active {
  transform: scale(0.95);
  transition-duration: 0.08s;
}

/* 文字型链接的按下反馈：缩放会显得怪，改成压暗 */
.tap-dim {
  transition: opacity 0.15s ease, color 0.15s ease;
}
.tap-dim:active {
  opacity: 0.55;
}

/* 图标按钮热区扩展：视觉尺寸保持不变，点击区域撑到 88rpx。
   仅用于「独立、周围没有紧邻可点元素」的小图标（关闭 ×、返回、星标等）；
   相邻小按钮之间不要用，会互相抢点击。 */
.hit-88 {
  position: relative;
}
.hit-88::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 88rpx;
  height: 88rpx;
  transform: translate(-50%, -50%);
}

/* 提交中：按钮进入不可重复点击的视觉态 */
.is-busy {
  opacity: 0.6;
  pointer-events: none;
}
.btn[disabled],
button[disabled] {
  opacity: 0.5;
}

/* ============ 标签 chip（小）============ */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: calc(22rpx * var(--fs-mul, 1));
  font-weight: 700;
}
.tag-pop { background: var(--pop-fill); color: #fff; }
.tag-glass { background: rgba(40, 30, 20, 0.55); color: #fff; }

/* ============ 文本工具 ============ */
.t-ink { color: var(--ink); }
.t-mut { color: var(--mut); }
.t-pop { color: var(--pop); }
.t-gold { color: var(--gold-deep); }
.ellipsis { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.clamp-2 {
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

/* ============ 表单 inline 校验 ============ */
.field-error {
  border-color: #d8342c !important;
  animation: field-error-shake 0.45s cubic-bezier(0.36, 0.07, 0.19, 0.97) both;
}
.field-error-msg {
  display: block;
  margin-top: 8rpx;
  font-size: calc(23rpx * var(--fs-mul, 1));
  font-weight: 600;
  color: #d8342c;
}
@keyframes field-error-shake {
  10%, 90% { transform: translateX(-4rpx); }
  20%, 80% { transform: translateX(6rpx); }
  30%, 50%, 70% { transform: translateX(-8rpx); }
  40%, 60% { transform: translateX(8rpx); }
}

/* ============ 兼容：现有页面在用的通用类 ============ */
.page-title { color: var(--ink); font-size: calc(50rpx * var(--fs-mul, 1)); font-weight: 900; line-height: 1.1; letter-spacing: -2rpx; }
.page-subtitle { margin-top: 10rpx; color: var(--mut-strong); font-size: var(--fs-sub); line-height: 1.5; }
.section-title { color: var(--ink); font-size: calc(36rpx * var(--fs-mul, 1)); font-weight: 800; line-height: 1.2; }
.section-desc { margin-top: 6rpx; color: var(--mut); font-size: calc(24rpx * var(--fs-mul, 1)); line-height: 1.45; }
.section { margin-top: 48rpx; }
.muted { color: var(--mut); }
.title { color: var(--ink); font-weight: 800; }
.subtitle { color: var(--mut-strong); }
.divider { height: 2rpx; margin: 24rpx 0; background: var(--paper-2); }
.row { display: flex; align-items: center; justify-content: space-between; }
.primary-btn { box-sizing: border-box; display: flex; align-items: center; justify-content: center; min-height: 88rpx; border-radius: var(--r-card); background: var(--pop-fill); color: #fff; font-size: var(--fs-btn); font-weight: 800; box-shadow: var(--sh-pop); }
.ghost-btn { box-sizing: border-box; display: flex; align-items: center; justify-content: center; min-height: 88rpx; border-radius: var(--r-card); background: var(--c-surface); color: var(--ink); border: var(--bd-card); font-size: var(--fs-btn); font-weight: 700; }
.accent-btn { box-sizing: border-box; display: flex; align-items: center; justify-content: center; min-height: 88rpx; border-radius: var(--r-card); background: var(--pine); color: #fff; font-size: var(--fs-btn); font-weight: 700; }
.primary-btn::after, .ghost-btn::after, .accent-btn::after { border: none; }
.primary-btn:active, .ghost-btn:active, .accent-btn:active { transform: scale(0.98); }
.textarea { box-sizing: border-box; width: 100%; min-height: 220rpx; padding: var(--pad-card-sm); border: var(--bd-card); border-radius: var(--r-card); background: var(--c-surface); color: var(--ink); font-size: calc(28rpx * var(--fs-mul, 1)); line-height: 1.5; }
.empty-state { display: flex; flex-direction: column; align-items: center; padding: 96rpx 28rpx; color: var(--mut); text-align: center; }
.empty-text { margin-top: 16rpx; color: var(--mut); font-size: calc(25rpx * var(--fs-mul, 1)); }
.skeleton { overflow: hidden; border-radius: var(--r-card); background: var(--skeleton); }

/* ============================================================
   动画引擎层 · 缓动对标 GSAP，落地为 WXSS（声明式挂 class）
   ============================================================ */
page {
  --g-dur-fast: 0.32s;
  --g-dur: 0.5s;
  --g-dur-slow: 0.7s;
  --g-power2-out: cubic-bezier(0.22, 0.61, 0.36, 1);
  --g-power3-out: cubic-bezier(0.16, 1, 0.3, 1);
  --g-back-out: cubic-bezier(0.34, 1.56, 0.64, 1);
}
.g-fade-up, .g-fade-in, .g-fade-down, .g-fade-left, .g-fade-right, .g-scale-in {
  animation-duration: var(--g-dur);
  /* backwards 而不是 both：只在「延迟等待 + 播放」期间占住样式，播完交还给元素自己。
     原来用 both，播完后 transform / opacity 被动画永久占着——同一元素上的 .tap-scale 按下缩放
     （社区帖子卡、清单行、首页大图文字区等 13 处）和禁用态的半透明都被盖掉，按了没反应。 */
  animation-fill-mode: backwards;
  animation-timing-function: var(--g-power3-out);
}
.g-fade-up { animation-name: gFadeUp; }
.rv-hold { opacity: 0; transform: translateY(34rpx); }   /* 滚动浮现潜藏态（scroll-reveal mixin 配套） */
.g-fade-down { animation-name: gFadeDown; }
.g-fade-in { animation-name: gFadeIn; animation-timing-function: var(--g-power2-out); }
.g-fade-left { animation-name: gFadeLeft; }
.g-fade-right { animation-name: gFadeRight; }
.g-scale-in { animation-name: gScaleIn; animation-timing-function: var(--g-back-out); }
@keyframes gFadeUp { from { opacity: 0; transform: translateY(34rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes gFadeDown { from { opacity: 0; transform: translateY(-34rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes gFadeIn { from { opacity: 0; } to { opacity: 1; } }
@keyframes gFadeLeft { from { opacity: 0; transform: translateX(48rpx); } to { opacity: 1; transform: translateX(0); } }
@keyframes gFadeRight { from { opacity: 0; transform: translateX(-48rpx); } to { opacity: 1; transform: translateX(0); } }
@keyframes gScaleIn { from { opacity: 0; transform: scale(0.9); } to { opacity: 1; transform: scale(1); } }
/* 状态切换的回应：点赞 / 收藏 / 点菜成功时图标弹一下。挂在「已选中」的选择器上，状态一变就播一次 */
.g-pop { animation: gPop var(--g-dur-fast) var(--g-back-out); }
@keyframes gPop { 0% { transform: scale(0.6); } 60% { transform: scale(1.25); } 100% { transform: scale(1); } }
/* 进度条：进页面时从左长出来，之后数值变化时平滑伸缩 */
.g-grow-x { transform-origin: left center; animation: gGrowX var(--g-dur-slow) var(--g-power3-out) backwards; transition: width var(--g-dur) var(--g-power3-out); }
@keyframes gGrowX { from { transform: scaleX(0); } }
/* 空态插画轻轻浮动，页面不至于完全静止 */
.g-float { animation: gFloat 3.2s ease-in-out infinite; }
@keyframes gFloat { 50% { transform: translateY(-10rpx); } }
.g-d1 { animation-delay: 0.06s; }
.g-d2 { animation-delay: 0.12s; }
.g-d3 { animation-delay: 0.18s; }
.g-d4 { animation-delay: 0.24s; }
.g-d5 { animation-delay: 0.3s; }
.g-d6 { animation-delay: 0.36s; }
.g-d7 { animation-delay: 0.42s; }
.g-d8 { animation-delay: 0.48s; }
.shimmer { position: relative; overflow: hidden; }
.shimmer::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(100deg, transparent 30%, var(--shimmer-hi) 50%, transparent 70%);
  background-size: 200% 100%;
  animation: shimmer 1.2s ease-in-out infinite;
}
@keyframes shimmer { from { background-position: 200% 0; } to { background-position: -200% 0; } }
/* 系统开了「减弱动态效果」：时长归零，内容直接到位；循环类动画停掉 */
@media (prefers-reduced-motion: reduce) {
  page { --g-dur-fast: 0.01s; --g-dur: 0.01s; --g-dur-slow: 0.01s; }
  .g-d1, .g-d2, .g-d3, .g-d4, .g-d5, .g-d6, .g-d7, .g-d8 { animation-delay: 0s; }
  .g-float, .shimmer::after { animation: none; }
  .rv-hold { opacity: 1; transform: none; }
}
@keyframes blink { 50% { opacity: 0; } }

/* —— 图片加载失败兜底（.img-broken，由 binderror 确认后才会挂上）—— */
/* 事故现场：把社区信息流第一条的 photo 指到一个不存在的文件，那张卡的配图位
   留下一整块 440rpx 高的空白——框还在、尺寸还在、什么说明都没有，
   看起来像"这条帖子本来就没图"，而不像"图坏了"。
   上一版这里用的是 CSS-only（在 <image> 上直接出 ::before 当占位，靠"图正常时盖住它"），
   **已回退**：同一个写法在 .pphoto 上画在图片之下（正常图能盖住），
   在 .rc-ph-img 上却画在图片之上——菜谱网格 8 张真实照片被灰块整排盖掉（截图对比复现）。
   同一份 CSS 在两种宿主元素上结论相反，而"遮住正常图片"比"留一个空洞"严重得多。
   所以现在改成：JS 的 binderror 确认失败 → 挂 .img-broken → 这一层才画出来。
   代价是每处要串一条 data-err-key，换来的是"不会误伤能正常显示的图片"。 */
.img-broken { position: relative; background: var(--skeleton); }
.img-broken::before {
  content: "图片没加载出来";
  position: absolute;
  inset: 0;
  box-sizing: border-box;
  padding: 0 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  border-radius: inherit;
  color: var(--mut);
  font-size: var(--fs-mini);
  line-height: 1.4;
}

/* ===================== 全站图标词汇（单色、可被 CSS color 着色）=====================
   为什么放全局：这些形状原来各页自己画一份（社区 .ico-chat、通知页 .ic-bell、
   导入页 .ic-cam…），而 WXML 里当图标用的字符只剩两种下场——系统 emoji（吃不到
   currentColor，既不跟品牌色也不跟深色档翻，iOS/Android 还各画各的），或者一个
   看不见摸不着的变体选择符。所以统一走 CSS 画：尺寸全用 em（跟着 font-size 走，
   大字模式自动生效），颜色一律 currentColor（跟着主题与激活态翻）。
   用法：给一个空 view 挂类，外层用 font-size 控制大小，用 color 控制颜色。 */
.ico-bubble { position: relative; display: inline-block; width: 1.05em; height: 1.05em; vertical-align: -0.14em; }
.ico-bubble::before {
  content: ""; position: absolute; left: 0.06em; top: 0.1em;
  width: 0.88em; height: 0.64em; box-sizing: border-box;
  border: 0.09em solid currentColor; border-radius: 0.2em 0.2em 0.2em 0.06em;
}
.ico-bubble::after {
  content: ""; position: absolute; left: 0.22em; bottom: 0.1em; width: 0; height: 0;
  border-left: 0.14em solid transparent; border-right: 0.05em solid transparent;
  border-top: 0.16em solid currentColor;
}
/* 分享 / 导出：顶部开口的托盘 + 一支向上的箭头（箭头用 clip-path 一次成型） */
.ico-share { position: relative; display: inline-block; width: 1em; height: 1em; vertical-align: -0.14em; }
.ico-share::before {
  content: ""; position: absolute; left: 0.08em; right: 0.08em; bottom: 0.04em;
  height: 0.46em; box-sizing: border-box;
  border: 0.09em solid currentColor; border-top: none; border-radius: 0.08em;
}
.ico-share::after {
  content: ""; position: absolute; left: 50%; top: 0.02em; width: 0.5em; height: 0.56em;
  transform: translateX(-50%); background: currentColor;
  clip-path: polygon(50% 0%, 100% 42%, 66% 42%, 66% 100%, 34% 100%, 34% 42%, 0% 42%);
}
/* 举报：旗杆 + 一面带缺口的旗 */
.ico-flag { position: relative; display: inline-block; width: 0.95em; height: 1.05em; vertical-align: -0.14em; }
.ico-flag::before {
  content: ""; position: absolute; left: 0.06em; top: 0; width: 0.12em; height: 100%;
  background: currentColor; border-radius: 0.05em;
}
.ico-flag::after {
  content: ""; position: absolute; left: 0.18em; top: 0.06em; width: 0.72em; height: 0.5em;
  background: currentColor; clip-path: polygon(0 0, 100% 0, 80% 50%, 100% 100%, 0 100%);
}
