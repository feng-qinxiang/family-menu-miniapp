<view class="vip-page">
  <!-- HERO -->
  <view class="vip-hero">
    <image class="vip-hero-img" src="/assets/dishes/shrimp-peas.jpg" mode="aspectFill" />
    <view class="vip-hero-shade"></view>
    <text class="vip-hero-bignum">VIP</text>
    <view class="vip-hero-top safe-top">
      <view class="vip-backbtn tap-scale" bindtap="goBack">
        <text class="vip-back-ico">‹</text>
      </view>
      <view class="vip-navtitle">会员中心</view>
    </view>
    <view class="vip-hero-body g-fade-up">
      <text class="vip-tag">家庭云同步</text>
      <view class="vip-hero-title title-stroke">家庭云<text class="pop">同步</text></view>
      <view class="vip-hero-sub">菜谱、菜单、买菜清单全家实时共享，谁改了哪样大家都看得到。</view>
      <view class="vip-hero-meta">
        <view class="vip-m">实时云同步</view>
        <view class="vip-m">成员无限</view>
        <view class="vip-m">¥68/年</view>
      </view>
    </view>
  </view>

  <!-- SHEET -->
  <view class="vip-sheet">
    <!-- 权益网格 -->
    <section-head eyebrow="权益一览" title="开通后" popPart="解锁" titleTail="这些" />
    <view class="vip-bgrid">
      <view class="vip-bcard tap-scale g-fade-up g-d{{index % 6 + 1}}" wx:for="{{benefits}}" wx:key="title">
        <view class="vip-bic vip-ic-{{item.icon}}"></view>
        <view class="vip-bc-title">{{item.title}}</view>
        <view class="vip-bc-desc">{{item.desc}}</view>
      </view>
    </view>

    <!-- 版本对比 -->
    <section-head eyebrow="版本对比" title="两个版本" popPart="对比" />
    <view class="vip-cmp">
      <view class="vip-crow vip-chead">
        <view class="vip-lab">功能</view>
        <view class="vip-col">免费版</view>
        <view class="vip-col vip-col-on">同步版</view>
      </view>
      <view class="vip-crow" wx:for="{{compareRows}}" wx:key="feat">
        <view class="vip-feat">{{item.feat}}</view>
        <view class="vip-cell">
          <text wx:if="{{item.freeText}}" class="vip-cell-txt">{{item.freeText}}</text>
          <text wx:elif="{{item.free}}" class="vip-tick">✓</text>
          <text wx:else class="vip-cross">✕</text>
        </view>
        <view class="vip-cell">
          <text wx:if="{{item.vip}}" class="vip-tick on">✓</text>
          <text wx:else class="vip-cross">✕</text>
        </view>
      </view>
    </view>

    <!-- 套餐选择 -->
    <section-head eyebrow="选择套餐" title="选个" popPart="合适" titleTail="的" />
    <view class="vip-plans">
      <view
        class="vip-plan tap-scale {{selectedPlan === item.key ? 'on' : ''}}"
        wx:for="{{plans}}"
        wx:key="key"
        data-plan="{{item.key}}"
        bindtap="selectPlan"
      >
        <view wx:if="{{item.recommend}}" class="vip-corner">推荐</view>
        <view class="vip-pname">{{item.name}}</view>
        <view class="vip-price">{{item.price}}<text wx:if="{{item.unit}}" class="vip-price-u">{{item.unit}}</text></view>
        <view class="vip-per">{{item.per}}</view>
        <view wx:if="{{item.save}}" class="vip-save">{{item.save}}</view>
        <view class="vip-radio {{selectedPlan === item.key ? 'on' : ''}}">
          <text wx:if="{{selectedPlan === item.key}}" class="vip-radio-tick">✓</text>
        </view>
      </view>
    </view>

    <!-- 家庭成员 -->
    <section-head eyebrow="家里人" title="家里" popPart="这几口" />
    <view class="vip-members">
      <view class="vip-pile">
        <view class="vip-av" wx:for="{{familyAvatars}}" wx:key="initial" style="background: {{item.tone}};">{{item.initial}}</view>
        <view class="vip-av vip-more">{{familyMore}}</view>
      </view>
      <view class="vip-synced"><view class="vip-sdot"></view>{{isVip ? '已同步' : '开通后同步'}}</view>
    </view>

    <!-- CTA -->
    <view class="vip-cta safe-bottom">
      <view class="btn btn-pop btn-block tap-scale {{activating ? 'disabled' : ''}}" bindtap="activateVip">
        {{isVip ? '已开通 · ' + planName : (selectedPlan === 'yearly' ? '开通家庭同步 · ¥68/年' : '开通家庭同步 · ¥9.9/月')}}
      </view>
      <view class="vip-note">连续包{{selectedPlan === 'yearly' ? '年' : '月'}}，可随时在设置中取消</view>
    </view>
  </view>
</view>
