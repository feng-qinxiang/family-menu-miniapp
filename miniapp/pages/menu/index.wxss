/* 做菜：信息在上、操作在下，长菜名与大字模式不争用横向空间。 */
.menu-page { padding: 0 0 calc(var(--tabbar-h) + 40rpx); }
.m-sheet { padding: 0 var(--page-gutter); }
.m-add { display: flex; align-items: center; padding: 0 20rpx; font-size: var(--fs-sub); }
.mn-seg { display: flex; padding: 6rpx; background: var(--paper-2); border-radius: var(--r-pill); margin: 8rpx 0 28rpx; }
.mn-seg-item { position: relative; flex: 1; min-height: 80rpx; display: flex; align-items: center; justify-content: center; color: var(--mut); font-size: var(--fs-body); font-weight: 600; border-radius: var(--r-pill); }
/* 视觉 80rpx 不变，热区上下撑到 88rpx（撑进轨道 6rpx 内边距，不超出轨道） */
.mn-seg-item::after { content: ''; position: absolute; left: 0; right: 0; top: 50%; height: var(--tap-min); transform: translateY(-50%); }
/* 选中滑块走 --seg-thumb：深色档卡面与轨道几乎同色，看不出选中 */
.mn-seg-item.on { background: var(--seg-thumb); color: var(--ink); box-shadow: var(--sh-card); }
.m-overview { display: flex; flex-wrap: wrap; align-items: center; gap: 24rpx; margin-bottom: 24rpx; padding: 24rpx; }
.m-overview-copy { flex: 1; min-width: 280rpx; }
.font-lg .m-overview-copy { flex-basis: 100%; }
.m-overview-progress { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 4rpx 12rpx; margin-top: 12rpx; font-size: var(--fs-cap); color: var(--mut-strong); }
.m-overview .m-overview-sub { font-size: var(--fs-cap); }
.m-overview .m-progress-track { margin: 8rpx 0 0; }
.m-overview .m-main-action { flex: none; padding: 0 24rpx; font-size: var(--fs-sub); }
.font-lg .m-overview .m-main-action { flex: 1; }
/* 这页的视觉重点：点了菜之后，总览卡是深色锚点卡（app.wxss .card-dark），进度条走浅金。字色恒浅，不跟主题翻转 */
.m-overview > .m-overview-copy, .m-overview > .m-main-action { position: relative; z-index: 1; }   /* 压在装饰圆上面 */
.m-overview .m-overview-title { color: var(--anchor-contrast); }
.m-overview .m-overview-sub { color: var(--anchor-contrast); opacity: 0.78; }
.m-overview .m-overview-progress { color: var(--gold-on-dark); }
.m-overview .m-progress-track { background: rgba(255, 255, 255, 0.16); }
.m-overview .m-progress-fill { background: var(--gold-on-dark); }
.m-overview-top, .m-overview-bottom, .m-week-head { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.m-overview-top > view { min-width: 0; }
/* 卡片标题一档：今日总览卡、本周计划卡、首页「这一餐的进度」都是 --fs-lg / 800（周卡原来单独大一档 --fs-h2） */
.m-overview-title { font-size: var(--fs-lg); font-weight: 800; color: var(--ink); line-height: 1.4; }
.m-overview-sub { margin-top: 8rpx; font-size: var(--fs-sub); line-height: 1.6; color: var(--mut); }
.m-progress-num { flex: none; font-size: var(--fs-stat); color: var(--pop); font-weight: 800; }
.m-progress-den { font-size: var(--fs-body); color: var(--mut); font-weight: 500; }
.m-progress-track { height: 10rpx; background: var(--paper-2); border-radius: var(--r-pill); overflow: hidden; margin: 24rpx 0 16rpx; }
.m-progress-fill { height: 100%; background: var(--pop-fill); border-radius: var(--r-pill); }
.m-main-action { display: flex; align-items: center; justify-content: center; min-height: var(--tap-min); padding: 0 30rpx; /* 例外：按钮不是卡，左右留白跟字号走 */ background: var(--pop-fill); color: var(--anchor-contrast); font-size: var(--fs-body); font-weight: 700; border-radius: var(--r-card); /* 实心主按钮统一走 --r-card */ }
.m-quick-row { display: flex; gap: 16rpx; margin: 24rpx 0 8rpx; }
/* 两张并排入口卡：图标 + 名称 + 真实状态 + ›；圆角与上方总览卡同为 --r-card */
.m-quick-card { flex: 1; min-width: 0; min-height: var(--tap-min); box-sizing: border-box; display: flex; align-items: center; gap: 16rpx; background: var(--c-surface); padding: 20rpx var(--pad-card-sm); border: var(--bd-card); border-radius: var(--r-card); }
.m-quick-ic { flex: none; width: 68rpx; height: 68rpx; display: flex; align-items: center; justify-content: center; border-radius: var(--r-sm); }
.m-quick-icon { flex: none; width: 40rpx; height: 40rpx; filter: brightness(0); opacity: .7; }
.m-quick-copy { flex: 1; min-width: 0; }
.m-quick-card .m-quick-sub { margin-top: 2rpx; color: var(--mut-strong); }
.m-quick-title { color: var(--ink); font-size: var(--fs-sub); font-weight: 700; line-height: 1.5; }
.m-arrow { color: var(--mut); font-size: var(--fs-cap); }
.m-quick-card .m-arrow { color: var(--mut-strong); font-size: var(--fs-lg); font-weight: 600; line-height: 1; }
.m-quick-sub { margin-top: 8rpx; color: var(--mut); font-size: var(--fs-cap); line-height: 1.5; }
/* 今日空态：在标题、分段和入口卡之下的剩余高度里居中，不在底部留一大块空白 */
/* 整页空：用常规尺寸空态紧跟在快捷卡下面；不再拉满剩余高度居中（上下各留出一大块空白） */
.m-empty { padding-top: 24rpx; }
.m-meal-block { margin-bottom: 28rpx; }
.m-meal-label { display: flex; align-items: center; gap: 14rpx; font-size: var(--fs-lg); font-weight: 700; color: var(--ink); margin: 24rpx 0 16rpx; }
.m-meal-count { font-size: var(--fs-cap); color: var(--mut); font-weight: 500; }
.m-cook-order { display: flex; align-items: flex-start; gap: 12rpx; padding: 18rpx 20rpx; background: var(--paper-2); border-radius: var(--r-sm); margin-bottom: 16rpx; }
.m-co-tag { flex: none; font-size: var(--fs-cap); font-weight: 700; color: var(--ink); line-height: 1.6; }
.m-co-text { font-size: var(--fs-cap); color: var(--mut-strong); line-height: 1.6; overflow-wrap: anywhere; }
.m-row { background: var(--c-surface); border: var(--bd-card); border-radius: var(--r-card); padding: 24rpx var(--pad-card-sm) 0; margin-bottom: 18rpx; overflow: hidden; }
.m-row.is-cooking { border-color: var(--pop-mist); }
.m-dish-top { display: flex; align-items: flex-start; gap: 20rpx; }
.m-thumb { width: var(--dish-thumb); height: var(--dish-thumb); border-radius: var(--r-sm); flex: none; background: var(--paper-2); }
.m-rmid { flex: 1; min-width: 0; }
.m-rname { color: var(--ink); font-size: var(--fs-lg); font-weight: 700; line-height: 1.45; word-break: break-all; }
.m-rsub { color: var(--mut); font-size: var(--fs-cap); margin-top: 8rpx; line-height: 1.6; }
.m-rby { color: var(--mut); font-size: var(--fs-cap); margin-top: 8rpx; line-height: 1.5; }
.m-state { flex: none; padding: 6rpx 12rpx; background: var(--paper-2); color: var(--mut); font-size: var(--fs-mini); font-weight: 600; border-radius: var(--r-xs); }
.m-state.st-cooking { background: var(--pop-soft); color: var(--pop-deep); }
.m-state.st-done { background: var(--c-accent-soft); color: var(--pine-ink); }
.m-dish-bottom { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; border-top: 1rpx solid var(--line); padding: 14rpx 0; margin-top: 22rpx; }
.m-remove { flex: none; display: flex; align-items: center; min-height: var(--tap-min); font-size: var(--fs-cap); color: var(--mut); }
.m-acts { display: flex; align-items: center; justify-content: flex-end; flex-wrap: wrap; gap: 14rpx; }
.m-act { min-height: var(--tap-min); box-sizing: border-box; display: flex; align-items: center; justify-content: center; padding: 0 22rpx; /* 例外：按钮不是卡，左右留白跟字号走 */ border-radius: var(--r-card); font-size: var(--fs-sub); font-weight: 700; }
.m-act-cook { background: var(--anchor); color: var(--anchor-contrast); }   /* 每道菜一颗：降为深色锚点，同屏只留顶部「进入厨房」一颗红 */
.m-act-done { color: var(--ink); background: var(--paper-2); }
.m-done-note { color: var(--pine-ink); font-size: var(--fs-sub); }
.m-week-card { margin-top: 24rpx; }
.m-week-link { display: flex; align-items: center; min-height: var(--tap-min); color: var(--pop); font-size: var(--fs-cap); flex: none; }
.m-wk-item { display: flex; align-items: center; gap: 20rpx; padding: 26rpx 0; border-bottom: 1rpx solid var(--line); }
.m-wk-day { flex: none; color: var(--ink); font-size: var(--fs-body); font-weight: 700; }
.m-wk-day text { color: var(--mut); font-size: var(--fs-cap); font-weight: 500; }
.m-wk-recipe { flex: 1; min-width: 0; color: var(--ink); font-size: var(--fs-sub); line-height: 1.6; }
.m-wk-count { color: var(--mut); font-size: var(--fs-cap); flex: none; }
.m-week-regenerate { margin-top: 12rpx; min-height: var(--tap-min); display: flex; align-items: center; justify-content: center; color: var(--mut); font-size: var(--fs-sub); }
/* 骨架圆角等于它替身的卡（.card / .m-row 都是 --r-card），加载完不跳角 */
.m-skel-card { height: 240rpx; background: var(--skeleton); border-radius: var(--r-card); margin-bottom: 24rpx; }
.m-skel-dish { height: 300rpx; background: var(--skeleton); border-radius: var(--r-card); margin-bottom: 20rpx; }
.font-lg .m-dish-bottom { flex-wrap: wrap; }
.font-lg .m-acts { margin-left: auto; }

/* 深色档覆盖放在文件末尾：@media 不加权重，写在被覆盖的规则之前会被盖回去。
   「已上桌」对齐首页 .hm-status--done 的深色档（--pine 文字在深底上只有约 2.9:1）；
   「制作中」直接用 --pop-deep，深色档已在 app.wxss 提亮，不逐页覆盖 */
@media (prefers-color-scheme: dark) {
  .m-state.st-done { color: var(--c-success); background: var(--c-success-soft); }
  .m-done-note { color: var(--c-success); }
  .m-quick-icon { filter: brightness(0) invert(1); }
}
