<wxs src="/utils/cuisine.wxs" module="cuisine" />
<view class="recipes-mag {{fontScale === 'lg' ? 'font-lg' : ''}}">
  <!-- ===== HERO（轻量头部：小图条 + 实心标题） ===== -->
  <view class="rx-hero g-fade-in">
    <image wx:if="{{heroRecipe.cover}}" class="rx-hero-img" src="{{heroRecipe.cover}}" mode="aspectFill" />
    <image wx:else class="rx-hero-img" src="/assets/dishes/kungpao-chicken.jpg" mode="aspectFill" />
    <view class="rx-hero-shade"></view>

    <view class="rx-hero-top g-fade-down g-d1" style="top: {{capsuleTop}}; right: {{capsuleRight}};">
      <view class="rx-greet">
        <view class="rx-hi">家常菜谱库</view>
        <view class="rx-name">挑一道，今晚就点它</view>
      </view>
      <view class="rx-create tap-scale" bindtap="goCreate">
        <text class="rx-create-plus">+</text>新建
      </view>
    </view>

    <view class="rx-hero-body g-fade-up g-d2">
      <view class="rx-tag">菜谱精选</view>
      <view class="rx-hero-title title-stroke">家里能点的<text class="pop">菜</text></view>
      <view class="rx-hero-meta">
        <view class="rx-m">{{filteredRecipes.length}} 道可点</view>
        <view class="rx-m">川 · 粤 · 家常</view>
      </view>
    </view>
  </view>

  <!-- ===== SHEET ===== -->
  <view class="rx-sheet">
    <!-- 搜索 -->
    <view class="rx-search g-fade-up g-d1 {{searchFocused ? 'focus' : ''}}">
      <view class="rx-search-ico"></view>
      <input class="rx-search-input" placeholder="搜菜名、菜系、口味" placeholder-class="rx-search-ph"
        value="{{searchText}}" bindinput="onSearchInput" bindfocus="onSearchFocus" bindblur="onSearchBlur" />
    </view>

    <!-- 来源 chips + 忌口设置 -->
    <view class="rx-srcrow">
      <scroll-view scroll-x class="rx-chips" enhanced="{{true}}" show-scrollbar="{{false}}">
        <view class="rx-chips-inner">
          <view wx:for="{{sourceTabs}}" wx:key="key"
            class="tap-scale chip rx-chip {{activeSource === item.key ? 'on' : ''}}"
            data-source="{{item.key}}" bindtap="selectSource">
            <view class="rx-sdot rx-sdot--{{item.key}}"></view>
            {{item.label}}
          </view>
        </view>
      </scroll-view>
      <!-- 忌口小 icon：避开整行占位 -->
      <view wx:if="{{avoidTags.length}}" class="rx-avd-ic tap-scale" catchtap="toggleAvoidFilter" aria-label="家人忌口">
        <view class="rx-avd-dot" wx:if="{{avoidActive}}"></view>
        <view class="rx-avd-glyph"></view>
        <text class="rx-avd-t">{{avoidActive ? '忌口' : '关'}}</text>
      </view>
    </view>

    <!-- 点菜条件：菜系 + 耗时 + 人份，合并到一个可展开面板 -->
    <view class="rx-diet tap-scale" bindtap="toggleAdvFilter">
      <view class="rx-diet-ico"></view>
      <text class="rx-diet-label">点菜条件</text>
      <text class="rx-diet-val">{{advFilter.cuisine || (advFilter.maxTime ? advFilter.maxTime + '分' : '') || (advFilter.minServings ? advFilter.minServings + '人' : '') || '菜系 · 耗时 · 人份'}}</text>
      <text class="rx-diet-toggle">{{showAdvFilter ? '收起' : '细筛'}}</text>
    </view>

    <view class="rx-quickfilters" wx:if="{{showAdvFilter}}">
      <!-- 菜系 -->
      <view class="rx-qf-row">
        <text class="rx-qf-label">菜系</text>
        <scroll-view scroll-x class="rx-qf-scroll" enhanced="{{true}}" show-scrollbar="{{false}}">
          <view class="rx-qf-chips">
            <view class="tap-scale rx-qf-chip {{!advFilter.cuisine ? 'on' : ''}}" data-val="" bindtap="setFilterCuisine">全部</view>
            <view wx:for="{{cuisineList}}" wx:key="*this"
              class="tap-scale rx-qf-chip {{advFilter.cuisine === item ? 'on' : ''}}"
              data-val="{{item}}" bindtap="setFilterCuisine">{{item}}</view>
          </view>
        </scroll-view>
      </view>
      <!-- 耗时 -->
      <view class="rx-qf-row">
        <text class="rx-qf-label">耗时</text>
        <view class="rx-qf-chips">
          <view class="tap-scale rx-qf-chip {{advFilter.maxTime === 0 ? 'on' : ''}}" data-val="0" bindtap="setFilterTime">不限</view>
          <view class="tap-scale rx-qf-chip {{advFilter.maxTime === 15 ? 'on' : ''}}" data-val="15" bindtap="setFilterTime">15分钟</view>
          <view class="tap-scale rx-qf-chip {{advFilter.maxTime === 30 ? 'on' : ''}}" data-val="30" bindtap="setFilterTime">30分钟</view>
          <view class="tap-scale rx-qf-chip {{advFilter.maxTime === 60 ? 'on' : ''}}" data-val="60" bindtap="setFilterTime">60分钟</view>
        </view>
      </view>
      <!-- 人份 -->
      <view class="rx-qf-row">
        <text class="rx-qf-label">人份</text>
        <view class="rx-qf-chips">
          <view class="tap-scale rx-qf-chip {{advFilter.minServings === 0 ? 'on' : ''}}" data-val="0" bindtap="setFilterServings">不限</view>
          <view class="tap-scale rx-qf-chip {{advFilter.minServings === 2 ? 'on' : ''}}" data-val="2" bindtap="setFilterServings">2人+</view>
          <view class="tap-scale rx-qf-chip {{advFilter.minServings === 4 ? 'on' : ''}}" data-val="4" bindtap="setFilterServings">4人+</view>
        </view>
      </view>
      <!-- 一键清空 -->
      <view class="rx-qf-reset tap-scale" bindtap="clearFilter">
        <text>清空全部条件</text>
      </view>
    </view>

    <!-- 骨架 -->
    <view wx:if="{{loading}}" class="rx-grid">
      <view class="rx-skel" wx:for="{{skeletonCards}}" wx:key="*this">
        <view class="rx-skel-cover shimmer"></view>
        <view class="rx-skel-line strong shimmer"></view>
        <view class="rx-skel-line shimmer"></view>
      </view>
    </view>

    <!-- 结果标题 -->
    <section-head
      wx:if="{{!loading && displayedRecipes.length}}"
      ext-class="rx-shead"
      eyebrow="点到即做"
      title=""
      popPart="{{filteredRecipes.length}}"
      titleTail=" 道可点"
      hint="点 + 加入今日"
    />

    <!-- 点到下拉：自定义面板替代原生 picker（原生白滚轮与整体风格不符，且样式不可定制） -->
    <view class="rx-meal-picker" wx:if="{{!loading && displayedRecipes.length}}">
      <view class="rx-meal-pk-btn tap-scale" catchtap="toggleMealDrop">
        <text class="rx-meal-pk-l">点到</text>
        <text class="rx-meal-pk-v">{{mealOptionLabels[mealIndex]}} ▾</text>
      </view>
      <view class="rx-drop-mask" wx:if="{{mealDropOpen}}" catchtap="closeMealDrop"></view>
      <view class="rx-meal-drop" wx:if="{{mealDropOpen}}">
        <view
          class="rx-meal-opt {{mealIndex === idx ? 'on' : ''}}"
          wx:for="{{mealOptionLabels}}"
          wx:for-item="label"
          wx:for-index="idx"
          wx:key="*this"
          data-idx="{{idx}}"
          hover-class="rx-meal-opt-hov"
          catchtap="onMealPick"
        >
          <text>{{label}}</text>
          <text class="rx-meal-opt-x">✓</text>
        </view>
      </view>
    </view>

    <!-- 菜卡网格 -->
    <view class="rx-grid" wx:if="{{!loading && displayedRecipes.length}}">
      <view
        class="rx-card-slot {{revealOn ? (reveal[index] ? 'g-fade-up' : 'rv-hold') : 'g-fade-up g-d' + (index % 5 + 1)}}"
        data-rv="{{index}}"
        wx:for="{{displayedRecipes}}"
        wx:key="id"
      >
        <recipe-card
          recipe="{{item}}"
          variant="card"
          density="grid"
          selected="{{item.selected}}"
          badge="{{item.sourceLabel}}"
          showAdd="{{true}}"
          showFav="{{false}}"
          addPlacement="corner"
          bind:tap="goDetail"
          bind:add="addRecipeToToday"
        />
      </view>
    </view>

    <!-- 上拉加载 -->
    <view wx:if="{{!loading && hasMore}}" class="tap-scale rx-loadmore" bindtap="loadMore">
      <view class="rx-loadmore-chev"></view>
      上拉加载更多 · 还有 {{remainCount}} 道
    </view>

    <!-- 加载失败态 -->
    <view wx:if="{{loadError}}">
      <state-empty type="offline" title="菜谱没加载出来" desc="网络开小差了，检查后再试" cta="重新加载" bindaction="retryLoad" />
    </view>

    <!-- 空状态 -->
    <view wx:elif="{{!loading && !filteredRecipes.length}}">
      <state-empty type="search" title="没有符合条件的菜谱" desc="换个来源或菜系，再试试" cta="清空筛选" bindaction="clearFilter">
        <view class="rx-empty-extra tap-scale" bindtap="goCreate">去新建一道</view>
      </state-empty>
    </view>
  </view>

  <!-- 长菜谱列表滚深后回顶（页面级滚动，避开餐盘条） -->
  <back-top show="{{showBackTop}}" right="32rpx" bottom="320rpx" bind:totop="backToTop" />

  <!-- ===== 餐盘 tray ===== -->
  <view class="rx-tray" wx:if="{{!loading}}">
    <view class="tap-scale rx-tray-badge" bindtap="goMenu">{{menuTray.count}}</view>
    <view class="tap-scale rx-tray-copy" bindtap="goMenu">
      <view class="rx-tray-t">今日餐盘</view>
      <view class="rx-tray-s">{{menuTray.names}}</view>
    </view>
    <view class="rx-tray-mini tap-scale" wx:if="{{menuTray.shoppingCount}}" catchtap="goShopping">买 {{menuTray.shoppingCount}}</view>
    <view class="rx-tray-go tap-scale" catchtap="goMenu">
      去点单
      <view class="rx-tray-arrow"></view>
    </view>
  </view>
</view>
