<!-- 餐盘为 0 不出浮条；底部留白跟着浮条走（rx-has-tray），两处共用同一个条件 -->
<view class="recipes-mag {{fontScale === 'lg' ? 'font-lg' : ''}} {{!loading && menuTray.count ? 'rx-has-tray' : ''}}">
  <nav-bar title="菜谱库" show-back="{{true}}" />
  <!-- ===== 紧凑页头（全站统一 .cpt-head，见 app.wxss） ===== -->
  <view class="cpt-head rx-heading">
    <view class="cpt-row">
      <view class="cpt-titles">
        <view class="rx-heading-title">家里的菜谱<text class="rx-heading-count" wx:if="{{recipes.length}}">{{recipes.length}} 道</text></view>
      </view>
      <view class="cpt-action rx-create tap-scale" bindtap="goCreate" aria-role="button" aria-label="新建菜谱">
        <text class="rx-create-plus">+</text>新建
      </view>
    </view>
  </view>

  <view class="rx-sheet">
    <!-- 搜索与筛选共用一条工具栏，分类和挑菜使用轻量文字入口。 -->
    <view class="rx-searchrow {{searchFocused ? 'focus' : ''}} {{showAdvFilter ? 'expanded' : ''}}">
      <view class="rx-search">
        <view class="rx-search-ico"></view>
        <input class="rx-search-input" placeholder="搜菜名、菜系、口味" placeholder-class="rx-search-ph"
          value="{{searchText}}" bindinput="onSearchInput" bindfocus="onSearchFocus" bindblur="onSearchBlur" />
      </view>
      <view class="rx-filter-btn tap-scale {{showAdvFilter || advFilter.maxTime || advFilter.minServings ? 'on' : ''}}"
        bindtap="toggleAdvFilter" aria-role="button" aria-expanded="{{showAdvFilter}}" aria-label="点菜条件：耗时、人份">
        <view class="rx-filter-ico"></view>
        <text class="rx-filter-t">{{showAdvFilter ? '收起' : '筛选'}}</text>
        <view wx:if="{{advFilter.maxTime || advFilter.minServings}}" class="rx-filter-dot" aria-hidden="true"></view>
      </view>
    </view>

    <view class="rx-quickfilters" wx:if="{{showAdvFilter}}" aria-label="耗时和人份筛选">
      <view class="rx-qf-row">
        <text class="rx-qf-label">耗时</text>
        <view class="rx-qf-chips">
          <view class="tap-scale rx-qf-chip {{advFilter.maxTime === 0 ? 'on' : ''}}" data-val="0" bindtap="setFilterTime" aria-role="button" aria-pressed="{{advFilter.maxTime === 0}}"><text class="rx-qf-text">不限</text></view>
          <view class="tap-scale rx-qf-chip {{advFilter.maxTime === 15 ? 'on' : ''}}" data-val="15" bindtap="setFilterTime" aria-role="button" aria-pressed="{{advFilter.maxTime === 15}}"><text class="rx-qf-text">15分内</text></view>
          <view class="tap-scale rx-qf-chip {{advFilter.maxTime === 30 ? 'on' : ''}}" data-val="30" bindtap="setFilterTime" aria-role="button" aria-pressed="{{advFilter.maxTime === 30}}"><text class="rx-qf-text">30分内</text></view>
          <view class="tap-scale rx-qf-chip {{advFilter.maxTime === 60 ? 'on' : ''}}" data-val="60" bindtap="setFilterTime" aria-role="button" aria-pressed="{{advFilter.maxTime === 60}}"><text class="rx-qf-text">60分内</text></view>
        </view>
      </view>
      <view class="rx-qf-row">
        <text class="rx-qf-label">人份</text>
        <view class="rx-qf-chips">
          <view class="tap-scale rx-qf-chip {{advFilter.minServings === 0 ? 'on' : ''}}" data-val="0" bindtap="setFilterServings" aria-role="button" aria-pressed="{{advFilter.minServings === 0}}"><text class="rx-qf-text">不限</text></view>
          <view class="tap-scale rx-qf-chip {{advFilter.minServings === 2 ? 'on' : ''}}" data-val="2" bindtap="setFilterServings" aria-role="button" aria-pressed="{{advFilter.minServings === 2}}"><text class="rx-qf-text">2人以上</text></view>
          <view class="tap-scale rx-qf-chip {{advFilter.minServings === 4 ? 'on' : ''}}" data-val="4" bindtap="setFilterServings" aria-role="button" aria-pressed="{{advFilter.minServings === 4}}"><text class="rx-qf-text">4人以上</text></view>
          <view class="rx-qf-reset tap-scale" bindtap="clearFilter" aria-role="button" aria-label="重置所有筛选条件"><text class="rx-qf-text">重置</text></view>
        </view>
      </view>
      <view class="rx-stock-toggle"><view><text>显示冰箱用料</text><text class="rx-filter-hint">在菜卡上核对现有食材</text></view><switch class="tap-scale" checked="{{showPantryDetails}}" color="#436b55" bindchange="togglePantryDetails" aria-label="显示冰箱用料状态" /></view>
    </view>

    <view class="rx-pickbar" wx:if="{{!loading && !loadError}}">
      <view class="rx-pick-option tap-scale {{pickerOpen && pickMode === 'all' ? 'on' : ''}}" data-mode="all" bindtap="openPicker" aria-role="button" aria-label="从当前筛选结果随机挑一道菜">
        <image class="rx-pick-icon" src="/assets/icons/lucide/sparkles.svg" mode="aspectFit" aria-hidden="true" />
        <text>随机一道</text>
      </view>
      <view class="rx-pick-option tap-scale {{pickerOpen && pickMode === 'pantry' ? 'on' : ''}}" data-mode="pantry" bindtap="openPicker" aria-role="button" aria-label="随机挑选冰箱食材齐全的菜，优先用临期食材">
        <image class="rx-pick-icon" src="/assets/icons/tab-fridge.svg" mode="aspectFit" aria-hidden="true" />
        <text>冰箱能做</text>
      </view>
      <view class="rx-pick-stock tap-scale" bindtap="openMealRequest" aria-role="button" aria-label="输入人数、耗时和口味，按需挑菜">按需挑菜 ›</view>
    </view>

    <view class="rx-picker" wx:if="{{pickerOpen && !loading && !loadError}}">
      <view class="rx-picker-head">
        <view class="rx-picker-label">{{pickMode === 'pantry' ? '冰箱里，挑一道' : '今天吃什么'}}</view>
        <view class="rx-picker-close tap-scale" bindtap="closePicker" aria-role="button" aria-label="收起随机挑菜">×</view>
      </view>
      <view class="rx-stock-summary">
        <view class="rx-stock-head"><text>冰箱现有<text wx:if="{{!pantryStockLoading && !pantryStockFailed && pantryItems.length}}"> · {{pantryItems.length}} 种</text></text><view class="tap-scale rx-stock-link" bindtap="goPantry" aria-role="button">查看全部 ›</view></view>
        <view class="rx-stock-note" wx:if="{{pantryStockLoading}}">正在看看冰箱里有什么…</view>
        <view class="rx-stock-note" wx:elif="{{pantryStockFailed}}">库存暂时没加载出来<text class="tap-scale" bindtap="loadPantryChoices"> · 重试</text></view>
        <view class="rx-stock-items" wx:elif="{{pantryItems.length}}">
          <view class="rx-stock-item" wx:for="{{pantryItems}}" wx:key="id" wx:if="{{index < 6}}"><text class="rx-stock-name">{{item.ingredientName}}</text><text class="rx-stock-amount">{{item.amountText || '数量待补'}}</text></view>
          <text class="rx-stock-more" wx:if="{{pantryItems.length > 6}}">另有 {{pantryItems.length - 6}} 种，可查看全部</text>
        </view>
        <view class="rx-stock-note" wx:else>冰箱还没有食材，先把家里有的记进来。</view>
        <view class="rx-picker-stock" wx:if="{{pickMode === 'pantry' && !pantryLoading && !pantryFailed && (pantrySummary.expiringCount || pantrySummary.expiredCount)}}">
          <text wx:if="{{pantrySummary.expiringCount}}">{{pantrySummary.expiringCount}} 种临期优先</text>
          <text wx:if="{{pantrySummary.expiredCount}}">过期食材已排除</text>
        </view>
      </view>
      <view wx:if="{{pickMode === 'pantry' && pantryLoading}}" class="rx-picker-empty">正在看看冰箱里能做什么…</view>
      <view wx:elif="{{pickMode === 'pantry' && pantryFailed}}" class="rx-picker-empty">
        <view>冰箱匹配暂时没加载出来</view>
        <view class="rx-picker-retry tap-scale" bindtap="loadPantryChoices" aria-role="button">重新匹配</view>
      </view>
      <block wx:elif="{{pickedRecipe}}">
        <view class="rx-picked-main tap-scale" bindtap="goDetail" data-id="{{pickedRecipe.id}}" aria-role="button" aria-label="查看{{pickedRecipe.title}}菜谱">
          <view class="rx-picked-photo"><image class="rx-picked-thumb" src="{{pickedRecipe.cover}}" mode="aspectFill" /></view>
          <view class="rx-picked-copy">
            <view class="rx-picked-name">{{pickedRecipe.title}}</view>
            <view class="rx-picked-meta">{{pickedRecipe.timeCost || '--'}} 分钟 · {{pickedRecipe.servings || '--'}} 人份</view>
            <view class="rx-picked-tags">{{pickedRecipe.cuisine}}<block wx:if="{{pickedRecipe.tasteTags.length}}"> · {{pickedRecipe.tasteTags[0]}}</block></view>
            <view class="rx-picked-ready" wx:if="{{pickMode === 'pantry'}}">食材齐全 · 按菜谱量</view>
            <view class="rx-picked-summary" wx:if="{{pickedRecipe.summary}}">{{pickedRecipe.summary}}</view>
            <view class="rx-picked-priority" wx:if="{{pickMode === 'pantry' && pickedRecipe.priorityText}}">{{pickedRecipe.priorityText}}</view>
          </view>
        </view>
        <view class="rx-picker-actions">
          <view class="rx-picker-next tap-scale" bindtap="pickRandom" aria-role="button">{{pickCount > 1 ? '换一道' : '就这一道'}}<text wx:if="{{pickCount > 1}}">{{pickCount}} 道可选</text></view>
          <view class="rx-picker-add tap-scale" bindtap="addPickedRecipe" aria-role="button">加入{{mealOptionLabels[mealIndex]}}</view>
        </view>
      </block>
      <view wx:else class="rx-picker-empty">
        <view>{{pickMode === 'pantry' ? '暂时没有未点过且食材齐全的菜' : '当前条件下没有未点过的菜'}}</view>
        <view class="rx-picker-note">{{pickMode === 'pantry' ? '查看冰箱补全数量、单位和到期日，或切换「随机一道」。' : '试试调整搜索或筛选条件。'}}</view>
      </view>
    </view>

    <!-- 菜系在左侧常驻。 -->
    <view wx:if="{{advFilter.cuisine || activeSource !== 'all' || advFilter.maxTime || advFilter.minServings || requestMildOnly}}" class="rx-current-filter" aria-label="当前筛选条件">
      <text class="rx-filter-caption">已选</text>
      <view wx:if="{{advFilter.cuisine}}" class="rx-filter-selected tap-scale" data-val="" bindtap="setFilterCuisine" aria-role="button" aria-label="清除菜系条件：{{advFilter.cuisine}}">{{advFilter.cuisine}} ×</view>
      <view wx:if="{{activeSource !== 'all'}}" class="rx-filter-selected tap-scale" data-source="all" bindtap="selectSource" aria-role="button" aria-label="清除来源条件">{{activeSource === 'owned' ? '自建' : activeSource === 'community' ? '社区' : activeSource === 'imported' ? '导入' : '收藏'}} ×</view>
      <view wx:if="{{advFilter.maxTime}}" class="rx-filter-selected tap-scale" data-val="0" bindtap="setFilterTime" aria-role="button" aria-label="清除耗时条件">{{advFilter.maxTime}} 分钟内 ×</view>
      <view wx:if="{{advFilter.minServings}}" class="rx-filter-selected tap-scale" data-val="0" bindtap="setFilterServings" aria-role="button" aria-label="清除人份条件">{{advFilter.minServings}} 人以上 ×</view>
      <view wx:if="{{requestMildOnly}}" class="rx-filter-selected tap-scale" bindtap="clearMildRequest" aria-role="button">不辣标注 ×</view>
    </view>
    <view class="rx-browser">
      <view class="rx-source-rail" aria-label="{{railMode === 'cuisine' ? '选择菜系' : '选择菜谱来源'}}">
        <picker range="{{railModes}}" value="{{railMode === 'source' ? 1 : 0}}" bindchange="selectRailMode" aria-label="切换菜系或来源分类"><view class="rx-rail-mode">{{railMode === 'cuisine' ? '菜系' : '来源'}}<text>⌄</text></view></picker>
        <scroll-view scroll-y class="rx-rail-scroll {{railMode === 'cuisine' ? 'rx-rail-cuisine' : ''}}" enhanced="{{true}}" show-scrollbar="{{false}}">
        <block wx:if="{{railMode === 'cuisine'}}">
          <view class="rx-source tap-scale {{!advFilter.cuisine ? 'on' : ''}}" data-val="" bindtap="setFilterCuisine" aria-role="button" aria-pressed="{{!advFilter.cuisine}}">全部</view>
          <view wx:for="{{cuisineList}}" wx:key="*this" class="rx-source tap-scale {{advFilter.cuisine === item ? 'on' : ''}}" data-val="{{item}}" bindtap="setFilterCuisine" aria-role="button" aria-pressed="{{advFilter.cuisine === item}}">{{item}}</view>
        </block>
        <block wx:else>
        <view wx:for="{{sourceTabs}}" wx:key="key"
          class="rx-source tap-scale {{activeSource === item.key ? 'on' : ''}}"
          data-source="{{item.key}}" bindtap="selectSource" aria-role="button" aria-pressed="{{activeSource === item.key}}">
          <text>{{item.key === 'favorites' ? '收藏' : item.label}}</text>
        </view>
        </block>
        </scroll-view>
        <view wx:if="{{avoidTags.length}}" class="rx-avoid tap-scale {{avoidActive ? 'on' : ''}}" bindtap="toggleAvoidFilter" aria-role="button" aria-label="家人忌口过滤：{{avoidActive ? '已开启' : '已关闭'}}" aria-pressed="{{avoidActive}}">忌口<text>{{avoidActive ? '已开' : '已关'}}</text></view>
      </view>
      <view class="rx-results">
    <!-- 骨架 -->
    <view wx:if="{{loading}}" class="rx-grid">
      <view class="rx-skel" wx:for="{{skeletonCards}}" wx:key="*this">
        <view class="rx-skel-cover shimmer"></view>
        <view class="rx-skel-line strong shimmer"></view>
        <view class="rx-skel-line shimmer"></view>
      </view>
    </view>

    <!-- 结果条：「N 道可点」与「点到 晚餐」并成一行（原来是 section-head 大标题 + 单独一行下拉） -->
    <view class="rx-listbar" wx:if="{{!loading && displayedRecipes.length}}">
      <view class="rx-listbar-l">
        <text class="rx-listbar-n">{{pickMode === 'pantry' ? '冰箱能做的菜' : '可选菜品'}} · {{filteredRecipes.length}}</text>
      </view>
      <!-- 点到下拉：自定义面板替代原生 picker（原生白滚轮与整体风格不符） -->
      <view class="rx-meal-picker">
        <view class="rx-meal-pk-btn tap-scale" catchtap="toggleMealDrop" aria-role="button" aria-label="加入到哪一餐：{{mealOptionLabels[mealIndex]}}">
          <text class="rx-meal-pk-l">点到</text>
          <text class="rx-meal-pk-v">{{mealOptionLabels[mealIndex]}} ▾</text>
        </view>
        <view class="rx-drop-mask" wx:if="{{mealDropOpen}}" catchtap="closeMealDrop"></view>
        <view class="rx-meal-drop" wx:if="{{mealDropOpen}}">
          <view
            class="rx-meal-opt {{mealIndex === idx ? 'on' : ''}}"
            wx:for="{{mealOptionLabels}}"
            wx:for-item="label"
            wx:for-index="idx"
            wx:key="*this"
            data-idx="{{idx}}"
            hover-class="rx-meal-opt-hov"
            catchtap="onMealPick"
          >
            <text>{{label}}</text>
            <text class="rx-meal-opt-x">✓</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 菜卡网格 -->
    <view class="rx-grid" wx:if="{{!loading && displayedRecipes.length}}">
      <view
        class="rx-card-slot {{revealOn ? (reveal[index] ? 'g-fade-up' : 'rv-hold') : 'g-fade-up g-d' + (index % 5 + 1)}}"
        data-rv="{{index}}"
        wx:for="{{displayedRecipes}}"
        wx:key="id"
      >
        <recipe-card
          recipe="{{item}}"
          variant="row"
          density="list"
          selected="{{item.selected}}"
          badge="{{item.sourceLabel}}"
          metaOverride="{{pickMode === 'pantry' ? (item.priorityText || item.pantryText) : ''}}"
          showAdd="{{true}}"
          showFav="{{false}}"
          showPantry="{{showPantryDetails}}"
          addPlacement="corner"
          bind:tap="goDetail"
          bind:add="addRecipeToToday"
        />
      </view>
    </view>

    <!-- 上拉加载 -->
    <view wx:if="{{!loading && hasMore}}" class="tap-scale rx-loadmore" bindtap="loadMore">
      <view class="rx-loadmore-chev"></view>
      上拉加载更多 · 还有 {{remainCount}} 道
    </view>

    <!-- 加载失败态 -->
    <view wx:if="{{loadError}}">
      <state-empty type="offline" title="菜谱没加载出来" desc="网络开小差了，检查后再试" cta="重新加载" bindaction="retryLoad" />
    </view>

    <!-- 空状态 -->
    <view wx:elif="{{!loading && !filteredRecipes.length && !pickerOpen}}">
      <state-empty type="search" title="没有符合条件的菜谱" desc="换个来源或菜系，再试试" cta="清空筛选" bindaction="clearFilter">
        <view class="rx-empty-extra tap-scale" bindtap="goCreate">去新建一道</view>
      </state-empty>
    </view>
      </view>
    </view>
  </view>

  <state-sheet visible="{{requestOpen}}" title="这顿想怎么吃？" bind:close="closeMealRequest">
    <view class="rx-request-intro">说说人数、耗时和口味，我们来挑一道。</view>
    <textarea class="rx-request-input" value="{{requestText}}" maxlength="100" placeholder="例如：两人吃，30分钟，不辣，冰箱有的" placeholder-class="rx-search-ph" bindinput="onMealRequestInput" aria-label="这顿饭的条件" />
    <view class="rx-request-examples" wx:if="{{!requestText}}">
      <text class="rx-request-caption">试试这样说</text>
      <view class="rx-request-example-grid"><view wx:for="{{requestExamples}}" wx:key="*this" wx:if="{{index < 2}}" class="rx-request-example tap-scale" data-index="{{index}}" bindtap="useMealRequestExample" aria-role="button"><text class="rx-request-example-title">{{index === 0 ? '两人快手餐' : '先用冰箱'}}</text><text>{{item}}</text></view></view>
    </view>
    <view class="rx-request-preview" wx:if="{{requestPreview.labels.length}}">
      <text class="rx-request-caption">按这些条件筛选</text>
      <view class="rx-request-labels">
        <view wx:if="{{requestPreview.minServings}}"><text>人数</text><text>{{requestPreview.minServings}} 人以上</text></view>
        <view wx:if="{{requestPreview.maxTime}}"><text>耗时</text><text>{{requestPreview.maxTime}} 分钟内</text></view>
        <view wx:if="{{requestPreview.cuisine}}"><text>菜系</text><text>{{requestPreview.cuisine}}</text></view>
        <view wx:if="{{requestPreview.mealType}}"><text>餐次</text><text>{{requestPreview.mealType === 'breakfast' ? '早餐' : requestPreview.mealType === 'lunch' ? '午餐' : requestPreview.mealType === 'dinner' ? '晚餐' : '加餐'}}</text></view>
        <view wx:if="{{requestPreview.mildOnly}}"><text>口味</text><text>有不辣／清淡标注</text></view>
        <view wx:if="{{requestPreview.pantryOnly}}"><text>食材</text><text>冰箱能做 · 临期优先</text></view>
      </view>
    </view>
    <view class="rx-request-warning" wx:for="{{requestPreview.warnings}}" wx:key="*this">{{item}}</view>
    <view class="rx-request-note" wx:if="{{requestPreview.mildOnly}}">只选有“不辣／清淡”标注的菜。</view>
    <button class="rx-request-submit tap-scale" disabled="{{!requestPreview.canApply || loading || loadError}}" bindtap="applyMealRequest">按这些条件挑一道</button>
  </state-sheet>

  <!-- 长菜谱列表滚深后回顶：有浮条时抬高避开它，没浮条时只避开 tabBar -->
  <back-top show="{{showBackTop}}" right="32rpx" bottom="{{!loading && menuTray.count ? '320rpx' : '200rpx'}}" bind:totop="backToTop" />

  <!-- ===== 餐盘 tray：有菜才出现 ===== -->
  <view class="rx-tray" wx:if="{{!loading && menuTray.count}}">
    <view class="tap-scale rx-tray-badge" bindtap="goMenu">{{menuTray.count}}</view>
    <view class="tap-scale rx-tray-copy" bindtap="goMenu">
      <view class="rx-tray-t">今日餐盘</view>
      <view class="rx-tray-s">{{menuTray.names}}</view>
    </view>
    <view class="rx-tray-mini tap-scale" wx:if="{{menuTray.shoppingCount}}" catchtap="goShopping">买 {{menuTray.shoppingCount}}</view>
    <view class="rx-tray-go tap-scale" catchtap="goMenu">
      去点单
      <view class="rx-tray-arrow"></view>
    </view>
  </view>
</view>
