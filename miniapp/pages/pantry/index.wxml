<view class="pantry-page {{fontScale === 'lg' ? 'font-lg' : ''}}">
  <state-loading visible="{{loading}}" text="冰箱开门中…" />

  <!-- 紧凑页头（只有「今日」保留整幅照片 hero） -->
  <view class="cpt-head g-fade-up" style="padding-top: {{capsuleTop}};">
    <view class="cpt-row" style="padding-right: {{capsuleRight}};">
      <view class="cpt-titles">
        <view class="cpt-eyebrow">我的冰箱</view>
        <view class="cpt-title">冰箱库存</view>
      </view>
    </view>
    <view class="cpt-sub">家里现在有什么，点菜前先看一眼 · 做完菜按用量自动扣</view>
    <!-- 统计一行字：空库不显示（三个 0 像坏了）；临期 >0 才出现且用 --pop-deep 当真实警示 -->
    <view wx:if="{{pantrySummary.count}}" class="pstat-line">
      <text>{{pantrySummary.count}} 种在库</text>
      <text wx:if="{{pantrySummary.expiringCount}}" class="pstat-warn"> · {{pantrySummary.expiringCount}} 种临期</text>
    </view>
  </view>

  <!-- 内容层 -->
  <view class="psheet">
    <!-- 现在有的：空库时空态自己会说「冰箱还空着」，不再叠一个区块标题 -->
    <section-head
      wx:if="{{!loaded || loadError || categories.length}}"
      eyebrow="在库食材"
      title="现在有的"
    />

    <!-- 加载失败态 -->
    <state-empty
      wx:if="{{loadError}}"
      type="offline"
      title="冰箱没打开"
      desc="网络开小差了，检查后再试"
      cta="重新加载"
      bind:action="retryLoad"
    />

    <!-- 空态 -->
    <state-empty
      wx:elif="{{loaded && !categories.length}}"
      type="pop"
      title="冰箱还空着"
      desc="把家里有的食材记进来，点菜时就能先看能做什么"
    />

    <!-- 添加食材：本页唯一主操作。放在空态正下方 / 列表之前，保证首屏可见、不被 tabBar 压住；
         加载失败时主操作是「重新加载」，这里先不出 -->
    <block wx:if="{{loaded && !loadError}}">
      <view class="addcard tap-scale" bindtap="toggleAddForm">
        <view class="add-pl"><view class="add-plus"></view></view>
        <view class="add-at">
          <view class="add-t">添加食材</view>
          <view class="add-s">记下食材名、数量和到期日</view>
        </view>
        <view class="add-arrow {{showAddForm ? 'up' : ''}}"></view>
      </view>

      <!-- 添加表单（展开）-->
      <view class="add-form" wx:if="{{showAddForm}}">
        <view class="af-row">
          <input class="af-input af-main" placeholder="食材名" placeholder-class="af-ph" value="{{newItem.ingredientName}}" bindinput="onNewInput" data-field="ingredientName" />
          <input class="af-input af-sm" placeholder="量" placeholder-class="af-ph" value="{{newItem.amount}}" bindinput="onNewInput" data-field="amount" />
          <input class="af-input af-sm" placeholder="单位" placeholder-class="af-ph" value="{{newItem.unit}}" bindinput="onNewInput" data-field="unit" />
        </view>
        <input class="af-input af-date" placeholder="到期日 如 2026-06-20（选填）" placeholder-class="af-ph" value="{{newItem.expiresAt}}" bindinput="onNewInput" data-field="expiresAt" />
        <view class="tap-scale btn btn-pop btn-block af-submit {{adding ? 'is-busy' : ''}}" bindtap="addItem">{{adding ? '保存中…' : '记入冰箱'}}</view>
      </view>
    </block>

    <!-- 分类 + 商品列表 -->
    <view class="cat g-fade-up g-d{{cidx + 1}}" wx:for="{{categories}}" wx:for-item="cat" wx:for-index="cidx" wx:key="key">
      <view class="cat-name">
        <view class="cat-ic cat-ic-{{cat.icon}}"></view>
        <text class="cat-h3">{{cat.label}}</text>
        <text class="cat-qty">· {{cat.qty}} 项</text>
      </view>
      <view class="pcard">
        <view
          class="pitem {{it.expiringSoon ? 'warn' : ''}}"
          wx:for="{{cat.items}}"
          wx:for-item="it"
          wx:key="id"
        >
          <view class="pi-dot"></view>
          <view class="pi-mid">
            <view class="pi-nm ellipsis">{{it.ingredientName}}</view>
            <view class="pi-ex {{it.expiringSoon ? 'red' : ''}}">{{it.expiresText}}</view>
          </view>
          <view class="pi-qt">{{it.amountText}}</view>
          <view class="pi-edit tap-scale" data-id="{{it.id}}" bindtap="openEditSheet">
            <view class="pi-edit-pen"></view>
          </view>
          <view class="pi-del tap-scale" data-id="{{it.id}}" bindtap="removeItem">
            <view class="pi-del-x"></view>
          </view>
        </view>
      </view>
    </view>

    <!-- 现在就能做 -->
    <section-head
      wx:if="{{showMatch && matchResults.length}}"
      eyebrow="现在能做"
      title="现在就能做"
      hint="按库存匹配"
    />

    <!-- 匹配接口失败 ≠ 一道都做不了：这里原来只判 !matchResults.length，
         网络一抖就显示「还没匹配到菜谱」，把用户往"我家食材不行"上带。
         失败位 JS 里一直在置（matchRecipes 的 catch），只是没人读它。 -->
    <state-empty
      wx:if="{{showMatch && matchFailed}}"
      type="offline"
      title="现在能做没算出来"
      desc="匹配失败了，不是家里没食材"
      cta="再算一次"
      cta-style="ghost"
      bind:action="retryMatch"
    />

    <!-- 有食材但一道都匹配不上：给空态，别整块消失让人以为没反应 -->
    <view wx:if="{{showMatch && !matchFailed && !matchResults.length && pantrySummary.count}}" class="pantry-empty g-fade-up">
      <text class="pantry-empty-txt">冰箱里的食材还没匹配到菜谱，再添几样或去菜谱库看看</text>
    </view>

    <view
      class="mcard g-fade-up g-d{{midx + 1}} tap-scale"
      wx:for="{{matchResults}}"
      wx:for-index="midx"
      wx:key="id"
      bindtap="onMatchTap"
      data-id="{{item.id}}"
    >
      <view class="mc-top">
        <image class="mc-ph" src="{{item.coverImage}}" mode="aspectFill" lazy-load />
        <view class="mc-mi">
          <view class="mc-h4 ellipsis">{{item.title}}</view>
          <view class="mc-meta">{{item.metaText}}</view>
          <view class="mc-miss ellipsis {{item.full ? 'full' : ''}}">{{item.missingText}}</view>
        </view>
        <view class="mc-badge">
          <view class="mc-pct">{{item.haveText}}</view>
          <view class="mc-lab">匹配</view>
        </view>
      </view>
      <view class="mc-bar">
        <view class="mc-bar-i {{item.full ? 'full' : ''}}" style="width: {{item.percentWidth}}%;"></view>
      </view>
    </view>

    <view class="safe-bottom"></view>
  </view>

  <!-- 编辑库存条目：字段与「添加食材」逐格对齐（同一页不给新增/编辑两套日期交互） -->
  <state-sheet lift visible="{{editingId ? true : false}}" title="编辑食材" bind:close="closeEditSheet">
    <view class="af-row">
      <input class="af-input af-main" placeholder="食材名" placeholder-class="af-ph" value="{{editDraft.ingredientName}}" bindinput="onEditInput" data-field="ingredientName" />
      <input class="af-input af-sm" placeholder="量" placeholder-class="af-ph" value="{{editDraft.amount}}" bindinput="onEditInput" data-field="amount" />
      <input class="af-input af-sm" placeholder="单位" placeholder-class="af-ph" value="{{editDraft.unit}}" bindinput="onEditInput" data-field="unit" />
    </view>
    <input class="af-input af-date" placeholder="到期日 如 2026-06-20（选填，清空即删除）" placeholder-class="af-ph" value="{{editDraft.expiresAt}}" bindinput="onEditInput" data-field="expiresAt" />
    <view class="af-actions">
      <view class="btn btn-ghost af-cancel tap-scale" catchtap="closeEditSheet">取消</view>
      <view class="btn btn-pop af-save tap-scale {{editing ? 'is-busy' : ''}}" catchtap="saveEdit">{{editing ? '保存中…' : '保存'}}</view>
    </view>
  </state-sheet>
</view>
