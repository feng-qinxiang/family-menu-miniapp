/* ============================================================
   pages/pantry · 冰箱库存（对标 pantry-final.html）
   配色 / 工具类全用 app.wxss 全局 token，本文件不重定义配色。
   ============================================================ */
.pantry-page {
  min-height: 100vh;
  background: var(--paper);
}
.pantry-heading { padding: 16rpx 24rpx 20rpx; }
.pantry-heading-title { font-size: calc(36rpx * var(--fs-mul, 1)); line-height: 1.4; font-weight: 700; color: var(--ink); }
.pantry-heading-title > text { display: block; margin-top: 8rpx; color: var(--mut-strong); font-size: var(--fs-sub); font-weight: 400; }

/* ============ 内容层 ============ */
/* 底部留白含 tabBar 实高（--tabbar-h 已带安全区），最后一张卡不会被压住 */
.psheet {
  padding: 0 24rpx calc(env(safe-area-inset-bottom) + 40rpx);
}
.psheet .shead { margin-top: 8rpx; }
.psheet .shead:first-child { margin-top: 0; }
.pantry-overview { padding: 20rpx 24rpx 0; border-radius: var(--r-md); background: var(--c-surface); border: var(--bd-card); margin-bottom: 12rpx; }
.pantry-pick { padding-bottom: 16rpx; border-bottom: var(--bd-card); }
.pantry-pick-head { display: flex; flex-wrap: wrap; align-items: center; gap: 12rpx; }
.pantry-pick-copy { flex: 1 1 240rpx; min-width: 0; }
.pantry-pick-title { font-size: calc(32rpx * var(--fs-mul, 1)); font-weight: 700; color: var(--ink); line-height: 1.4; }
.pantry-pick-note, .pantry-date-note { font-size: var(--fs-sub); color: var(--mut-strong); margin-top: 6rpx; line-height: 1.5; }
.pantry-pick-btn { min-height: 88rpx; display: flex; align-items: center; padding: 0 20rpx; border-radius: var(--r-md); background: var(--pop-soft); color: var(--pop-deep); font-size: var(--fs-sub); font-weight: 700; flex: none; }
.pantry-priority { color: var(--mut-strong); display: flex; flex-wrap: wrap; align-items: baseline; gap: 12rpx; font-size: var(--fs-sub); margin-top: 12rpx; line-height: 1.5; }
.pantry-priority text { color: var(--pop-deep); font-weight: 700; }
.pantry-date-note { margin-top: 14rpx; line-height: 1.5; }
.pantry-list-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.pantry-list-title { font-size: var(--fs-lg); font-weight: 800; color: var(--ink); }
.pantry-add { display: flex; align-items: center; justify-content: center; min-height: 88rpx; padding: 0 20rpx; border-radius: var(--r-md); background: var(--pop-soft); color: var(--pop-deep); font-size: var(--fs-sub); font-weight: 700; }
.pantry-filters { display: flex; gap: 8rpx; margin-top: 12rpx; padding: 4rpx; background: var(--paper-2); border-radius: var(--r-md); }
.pantry-filter { flex: 1; min-height: 88rpx; display: flex; align-items: center; justify-content: center; border-radius: var(--r-sm); color: var(--mut-strong); font-size: var(--fs-sub); font-weight: 600; }
.pantry-filter.on { background: var(--c-surface); color: var(--ink); font-weight: 800; box-shadow: var(--sh-card); }
.pantry-filter-empty { padding: 24rpx 0; color: var(--mut-strong); font-size: var(--fs-sub); }
.pi-main { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 6rpx 16rpx; }
.pitem.expired .pi-nm { color: var(--mut-strong); }
.pi-ex text { color: var(--mut); }
.mc-priority { font-size: var(--fs-cap); color: var(--pop-deep); margin-top: 8rpx; }
.af-date { display: flex; align-items: center; gap: 16rpx; }
.af-date text { color: var(--mut-strong); }
.af-date-row { display: flex; align-items: center; gap: 12rpx; }
.af-date-picker { flex: 1; min-width: 0; }
.af-date-clear { display: flex; align-items: center; justify-content: center; min-height: 88rpx; min-width: 88rpx; margin-top: 16rpx; font-size: var(--fs-cap); color: var(--mut-strong); }
/* ============ 分类 ============ */
.cat { margin-bottom: 16rpx; }
.cat-name {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 24rpx 0 12rpx;
}
.cat-ic {
  width: 40rpx;
  height: 40rpx;
  border-radius: var(--r-sm);
  background: var(--paper-2);
  flex: none;
  position: relative;
}
.cat-ic::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 26rpx;
  height: 26rpx;
}
.cat-ic-veg::after { background: var(--pine); border-radius: var(--r-sm) 4rpx var(--r-sm) var(--r-sm); }
.cat-ic-meat::after { background: var(--gold-deep); border-radius: 50% 50% 45% 45%; }
.cat-ic-season::after { background: var(--orange); border-radius: 6rpx 6rpx 10rpx 10rpx; }
.cat-ic-other::after { background: var(--mut); border-radius: var(--r-xs); }
.cat-h3 {
  font-size: calc(28rpx * var(--fs-mul, 1));
  font-weight: 800;
  color: var(--ink);
  letter-spacing: -0.6rpx;
}
.cat-qty {
  font-size: calc(23rpx * var(--fs-mul, 1));
  color: var(--mut-strong);
  font-weight: 600;
}

/* ============ 商品卡 ============ */
.pcard {
  background: var(--c-surface);
  border-radius: var(--r-card);
  padding: 4rpx var(--pad-card-sm);
  box-shadow: none;
  border: var(--bd-card);
}
.pitem {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  /* 行分隔线全站统一 2rpx + --paper-2：原来是 1rpx（在 2x 屏上会渲染成半像素灰，
     有的机型看得见、有的一阵有一阵没） */
  border-bottom: 2rpx solid var(--paper-2);
}
.pitem:last-child { border-bottom: none; }
.pi-thumb { position: relative; width: var(--tile-list-wide); height: var(--tile-list-wide); flex: none; border-radius: var(--r-sm); background: var(--paper-2); overflow: hidden; display: flex; align-items: center; justify-content: center; }
.pi-thumb image { width: 100%; height: 100%; }
.pi-thumb text { padding: 4rpx; font-size: var(--fs-cap); font-weight: 700; color: var(--mut-strong); text-align: center; word-break: break-all; line-height: 1.3; }
.pi-thumb.expired { opacity: .55; }
.pi-thumb-text { align-self: stretch; text-align: center; display: flex; align-items: center; justify-content: center; padding: 8rpx 6rpx 36rpx; }
.pi-thumb .pi-thumb-hint { position: absolute; right: 4rpx; bottom: 4rpx; padding: 3rpx 8rpx; border-radius: var(--r-xs); font-size: var(--fs-mini); color: var(--mut-strong); background: var(--c-surface); font-weight: 500; line-height: 1.2; }
.pantry-reminder { padding: 0 0 8rpx; }
.pantry-reminder-toggle { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; min-height: 88rpx; color: var(--mut-strong); font-size: var(--fs-sub); }
.pantry-reminder-short { font-weight: 400; font-size: var(--fs-sub); color: var(--mut-strong); margin-left: 8rpx; }
.pantry-reminder-head { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.pantry-reminder-row { display: flex; align-items: center; gap: 16rpx; }
.pantry-reminder-title { display: flex; align-items: center; gap: 8rpx; font-size: var(--fs-sub); font-weight: 700; color: var(--ink); line-height: 1.5; }
.pantry-reminder-title image { width: 30rpx; height: 30rpx; flex: none; filter: brightness(0); }
.pantry-reminder button.pantry-reminder-link { box-sizing: border-box; display: flex; align-items: center; justify-content: center; flex: none; width: 156rpx; min-width: 0; max-width: 156rpx; min-height: 88rpx; margin: 0; padding: 0; background: transparent; color: var(--mut-strong); font-size: var(--fs-cap); line-height: 1.4; }
.pantry-reminder-link::after, .pantry-reminder-button::after { border: 0; }
.pantry-reminder-copy { flex: 1; min-width: 0; font-size: var(--fs-cap); line-height: 1.5; color: var(--ink); }
.pantry-reminder-copy > text { display: block; margin-top: 4rpx; font-size: var(--fs-sub); color: var(--mut-strong); }
.pantry-reminder-policy { color: var(--ink); font-size: var(--fs-cap); }
.pantry-reminder button.pantry-reminder-button { box-sizing: border-box; display: flex; align-items: center; justify-content: center; flex: none; width: 176rpx; min-width: 0; max-width: 176rpx; min-height: 88rpx; margin: 0; padding: 0 12rpx; border-radius: var(--r-sm); background: var(--pine); color: #fff; font-size: var(--fs-cap); font-weight: 700; line-height: 1.4; }
.pantry-reminder button.pantry-reminder-button.is-unavailable { background: var(--paper-2); color: var(--mut-strong); }
.pantry-reminder-link-label, .pantry-reminder-button-label { white-space: nowrap; }
.pantry-reminder-button[disabled] { opacity: .55; }
.pantry-photo-note { color: var(--mut); font-size: var(--fs-mini); line-height: 1.5; margin-top: 8rpx; }
.pi-mid { flex: 1; min-width: 0; }
.pi-nm {
  flex: 1 1 128rpx;
  min-width: 0;
  word-break: break-all;
  font-size: calc(32rpx * var(--fs-mul, 1));
  font-weight: 700;
  color: var(--ink);
  letter-spacing: -0.4rpx;
}
.pi-ex {
  font-size: var(--fs-cap);
  color: var(--mut-strong);
  display: inline-block;
  padding: 4rpx 10rpx;
  border-radius: var(--r-xs);
  background: var(--paper-2);
  margin-top: 8rpx;
  line-height: 1.5;
}
.pi-bottom { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0 8rpx; }
.pi-date { font-size: var(--fs-mini); font-weight: 400; color: var(--mut-strong); line-height: 1.5; }
.pi-ex.red { color: var(--pop-deep); background: var(--pop-soft); font-weight: 600; }
.pi-qt {
  font-size: var(--fs-sub);
  font-weight: 600;
  color: var(--ink-deep);
  max-width: 100%;
  margin-left: auto;
  word-break: break-all;
}
/* 每行一个管理入口，编辑与删除复用原有表单和确认流程。 */
.pi-edit { min-width: 88rpx; min-height: 88rpx; margin-left: auto; border-radius: var(--r-sm); display: flex; align-items: center; justify-content: center; flex: none; color: var(--mut-strong); font-size: var(--fs-cap); font-weight: 500; }

/* ============ 添加表单 ============ */
.add-form {
  margin-top: 20rpx;
  background: var(--c-surface);
  border-radius: var(--r-card);
  border: var(--bd-card);
  box-shadow: var(--sh-soft);
  padding: var(--pad-card);
}
.af-row { display: flex; flex-wrap: wrap; gap: 16rpx; }
.af-input {
  box-sizing: border-box;
  height: 84rpx;
  padding: 0 26rpx;
  border-radius: var(--r-md);
  background: var(--paper-2);
  font-size: var(--fs-cap);
  color: var(--ink);
}
.af-main { flex: 1 1 100%; min-width: 0; }
.af-sm { flex: 1; min-width: 0; }
.af-date { width: 100%; margin-top: 16rpx; }
.af-ph { color: var(--mut); }
.af-submit { margin-top: 24rpx; }
/* 编辑弹层的按钮行（与家属页 .avoid-actions 同一范式） */
.af-actions { display: flex; gap: 20rpx; margin-top: 28rpx; }
.af-cancel { flex: 1; }
.af-save { flex: 1.6; }

/* ============ 匹配卡 ============ */
.mcard {
  background: var(--c-surface);
  border-radius: var(--r-card);
  overflow: hidden;
  box-shadow: var(--sh-card);
  border: var(--bd-card);
  margin-bottom: 27rpx;
}
.mc-top { display: flex; gap: 20rpx; padding: 22rpx; }
.mc-ph {
  
  
  border-radius: var(--r-md);
  flex: none;
  background: var(--paper-2);
  width: var(--tile-list-wide);
  height: var(--tile-list-tall);
}
.mc-mi { flex: 1; min-width: 0; }
.mc-h4 {
  font-size: calc(32rpx * var(--fs-mul, 1));
  font-weight: 800;
  color: var(--ink);
  letter-spacing: -0.6rpx;
}
.mc-meta {
  font-size: var(--fs-cap);
  color: var(--mut);
  margin-top: 10rpx;
}
.mc-miss {
  font-size: var(--fs-cap);
  color: var(--pop-deep);
  font-weight: 700;
  margin-top: 13rpx;
}
.mc-miss.full { color: var(--pine); }
.mc-h4, .mc-miss { white-space: normal; word-break: break-all; line-height: 1.5; }
.mc-meta { line-height: 1.5; }
.mc-status { display: flex; align-items: center; justify-content: space-between; gap: 8rpx; flex-wrap: wrap; margin-top: 12rpx; color: var(--pine); font-size: var(--fs-cap); }
.mc-badge { flex: none; text-align: right; }
.mc-pct {
  font-size: calc(40rpx * var(--fs-mul, 1));
  font-weight: 900;
  color: var(--ink-deep);
  letter-spacing: -2rpx;
}
.mc-lab {
  font-size: calc(21rpx * var(--fs-mul, 1));
  color: var(--mut);
  font-weight: 600;
}
.mc-bar {
  height: 10rpx;
  background: var(--paper-2);
  margin: 0 27rpx 27rpx;
  border-radius: 6rpx;
  overflow: hidden;
}
.mc-bar-i {
  height: 100%;
  background: var(--gold-deep);
  border-radius: 6rpx;
}
.mc-bar-i.full { background: var(--pine); }

/* 匹配为空时的空态：与列表卡片同宽同圆角 */
.pantry-empty {
  box-sizing: border-box;
  margin: 0 46rpx;
  padding: 44rpx var(--pad-card);
  border-radius: var(--r-card);
  background: var(--c-surface);
  border: var(--bd-card);
  text-align: center;
}
.pantry-empty-txt {
  font-size: var(--fs-sub);
  color: var(--mut);
  line-height: 1.6;
}
