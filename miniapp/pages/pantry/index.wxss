/* ============================================================
   pages/pantry · 冰箱库存（对标 pantry-final.html）
   配色 / 工具类全用 app.wxss 全局 token，本文件不重定义配色。
   ============================================================ */
.pantry-page {
  min-height: 100vh;
  background: var(--paper);
}

/* 页头下的统计一行字（.cpt-head 内）：空库不渲染；临期段用 --pop-deep 做真实警示 */
.pstat-line {
  margin-top: 12rpx;
  font-size: var(--fs-sub);
  font-weight: 700;
  color: var(--mut);
}
.pstat-warn { color: var(--pop-deep); }

/* ============ 内容层 ============ */
/* 底部留白含 tabBar 实高（--tabbar-h 已带安全区），最后一张卡不会被压住 */
.psheet {
  padding: 0 var(--ctl-x, 48rpx) calc(var(--tabbar-h) + 40rpx);
}
.psheet .shead { margin-top: 8rpx; }
.psheet .shead:first-child { margin-top: 0; }
/* ============ 分类 ============ */
.cat { margin-bottom: 16rpx; }
.cat-name {
  display: flex;
  align-items: center;
  gap: 17rpx;
  margin: 38rpx 0 19rpx;
}
.cat-ic {
  width: 58rpx;
  height: 58rpx;
  border-radius: 19rpx;
  background: var(--paper-2);
  flex: none;
  position: relative;
}
.cat-ic::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 26rpx;
  height: 26rpx;
}
.cat-ic-veg::after { background: var(--pine); border-radius: var(--r-sm) 4rpx var(--r-sm) var(--r-sm); }
.cat-ic-meat::after { background: var(--gold-deep); border-radius: 50% 50% 45% 45%; }
.cat-ic-season::after { background: var(--orange); border-radius: 6rpx 6rpx 10rpx 10rpx; }
.cat-ic-other::after { background: var(--mut); border-radius: var(--r-xs); }
.cat-h3 {
  font-size: calc(32rpx * var(--fs-mul, 1));
  font-weight: 800;
  color: var(--ink);
  letter-spacing: -0.6rpx;
}
.cat-qty {
  font-size: calc(23rpx * var(--fs-mul, 1));
  color: var(--mut-strong);
  font-weight: 600;
}

/* ============ 商品卡 ============ */
.pcard {
  background: var(--c-surface);
  border-radius: var(--r-card);
  padding: 12rpx var(--pad-card);
  box-shadow: var(--sh-card);
  border: var(--bd-card);
}
.pitem {
  display: flex;
  align-items: center;
  gap: 25rpx;
  padding: 27rpx 0;
  /* 行分隔线全站统一 2rpx + --paper-2：原来是 1rpx（在 2x 屏上会渲染成半像素灰，
     有的机型看得见、有的一阵有一阵没） */
  border-bottom: 2rpx solid var(--paper-2);
}
.pitem:last-child { border-bottom: none; }
.pi-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--mut-2);
  flex: none;
}
.pitem.warn .pi-dot { background: var(--pop-deep); }
.pi-mid { flex: 1; min-width: 0; }
.pi-nm {
  font-size: calc(32rpx * var(--fs-mul, 1));
  font-weight: 800;
  color: var(--ink);
  letter-spacing: -0.4rpx;
}
.pi-ex {
  font-size: var(--fs-cap);
  color: var(--mut-strong);
  margin-top: 8rpx;
}
.pi-ex.red { color: var(--pop-deep); font-weight: 700; }
.pi-qt {
  font-size: var(--fs-sub);
  font-weight: 700;
  color: var(--ink-deep);
  flex: none;
}
.pi-del {
  position: relative;
  width: 77rpx;
  height: 77rpx;
  border-radius: 23rpx;
  background: var(--paper-2);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}
.pi-del::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 88rpx;
  height: 88rpx;
  transform: translate(-50%, -50%);
}
.pi-del-x {
  width: 24rpx;
  height: 24rpx;
  position: relative;
}
.pi-del-x::before,
.pi-del-x::after {
  content: "";
  position: absolute;
  left: 0;
  top: 11rpx;
  width: 24rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: var(--mut);
}
.pi-del-x::before { transform: rotate(45deg); }
.pi-del-x::after { transform: rotate(-45deg); }

/* 编辑：与删除同一套几何（视觉 77rpx，热区由 ::after 撑到 --tap-min） */
.pi-edit {
  position: relative;
  width: 77rpx;
  height: 77rpx;
  border-radius: 23rpx;
  background: var(--paper-2);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}
.pi-edit::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: var(--tap-min);
  height: var(--tap-min);
  transform: translate(-50%, -50%);
}
.pi-edit-pen {
  width: 26rpx;
  height: 26rpx;
  position: relative;
}
/* 铅笔：一条斜杆 + 笔尖（纯 CSS，与 .pi-del-x 同族画法） */
.pi-edit-pen::before {
  content: "";
  position: absolute;
  left: 3rpx;
  top: 10rpx;
  width: 22rpx;
  height: 6rpx;
  border-radius: 2rpx;
  background: var(--mut);
  transform: rotate(-45deg);
}
.pi-edit-pen::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: 0;
  width: 0;
  height: 0;
  border-left: 5rpx solid transparent;
  border-right: 5rpx solid transparent;
  border-top: 9rpx solid var(--mut);
  transform: rotate(-45deg);
}

/* ============ 添加卡 ============ */
.addcard {
  margin-top: 27rpx;
  background: var(--pop-soft);
  border: 3rpx dashed var(--pop-mist);
  border-radius: 38rpx;
  padding: 29rpx 31rpx;
  display: flex;
  align-items: center;
  gap: 25rpx;
}
.add-pl {
  width: 81rpx;
  height: 81rpx;
  border-radius: 27rpx;
  background: var(--pop);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  box-shadow: var(--sh-pop);
}
.add-plus {
  width: 32rpx;
  height: 32rpx;
  position: relative;
}
.add-plus::before,
.add-plus::after {
  content: "";
  position: absolute;
  background: var(--c-surface);
  border-radius: 3rpx;
}
.add-plus::before { left: 14rpx; top: 0; width: 5rpx; height: 32rpx; }
.add-plus::after { left: 0; top: 14rpx; width: 32rpx; height: 5rpx; }
.add-at { flex: 1; }
.add-t { font-size: calc(29rpx * var(--fs-mul, 1)); font-weight: 800; color: var(--ink); }
.add-s { font-size: var(--fs-cap); color: var(--mut); margin-top: 4rpx; }
.add-arrow {
  width: 18rpx;
  height: 18rpx;
  border-right: 5rpx solid var(--gold-deep);
  border-top: 5rpx solid var(--gold-deep);
  transform: rotate(45deg);
  flex: none;
  transition: transform 0.2s ease;
}
.add-arrow.up { transform: rotate(-45deg); }
/* ============ 添加表单 ============ */
.add-form {
  margin-top: 20rpx;
  background: var(--c-surface);
  border-radius: var(--r-card);
  border: var(--bd-card);
  box-shadow: var(--sh-soft);
  padding: var(--pad-card);
}
.af-row { display: flex; gap: 16rpx; }
.af-input {
  box-sizing: border-box;
  height: 84rpx;
  padding: 0 26rpx;
  border-radius: var(--r-md);
  background: var(--paper-2);
  font-size: var(--fs-cap);
  color: var(--ink);
}
.af-main { flex: 1; }
.af-sm { width: 150rpx; }
.af-date { width: 100%; margin-top: 16rpx; }
.af-ph { color: var(--mut); }
.af-submit { margin-top: 24rpx; }
/* 编辑弹层的按钮行（与家属页 .avoid-actions 同一范式） */
.af-actions { display: flex; gap: 20rpx; margin-top: 28rpx; }
.af-cancel { flex: 1; }
.af-save { flex: 1.6; }

/* ============ 匹配卡 ============ */
.mcard {
  background: var(--c-surface);
  border-radius: var(--r-card);
  overflow: hidden;
  box-shadow: var(--sh-card);
  border: var(--bd-card);
  margin-bottom: 27rpx;
}
.mc-top { display: flex; gap: 27rpx; padding: 27rpx; }
.mc-ph {
  
  
  border-radius: var(--r-md);
  flex: none;
  background: var(--paper-2);
  width: var(--dish-thumb);
  height: var(--dish-thumb);
}
.mc-mi { flex: 1; min-width: 0; }
.mc-h4 {
  font-size: calc(32rpx * var(--fs-mul, 1));
  font-weight: 800;
  color: var(--ink);
  letter-spacing: -0.6rpx;
}
.mc-meta {
  font-size: var(--fs-cap);
  color: var(--mut);
  margin-top: 10rpx;
}
.mc-miss {
  font-size: var(--fs-cap);
  color: var(--pop-deep);
  font-weight: 700;
  margin-top: 13rpx;
}
.mc-miss.full { color: var(--pine); }
.mc-badge { flex: none; text-align: right; }
.mc-pct {
  font-size: calc(40rpx * var(--fs-mul, 1));
  font-weight: 900;
  color: var(--ink-deep);
  letter-spacing: -2rpx;
}
.mc-lab {
  font-size: calc(21rpx * var(--fs-mul, 1));
  color: var(--mut);
  font-weight: 600;
}
.mc-bar {
  height: 10rpx;
  background: var(--paper-2);
  margin: 0 27rpx 27rpx;
  border-radius: 6rpx;
  overflow: hidden;
}
.mc-bar-i {
  height: 100%;
  background: var(--gold-deep);
  border-radius: 6rpx;
}
.mc-bar-i.full { background: var(--pine); }

/* 匹配为空时的空态：与列表卡片同宽同圆角 */
.pantry-empty {
  box-sizing: border-box;
  margin: 0 46rpx;
  padding: 44rpx var(--pad-card);
  border-radius: var(--r-card);
  background: var(--c-surface);
  border: var(--bd-card);
  text-align: center;
}
.pantry-empty-txt {
  font-size: var(--fs-sub);
  color: var(--mut);
  line-height: 1.6;
}
