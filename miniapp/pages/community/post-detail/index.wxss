/* pages/community/post-detail · 帖子详情 */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--paper);
}

/* 滚动区占满 nav-bar 与输入框之间 */
.scroll {
  flex: 1;
  min-height: 0;
}
.body {
  box-sizing: border-box;
  padding: 12rpx 30rpx 48rpx;
}

/* ===== 头像 ===== */
.ava {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  font-family: var(--serif);
  font-weight: 700;
  font-size: 38rpx;
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(60, 40, 20, 0.12);
}
.ava-sm { width: 72rpx; height: 72rpx; font-size: 30rpx; }
.ava-lin { background: linear-gradient(135deg, #e8472a, #f08a52); }
.ava-lan { background: linear-gradient(135deg, #2f4a3a, #577a5f); }
.ava-zhao { background: linear-gradient(135deg, #5a4a8a, #9a7fc4); }
.ava-gold { background: linear-gradient(135deg, #b08949, #f4d9a8); }
.ava-pine { background: linear-gradient(135deg, #2f4a3a, #7aa888); }

/* ===== 作者块 ===== */
.author {
  display: flex;
  align-items: center;
  gap: 22rpx;
}
.acol { flex: 1; min-width: 0; }
.aname {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--ink);
  letter-spacing: -0.4rpx;
}
.atime {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: var(--mut-strong);
}

/* ===== 标题 ===== */
.eyebrow-mt { margin-top: 42rpx; display: block; }
.post-title {
  margin-top: 14rpx;
  font-size: 52rpx;
  line-height: 1.08;
  letter-spacing: -2rpx;
  /* title-stroke/title-shadow 已提供描边白字 */
}

/* ===== 正文 ===== */
.post-text { margin-top: 26rpx; }
.ptext-p {
  font-size: 29rpx;
  line-height: 1.75;
  color: var(--ink-deep);
  margin-bottom: 22rpx;
}
.ptext-p:last-child { margin-bottom: 0; }

/* ===== 菜图 ===== */
.dish-img {
  width: 100%;
  height: 460rpx;
  border-radius: 42rpx;
  margin-top: 34rpx;
  display: block;
  box-shadow: var(--sh-card);
}
.imgcap {
  margin-top: 18rpx;
  text-align: center;
  font-family: var(--serif);
  font-style: italic;
  font-size: 23rpx;
  color: var(--mut-strong);
}

/* ===== 标签 ===== */
.ptags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 30rpx;
}
.ptag {
  font-size: 23rpx;
  font-weight: 700;
  color: var(--gold-deep);
  background: var(--paper-2);
  padding: 12rpx 24rpx;
  border-radius: var(--r-pill);
}

/* ===== 关联菜谱卡 ===== */
.recipe-card {
  display: flex;
  align-items: center;
  gap: 26rpx;
  background: #fff;
  border-radius: var(--r-card);
  padding: 24rpx;
  margin-top: 38rpx;
  border: var(--bd-card);
  box-shadow: var(--sh-card);
}
.rc-img {
  width: 138rpx;
  height: 138rpx;
  border-radius: 30rpx;
  flex: none;
}
.rc-mid { flex: 1; min-width: 0; }
.rc-kick {
  font-family: var(--serif);
  font-style: italic;
  font-size: 21rpx;
  color: var(--gold-deep);
  font-weight: 700;
}
.rc-name {
  margin-top: 6rpx;
  font-size: 33rpx;
  font-weight: 800;
  color: var(--ink);
  letter-spacing: -0.6rpx;
}
.rc-meta {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: var(--mut-strong);
}
.rc-go {
  flex: none;
  width: 76rpx;
  height: 76rpx;
  border-radius: 26rpx;
  background: var(--ink-deep);
  display: flex;
  align-items: center;
  justify-content: center;
}
.rc-arrow {
  width: 18rpx;
  height: 18rpx;
  border-top: 5rpx solid var(--paper);
  border-right: 5rpx solid var(--paper);
  transform: translateX(-3rpx) rotate(45deg);
  border-radius: 2rpx;
}

/* ===== 操作栏 ===== */
.react-bar {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 42rpx;
  padding-bottom: 42rpx;
  border-bottom: 2rpx solid #efe9df;
}
.react {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 18rpx 30rpx;
  border-radius: var(--r-pill);
  background: var(--paper-2);
  color: var(--mut-strong);
  font-size: 25rpx;
  font-weight: 700;
}
.react .ricon { font-size: 28rpx; line-height: 1; }
.react .n { font-weight: 800; }
.react.liked { background: var(--pop-soft); color: var(--pop); }
.react.fav-on { background: var(--pop-soft); color: var(--pop); }
.react-end { margin-left: auto; }

/* ===== 评论区 ===== */
.csec { margin-top: 44rpx; }
.cs-head {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}
.cs-title {
  font-size: 38rpx;
  font-weight: 900;
  color: var(--ink);
  letter-spacing: -0.8rpx;
}
.cnt {
  font-size: 25rpx;
  font-weight: 700;
  color: var(--mut-strong);
}
.cmt-list { margin-top: 8rpx; }
.cmt {
  display: flex;
  gap: 22rpx;
  padding: 30rpx 0;
  border-bottom: 2rpx solid #efe9df;
}
.cmt:last-child { border-bottom: none; }
.ccol { flex: 1; min-width: 0; }
.crow {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.cname {
  font-size: 26rpx;
  font-weight: 800;
  color: var(--ink);
  flex: 1;
  min-width: 0;
}
.ctime {
  font-size: 21rpx;
  color: var(--mut);
  flex: none;
}
.ctext {
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--ink-deep);
}

/* ===== 底部输入框 ===== */
.inputbar {
  flex: none;
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 22rpx 34rpx;
  background: rgba(251, 248, 243, 0.96);
  border-top: 2rpx solid #ece5d9;
}
.field {
  flex: 1;
  box-sizing: border-box;
  height: 84rpx;
  border-radius: var(--r-pill);
  background: var(--paper-2);
  border: 2rpx solid #e6dfd2;
  padding: 0 34rpx;
  font-size: 26rpx;
  color: var(--ink);
}
.field-ph { color: var(--mut); }
.send {
  flex: none;
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: var(--pop);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--sh-pop);
}
.send-busy { opacity: 0.55; }
/* 发送箭头：CSS 三角 */
.send-icon {
  width: 18rpx;
  height: 18rpx;
  border-top: 5rpx solid #fff;
  border-right: 5rpx solid #fff;
  transform: translateX(-2rpx) rotate(45deg);
  border-radius: 2rpx;
}

/* ===== 加载骨架 ===== */
.loading { padding: 40rpx 30rpx; }
.sk-line {
  height: 34rpx;
  border-radius: 12rpx;
  background: #efe4d7;
  margin-bottom: 22rpx;
}
.sk-w60 { width: 60%; }
.sk-w80 { width: 80%; }
.sk-w90 { width: 90%; }
.sk-img {
  width: 100%;
  height: 360rpx;
  margin: 12rpx 0 28rpx;
}
