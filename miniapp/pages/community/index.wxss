/* ============================================================
   pages/community · 邻里厨房「紧凑页头 + 帖子流」
   页头结构/样式来自 app.wxss .cpt-head；配色全部走 token，本文件不重定义配色。
   ============================================================ */
.community-page {
  position: relative;
  min-height: 100vh;
  background: var(--paper);
}
.community-page .cpt-head { padding-bottom: 20rpx; }

/* 页头唯一主操作：番茄红只给它。视觉 72rpx，::after 把热区撑到 88rpx；
   实心主按钮按全站约定用卡片圆角（不再是胶囊），字号对齐 .btn */
.cm-post-btn {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 72rpx;
  padding: 0 28rpx;
  border-radius: var(--r-card);
  background: var(--pop-fill);
  color: var(--anchor-contrast);
  font-size: var(--fs-btn);
  font-weight: 800;
}
.cm-post-btn::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  height: var(--tap-min);
  transform: translateY(-50%);
}

.community-scroll {
  height: 100vh;
  box-sizing: border-box;
  padding-bottom: var(--tabbar-h);
}

/* ===================== 内容区 ===================== */
/* 不再压在 hero 上：去掉负 margin 与顶部圆角，只留底部留白 */
.sheet { padding-bottom: 40rpx; }
.pad { padding: 0 var(--page-gutter); }
/* 页头已给出页名，区块标题贴近页头，首屏多露帖子（全局 .shead 上边距 56rpx） */
.cm-feed-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin: 4rpx 0 12rpx; font-size: var(--fs-lg); font-weight: 800; color: var(--ink); }
.cm-feed-count { font-size: var(--fs-cap); color: var(--mut-strong); font-weight: 500; }

/* ===================== 帖子卡 ===================== */
.post-list { display: block; }
.pcard {
  background: var(--c-surface);
  border-radius: var(--r-card);
  padding: 20rpx var(--pad-card-sm) 4rpx;
  margin-bottom: 20rpx;
  box-shadow: none;
  border: var(--bd-card);
}
.ptop { display: flex; align-items: center; gap: 16rpx; }
.pavatar {
  width: var(--ava-cmt);
  height: var(--ava-cmt);
  border-radius: calc(var(--ava-cmt) * var(--r-ava));
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: calc(var(--ava-cmt) * var(--ava-glyph) * var(--fs-mul, 1));
  font-weight: 900;
  color: var(--anchor-contrast);
  font-family: var(--serif);
}
.pmeta { flex: 1; min-width: 0; }
.pname { font-size: calc(28rpx * var(--fs-mul, 1)); font-weight: 700; color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ptime { font-size: var(--fs-cap); color: var(--mut-strong); margin-top: 4rpx; }
.ptitle { font-size: calc(32rpx * var(--fs-mul, 1)); font-weight: 800; color: var(--ink); letter-spacing: 0; margin: 14rpx 0 8rpx; line-height: 1.45; }
.pcontent { font-size: calc(28rpx * var(--fs-mul, 1)); color: var(--mut-strong); line-height: 1.6; }
/* 内层圆角不大于外层 .pcard（--r-card） */
.pphoto { display: block; width: 100%; height: var(--photo-feed-h); border-radius: var(--r-sm); margin-top: 14rpx; }

/* 关联菜谱 */
.precipe {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 18rpx;
  padding: 16rpx;
  background: var(--paper);
  border-radius: var(--r-sm);
  border: 2rpx solid var(--paper-2);
}
.precipe .rthumb { width: var(--tile-row-sm); height: var(--tile-row-sm); border-radius: var(--r-sm); flex: none; }
.precipe .rmid { flex: 1; min-width: 0; }
/* 21rpx 金字在米白底上对比度不足 4.5:1，改为次要文字色 + 辅助字号 */
.precipe .rk { font-size: var(--fs-cap); color: var(--mut-strong); font-weight: 700; }
.precipe .rn { font-size: calc(28rpx * var(--fs-mul, 1)); font-weight: 700; color: var(--ink); margin-top: 4rpx; white-space: normal; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.4; }
.precipe .rm { font-size: var(--fs-cap); color: var(--mut-strong); margin-top: 6rpx; line-height: 1.5; }
.precipe .rgo {
  width: 32rpx;
  height: 88rpx;
  border-radius: 50%;
  background: transparent;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
}
.rgo-arrow {
  width: 16rpx;
  height: 16rpx;
  border-top: 3rpx solid var(--mut);
  border-right: 3rpx solid var(--mut);
  transform: rotate(45deg) translate(-2rpx, 2rpx);
}

/* 标签 */
.ptags { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 16rpx; }
.p-tag {
  font-size: calc(23rpx * var(--fs-mul, 1));
  font-weight: 700;
  color: var(--gold-deep);
  background: transparent;
  padding: 4rpx 0;
  border-radius: var(--r-pill);
}

/* 操作栏 */
.pactions {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 12rpx;
  padding-top: 4rpx;
  border-top: 2rpx solid var(--paper-2);
}
.pa-btn {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: calc(25rpx * var(--fs-mul, 1));
  font-weight: 700;
  color: var(--mut);
  /* 触控高度 88rpx：原上下内边距只有 8rpx，实际可点高度约 53rpx */
  min-height: 88rpx;
  padding: 0 10rpx;
}
.pa-btn.on { color: var(--pop); }
.pa-ico { font-size: calc(28rpx * var(--fs-mul, 1)); line-height: 1; }
/* 图标一律要求「单色、可被 CSS color 着色」。CSS 里追加的 FE0E 是
   variation selector-15（文字呈现）：不追加时 ☆★♡⚠ 在 iOS/Android 上常被渲染成彩色 emoji，
   既吃不到 currentColor（也就跟着不翻深色档），又把系统风格混进品牌界面。
   成熟方案（iconfont / 单色 SVG）都是单色描边，这里用最小改动对齐同一观感。 */
.ico-star::before { content: "\2606\FE0E"; }
.ico-star.on::before { content: "\2605\FE0E"; }
.ico-heart::before { content: "\2661\FE0E"; }
.ico-heart.on::before { content: "\2665\FE0E"; }
/* 评论：BMP 里没有可用的单色气泡字符（💬 是纯 emoji，没有文字呈现形式），
   所以用 CSS 画——尺寸全用 em，跟着 font-size 走，
   大字模式与深色档都自动生效。 */
.ico-chat { position: relative; display: inline-block; width: 1.05em; height: 1.05em; vertical-align: -0.14em; }
.ico-chat::before {
  content: ""; position: absolute; left: 0.06em; top: 0.1em;
  width: 0.88em; height: 0.64em; box-sizing: border-box;
  border: 0.09em solid currentColor; border-radius: 0.2em 0.2em 0.2em 0.06em;
}
.ico-chat::after {
  content: ""; position: absolute; left: 0.22em; bottom: 0.1em; width: 0; height: 0;
  border-left: 0.14em solid transparent; border-right: 0.05em solid transparent;
  border-top: 0.16em solid currentColor;
}
.ico-warn::before { content: "\26A0\FE0E"; }
.pa-report { flex: none; min-width: 88rpx; min-height: 88rpx; font-size: var(--fs-lg); color: var(--mut-strong); font-weight: 700; display: flex; align-items: center; justify-content: center; }

/* ===================== 加载骨架（与 .pcard 同形状，加载完不跳版） ===================== */
/* 内边距/间距/头像与真卡 .pcard、.pavatar 同值（原来 28/34/84rpx 是旧版卡片的规格） */
.cf-skel-card {
  background: var(--c-surface);
  border: var(--bd-card);
  border-radius: var(--r-card);
  padding: 20rpx var(--pad-card-sm);
  margin-bottom: 20rpx;
}
.cf-skel-head { width: var(--ava-cmt); height: var(--ava-cmt); border-radius: calc(var(--ava-cmt) * var(--r-ava)); background: var(--skeleton); }
.cf-skel-line { height: 26rpx; margin-top: 26rpx; border-radius: var(--r-xs); background: var(--skeleton); }
.cf-skel-line--short { width: 55%; }

/* ===================== 热门话题 ===================== */
.topics { margin: 0 0 14rpx; }
.thead { display: flex; align-items: center; gap: 14rpx; margin-bottom: 26rpx; }
.thead .th-title { font-size: calc(32rpx * var(--fs-mul, 1)); font-weight: 900; color: var(--ink); letter-spacing: -1rpx; }
.topic-scroll { white-space: nowrap; }
.tchips { display: inline-flex; gap: 12rpx; padding: 4rpx 0; }
.tchip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: var(--paper-2);
  border-radius: var(--r-pill);
  min-height: 88rpx;
  box-sizing: border-box;
  padding: 8rpx 20rpx;
  flex: none;
  font-size: var(--fs-sub);
  font-weight: 700;
  color: var(--ink);
}
.tchip.on { background: var(--anchor); color: var(--anchor-contrast); }   /* 单选筛选与全局 .chip.on 一致：深底白字 */
.tchip.on .tt { color: inherit; }
.tchip .tt { font-size: var(--fs-sub); font-weight: 800; color: var(--ink); letter-spacing: -0.4rpx; }

/* ===================== 流末 ===================== */
.feed-end { display: flex; align-items: center; justify-content: center; gap: 22rpx; margin: 40rpx 0 8rpx; }
.feed-end::before, .feed-end::after { content: ""; height: 2rpx; width: 88rpx; background: var(--c-border); }
.feed-end text { font-size: calc(23rpx * var(--fs-mul, 1)); color: var(--mut-strong); letter-spacing: 2rpx; font-weight: 600; }
/* 翻页失败的重试行：整行是热区，最小命中高度走 token；字色换成可点的强调色 */
.feed-end--retry { min-height: var(--tap-min); margin-top: 20rpx; }
.feed-end--retry text { color: var(--pop); }

/* ===================== 发帖弹层（容器由 state-sheet 组件提供，页面只留表单样式） ===================== */
.pf-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  padding: 22rpx var(--pad-card-sm);
  margin-bottom: 20rpx;
  border: var(--bd-card);
  border-radius: var(--r-card);
  background: var(--c-surface);
  color: var(--ink);
  font-size: calc(28rpx * var(--fs-mul, 1));
}
.pf-textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 220rpx;
  padding: 22rpx var(--pad-card-sm);
  margin-bottom: 20rpx;
  border: var(--bd-card);
  border-radius: var(--r-card);
  background: var(--c-surface);
  color: var(--ink);
  font-size: calc(28rpx * var(--fs-mul, 1));
  line-height: 1.5;
}
.pf-ph { color: var(--mut); }   /* --mut-2 在白底上约 2.4:1，三格没有标签，占位字就是标签 */

/* 关联的菜（「晒一晒」带过来的那道）：与输入框同一套描边圆角，
   读作「这条帖子会带出这张菜卡」，与普通发帖区分开。 */
.pf-dish {
  display: flex;
  align-items: center;
  gap: 14rpx;
  box-sizing: border-box;
  min-height: 88rpx;
  padding: 0 var(--pad-card-sm);
  margin-bottom: 20rpx;
  border: var(--bd-card);
  border-radius: var(--r-card);
  background: var(--c-surface);
}
.pf-dish-tag {
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  border-radius: var(--r-pill);
  background: var(--pop-soft);
  color: var(--pop);
  font-size: calc(21rpx * var(--fs-mul, 1));
  font-weight: 700;
}
.pf-dish-name {
  flex: 1;
  color: var(--ink);
  font-size: calc(28rpx * var(--fs-mul, 1));
}
.pf-dish-x {
  flex-shrink: 0;
  width: 88rpx;   /* 触控热区按 88rpx 标准走：这是「取消关联」，误点代价小但也不能点不中 */
  text-align: right;
  color: var(--mut);   /* 这一行唯一的可点标记，--mut-2 在白底上只有约 2.4:1 */
  font-size: calc(32rpx * var(--fs-mul, 1));
}

.pf-actions { display: flex; gap: 20rpx; margin-top: 8rpx; }
.pf-cancel { flex: 1; }
.pf-submit { flex: 2; }
/* 内容规范提示：紧跟正文输入框的小字说明（颜色复用全局 .muted） */
.pf-hint { margin: 4rpx 4rpx 0; font-size: var(--fs-cap); line-height: 1.5; }

/* 自定义 TabBar 实高 96rpx + 24rpx 内边距 + 安全区，占位必须跟着走 */
/* 原来这里重定义了全局 .safe-bottom（全局是 padding-bottom，这里是 height，
   同一个类名两套盒模型，且 132rpx 与 tabBar 实高 128rpx 对不上）。
   底部留白已由上面 .community-scroll 的 padding-bottom 统一负责，不再覆盖全局类。 */
/* 举报弹层 */
.rp-reasons {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 8rpx 40rpx 4rpx;
}
.rp-reason {
  box-sizing: border-box;
  min-height: var(--tap-min);
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  border-radius: var(--r-pill);
  background: var(--paper-2);
  color: var(--mut-strong);
  font-size: calc(25rpx * var(--fs-mul, 1));
  border: 1rpx solid transparent;
}
.rp-reason--on {
  background: var(--pop-soft);
  color: var(--pop);
  border-color: var(--pop);
  font-weight: 600;
}
.rp-desc {
  margin: 20rpx 40rpx 0;
  height: 150rpx;
  box-sizing: border-box;
}

/* —— 帖子配图（信息流角标 + 发帖选择器） —— */
.pphoto-wrap { position: relative; }
.pphoto-count {
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: var(--fs-mini);
  padding: 4rpx 14rpx;
  border-radius: var(--r-pill);
}
.pf-imgs {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 18rpx;
}
.pf-img {
  position: relative;
  width: var(--tile-img-pick);
  height: var(--tile-img-pick);
}
.pf-img image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}
.pf-img-del {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  /* 圆形删除钮是"几何件"，整颗（含字形与命中区）按大字档等比放大，
     否则字形长大会撑破 44rpx 的圆 */
  width: calc(44rpx * var(--fs-mul, 1));
  height: calc(44rpx * var(--fs-mul, 1));
  border-radius: 50%;
  /* --anchor / --anchor-contrast 是恒定深底浅字的色对（深色档 --anchor 只提亮一档，浅字仍 4.7:1）；
     原先用 --ink，深色档它翻成 #efefef，白底白字等于看不见删除按钮 */
  background: var(--anchor);
  color: var(--anchor-contrast);
  font-size: calc(28rpx * var(--fs-mul, 1));
  display: flex;
  align-items: center;
  justify-content: center;
}
/* 视觉 44rpx（大字档等比放大），命中区恒为 2×：删除是破坏性操作，手指不该点不中 */
.pf-img-del::after {
  position: absolute;
  top: 50%;
  left: 50%;
  width: calc(88rpx * var(--fs-mul, 1));
  height: calc(88rpx * var(--fs-mul, 1));
  content: "";
  transform: translate(-50%, -50%);
}
.pf-img-add {
  /* 方格必须与 .pf-img 同宽才能对上下面的图片网格，所以只放大 ＋ 字形 */
  width: var(--tile-img-pick);
  height: var(--tile-img-pick);
  border: 2rpx dashed var(--line-deep);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: calc(44rpx * var(--fs-mul, 1));
  color: var(--mut);
}

/* —— 话题过滤提示条 —— */
.tag-filter {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  margin-top: 16rpx;
  padding: 0 22rpx;   /* 高度由 .tag-filter-x 的 88rpx 命中区撑开 */
  border-radius: var(--r-pill);
  background: var(--pop-soft);   /* 走 token，深色档跟着翻 */
}
.tag-filter-t {
  font-size: var(--fs-cap);
  font-weight: 700;
  color: var(--pop);
}
.tag-filter-x {
  flex: none;
  min-height: var(--tap-min);
  display: flex;
  align-items: center;
  font-size: var(--fs-cap);
  color: var(--mut-strong);
  font-weight: 700;
}

/* —— 待审核角标（仅作者本人可见的帖子） —— */
.ptitle-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}
.ptitle-row .ptitle { flex: 1; min-width: 0; }
.ppending {
  flex: none;
  font-size: var(--fs-mini);
  font-weight: 700;
  color: var(--gold-deep);
  background: rgba(176, 137, 73, 0.14);
  padding: 4rpx 14rpx;
  border-radius: var(--r-pill);
}
