<view class="community-page {{fontScale === 'lg' ? 'font-lg' : ''}}">
  <!-- tab 页顶部导航（透明覆盖在 hero 上，无返回键）。
       标题留空：本页导航右侧是「发帖」胶囊，加上微信胶囊后中间已无位置——
       实测 4 字标题会被发帖按钮压掉最后一个字（导航标题是绝对居中的，不会自动让位）。
       页面名由下方 hero 的「邻里厨房」大字承担，与餐桌页「点菜」按钮 + hero 的写法一致。 -->
  <nav-bar title="" show-back="{{false}}" status-bar-height="{{statusBarHeight}}">
    <view class="nav-post-btn tap-scale" catchtap="togglePostForm">
      <text class="nav-post-plus">+</text>{{showPostForm ? '收起' : '发帖'}}
    </view>
  </nav-bar>

  <scroll-view class="community-scroll" scroll-y enhanced show-scrollbar="{{false}}"
    refresher-enabled="{{true}}" refresher-triggered="{{refreshing}}" bindrefresherrefresh="onRefresh"
    scroll-top="{{scrollTopTo}}" scroll-with-animation bindscroll="onScrollBody"
    lower-threshold="120" bindscrolltolower="loadMorePosts">
    <!-- ===== Hero ===== -->
    <view class="hero">
      <image class="hero-bg" src="/assets/dishes/sweet-sour-chicken.jpg" mode="aspectFill" />
      <view class="hero-mask"></view>
      <view class="hero-body g-fade-up">
        <text class="hero-tag">左邻右舍</text>
        <view class="hero-title title-stroke">邻里<text class="pop">厨房</text></view>
        <view class="hero-sub">看看别人家今晚上桌什么，也把自己的拿手做法留下来。</view>
        <view class="cstats">
          <view class="cstat">
            <view class="cstat-num">{{communitySummary.postCount}}</view>
            <view class="cstat-lab">帖子</view>
          </view>
          <view class="cstat">
            <view class="cstat-num">{{communitySummary.commentCount}}</view>
            <view class="cstat-lab">评论</view>
          </view>
          <view class="cstat">
            <view class="cstat-num">{{communitySummary.favoriteCount}}</view>
            <view class="cstat-lab">收藏</view>
          </view>
        </view>
      </view>
    </view>

    <!-- ===== Sheet ===== -->
    <view class="sheet">
      <view class="pad">
        <section-head eyebrow="今日餐桌" title="邻居们" popPart="在做" titleTail="啥" />

          <!-- 加载态：与菜谱/买菜清单同一套骨架语言，不用一行文字占位 -->
          <view wx:if="{{loading && !posts.length}}" class="cf-skel">
            <view class="cf-skel-card" wx:for="{{[1,2,3]}}" wx:key="*this">
              <view class="cf-skel-head shimmer"></view>
              <view class="cf-skel-line shimmer"></view>
              <view class="cf-skel-line cf-skel-line--short shimmer"></view>
            </view>
          </view>
          <!-- 失败态 -->
          <state-empty wx:elif="{{loadError}}" type="offline"
            title="社区没加载出来" desc="检查网络后再试试" cta="重新加载" bindaction="retryLoad" />
          <!-- 空态：生产库第一天就是空的，这一屏审核员一定会看到。
               按话题筛过的空 ≠ 全站没人发帖，文案要分开，别对用户撒小谎。 -->
          <state-empty wx:elif="{{!posts.length}}" type="{{currentTag ? 'search' : 'pop'}}"
            title="{{currentTag ? '「' + currentTag + '」下还没有帖子' : '还没有人发帖'}}"
            desc="{{currentTag ? '换个话题，或者自己开一条' : '做第一个分享这顿吃什么的人'}}"
            cta="{{currentTag ? '清空筛选' : '写一条'}}" bindaction="onEmptyAction" />

        <!-- 帖子流 -->
        <view class="post-list">
          <view
            class="pcard tap-scale {{revealOn ? (reveal[index] ? 'g-fade-up' : 'rv-hold') : 'g-fade-up g-d' + (index % 5 + 1)}}"
            data-rv="{{index}}"
            wx:for="{{posts}}"
            wx:key="id"
            data-id="{{item.id}}"
            bindtap="openPost"
          >
            <view class="ptop">
              <view class="pavatar" style="background:{{item.avatarColor}}">{{item.authorInitial}}</view>
              <view class="pmeta">
                <view class="pname">{{item.author}}</view>
                <view class="pstats">
                  <view class="pstats-heart"></view>{{item.likeCount}} 赞 · {{item.commentCount}} 评论
                </view>
              </view>
              <view class="ptime">{{item.timeText || ''}}</view>
            </view>

            <view class="ptitle-row">
              <text class="ptitle clamp-2">{{item.title}}</text>
              <text wx:if="{{item.isPending}}" class="ppending">审核中</text>
            </view>
            <view class="pcontent clamp-2">{{item.content}}</view>

            <view class="pphoto-wrap">
              <image wx:if="{{item.photo}}" class="pphoto img-ph" src="{{item.photo}}" mode="aspectFill" />
              <view wx:else class="pphoto pphoto-none">
                <text class="pphoto-none-t">这篇还没配图</text>
              </view>
              <view wx:if="{{item.imageCount > 1}}" class="pphoto-count">{{item.imageCount}} 图</view>
            </view>

            <!-- 关联菜谱 -->
            <view
              wx:if="{{item.recipe}}"
              class="tap-scale precipe"
              catchtap="openRecipe"
              data-recipe-id="{{item.recipe.id}}"
            >
              <image wx:if="{{item.recipeThumb}}" class="rthumb" src="{{item.recipeThumb}}" mode="aspectFill" />
              <view class="rmid">
                <view class="rk">关联菜谱</view>
                <view class="rn ellipsis">{{item.recipe.title}}</view>
                <view class="rm">{{item.recipe.cuisine}} · {{item.recipe.timeCost}} 分钟 · {{item.recipe.servings}} 人份</view>
              </view>
              <view class="rgo"><view class="rgo-arrow"></view></view>
            </view>

            <!-- 标签 -->
            <view class="ptags" wx:if="{{item.tags.length}}">
              <text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" class="p-tag">#{{tag}}</text>
            </view>

            <!-- 操作栏 -->
            <view class="pactions">
              <view
                class="tap-scale pa-btn {{item.liked ? 'on' : ''}}"
                catchtap="toggleLike"
                data-id="{{item.id}}"
              >
                <view class="pa-ico ico-heart {{item.liked ? 'on' : ''}}"></view>{{item.likeCount}} 赞
              </view>
              <view
                class="tap-scale pa-btn {{item.favorited ? 'on' : ''}}"
                catchtap="toggleFavorite"
                data-id="{{item.id}}"
              >
                <view class="pa-ico ico-star {{item.favorited ? 'on' : ''}}"></view>{{item.favorited ? '已收藏' : '收藏'}}
              </view>
              <view class="tap-scale pa-btn" catchtap="openPost" data-id="{{item.id}}">
                <view class="pa-ico ico-chat"></view>评论
              </view>
              <view class="pa-spacer"></view>
              <view class="tap-scale pa-report" catchtap="openReportSheet" data-id="{{item.id}}">
                  <view class="pa-ico ico-warn"></view>举报
                </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 广告位 -->
      <ad-banner placement="community-bottom"></ad-banner>

      <!-- 热门话题 -->
      <view class="topics">
        <view class="thead">
          <text class="th-title">热门话题</text>
        </view>
        <view class="tchips">
          <view class="tchip tap-scale" wx:for="{{hotTopics}}" wx:key="tag" data-tag="{{item.tag}}" bindtap="onTopicTap">
            <text class="tt">#{{item.tag}}</text>
          </view>
        </view>
        <view wx:if="{{currentTag}}" class="tag-filter">
          <text class="tag-filter-t">话题：#{{currentTag}}</text>
          <view class="tag-filter-x tap-scale" bindtap="clearTopic">看全部 ×</view>
        </view>
      </view>

      <!-- 流末 -->
      <view class="pad" wx:if="{{posts.length}}">
        <view class="feed-end"><text>{{hasMore ? '上拉加载更多…' : '没有更多了'}}</text></view>
      </view>

      <view class="safe-bottom"></view>
    </view>
  </scroll-view>

  <!-- 发帖 FAB -->
  <view class="fab tap-scale" catchtap="togglePostForm">
    <view class="fab-plus"></view>
  </view>

  <!-- 信息流滚深后回顶（与 FAB 同轴竖排） -->
  <back-top show="{{showBackTop}}" right="38rpx" bottom="352rpx" bind:totop="backToTop" />

  <!-- ===== 发帖弹层 ===== -->
  <state-sheet lift visible="{{showPostForm}}" title="分享今天的菜" bind:close="togglePostForm">
    <input
      class="pf-input"
      placeholder="给帖子起个标题"
      placeholder-class="pf-ph"
      value="{{postForm.title}}"
      bindinput="onPostInput"
      data-field="title"
    />
    <textarea
      class="pf-textarea"
      placeholder="说说做法、心得，或者今晚的灵魂拷问…"
      placeholder-class="pf-ph"
      value="{{postForm.content}}"
      bindinput="onPostInput"
      data-field="content"
    />
    <input
      class="pf-input"
      placeholder="标签，逗号分隔（如：川菜,下饭）"
      placeholder-class="pf-ph"
      value="{{postForm.tagsText}}"
      bindinput="onPostInput"
      data-field="tagsText"
    />
    <!-- 配图：最多 6 张，点了就选（相册/相机），可删 -->
    <view class="pf-imgs">
      <view wx:for="{{postForm.images}}" wx:key="*this" class="pf-img">
        <image src="{{item}}" mode="aspectFill" />
        <view class="pf-img-del tap-scale" data-index="{{index}}" catchtap="removePostImage">×</view>
      </view>
      <view wx:if="{{postForm.images.length < 6}}" class="pf-img-add tap-scale" bindtap="addPostImages">＋</view>
    </view>
    <view class="pf-actions">
      <view class="btn btn-ghost pf-cancel tap-scale" catchtap="togglePostForm">取消</view>
      <view class="btn btn-pop pf-submit tap-scale {{postSubmitting ? 'is-busy' : ''}}" catchtap="submitPost">{{postSubmitting ? '发布中…' : '发布'}}</view>
    </view>
  </state-sheet>

  <!-- ============ 举报弹层 ============ -->
  <state-sheet lift visible="{{showReportSheet}}" title="举报这条帖子" bind:close="closeReportSheet">
    <view class="rp-reasons">
      <view
        wx:for="{{reportReasons}}"
        wx:key="*this"
        class="rp-reason tap-scale {{activeReportReason === item ? 'rp-reason--on' : ''}}"
        catchtap="setReportReason"
        data-reason="{{item}}"
      >{{item}}</view>
    </view>
    <textarea
      class="pf-textarea rp-desc"
      placeholder="补充说明（选填）：比如内容哪里不实、疑似搬运来源…"
      placeholder-class="pf-ph"
      value="{{reportDesc}}"
      bindinput="onReportDescInput"
    />
    <view class="pf-actions">
      <view class="btn btn-ghost pf-cancel tap-scale" catchtap="closeReportSheet">取消</view>
      <view class="btn btn-pop pf-submit tap-scale {{reportSubmitting ? 'is-busy' : ''}}" catchtap="submitReport">{{reportSubmitting ? '提交中…' : '提交举报'}}</view>
    </view>
  </state-sheet>
</view>
