/* 邀请家人 · 页面样式 · 复用 app.wxss token，禁止硬编码配色 */
.fi-page {
  padding: 20rpx 46rpx 60rpx;
}

/* HERO */
.fi-hero {
  text-align: center;
  margin-top: 8rpx;
}
.fi-eyebrow {
  font-family: var(--serif);
  font-style: italic;
  font-size: var(--fs-cap);
  letter-spacing: 2rpx;
  color: var(--gold-deep);
  font-weight: 700;
}
.fi-title {
  font-size: 58rpx;
  font-weight: 900;
  color: var(--ink);
  letter-spacing: -2rpx;
  line-height: 1;
  margin-top: 14rpx;
  font-family: var(--sans);
}

/* 邀请暗卡（基于 .card-dark） */
.fi-invite {
  margin-top: 46rpx;
  padding: 58rpx 50rpx 50rpx;
  border-radius: 54rpx;
  text-align: center;
}
.fi-iv-cap {
  position: relative;
  z-index: 2;
  font-family: var(--serif);
  font-style: italic;
  font-size: var(--fs-cap);
  letter-spacing: 2rpx;
  color: var(--gold);
  font-weight: 700;
}

/* 6 位 code 分组 */
.fi-code {
  position: relative;
  z-index: 2;
  display: flex;
  justify-content: center;
  gap: 17rpx;
  margin-top: 27rpx;
}
.fi-dg {
  width: 81rpx;
  height: 108rpx;
  border-radius: 23rpx;
  background: rgba(255, 255, 255, 0.07);
  border: 2rpx solid rgba(255, 255, 255, 0.14);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--serif);
  font-size: 62rpx;
  font-weight: 700;
  color: var(--paper);
}

/* 复制按钮 */
.fi-copybtn {
  position: relative;
  z-index: 2;
  margin-top: 35rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  width: 100%;
  padding: 22rpx 0;
  border-radius: var(--r-pill);
  background: rgba(255, 255, 255, 0.1);
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  color: var(--paper);
  font-size: 26rpx;
  font-weight: 700;
}
.fi-ic-copy {
  width: 30rpx;
  height: 30rpx;
  border: 4rpx solid var(--paper);
  border-radius: 6rpx;
  position: relative;
}
.fi-ic-copy::after {
  content: "";
  position: absolute;
  left: -12rpx;
  top: -12rpx;
  width: 20rpx;
  height: 20rpx;
  border: 4rpx solid var(--paper);
  border-right: none;
  border-bottom: none;
  border-radius: 4rpx;
}

/* 二维码占位 */
.fi-qrwrap {
  position: relative;
  z-index: 2;
  margin: 42rpx auto 0;
  width: 330rpx;
  height: 330rpx;
  background: var(--c-surface);
  border-radius: 38rpx;
  padding: 27rpx;
  box-sizing: border-box;
  box-shadow: 0 20rpx 50rpx rgba(0, 0, 0, 0.25);
}
.fi-qr {
  position: relative;
  width: 276rpx;
  height: 276rpx;
}
.fi-qr-cell {
  position: absolute;
  width: 9rpx;
  height: 9rpx;
  background: var(--ink);
  border-radius: 1rpx;
}
.fi-qr-hint {
  position: relative;
  z-index: 2;
  text-align: center;
  margin-top: 25rpx;
  font-size: 22rpx;
  letter-spacing: 1rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* 微信分享按钮（基于 .btn-wx） */
.fi-wxbtn {
  margin-top: 50rpx;
  gap: 17rpx;
  font-size: 31rpx;
  font-weight: 800;
  border-radius: 35rpx;
  box-shadow: 0 20rpx 46rpx rgba(7, 193, 96, 0.32);
}
.fi-wxbtn::after { border: none; }
.fi-ic-wx {
  width: 38rpx;
  height: 32rpx;
  border-radius: 50% 50% 50% var(--r-xs);
  background: var(--c-surface);
  position: relative;
}
.fi-ic-wx::after {
  content: "";
  position: absolute;
  right: -12rpx;
  bottom: -10rpx;
  width: 30rpx;
  height: 26rpx;
  border-radius: 50% 50% var(--r-xs) 50%;
  background: var(--c-surface);
  box-shadow: 0 0 0 4rpx var(--wx);
}

/* 保存邀请图按钮 */
.fi-savebtn {
  margin-top: 25rpx;
  width: 100%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 17rpx;
  padding: 29rpx 0;
  border-radius: 35rpx;
  background: var(--c-surface);
  color: var(--ink);
  font-size: 29rpx;
  font-weight: 700;
  border: var(--bd-card);
  box-shadow: var(--sh-soft);
}
.fi-ic-save {
  width: 30rpx;
  height: 30rpx;
  position: relative;
}
.fi-ic-save::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 0;
  transform: translateX(-50%);
  width: 4rpx;
  height: 20rpx;
  background: var(--ink);
  border-radius: 2rpx;
}
.fi-ic-save::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 9rpx;
  transform: translateX(-50%) rotate(45deg);
  width: 14rpx;
  height: 14rpx;
  border-right: 4rpx solid var(--ink);
  border-bottom: 4rpx solid var(--ink);
}

/* Tip 24h */
.fi-note {
  display: flex;
  align-items: flex-start;
  gap: 17rpx;
  margin-top: 46rpx;
  padding: 27rpx 31rpx;
  background: var(--pop-soft);
  border-radius: 31rpx;
}
.fi-note-ic {
  flex: none;
  margin-top: 2rpx;
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid var(--pop);
  border-radius: 50%;
  position: relative;
}
.fi-note-ic::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 12rpx;
  transform: translateX(-50%);
  width: 4rpx;
  height: 12rpx;
  background: var(--pop);
  border-radius: 2rpx;
  box-shadow: 0 -10rpx 0 var(--pop);
}
.fi-note-text {
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--mut-strong);
}
.fi-note-text .b {
  color: var(--pop);
  font-weight: 800;
}
