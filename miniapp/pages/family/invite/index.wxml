<!-- 邀请家人 · 二级页 -->
<nav-bar title="邀请家人" status-bar-height="{{statusBarHeight}}"></nav-bar>

<view class="container fi-page">
  <!-- HERO 标题 -->
  <view class="fi-hero g-fade-up">
    <view class="fi-eyebrow">加入家庭</view>
    <view class="fi-title">把<text class="t-pop">餐桌</text>分享给家人</view>
  </view>

  <!-- 邀请暗卡 -->
  <view class="card-dark fi-invite g-fade-up g-d1">
    <view class="deco-circle"></view>

    <view class="fi-iv-cap">家庭邀请码</view>

    <!-- 6 位 code 分组 -->
    <view class="fi-code">
      <view class="fi-dg" wx:for="{{codeDigits}}" wx:key="index">{{item}}</view>
    </view>

    <view class="fi-copybtn tap-scale" bindtap="onCopyCode">
      <view class="fi-ic-copy"></view>
      <text>复制邀请码</text>
    </view>

    <!-- 二维码占位 -->
    <view class="fi-qrwrap">
      <view class="fi-qr">
        <view class="fi-qr-cell" wx:for="{{qrCells}}" wx:key="index" style="left:{{item.x}}rpx;top:{{item.y}}rpx;"></view>
      </view>
    </view>
    <view class="fi-qr-hint">微信扫一扫，加入这桌</view>
  </view>

  <!-- 微信分享 -->
  <button class="btn btn-wx btn-block fi-wxbtn tap-scale g-fade-up g-d2" open-type="share">
    <view class="fi-ic-wx"></view>
    微信分享给家人
  </button>

  <!-- 保存邀请图 -->
  <view class="fi-savebtn tap-scale g-fade-up g-d3" bindtap="onSaveImage">
    <view class="fi-ic-save"></view>
    <text>保存邀请图</text>
  </view>

  <!-- Tip 24h -->
  <view class="fi-note g-fade-up g-d4">
    <view class="fi-note-ic"></view>
    <view class="fi-note-text">家人<text class="b">扫码</text>或在小程序里<text class="b">输入邀请码</text>即可加入这桌，一起点菜、凑齐今晚的菜单。邀请码 <text class="b">24 小时</text>内有效。</view>
  </view>

  <view class="safe-bottom"></view>
</view>

<state-toast
  visible="{{toast.visible}}"
  type="{{toast.type}}"
  text="{{toast.text}}"
  duration="1800"
  bind:close="onToastClose"
></state-toast>
