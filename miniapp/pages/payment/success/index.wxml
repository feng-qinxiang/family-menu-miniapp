<!-- pages/payment/success/index · 开通成功页 -->
<nav-bar title="开通成功" show-back="{{true}}"></nav-bar>

<view class="ps-wrap safe-bottom">
  <!-- 成功徽章 + 金光晕 -->
  <view class="ps-badge g-scale-in g-d1">
    <view class="ps-badge-ring"></view>
    <text class="ps-badge-check">✓</text>
  </view>

  <view class="ps-eyebrow eyebrow-serif g-fade-up g-d2">Welcome to Family Sync</view>
  <view class="ps-title title-stroke title-shadow g-fade-up g-d2">
    开通<text class="pop">成功</text>
  </view>
  <view class="ps-sub g-fade-up g-d3">家庭云同步已生效，现在全家的菜谱、菜单和购物清单都会实时同步啦。</view>

  <!-- VIP 标签 -->
  <view class="ps-viptag g-fade-up g-d3">
    <text class="ps-viptag-star">★</text>
    <text>{{planName}}</text>
  </view>

  <!-- 权益清单 -->
  <view class="ps-perks card g-fade-up g-d4">
    <view class="ps-perk" wx:for="{{perks}}" wx:key="*this">
      <view class="ps-perk-ck"><text class="ps-perk-ck-tx">✓</text></view>
      <text class="ps-perk-tx ellipsis">{{item}}</text>
    </view>
  </view>

  <!-- 订单卡 -->
  <view class="ps-order card g-fade-up g-d5">
    <view class="ps-orow">
      <text class="ps-ol">订单号</text>
      <text class="ps-ov">{{order.orderNo}}</text>
    </view>
    <view class="ps-orow">
      <text class="ps-ol">实付金额</text>
      <text class="ps-ov ps-ov-pay">{{order.payAmount}}</text>
    </view>
    <view class="ps-orow">
      <text class="ps-ol">有效期至</text>
      <text class="ps-ov">{{order.expireAt}}</text>
    </view>
  </view>

  <!-- 操作区 -->
  <view class="ps-actions g-fade-up g-d6">
    <view class="btn btn-pop btn-block tap-scale" catchtap="onStart">开始使用</view>
    <view class="ps-link tap-scale" catchtap="onViewOrder">查看订单详情</view>
  </view>
</view>

<state-toast
  visible="{{toastVisible}}"
  type="center"
  text="{{toastText}}"
  bind:close="onToastClose"
></state-toast>
