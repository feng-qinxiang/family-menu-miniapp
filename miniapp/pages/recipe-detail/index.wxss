/* ============================================================
   pages/recipe-detail · 菜谱详情「美食杂志」重做
   配色/工具类复用 app.wxss，本文件仅页面特有结构
   ============================================================ */
.rd-page {
  position: relative;
  min-height: 100vh;
  background: var(--paper);
}
.rd-scroll {
  height: 100vh;
}

/* ===== Hero 大图 ===== */
.rd-hero {
  position: relative;
  height: 826rpx;
  overflow: hidden;
}
.rd-hero-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.rd-hero-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg,
    rgba(20, 14, 8, 0.55) 0%,
    rgba(20, 14, 8, 0) 30%,
    rgba(20, 14, 8, 0.2) 54%,
    rgba(20, 14, 8, 0.92) 100%);
}
.rd-hero-bignum {
  position: absolute;
  top: 230rpx;
  right: 18rpx;
  font-size: 384rpx;
  font-weight: 700;
  line-height: 1;
  color: rgba(255, 255, 255, 0.08);
  pointer-events: none;
}

/* nav-bar 右侧操作按钮 */
.rd-nav-actions {
  display: flex;
  gap: 18rpx;
}
.rd-cbtn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(58, 46, 35, 0.55);
  border: 2rpx solid rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Hero 文案 */
.rd-hero-body {
  position: absolute;
  left: 46rpx;
  right: 46rpx;
  bottom: 88rpx;
  z-index: 2;
  color: var(--c-surface);
}
.rd-tag {
  display: inline-block;
  font-family: var(--serif);
  font-style: italic;
  font-size: var(--fs-cap);
  letter-spacing: 2rpx;
  font-weight: 700;
  color: var(--c-surface);
  background: var(--pop);
  padding: 10rpx 26rpx;
  border-radius: var(--r-xs);
}
.rd-hero-title {
  font-size: 116rpx;
  line-height: 0.92;
  letter-spacing: -6rpx;
  margin: 28rpx 0 26rpx;
  -webkit-text-stroke: 3rpx var(--c-surface);
}
.rd-hero-meta {
  display: flex;
  gap: 16rpx;
  align-items: center;
  flex-wrap: wrap;
}
.rd-m {
  display: inline-flex;
  align-items: center;
  font-size: var(--fs-cap);
  font-weight: 600;
  color: var(--c-surface);
  background: rgba(255, 255, 255, 0.16);
  padding: 13rpx 24rpx;
  border-radius: var(--r-chip);
}
.rd-m-solid { background: var(--pop); }

/* 圆形份量 stepper */
.rd-srv {
  display: inline-flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.16);
  border-radius: var(--r-chip);
  padding: 6rpx;
}
.rd-sbtn {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
}
.rd-sbtn-minus,
.rd-sbtn-plus {
  position: relative;
  width: 24rpx;
  height: 5rpx;
  background: var(--c-surface);
  border-radius: 3rpx;
}
.rd-sbtn-plus::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 5rpx;
  height: 24rpx;
  background: var(--c-surface);
  border-radius: 3rpx;
}
.rd-sval {
  font-size: var(--fs-cap);
  font-weight: 700;
  color: var(--c-surface);
  min-width: 96rpx;
  text-align: center;
}
/* ===== Sheet ===== */
.rd-sheet {
  position: relative;
  margin-top: -50rpx;
  background: var(--paper);
  border-radius: 54rpx 54rpx 0 0;
  padding: 44rpx 46rpx 220rpx;
  z-index: 5;
}
.rd-sheet .shead { margin: 0 0 30rpx; }
.rd-sheet .shead:not(:first-child) { margin-top: 56rpx; }
.rd-card { margin: 0; }

.rd-empty-mini {
  color: var(--mut);
  font-size: 26rpx;
  text-align: center;
  padding: 48rpx 28rpx;
}

/* —— 食材行 —— */
.rd-ing {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--paper-2);
}
.rd-ing:last-child { border-bottom: none; }
.rd-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  flex: none;
}
.rd-dot.have { background: var(--pine); }
.rd-dot.miss { background: var(--pop); }
.rd-icw {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--r-md);
  background: var(--paper-2);
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
}
.rd-iname { flex: 1; }
.rd-iname-h {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--ink);
  letter-spacing: -0.4rpx;
}
.rd-note {
  font-size: 22rpx;
  color: var(--mut-strong);
  margin-top: 4rpx;
}
.rd-note.miss { color: var(--pop); font-weight: 600; }
.rd-amt {
  font-size: var(--fs-cap);
  font-weight: 800;
  color: var(--ink-deep);
  flex: none;
}

/* 加入买菜清单按钮 */
.rd-ing-cart { padding: 26rpx 0 8rpx; }
.rd-cart-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  min-height: 92rpx;
  border-radius: 28rpx;
  background: var(--pop);
  color: var(--c-surface);
  font-size: 28rpx;
  font-weight: 800;
  box-shadow: var(--sh-pop);
}
.rd-cnum {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 42rpx;
  height: 42rpx;
  padding: 0 12rpx;
  border-radius: 21rpx;
  background: rgba(255, 255, 255, 0.25);
  font-size: 24rpx;
  font-weight: 900;
}

/* —— 做法步骤 —— */
.rd-step {
  display: flex;
  gap: 28rpx;
  padding: 30rpx 0;
  border-bottom: 2rpx solid var(--paper-2);
}
.rd-step:last-child { border-bottom: none; }
.rd-sno {
  width: 66rpx;
  height: 66rpx;
  border-radius: 21rpx;
  background: var(--ink-deep);
  color: var(--gold);
  font-size: 33rpx;
  font-weight: 700;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
}
.rd-sno.hot {
  background: var(--pop);
  color: var(--c-surface);
  box-shadow: 0 12rpx 28rpx rgba(232, 71, 42, 0.35);
}
.rd-stx { flex: 1; padding-top: 6rpx; }
.rd-stx-p {
  font-size: 28rpx;
  line-height: 1.55;
  color: var(--ink);
}
.rd-step-img {
  width: 100%;
  margin-top: 18rpx;
  border-radius: 20rpx;
}
.rd-tip {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 16rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--gold-deep);
  background: var(--paper-2);
  padding: 10rpx 20rpx;
  border-radius: var(--r-chip);
}

/* —— 评价 —— */
.rd-rev {
  display: flex;
  gap: 25rpx;
  padding: 28rpx 0;
  border-bottom: 2rpx solid var(--paper-2);
}
.rd-av {
  width: 80rpx;
  height: 80rpx;
  border-radius: 26rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 900;
  color: var(--c-surface);
  font-family: var(--serif);
}
.rd-rc { flex: 1; }
.rd-rtop {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.rd-who { font-size: 28rpx; font-weight: 800; color: var(--ink); }
.rd-when { font-size: var(--fs-mini); color: var(--mut); }
.rd-stars { display: flex; gap: 4rpx; margin: 8rpx 0 12rpx; }
.rd-star {
  width: 24rpx;
  height: 24rpx;
  background: var(--c-border);
  clip-path: polygon(50% 0, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
}
.rd-star.on { background: var(--pop); }
.rd-cm { font-size: var(--fs-sub); line-height: 1.5; color: var(--mut); }

/* 写评价入口 */
.rd-rev-entry {
  display: flex;
  align-items: center;
  gap: 21rpx;
  padding: 28rpx 0 8rpx;
  border-top: 2rpx solid var(--paper-2);
  margin-top: 6rpx;
}
.rd-rev-entry.no-top { border-top: none; margin-top: 0; padding-top: 8rpx; }
.rd-meav {
  width: 80rpx;
  height: 80rpx;
  border-radius: 26rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 900;
  color: var(--c-surface);
  font-family: var(--serif);
  background: var(--pop);
}
.rd-fakein {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 26rpx;
  background: var(--paper-2);
  border: 2rpx solid var(--c-border);
  padding: 0 28rpx;
  font-size: var(--fs-sub);
  color: var(--mut-strong);
  font-weight: 600;
}
.rd-gobtn {
  flex: none;
  min-width: 100rpx;
  height: 84rpx;
  border-radius: 26rpx;
  background: var(--ink-deep);
  color: var(--gold);
  font-size: var(--fs-sub);
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}
/* ===== 底部 footbar ===== */
.rd-footbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 50;
  display: flex;
  gap: 16rpx;
  padding: 24rpx 30rpx;
  background: rgba(251, 248, 243, 0.94);
  border-top: 2rpx solid var(--paper-2);
}
.rd-ghost-btn {
  flex: none;
  width: 156rpx;
  height: 104rpx;
  border-radius: var(--r-chip);
  background: var(--paper-2);
  color: var(--ink-deep);
  font-size: 24rpx;
  font-weight: 800;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  border: 2rpx solid var(--c-border);
}
.rd-primary-btn {
  flex: 1;
  height: 104rpx;
  border-radius: var(--r-chip);
  background: var(--pop);
  color: var(--c-surface);
  font-size: 28rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: var(--sh-pop);
}
.rd-cook-btn {
  flex: none;
  width: 130rpx;
  height: 104rpx;
  border-radius: var(--r-chip);
  background: var(--ink-deep);
  color: var(--gold);
  font-size: 24rpx;
  font-weight: 800;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

/* ===== 纯 CSS 图标 ===== */
.rd-ic { position: relative; flex: none; }
/* 加号 */
.rd-ic-plus {
  width: 32rpx; height: 32rpx;
}
.rd-ic-plus::before, .rd-ic-plus::after {
  content: ""; position: absolute; left: 50%; top: 50%; background: currentColor; border-radius: 3rpx;
}
.rd-ic-plus { color: var(--c-surface); }
.rd-ic-plus::before { width: 30rpx; height: 5rpx; transform: translate(-50%, -50%); }
.rd-ic-plus::after { width: 5rpx; height: 30rpx; transform: translate(-50%, -50%); }
/* 对勾 */
.rd-ic-check {
  width: 34rpx; height: 22rpx;
  border-left: 5rpx solid var(--ink-deep);
  border-bottom: 5rpx solid var(--ink-deep);
  transform: rotate(-45deg) translateY(-4rpx);
  border-radius: 2rpx;
}
/* 播放三角 */
.rd-ic-play {
  width: 0; height: 0;
  border-left: 24rpx solid var(--gold);
  border-top: 14rpx solid transparent;
  border-bottom: 14rpx solid transparent;
}
/* 食材盒子图标 */
.rd-ic-box {
  width: 34rpx; height: 34rpx;
  border: 3rpx solid var(--gold-deep);
  border-radius: var(--r-xs);
}
.rd-ic-box::after {
  content: ""; position: absolute; left: 7rpx; right: 7rpx; top: 50%;
  height: 3rpx; background: var(--gold-deep); transform: translateY(-50%); border-radius: 2rpx;
}
/* 购物车（nav-bar 右上 + 卡内）*/
.rd-ic-cart, .rd-ic-cart2 {
  width: 34rpx; height: 30rpx;
  border: 3rpx solid var(--c-surface);
  border-top: none; border-radius: 0 0 var(--r-xs) var(--r-xs);
}
.rd-ic-cart::before, .rd-ic-cart2::before {
  content: ""; position: absolute; left: -2rpx; top: -16rpx; width: 16rpx; height: 18rpx;
  border-left: 3rpx solid var(--c-surface); border-top: 3rpx solid var(--c-surface); transform: skewX(-12deg); border-radius: 4rpx 0 0 0;
}
/* 星形 tip */
.rd-ic-star {
  width: 22rpx; height: 22rpx; background: var(--gold-deep);
  clip-path: polygon(50% 0, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
}

/* ===== 加载骨架 ===== */
.rd-hero-skel {
  height: 560rpx;
  background: linear-gradient(135deg, var(--paper-2), var(--c-border-light));
}
.rd-skel-row { display: flex; align-items: center; gap: 24rpx; padding: 24rpx 0; }
.rd-skel-dot { width: 80rpx; height: 80rpx; border-radius: var(--r-md); flex: none; }
.rd-skel-line { flex: 1; height: 32rpx; border-radius: var(--r-sm); }

/* ===== 空态 ===== */
.rd-empty-page { padding-top: 0; }
