/* ============================================================
   home/index.wxss · 杂志撞色风格首页（标杆 home-final.html）
   全局 token / 工具类见 app.wxss，此处不重复定义配色
   ============================================================ */
.mag-home {
  --photo-hero-h: 624rpx;
  min-height: 100vh;
  background: var(--paper);
}
.mag-home.font-lg { --photo-hero-h: 760rpx; }

/* 滚动后的页头复用导航组件，让内容从胶囊与状态栏下方经过。 */
.hm-scroll-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 60;
  background: var(--paper);
  border-bottom: var(--bd-card);
}

/* ============ HERO ============ */
.mh-hero {
  position: relative;
  height: var(--photo-hero-h);
  overflow: hidden;
}
.mh-hero-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.mh-hero-shade {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg,
    rgba(20, 14, 8, 0.55) 0%,
    rgba(20, 14, 8, 0.12) 26%,
    rgba(20, 14, 8, 0.45) 42%,
    rgba(20, 14, 8, 0.86) 64%,
    rgba(20, 14, 8, 0.94) 100%);
}

.mh-hero-top {
  position: absolute;
  top: calc(env(safe-area-inset-top) + 90rpx);
  left: 46rpx;
  /* 首帧兜底与 utils/capsule.js 的 FALLBACK_RIGHT（96px）一致，问候语不伸到胶囊下 */
  right: 96px;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.mh-greet { flex: 1; min-width: 0; }
.mh-name {
  font-size: calc(32rpx * var(--fs-mul, 1));
  font-weight: 600;
  margin-top: 6rpx;
  color: var(--anchor-contrast);
  text-shadow: 0 2rpx 10rpx rgba(20, 14, 8, 0.65);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
/* ---- hero body ---- */
.mh-hero-body {
  position: absolute;
  left: 46rpx;
  right: 46rpx;
  bottom: 72rpx;   /* 40rpx + 下方 sheet 上叠的 32rpx */
  z-index: 10;
  color: var(--anchor-contrast);
}
.mh-pill-tag {
  display: inline-block;
  font-size: var(--fs-cap);
  letter-spacing: 1rpx;
  font-weight: 700;
  color: var(--anchor-contrast);
  background: rgba(20, 14, 8, 0.4);   /* 角标降为暗色毛玻璃：同屏的红只留给「加入X餐」 */
  padding: 6rpx 20rpx;
  border-radius: var(--r-pill);
  border: 2rpx solid rgba(255, 255, 255, 0.45);
}
.mh-hero-title {
  font-size: calc(66rpx * var(--fs-mul, 1));
  font-weight: 900;
  line-height: 1.12;
  letter-spacing: -1rpx;
  margin: 16rpx 0 12rpx;
  color: var(--anchor-contrast);
  text-shadow: 0 4rpx 24rpx rgba(20, 14, 8, 0.55);
  white-space: nowrap;   /* 长菜名不换行，靠分档缩字号（t6/t7/t9/t11）兜住 */
}
/* title-stroke 镂空描边：原生 text-stroke 锐利无毛边，text-shadow 只留底部投影保证暗部可读。
   老内核不识别 -webkit-text-stroke 时退化为白字 + hero shade，可读性仍达标 */
.mh-hero-title.title-stroke {
  color: #fff;
  -webkit-text-stroke: 0;
  text-shadow: 0 2rpx 8rpx rgba(20, 14, 8, 0.7), 0 10rpx 28rpx rgba(20, 14, 8, 0.45);
}
/* 长菜名分档缩字号（titleClass 由 dish-logic.decorateHero 输出），随基准 84rpx 等比降档 */
.mh-hero-title.t6 { font-size: calc(62rpx * var(--fs-mul, 1)); }
.mh-hero-title.t7 { font-size: calc(60rpx * var(--fs-mul, 1)); }
.mh-hero-title.t9 { font-size: calc(56rpx * var(--fs-mul, 1)); }
.mh-hero-title.t11 {
  font-size: calc(50rpx * var(--fs-mul, 1));
  line-height: 1.12;
  white-space: normal;
  word-break: break-all;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 暖光叠层：底部暖金 radial 提亮，对标 home-final.html */
.mh-hero-glow {
  display: none;
}
.mh-hero-sub {
  font-size: var(--fs-sub);
  color: rgba(255, 255, 255, 0.92);
  font-weight: 400;
  text-shadow: 0 2rpx 8rpx rgba(20, 14, 8, 0.55);
  line-height: 1.45;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  word-break: break-all;
}
.mh-hero-meta {
  margin-top: 10rpx;
  font-size: var(--fs-sub);
  font-weight: 600;
  color: rgba(255, 255, 255, 0.95);
  text-shadow: 0 2rpx 8rpx rgba(20, 14, 8, 0.55);
}
.mh-hero-acts {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 18rpx;
  margin-top: 14rpx;
}
.mh-hero-add {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  min-height: 44px;
  border-radius: var(--r-card);
  background: var(--pop-fill);
  color: var(--anchor-contrast);
  font-size: calc(29rpx * var(--fs-mul, 1));
  font-weight: 800;
  box-shadow: var(--sh-pop);
}
.mh-hero-add.is-picked { background: var(--pine); box-shadow: none; }
/* 换一道：圆形毛玻璃次按钮，与主按钮并排（决策动作同级，不再埋在文字链里） */
.mh-hero-shuffle {
  /* 纯图标圆钮易被看成计时器：改胶囊 + 「换一道」文字，语义可读 */
  flex: none;
  box-sizing: border-box;
  height: var(--tap-min);
  min-height: 44px;
  padding: 0 var(--pad-card-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border-radius: var(--r-card);
  background: rgba(20, 14, 8, 0.24);
  border: 2rpx solid rgba(255, 255, 255, 0.4);
}
.mh-shuffle-tx {
  font-size: calc(25rpx * var(--fs-mul, 1));
  font-weight: 700;
  color: var(--anchor-contrast);
  letter-spacing: 1rpx;
}
.mh-ico-shuffle {
  position: relative;
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid var(--anchor-contrast);
  border-left-color: transparent;
  border-radius: 50%;
  transform: rotate(-45deg);
}
/* 圆环缺口处的箭头 */
.mh-ico-shuffle::after {
  content: "";
  position: absolute;
  top: -4rpx;
  left: 50%;
  transform: translateX(-50%) rotate(-45deg);
  width: 0;
  height: 0;
  border-left: 7rpx solid transparent;
  border-right: 7rpx solid transparent;
  border-bottom: 11rpx solid var(--anchor-contrast);
}
/* ============ SHEET ============ */
.mh-sheet {
  position: relative;
  margin-top: -32rpx;   /* 上叠 hero，圆角接住照片底边，不再一刀切 */
  background: var(--paper);
  border-radius: calc(var(--r-sheet) * 2) calc(var(--r-sheet) * 2) 0 0;
  /* 底部留白必须含 tabBar 实高（--tabbar-h 已带安全区）。
     原来写死 186rpx：刘海机上 tabBar 实高 196rpx，最后一张卡被压在下面。 */
  padding: 24rpx 0 calc(var(--tabbar-h) + 40rpx);
  z-index: 20;
}
.mh-pad { padding: 0 46rpx; }
/* 今天这一桌卡底部：随机点菜 / 冰箱能做 两个文字按钮，不抢上方主动作 */
.hm-pick-tools { display: flex; align-items: center; justify-content: space-around; flex-wrap: wrap; gap: 8rpx 32rpx; margin-top: 8rpx; border-top: 1rpx solid var(--c-border-light); }
.hm-pick-tool { display: flex; align-items: center; gap: 10rpx; color: var(--gold-deep); font-size: var(--fs-sub); }
.hm-pick-tool image { width: 30rpx; height: 30rpx; flex: none; filter: brightness(0); opacity: .6; }
.hm-recipe-search { display: flex; align-items: center; gap: 16rpx; margin: 16rpx var(--page-gutter) 8rpx; padding: 0 20rpx; background: var(--c-surface); border: var(--bd-card); border-radius: var(--r-md); }
.hm-search-icon { width: 30rpx; height: 30rpx; flex: none; }
.hm-search-input { flex: 1; min-width: 0; min-height: 88rpx; font-size: var(--fs-sub); color: var(--ink); }
.hm-search-placeholder { color: var(--mut); }
.hm-search-submit { min-height: 88rpx; min-width: 88rpx; display: flex; align-items: center; justify-content: flex-end; font-size: var(--fs-sub); font-weight: 700; color: var(--pop-deep); }

/* chips */
.hm-recipes-head { margin-top: 24rpx; }
.mh-chips { width: 100%; margin: 12rpx 0 18rpx; white-space: nowrap; }
.mh-chips-inner {
  display: inline-flex;
  gap: 18rpx;
  padding: 0 46rpx 8rpx;
}

/* 家常菜横滑大卡 */
.mh-hcards { width: 100%; white-space: nowrap; }
.mh-hcards-inner {
  display: inline-flex;
  gap: 30rpx;
  padding: 4rpx 46rpx 12rpx;
}
/* 横滑槽：宽度交给 recipe-card density=home */
.mh-rcard-slot {
  flex: none;
  width: 404rpx;
}

/* ============ 家庭菜单 ============ */
.hm-menu-card {
  box-sizing: border-box;
  padding: 20rpx var(--pad-card-sm);
  border: var(--bd-card);
  border-radius: var(--r-card);
  background: var(--c-surface);
  box-shadow: var(--sh-card);
}
.hm-menu-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.hm-menu-heading { min-width: 0; flex: 1; }
.hm-menu-eyebrow {
  color: var(--gold-deep);
  font-size: var(--fs-cap);
  font-weight: 700;
  line-height: 1.4;
}
.hm-menu-title {
  margin-top: 4rpx;
  color: var(--ink);
  font-size: var(--fs-lg);
  font-weight: 800;
  line-height: 1.3;
}
.hm-menu-title-progress { font-size: var(--fs-cap); font-weight: 500; color: var(--mut-strong); }
.hm-menu-open {
  flex: none;
  min-height: 44px;
  display: flex;
  align-items: center;
  color: var(--gold-deep);
  font-size: var(--fs-cap);
  font-weight: 700;
}
.hm-menu-list { margin-top: 12rpx; border-top: 1rpx solid var(--c-border-light); }
.hm-menu-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: var(--tile-row-sm);
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--c-border-light);
}
.hm-menu-row:last-child { border-bottom: 0; }
.hm-menu-thumb {
  flex: none;
  width: var(--tile-row-sm);
  height: var(--tile-row-sm);
  border-radius: var(--r-card);
  background: var(--paper-2);
}
.hm-menu-copy { flex: 1; min-width: 0; }
.hm-menu-mainline {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}
.hm-menu-dish-title {
  flex: 1;
  min-width: 0;
  color: var(--ink);
  font-size: var(--fs-lg);
  font-weight: 700;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  word-break: break-all;
}
.hm-status {
  flex: none;
  padding: 5rpx 12rpx;
  border-radius: var(--r-pill);
  font-size: calc(21rpx * var(--fs-mul, 1));
  font-weight: 700;
  line-height: 1.3;
  white-space: nowrap;
}
.hm-status--todo { color: var(--mut-strong); background: var(--paper-2); }
.hm-status--cooking { color: var(--pop-deep); background: var(--pop-soft); }
.hm-status--done { color: var(--pine-ink); background: var(--c-accent-soft); }
.hm-menu-byline {
  margin-top: 8rpx;
  color: var(--mut-strong);
  font-size: var(--fs-cap);
  line-height: 1.4;
  word-break: break-all;
}
.hm-menu-more {
  box-sizing: border-box;
  min-height: var(--tap-min);
  padding: 4rpx 0;
  display: flex;
  align-items: center;
  color: var(--gold-deep);
  font-size: var(--fs-cap);
  font-weight: 700;
}
.hm-menu-summary {
  margin-top: 6rpx;
}
.hm-menu-progress {
  height: 6rpx;
  overflow: hidden;
  border-radius: var(--r-pill);
  background: var(--paper-2);
}
.hm-menu-progress-fill {
  height: 100%;
  border-radius: inherit;
  background: var(--pine);
}
.hm-menu-actions {
  display: flex;
  align-items: stretch;
  gap: 12rpx;
  margin-top: 12rpx;
}
.hm-menu-action-secondary {
  box-sizing: border-box;
  flex: none;
  min-height: 44px;
  padding: 12rpx var(--pad-card-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 8rpx;
  border: var(--bd-card);
  border-radius: var(--r-card);
  background: var(--paper-2);
  color: var(--mut-strong);
  font-size: calc(25rpx * var(--fs-mul, 1));
  font-weight: 700;
}
.hm-menu-shopping-count {
  color: var(--gold-deep);
  font-size: var(--fs-cap);
  font-weight: 800;
}
.hm-menu-action-icon {
  flex: none;
  width: 30rpx;
  height: 30rpx;
}
.hm-menu-action-secondary .hm-menu-action-icon {
  filter: brightness(0);
  opacity: 0.6;
}
.hm-menu-action-primary {
  box-sizing: border-box;
  flex: 1;
  min-width: 0;
  min-height: 44px;
  padding: 20rpx var(--pad-card-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border-radius: var(--r-card);
  /* 同屏只留 hero 一颗红；浅底页面不用深棕实心当第二主按钮（规范 四点五·1），这里走次按钮 */
  background: var(--c-surface);
  color: var(--ink);
  border: var(--bd-card);
  font-size: var(--fs-btn);
  font-weight: 800;
  line-height: 1.3;
}
.hm-menu-action-primary .hm-menu-action-icon { filter: brightness(0); opacity: 0.6; }
.hm-menu-empty-note {
  margin-top: 8rpx;
  color: var(--mut-strong);
  font-size: var(--fs-sub);
  line-height: 1.5;
}
.hm-menu-empty-top { display: flex; align-items: center; gap: 20rpx; }
.hm-menu-empty-copy { flex: 1; min-width: 0; }
.hm-menu-empty-plate { width: 112rpx; height: 112rpx; flex: none; }
.font-lg .hm-menu-empty-plate { width: 88rpx; height: 88rpx; }
.hm-menu-pick { margin-top: 22rpx; }

.font-lg .hm-menu-head { align-items: flex-start; }
.font-lg .hm-menu-mainline { flex-direction: column; gap: 6rpx; }
.font-lg .hm-menu-dish-title { flex: none; width: 100%; }

@media (prefers-color-scheme: dark) {
  /* 这些 SVG 在浅色档靠 brightness(0) 压成黑色，深色档要翻成白色，否则黑图标落在深卡上看不见 */
  .hm-pick-tool image,
  .hm-menu-action-secondary .hm-menu-action-icon,
  .hm-menu-action-primary .hm-menu-action-icon { filter: brightness(0) invert(1); }
  /* 空盘插画是奶油色实底，深卡上会亮成一块白斑；压到 0.3，餐具与卡底的对比和浅色档相当 */
  .hm-menu-empty-plate { opacity: 0.3; }
  .hm-status--done { color: var(--c-success); background: var(--c-success-soft); }
  .hm-menu-progress-fill { background: var(--c-success); }
}

/* 首页局部覆盖：section eyebrow 去衬线斜体，中文更亲切（不影响其他页面的全局 .eyebrow）。
   暖橙金 eyebrow 文字，配中文实心标题，弱化原杂志冷调。 */
.mag-home .eyebrow {
  font-family: var(--sans);
  font-style: normal;
  letter-spacing: 0;
  color: var(--gold-deep);
}

/* ============ 家庭点菜：餐次选择器 + 许愿池 ============ */
/* 餐次分段：与菜单页 .mn-seg 同一做法（浅轨道 + 白滑块），视觉 64rpx，热区撑到 --tap-min */
.fp-slotbar {
  display: flex;
  margin: 4rpx 46rpx 20rpx;
  padding: 6rpx;
  background: var(--paper-2);
  border-radius: var(--r-pill);
}
.fp-slot {
  position: relative;
  flex: 1;
  min-width: 0;
  min-height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-sub);
  font-weight: 600;
  color: var(--mut-strong);
  border-radius: var(--r-pill);
}
.fp-slot::after { content: ''; position: absolute; left: 0; right: 0; top: 50%; height: var(--tap-min); transform: translateY(-50%); }
.fp-slot.on {
  color: var(--ink);
  background: var(--seg-thumb);
  box-shadow: var(--sh-card);
  font-weight: 700;
}

.fp-wish {
  position: relative;
  z-index: 21;
  margin: 24rpx 46rpx 0;
  background: var(--c-surface);
  border: var(--bd-card);
  border-radius: var(--r-card);
  padding: 20rpx var(--pad-card-sm);
  box-shadow: var(--sh-card);
}
.fp-wish-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.fp-wish-head--toggle {
  flex: 1;
  min-width: 0;
  min-height: 44px;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.fp-wish-title { flex: 0 1 auto; min-width: 0; line-height: 1.5; }
.fp-wish-eyebrow {
  font-size: var(--fs-lg);
  font-weight: 800;
  color: var(--ink);
}
.fp-wish-meta {
  margin-top: 4rpx;
  font-size: var(--fs-cap);
  color: var(--mut-strong);
  font-weight: 600;
}
.fp-wish-caret {
  flex: none;
  width: 20rpx;
  height: 20rpx;
  border-right: 4rpx solid var(--mut);
  border-bottom: 4rpx solid var(--mut);
  transform: rotate(45deg);
  transition: transform 0.2s;
  margin: 0 auto 0 4rpx; /* 紧跟标题，右侧留空给「+ 我想吃」，两者不再挤在一起 */
}
.fp-wish-caret.up { transform: rotate(-135deg); }
.fp-wish-add {
  flex: none;
  min-height: 44px;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  border-radius: var(--r-pill);
  background: transparent;   /* 文字按钮：首屏红色只留给 hero「加入X餐」 */
  color: var(--gold-deep);
  font-size: var(--fs-sub);
  font-weight: 700;
}
/* 展开态下头部补 margin-bottom */
.fp-wish-head { margin-bottom: 0; }
.fp-wish.expanded .fp-wish-head { margin-bottom: 18rpx; }
.fp-wish-preview {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx;
  margin-top: 12rpx;
  background: var(--paper);
  border-radius: var(--r-sm);   /* 内层圆角不大于外层心愿卡（--r-card） */
  color: var(--mut-strong);
  font-size: var(--fs-cap);
}
.fp-wish-preview-copy { flex: 1; min-width: 0; }
.fp-wish-preview-by { margin-top: 6rpx; font-size: var(--fs-cap); }
.fp-wish-preview-dish { color: var(--ink); font-size: calc(32rpx * var(--fs-mul, 1)); font-weight: 700; line-height: 1.45; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; word-break: break-all; }
.fp-wish-preview-rest { flex: none; font-size: var(--fs-cap); color: var(--gold-deep); }
.fp-wish-list { display: flex; flex-direction: column; }
.fp-wish-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 18rpx 0 8rpx;
  border-bottom: 2rpx solid var(--paper-2);
}
.fp-wish-item:last-child { border-bottom: 0; }
.fp-wish-item-copy { display: flex; align-items: flex-start; gap: 14rpx; width: 100%; min-width: 0; }
.fp-wish-avatar { width: 56rpx; height: 56rpx; flex: none; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--paper-2); color: var(--mut-strong); font-size: var(--fs-cap); font-weight: 700; }
.fp-wish-text {
  flex: 1;
  min-width: 0;
  font-size: calc(28rpx * var(--fs-mul, 1));
  font-weight: 700;
  line-height: 1.45;
  color: var(--ink);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  word-break: break-all;
}
.fp-wish-item-meta { display: flex; width: 100%; align-items: center; gap: 8rpx; }
/* 待挑菜标记：纯文本心愿点击直达按关键词搜菜 */
.fp-wish-pending {
  flex: none;
  min-height: 44px;
  display: flex;
  align-items: center;
  font-size: var(--fs-cap);
  font-weight: 700;
  color: var(--gold-deep);
  padding: 0 8rpx;
}
.fp-wish-by { flex: 1; min-width: 0; padding-left: 70rpx; font-size: var(--fs-cap); color: var(--mut-strong); font-weight: 600; }
/* 操作占用独立的触控区域，避免相邻按钮的扩展热区重叠。 */
.fp-wish-more {
  flex: none;
  box-sizing: border-box;
  min-width: 44px;
  min-height: 44px;
  border-radius: var(--r-card);
  display: flex; align-items: center; justify-content: center;
  font-size: calc(25rpx * var(--fs-mul, 1));
  font-weight: 700;
  color: var(--mut-strong);
}
.fp-wish-linked { color: var(--pine-ink); font-size: var(--fs-cap); }
.fp-wish-confirm {
  margin-top: 22rpx;
  min-height: 44px;
  padding: 12rpx var(--pad-card-sm);
  border-radius: var(--r-card);   /* 实心主按钮统一走 --r-card */
  background: var(--anchor);
  color: var(--anchor-contrast);
  font-size: calc(28rpx * var(--fs-mul, 1));
  font-weight: 800;
  line-height: 1.4;
  text-align: center;
  display: flex; align-items: center; justify-content: center;
  box-shadow: var(--sh-card);
}
.fp-wish-confirm.disabled {
  background: var(--line-deep);
  color: var(--anchor-contrast);
  box-shadow: none;
}
/* 空态引导：许愿池为空时，弱化为虚线引导框，避免误导点击 */
.fp-wish-confirm.hint {
  background: var(--paper-2);
  color: var(--mut-strong);
  box-shadow: none;
  border: 2rpx dashed var(--line-deep);
  font-weight: 700;
}

/* ============ HERO 空态（杂志文字驱动）============ */
.mh-hero.mh-hero--empty {
  height: auto;
  overflow: visible;
  position: relative;
  padding: calc(env(safe-area-inset-top) + 48rpx) 36rpx 56rpx;
  background: var(--anchor);
}
.mh-hero--empty .mh-hero-img,
.mh-hero--empty .mh-hero-shade { display: none; }
.mh-empty-body {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 0;
}
.mh-hero--empty .mh-greet {
  margin-bottom: 40rpx;
}
.mh-hero--empty .mh-greet .mh-name {
  color: var(--anchor-contrast);
  font-size: calc(32rpx * var(--fs-mul, 1));
  font-weight: 700;
}
.mh-empty-headline {
  font-size: calc(56rpx * var(--fs-mul, 1));
  font-weight: 900;
  color: var(--anchor-contrast);
  line-height: 1.15;
  letter-spacing: -2rpx;
  margin-bottom: 16rpx;
}
.mh-empty-headline .pop { color: var(--pop); }
.mh-empty-sub {
  font-size: calc(25rpx * var(--fs-mul, 1));
  color: rgba(255,255,255,0.55);
  line-height: 1.55;
  margin-bottom: 36rpx;
}
.mh-empty-acts {
  display: flex;
  gap: 20rpx;
}
.mh-empty-go {
  display: inline-flex;
  align-items: center;
  min-height: 44px;
  box-sizing: border-box;
  padding: 20rpx 44rpx;   /* 例外：这是实心按钮不是卡，左右留白跟字号走 */
  border-radius: var(--r-card);   /* 实心主按钮统一走 --r-card */
  background: var(--pop-fill);
  color: var(--anchor-contrast);
  font-size: calc(28rpx * var(--fs-mul, 1));
  font-weight: 800;
  box-shadow: var(--sh-pop);
}

/* 深色档覆盖要写在被覆盖的规则之后：@media 不加权重，写在前面会被后面的浅色规则盖回去 */
@media (prefers-color-scheme: dark) {
  /* 已选菜谱：与「已上桌」同一个完成色（--pine 文字在深底上只有约 2.9:1） */
  .fp-wish-linked { color: var(--c-success); }
  /* 空态 hero 底是 --anchor 锚点色，而 --gold 深色档翻成 #8a6a3a，金字压在锚点底上不到 3:1 */
}

/* ============ 许愿弹窗（root-portal 渲染在页面根之外，不保证继承 page 变量；
   在此显式声明弹窗用到的全部 token 副本（色值 + 圆角 + 阴影 + 字号），
   内部统一 var() 引用，换肤只改此处。缺一个变量 = 该样式在弹窗里失效） ============ */
/* 注意：backdrop 与 modal 是 root-portal 下的兄弟节点，变量必须同时声明给两者 */
.wish-backdrop,
.wish-modal {
  --pop: #c8381f;
  --pop-soft: #fdece6;
  --pop-deep: #b3381f;
  --ink: #2c241b;
  --mut: #716555;
  --mut-2: #b3a795;
  --mut-strong: #6b5f50;
  --paper-2: #f0ebe2;
  --c-surface: #ffffff;
  --line: #e8e0d0;
  --line-light: #f1ece2;
  --r-sm: 16rpx;
  --r-md: 24rpx;
  --r-card: 16rpx;
  --r-pill: 999rpx;
  --sh-pop: 0 6rpx 16rpx rgba(200, 56, 31, 0.22);
  --fs-cap: 23rpx;
  --ink-deep: #3a2e23;          /* 「算了」按钮字色（原副本漏了这两项） */
  --anchor-contrast: #fbf8f3;   /* 「许愿」按钮字色，两档恒定 */
  --pop-fill: #c8381f;          /* 「许愿」红底（同 app.wxss --pop-fill） */
}
/* 深色模式副本：root-portal 不继承 page 变量，dark 值取 theme.json dark 段 */
.wish-backdrop.is-dark,
.wish-modal.is-dark {
  --pop: #ff6a4d;
  --pop-soft: #3a2218;
  --pop-deep: #ff7a5c;
  --ink: #efefef;
  --mut: #9a9a96;
  --mut-2: #757570;
  --mut-strong: #c4c0b8;
  --paper-2: #2e2e2e;
  --c-surface: #242424;
  --line: #333333;
  --line-light: #333333;
  --sh-pop: 0 6rpx 16rpx rgba(0, 0, 0, 0.45);
  --ink-deep: #e2e2e2;
  --pop-fill: #c8381f;          /* 深色档 --pop 上放浅字只有 2.7:1，红底用品牌原红（4.9:1） */
}

.wish-backdrop {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(20, 14, 8, 0.45);   /* 与全站 state-dialog 遮罩一致 */
  z-index: 9998;
}
.wish-modal {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 620rpx;
  background: var(--c-surface);
  border-radius: 40rpx;                 /* 对齐 state-dialog */
  overflow: hidden;
  box-shadow: 0 40rpx 100rpx rgba(30, 18, 8, 0.4), 0 8rpx 24rpx rgba(30, 18, 8, 0.2);
  animation: sdPop 0.35s cubic-bezier(0.2, 0.9, 0.3, 1.3) both;
  z-index: 9999;
}
@keyframes sdPop {
  from { opacity: 0; transform: translate(-50%, -50%) scale(0.9); }
  to { opacity: 1; transform: translate(-50%, -50%) scale(1); }
}
/* 头部：居中圆形图标（对齐 state-dialog 的 sd-ic）+ 标题 + 副标题 */
.wish-modal-hd {
  padding: 60rpx 52rpx 0;
  text-align: center;
}
.wish-modal-ic {
  width: 136rpx;
  height: 136rpx;
  margin: 0 auto 36rpx;
  border-radius: 50%;
  background: var(--pop-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}
.wish-modal-ic::after {
  content: "";
  position: absolute;
  inset: -14rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(200, 56, 31, 0.18);
}
.wish-modal-ic-glyph { font-size: calc(72rpx * var(--fs-mul, 1)); font-weight: 900; line-height: 1; color: var(--pop); }
.wish-modal-title { font-size: calc(40rpx * var(--fs-mul, 1)); font-weight: 900; color: var(--ink); letter-spacing: -1rpx; line-height: 1.25; }
.wish-modal-sub { margin-top: 14rpx; font-size: calc(28rpx * var(--fs-mul, 1)); color: var(--mut-strong); line-height: 1.55; }
.wish-modal-bd { padding: 44rpx 52rpx 0; }
.wish-modal-input {
  width: 100%;
  box-sizing: border-box;
  height: 96rpx;
  padding: 0 28rpx;   /* 例外：输入框不是卡表面；root-portal 里取不到 --pad-card，数值与它相同 */
  font-size: calc(29rpx * var(--fs-mul, 1));
  color: var(--ink);
  background: var(--paper-2);
  border: none;
  border-radius: var(--r-card);   /* 与弹窗按钮、state-dialog 按钮同为 --r-card（原 28rpx） */
  transition: border-color .2s;
}
.wish-modal-input:focus,
.wish-modal-input-focus { border: 2rpx solid var(--pop); background: var(--c-surface); }
.wish-ph { color: var(--mut-2); }
/* 底部按钮：完全对齐 state-dialog（ghost 灰底 + danger 红底，100rpx 高） */
.wish-modal-ft {
  display: flex;
  gap: 22rpx;
  padding: 44rpx 44rpx 44rpx;
}
.wish-btn-cancel,
.wish-btn-ok {
  flex: 1;
  height: 100rpx;
  border-radius: var(--r-card);   /* 弹窗块里已声明 --r-card 副本 */
  font-size: calc(32rpx * var(--fs-mul, 1));
  font-weight: 800;
  letter-spacing: 0.6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.wish-btn-cancel { background: var(--paper-2); color: var(--ink-deep); }
.wish-btn-ok { background: var(--pop-fill); color: var(--anchor-contrast); box-shadow: 0 4rpx 8rpx rgba(180, 40, 20, 0.3), 0 20rpx 44rpx rgba(200, 56, 31, 0.4); }
.wish-btn-ok.off { opacity: 0.4; }

/* ============ SKELETON ============ */
.mh-skel { padding: calc(env(safe-area-inset-top) + 16rpx) 46rpx 0; }
.mh-skel-hero {
  width: 100%;
  /* 与真实 hero（--photo-hero-h）一致，避免加载完成时高度跳变 */
  height: var(--photo-hero-h);
  border-radius: 0 0 var(--r-card) var(--r-card);
  background: var(--skeleton);
}
.mh-skel-slots {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}
.mh-skel-chip {
  width: 120rpx;
  height: 64rpx;
  border-radius: var(--r-chip);
  background: var(--skeleton);
}
.mh-skel-cards {
  display: flex;
  /* gap 与真卡同值（.mh-hcards-inner 是 30rpx）：原来 20rpx，
     数据回来那一刻整排卡会横向摊开约 10rpx×N */
  gap: 30rpx;
  margin-top: 32rpx;
  overflow: hidden;
}
.mh-skel-card {
  flex: none;
  /* 骨架必须等于它替身的那张卡：真卡是 recipe-card density=home 的 404rpx，
     原来写 300rpx，加载完每张卡横向长 104rpx，整排往右挤 */
  width: 404rpx;
}
.mh-skel-cover {
  width: 100%;
  height: 288rpx;   /* = .rc-ph 的 288rpx */
  border-radius: var(--r-card);
  background: var(--skeleton);
}
.mh-skel-line {
  margin-top: 16rpx;
  height: 24rpx;
  border-radius: 12rpx;
  background: var(--skeleton);
  width: 80%;
}
.mh-skel-line.strong {
  width: 60%;
  height: 28rpx;
}


/* ===== 加载失败态：静态「碗」图示，禁止任何 spin/无限动画 ===== */
.mh-load-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-sizing: border-box;
}
.mh-load-error--full {
  min-height: 72vh;
  padding: calc(env(safe-area-inset-top) + 120rpx) 48rpx calc(var(--tabbar-h) + 40rpx);
  justify-content: center;
}
.mh-load-error--soft {
  padding: 72rpx 48rpx 40rpx;
  border-bottom: 2rpx solid var(--paper-2);
}
.mh-load-error-mark {
  position: relative;
  width: 128rpx;
  height: 128rpx;
  margin-bottom: 36rpx;
  border-radius: 50%;
  background: var(--pop-soft);
  display: flex;
  align-items: center;
  justify-content: center;
}
/* 静态碗形：下半圆弧 + 顶横线，绝无 animation */
.mh-load-error-cloud {
  width: 64rpx;
  height: 36rpx;
  border: 5rpx solid var(--pop);
  border-top: none;
  border-radius: 0 0 36rpx 36rpx;
  box-sizing: border-box;
  margin-top: 12rpx;
}
.mh-load-error-bolt {
  position: absolute;
  top: 36rpx;
  left: 50%;
  width: 48rpx;
  height: 5rpx;
  margin-left: -24rpx;
  border-radius: 3rpx;
  background: var(--pop-fill);
}
.mh-load-error-title {
  font-size: calc(36rpx * var(--fs-mul, 1));
  font-weight: 800;
  color: var(--ink-deep);
  letter-spacing: -0.5rpx;
}
.mh-load-error-desc {
  margin-top: 14rpx;
  max-width: 480rpx;
  font-size: calc(25rpx * var(--fs-mul, 1));
  line-height: 1.5;
  color: var(--mut-strong);
}
.mh-load-error-btn {
  margin-top: 44rpx;
  min-height: 88rpx;
  padding: 0 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-card);
  background: var(--pop-fill);
  color: var(--anchor-contrast);
  font-size: var(--fs-btn);
  font-weight: 800;
  box-shadow: var(--sh-pop);
}
