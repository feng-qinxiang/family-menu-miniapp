/* ============================================================
   home/index.wxss · 杂志撞色风格首页（标杆 home-final.html）
   全局 token / 工具类见 app.wxss，此处不重复定义配色
   ============================================================ */
.mag-home {
  min-height: 100vh;
  background: var(--paper);
}

/* ============ HERO ============ */
.mh-hero {
  position: relative;
  height: 560rpx;
  overflow: hidden;
}
.mh-hero-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.mh-hero-shade {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg,
    rgba(20, 14, 8, 0.55) 0%,
    rgba(20, 14, 8, 0) 28%,
    rgba(20, 14, 8, 0.18) 52%,
    rgba(20, 14, 8, 0.94) 100%);
}

.mh-hero-top {
  position: absolute;
  top: calc(env(safe-area-inset-top) + 90rpx);
  left: 46rpx;
  right: 46rpx;
  z-index: 10;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}
.mh-hi {
  font-size: var(--fs-sub);
  letter-spacing: 1rpx;
  opacity: 0.9;
  font-weight: 600;
  color: var(--c-surface);
}
.mh-name {
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 6rpx;
  color: var(--c-surface);
}
.mh-iconbtns { display: flex; gap: 18rpx; }
.mh-iconbtn {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
  border: 2rpx solid rgba(255, 255, 255, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
}
.mh-cart-dot {
  position: absolute;
  top: 12rpx;
  right: 14rpx;
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: var(--pop);
  border: 3rpx solid var(--c-surface);
}
.mh-ico-cart {
  width: 30rpx;
  height: 22rpx;
  border: 3rpx solid var(--c-surface);
  border-top: none;
  border-radius: 0 0 8rpx 8rpx;
  position: relative;
  margin-top: 8rpx;
}
.mh-ico-cart::before {
  content: "";
  position: absolute;
  left: -2rpx;
  top: -10rpx;
  width: 28rpx;
  height: 12rpx;
  border: 3rpx solid var(--c-surface);
  border-bottom: none;
  border-radius: 6rpx 6rpx 0 0;
}
.mh-ico-book {
  width: 28rpx;
  height: 32rpx;
  border: 3rpx solid var(--c-surface);
  border-radius: 4rpx 8rpx 8rpx 4rpx;
  position: relative;
}
.mh-ico-book::after {
  content: "";
  position: absolute;
  left: 8rpx;
  top: 6rpx;
  bottom: 6rpx;
  width: 3rpx;
  background: var(--c-surface);
}
/* ---- hero body ---- */
.mh-hero-body {
  position: absolute;
  left: 46rpx;
  right: 46rpx;
  bottom: 36rpx;
  z-index: 10;
  color: var(--c-surface);
}
.mh-pill-tag {
  display: inline-block;
  font-size: var(--fs-cap);
  letter-spacing: 1rpx;
  font-weight: 700;
  color: var(--c-surface);
  background: var(--pop);
  padding: 8rpx 22rpx;
  border-radius: var(--r-pill);
  border: 2rpx solid rgba(255, 255, 255, 0.65);   /* 白描边：红 pill 叠红汤/暖色菜图时保持辨识度 */
  box-shadow: 0 4rpx 12rpx rgba(20, 14, 8, 0.3);
}
.mh-hero-title {
  font-size: 84rpx;
  font-weight: 900;
  line-height: 0.98;
  letter-spacing: -3rpx;
  margin: 12rpx 0 8rpx;
  color: var(--c-surface);
  text-shadow: 0 4rpx 24rpx rgba(20, 14, 8, 0.55);
  white-space: nowrap;   /* 长菜名不换行，靠分档缩字号（t6/t7/t9/t11）兜住 */
}
/* title-stroke 镂空描边：原生 text-stroke 锐利无毛边，text-shadow 只留底部投影保证暗部可读。
   老内核不识别 -webkit-text-stroke 时退化为白字 + hero shade，可读性仍达标 */
.mh-hero-title.title-stroke {
  -webkit-text-stroke: 1.5rpx rgba(255, 255, 255, 0.85);
  text-shadow: 0 8rpx 28rpx rgba(20, 14, 8, 0.5);
}
/* 长菜名分档缩字号（titleClass 由 dish-logic.decorateHero 输出），随基准 84rpx 等比降档 */
.mh-hero-title.t6 { font-size: 76rpx; }
.mh-hero-title.t7 { font-size: 66rpx; }
.mh-hero-title.t9 { font-size: 56rpx; }
.mh-hero-title.t11 { font-size: 52rpx; }

/* 暖光叠层：底部暖金 radial 提亮，对标 home-final.html */
.mh-hero-glow {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 55%;
  background: radial-gradient(120% 100% at 50% 100%, rgba(255, 176, 84, 0.3) 0%, rgba(255, 176, 84, 0) 60%);
  pointer-events: none;
  z-index: 1;
}
.mh-hero-sub {
  font-size: var(--fs-cap);
  color: rgba(255, 255, 255, 0.85);
  font-weight: 400;
}
.mh-hero-meta {
  display: flex;
  gap: 16rpx;
  margin-top: 10rpx;
  flex-wrap: wrap;
}
.mh-m {
  display: inline-flex;
  align-items: center;
  font-size: var(--fs-cap);
  font-weight: 500;
  color: rgba(255, 255, 255, 0.72);
}
.mh-m + .mh-m::before {
  content: "·";
  margin-right: 16rpx;
  opacity: 0.6;
}
.mh-hero-acts {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 18rpx;
  margin-top: 14rpx;
}
.mh-hero-add {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  border-radius: var(--r-pill);
  background: var(--pop);
  color: var(--c-surface);
  font-size: 29rpx;
  font-weight: 800;
  box-shadow: var(--sh-pop);
}
/* 换一道：圆形毛玻璃次按钮，与主按钮并排（决策动作同级，不再埋在文字链里） */
.mh-hero-shuffle {
  flex: none;
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  backdrop-filter: blur(8rpx);
}
.mh-ico-shuffle {
  position: relative;
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid var(--c-surface);
  border-left-color: transparent;
  border-radius: 50%;
  transform: rotate(-45deg);
}
/* 圆环缺口处的箭头 */
.mh-ico-shuffle::after {
  content: "";
  position: absolute;
  top: -4rpx;
  left: 50%;
  transform: translateX(-50%) rotate(-45deg);
  width: 0;
  height: 0;
  border-left: 9rpx solid transparent;
  border-right: 9rpx solid transparent;
  border-bottom: 14rpx solid var(--c-surface);
}
/* ============ SHEET ============ */
.mh-sheet {
  position: relative;
  margin-top: -50rpx;
  background: var(--paper);
  border-radius: 20rpx 20rpx 0 0;
  padding: 44rpx 0 186rpx;
  z-index: 20;
}
.mh-pad { padding: 0 46rpx; }

/* chips */
.mh-chips { width: 100%; white-space: nowrap; }
.mh-chips-inner {
  display: inline-flex;
  gap: 18rpx;
  padding: 0 46rpx 8rpx;
}

/* 家常菜横滑大卡 */
.mh-hcards { width: 100%; white-space: nowrap; }
.mh-hcards-inner {
  display: inline-flex;
  gap: 30rpx;
  padding: 4rpx 46rpx 12rpx;
}
/* 横滑槽：宽度交给 recipe-card density=home */
.mh-rcard-slot {
  flex: none;
  width: 404rpx;
}

/* 查看全部卡 */
.mh-seeall-card {
  flex: none;
  width: 250rpx;
  border-radius: var(--r-card);
  background: var(--paper-2);
  border: none;   /* 实底与旁边菜卡同层级，不再用虚线 */
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
}
.mh-sa-circle {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: var(--c-surface);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--sh-soft);
}
.mh-sa-t { font-size: 28rpx; font-weight: 800; color: var(--ink); }
.mh-sa-s { font-size: 22rpx; color: var(--mut-strong); font-weight: 600; }

/* + 图标（菜单暗卡等仍用） */
.mh-ico-plus, .mh-ico-plus-dark {
  position: relative;
  width: 32rpx;
  height: 32rpx;
}
.mh-ico-plus::before, .mh-ico-plus::after,
.mh-ico-plus-dark::before, .mh-ico-plus-dark::after {
  content: "";
  position: absolute;
  background: var(--c-surface);
  border-radius: 4rpx;
}
.mh-ico-plus::before, .mh-ico-plus-dark::before {
  left: 50%; top: 0; transform: translateX(-50%);
  width: 5rpx; height: 100%;
}
.mh-ico-plus::after, .mh-ico-plus-dark::after {
  top: 50%; left: 0; transform: translateY(-50%);
  width: 100%; height: 5rpx;
}
.mh-ico-plus-dark { width: 28rpx; height: 28rpx; }
.mh-ico-plus-dark::before, .mh-ico-plus-dark::after { background: var(--pop); }

/* 金色箭头 / hero 箭头 */
.mh-ico-arrow-gold {
  width: 22rpx;
  height: 22rpx;
  border-top: 4rpx solid var(--gold-deep);
  border-right: 4rpx solid var(--gold-deep);
  transform: rotate(45deg);
  border-radius: 2rpx;
}
/* ============ 今日菜单 暗卡 ============ */
.mh-menucard, .mh-empty-menu {
  margin-top: 50rpx;
}
.mh-mc-eyebrow {
  position: relative;
  z-index: 2;
  font-size: var(--fs-cap);
  letter-spacing: 1rpx;
  color: var(--gold);
  font-weight: 700;
}
/* 当前餐次小标签：跟随 slotbar 联动显示 */
.mh-mc-slot {
  display: inline-block;
  margin-left: 10rpx;
  padding: 4rpx 16rpx;
  font-size: var(--fs-mini);
  font-weight: 700;
  letter-spacing: 1rpx;
  color: var(--gold);
  border: 2rpx solid rgba(244, 217, 168, 0.45);
  border-radius: var(--r-pill);
  vertical-align: middle;
}
.mh-mc-title {
  position: relative;
  z-index: 2;
  font-size: 46rpx;
  font-weight: 900;
  margin-top: 10rpx;
  letter-spacing: -1rpx;
  color: var(--paper);
}
.mh-mc-names {
  position: relative;
  z-index: 2;
  font-size: var(--fs-sub);
  color: rgba(255, 255, 255, 0.78);
  font-weight: 600;
  margin-top: 14rpx;
}
.mh-mc-pile {
  position: relative;
  z-index: 2;
  display: flex;
  margin-top: 26rpx;
}
.mh-mc-d {
  width: 92rpx;
  height: 92rpx;
  border-radius: var(--r-md);
  border: 4rpx solid var(--ink-deep);
  margin-left: -22rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.25);
}
.mh-mc-d:first-child { margin-left: 0; }
.mh-mc-bot {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 34rpx;
  padding-top: 30rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.13);
}
.mh-mc-stats { display: flex; gap: 50rpx; }
.mh-mc-num {
  font-size: 46rpx;
  font-weight: 900;
  color: var(--paper);
  line-height: 1;
}
.mh-mc-u {
  font-size: var(--fs-cap);
  font-weight: 600;
  color: rgba(255, 255, 255, 0.6);
  margin-left: 4rpx;
}
.mh-mc-cap {
  font-size: var(--fs-mini);
  color: rgba(255, 255, 255, 0.6);
  letter-spacing: 1rpx;
  margin-top: 8rpx;
}
.mh-mc-go {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: var(--pop);
  color: var(--c-surface);
  font-size: 26rpx;
  font-weight: 800;
  padding: 22rpx 36rpx;
  border-radius: var(--r-pill);
  box-shadow: var(--sh-pop);
}
.mh-mc-empty-hint {
  font-size: var(--fs-sub);
  color: rgba(255, 255, 255, 0.6);
  font-weight: 600;
}

/* 首页局部覆盖：section eyebrow 去衬线斜体，中文更亲切（不影响其他页面的全局 .eyebrow）。
   暖橙金 eyebrow 文字，配中文实心标题，弱化原杂志冷调。 */
.mag-home .eyebrow {
  font-family: var(--sans);
  font-style: normal;
  letter-spacing: 0;
  color: var(--gold-deep);
}

/* ============ 家庭点菜：餐次选择器 + 许愿池 ============ */
.fp-slotbar {
  display: flex;
  gap: 14rpx;
  padding: 24rpx 46rpx 8rpx;
  background: var(--paper);
}
.fp-slot {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--mut-strong);
  background: var(--paper-2);
  border: 2rpx solid var(--c-border);
  border-radius: var(--r-pill);
}
.fp-slot.on {
  color: var(--c-surface);
  background: var(--ink-deep);
  border-color: var(--ink-deep);
}
.fp-slot-week {
  flex: none;
  padding: 0 20rpx;
  color: var(--gold-deep);
  background: transparent;
  border: none;   /* 跳转入口弱化为金色文字链，与前三个时段选择器区分语义 */
  font-weight: 700;
}

.fp-wish {
  position: relative;
  z-index: 21;
  margin: 16rpx 46rpx 24rpx;
  background: var(--c-surface);
  border: var(--bd-card);
  border-radius: var(--r-card);
  padding: 28rpx 28rpx 24rpx;
  box-shadow: var(--sh-card);
}
.fp-wish-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}
.fp-wish-eyebrow {
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: var(--gold-deep);
  margin-right: 14rpx;
}
.fp-wish-slot {
  font-size: 32rpx;
  font-weight: 900;
  color: var(--ink);
}
.fp-wish-add {
  height: 60rpx;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  border-radius: var(--r-pill);
  background: var(--pop);
  color: var(--c-surface);
  font-size: 24rpx;
  font-weight: 800;
  box-shadow: var(--sh-pop);
}
.fp-wish-list { display: flex; flex-direction: column; gap: 12rpx; }
.fp-wish-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 18rpx;
  background: var(--paper-2);
  border-radius: var(--r-md);
}
.fp-wish-text { flex: 1; min-width: 0; font-size: 28rpx; font-weight: 700; color: var(--ink); }
.fp-wish-by { font-size: 22rpx; color: var(--mut-strong); font-weight: 600; }
.fp-wish-del {
  width: 64rpx;   /* 适老触点 ≥64rpx（原 44rpx 偏小） */
  height: 64rpx;
  border-radius: 50%;
  background: var(--c-surface);
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; color: var(--mut);
  border: 2rpx solid var(--c-border);
}
.fp-wish-confirm {
  margin-top: 22rpx;
  min-height: 88rpx;
  padding: 12rpx 24rpx;
  border-radius: var(--r-pill);
  background: var(--ink-deep);
  color: var(--c-surface);
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.4;
  text-align: center;
  display: flex; align-items: center; justify-content: center;
  box-shadow: var(--sh-card);
}
.fp-wish-confirm.disabled {
  background: var(--line-deep);
  color: var(--c-surface);
  box-shadow: none;
}
/* 空态引导：许愿池为空时，弱化为虚线引导框，避免误导点击 */
.fp-wish-confirm.hint {
  background: var(--paper-2);
  color: var(--mut-strong);
  box-shadow: none;
  border: 2rpx dashed var(--line-deep);
  font-weight: 700;
}

/* ============ HERO 空态（杂志文字驱动）============ */
.mh-hero.mh-hero--empty {
  height: auto;
  overflow: visible;
  position: relative;
  padding: calc(env(safe-area-inset-top) + 48rpx) 36rpx 56rpx;
  background: var(--ink-deep);
}
.mh-hero--empty .mh-hero-img,
.mh-hero--empty .mh-hero-shade { display: none; }
.mh-empty-body {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 0;
}
.mh-hero--empty .mh-greet {
  margin-bottom: 40rpx;
}
.mh-hero--empty .mh-greet .mh-hi {
  color: var(--gold);
  font-size: 24rpx;
}
.mh-hero--empty .mh-greet .mh-name {
  color: var(--c-surface);
  font-size: 32rpx;
  font-weight: 700;
}
.mh-empty-eyebrow {
  font-family: var(--serif);
  font-style: italic;
  font-size: 24rpx;
  color: var(--gold);
  font-weight: 700;
  letter-spacing: 1rpx;
  margin-bottom: 12rpx;
}
.mh-empty-headline {
  font-size: 56rpx;
  font-weight: 900;
  color: var(--c-surface);
  line-height: 1.15;
  letter-spacing: -2rpx;
  margin-bottom: 16rpx;
}
.mh-empty-headline .pop { color: var(--pop); }
.mh-empty-sub {
  font-size: 26rpx;
  color: rgba(255,255,255,0.55);
  line-height: 1.55;
  margin-bottom: 36rpx;
}
.mh-empty-acts {
  display: flex;
  gap: 20rpx;
}
.mh-empty-go {
  display: inline-flex;
  align-items: center;
  padding: 20rpx 44rpx;
  border-radius: var(--r-pill);
  background: var(--pop);
  color: var(--c-surface);
  font-size: 28rpx;
  font-weight: 800;
  box-shadow: var(--sh-pop);
}

/* ============ 许愿弹窗（root-portal 渲染在页面根之外，不保证继承 page 变量；
   在此显式声明弹窗用到的全部 token 副本（色值 + 圆角 + 阴影 + 字号），
   内部统一 var() 引用，换肤只改此处。缺一个变量 = 该样式在弹窗里失效） ============ */
/* 注意：backdrop 与 modal 是 root-portal 下的兄弟节点，变量必须同时声明给两者 */
.wish-backdrop,
.wish-modal {
  --pop: #e8472a;
  --pop-soft: #fdece6;
  --pop-deep: #b3381f;
  --ink: #2c241b;
  --mut: #7a6e5d;
  --mut-2: #b3a795;
  --mut-strong: #6b5f50;
  --paper-2: #f0ebe2;
  --c-surface: #ffffff;
  --line: #e8e0d0;
  --line-light: #f1ece2;
  --r-sm: 16rpx;
  --r-md: 24rpx;
  --r-card: 16rpx;
  --r-pill: 999rpx;
  --sh-pop: 0 6rpx 16rpx rgba(232, 71, 42, 0.22);
  --fs-cap: 23rpx;
}
.wish-backdrop {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(20, 14, 8, 0.45);   /* 与全站 state-dialog 遮罩一致 */
  z-index: 9998;
}
.wish-modal {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 620rpx;
  background: var(--c-surface);
  border-radius: 40rpx;                 /* 对齐 state-dialog */
  overflow: hidden;
  box-shadow: 0 40rpx 100rpx rgba(30, 18, 8, 0.4), 0 8rpx 24rpx rgba(30, 18, 8, 0.2);
  animation: sdPop 0.35s cubic-bezier(0.2, 0.9, 0.3, 1.3) both;
  z-index: 9999;
}
@keyframes sdPop {
  from { opacity: 0; transform: translate(-50%, -50%) scale(0.9); }
  to { opacity: 1; transform: translate(-50%, -50%) scale(1); }
}
/* 头部：居中圆形图标（对齐 state-dialog 的 sd-ic）+ 标题 + 副标题 */
.wish-modal-hd {
  padding: 60rpx 52rpx 0;
  text-align: center;
}
.wish-modal-ic {
  width: 136rpx;
  height: 136rpx;
  margin: 0 auto 36rpx;
  border-radius: 50%;
  background: var(--pop-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}
.wish-modal-ic::after {
  content: "";
  position: absolute;
  inset: -14rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(232, 71, 42, 0.18);
}
.wish-modal-ic-glyph { font-size: 70rpx; font-weight: 900; line-height: 1; color: var(--pop); }
.wish-modal-title { font-size: 40rpx; font-weight: 900; color: var(--ink); letter-spacing: -1rpx; line-height: 1.25; }
.wish-modal-sub { margin-top: 14rpx; font-size: 28rpx; color: var(--mut-strong); line-height: 1.55; }
.wish-modal-bd { padding: 44rpx 52rpx 0; }
.wish-modal-input {
  width: 100%;
  box-sizing: border-box;
  height: 96rpx;
  padding: 0 28rpx;
  font-size: 29rpx;
  color: var(--ink);
  background: var(--paper-2);
  border: none;
  border-radius: 28rpx;   /* 对齐 state-dialog 按钮圆角 */
  transition: border-color .2s;
}
.wish-modal-input:focus,
.wish-modal-input-focus { border: 2rpx solid var(--pop); background: var(--c-surface); }
.wish-ph { color: var(--mut-2); }
/* 底部按钮：完全对齐 state-dialog（ghost 灰底 + danger 红底，100rpx 高） */
.wish-modal-ft {
  display: flex;
  gap: 22rpx;
  padding: 44rpx 44rpx 44rpx;
}
.wish-btn-cancel,
.wish-btn-ok {
  flex: 1;
  height: 100rpx;
  border-radius: 28rpx;
  font-size: 32rpx;
  font-weight: 800;
  letter-spacing: 0.6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.wish-btn-cancel { background: var(--paper-2); color: var(--ink-deep); }
.wish-btn-ok { background: var(--pop); color: var(--c-surface); box-shadow: 0 4rpx 8rpx rgba(180, 40, 20, 0.3), 0 20rpx 44rpx rgba(232, 71, 42, 0.4); }
.wish-btn-ok.off { opacity: 0.4; }

/* ============ SKELETON ============ */
.mh-skel { padding: 0 28rpx; }
.mh-skel-hero {
  width: 100%;
  height: 760rpx;
  border-radius: 0 0 var(--r-card) var(--r-card);
  background: var(--paper-2);
}
.mh-skel-slots {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}
.mh-skel-chip {
  width: 120rpx;
  height: 64rpx;
  border-radius: var(--r-chip);
  background: var(--paper-2);
}
.mh-skel-cards {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
  overflow: hidden;
}
.mh-skel-card {
  flex: none;
  width: 300rpx;
}
.mh-skel-cover {
  width: 100%;
  height: 280rpx;
  border-radius: var(--r-card);
  background: var(--paper-2);
}
.mh-skel-line {
  margin-top: 16rpx;
  height: 24rpx;
  border-radius: 12rpx;
  background: var(--paper-2);
  width: 80%;
}
.mh-skel-line.strong {
  width: 60%;
  height: 28rpx;
}


/* ===== 加载失败态：静态「碗」图示，禁止任何 spin/无限动画 ===== */
.mh-load-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-sizing: border-box;
}
.mh-load-error--full {
  min-height: 72vh;
  padding: calc(env(safe-area-inset-top) + 120rpx) 48rpx 120rpx;
  justify-content: center;
}
.mh-load-error--soft {
  padding: 72rpx 48rpx 40rpx;
  border-bottom: 2rpx solid var(--paper-2);
}
.mh-load-error-mark {
  position: relative;
  width: 128rpx;
  height: 128rpx;
  margin-bottom: 36rpx;
  border-radius: 50%;
  background: var(--pop-soft);
  display: flex;
  align-items: center;
  justify-content: center;
}
/* 静态碗形：下半圆弧 + 顶横线，绝无 animation */
.mh-load-error-cloud {
  width: 64rpx;
  height: 36rpx;
  border: 5rpx solid var(--pop);
  border-top: none;
  border-radius: 0 0 36rpx 36rpx;
  box-sizing: border-box;
  margin-top: 12rpx;
}
.mh-load-error-bolt {
  position: absolute;
  top: 36rpx;
  left: 50%;
  width: 48rpx;
  height: 5rpx;
  margin-left: -24rpx;
  border-radius: 3rpx;
  background: var(--pop);
}
.mh-load-error-title {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--ink-deep);
  letter-spacing: -0.5rpx;
}
.mh-load-error-desc {
  margin-top: 14rpx;
  max-width: 480rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: var(--mut-strong);
}
.mh-load-error-btn {
  margin-top: 44rpx;
  min-height: 88rpx;
  padding: 0 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-pill);
  background: var(--pop);
  color: var(--c-surface);
  font-size: var(--fs-btn);
  font-weight: 800;
  box-shadow: var(--sh-pop);
}
