<wxs src="/utils/cuisine.wxs" module="cuisine" />
<view class="mag-home {{fontScale === 'lg' ? 'font-lg' : ''}}">

  <!-- ============ SKELETON (loading) ============ -->
  <view class="mh-skel" wx:if="{{loading}}">
    <view class="mh-skel-hero shimmer"></view>
    <view class="mh-skel-slots">
      <view class="mh-skel-chip shimmer"></view>
      <view class="mh-skel-chip shimmer"></view>
      <view class="mh-skel-chip shimmer"></view>
    </view>
    <view class="mh-skel-cards">
      <view class="mh-skel-card" wx:for="{{[1,2,3]}}" wx:key="*this">
        <view class="mh-skel-cover shimmer"></view>
        <view class="mh-skel-line strong shimmer"></view>
        <view class="mh-skel-line shimmer"></view>
      </view>
    </view>
  </view>

  <!-- ============ LOAD ERROR ============ -->
  <view class="mh-load-error {{hasHomeData ? 'mh-load-error--soft' : 'mh-load-error--full'}}" wx:if="{{!loading && loadError}}">
    <!-- 整页错误态：与其它 13 个页面统一走 state-empty（原来是自己画「空碗」） -->
    <state-empty wx:if="{{!hasHomeData}}" type="offline" title="连不上厨房了" desc="网络开小差了，检查后再试一次" cta="重新加载" bind:action="loadAll" />
    <!-- 软提示（已有缓存数据、仅刷新失败）：保持紧凑行内样式 -->
    <block wx:else>
      <view class="mh-load-error-mark" aria-hidden="true">
        <view class="mh-load-error-cloud"></view>
        <view class="mh-load-error-bolt"></view>
      </view>
      <view class="mh-load-error-title">连不上厨房了</view>
      <view class="mh-load-error-desc">网络开小差了，检查后再试一次</view>
      <view class="mh-load-error-btn tap-scale" bindtap="loadAll">重新加载</view>
    </block>
  </view>

  <!-- ============ HERO ============ -->
  <view class="mh-hero g-fade-in" wx:if="{{!loading && !(loadError && !hasHomeData) && heroRecipe}}">
    <image class="mh-hero-img" src="{{heroRecipe.dishImg}}" mode="aspectFill" data-id="{{heroRecipe.id}}" bindtap="goDetail" binderror="onHeroImgError" />
    <view class="mh-hero-shade"></view>
    <view class="mh-hero-glow"></view>

    <view class="mh-hero-top" style="top: {{capsuleTop}}; right: {{capsuleRight}};">
      <view class="mh-greet">
        <view class="mh-hi">{{greeting}}</view>
        <view class="mh-name">{{currentUser.nickname || '朋友'}}，今晚想吃点啥</view>
      </view>
      <view class="tap-scale mh-iconbtns">
        <view class="tap-scale mh-iconbtn" catchtap="goShopping" aria-label="买菜">
          <view class="mh-ico-glyph">买</view>
          <view class="mh-cart-dot" wx:if="{{shoppingPending}}"></view>
        </view>
        <view class="tap-scale mh-iconbtn" catchtap="goRecipes" aria-label="菜谱库">
          <view class="mh-ico-glyph">谱</view>
        </view>
      </view>
    </view>

    <view class="tap-scale mh-hero-body g-fade-up g-d2" data-id="{{heroRecipe.id}}" bindtap="goDetail">
      <text class="mh-pill-tag">今晚主打</text>
      <view class="mh-hero-title title-stroke {{heroRecipe.titleClass}}">
        {{heroRecipe.title}}
      </view>
      <view class="mh-hero-sub">{{heroRecipe.summary || '今晚就安排它上桌'}}</view>
      <view class="mh-hero-meta">
        <view class="mh-m" wx:if="{{heroRecipe.timeCost}}">{{heroRecipe.timeCost}} 分钟</view>
        <view class="mh-m" wx:if="{{heroRecipe.servings}}">{{heroRecipe.servings}} 人份</view>
        <view class="mh-m">{{heroRecipe.cuisine || '家常'}}<block wx:if="{{heroRecipe.tasteTags[0]}}"> · {{heroRecipe.tasteTags[0]}}</block></view>
      </view>
      <view class="mh-hero-acts">
        <view class="mh-hero-add tap-scale" catchtap="addToToday" data-id="{{heroRecipe.id}}">加到菜单</view>
        <view class="mh-hero-shuffle tap-scale" catchtap="shuffleHero" aria-label="换一道">
          <view class="mh-ico-shuffle"></view>
          <text class="mh-shuffle-tx">换一道</text>
        </view>
      </view>
    </view>
  </view>

  <!-- Hero 空态：紧凑杂志风，文字驱动 -->
  <view class="mh-hero mh-hero--empty g-fade-in" wx:if="{{!loading && !(loadError && !hasHomeData) && !heroRecipe}}">
    <view class="mh-empty-body g-fade-up">
      <view class="mh-greet">
        <view class="mh-hi">{{greeting}}</view>
        <view class="mh-name">{{currentUser.nickname || '朋友'}}，今晚想吃点啥</view>
      </view>
      <text class="mh-empty-eyebrow">第一道菜</text>
      <view class="mh-empty-headline">从第一道菜<text class="pop">开始</text></view>
      <view class="mh-empty-sub">录入拿手菜，或导入收藏链接找灵感</view>
      <view class="mh-empty-acts">
        <view class="mh-empty-go tap-scale" bindtap="goRecipes">添加菜谱 ›</view>
      </view>
    </view>
  </view>

  <!-- ============ 餐次选择器 + 许愿池（冷启动全屏错误时隐藏） ============ -->
  <view class="fp-slotbar" wx:if="{{!loading && !(loadError && !hasHomeData)}}">
    <view
      wx:for="{{slots}}"
      wx:key="key"
      class="tap-scale fp-slot {{currentSlot === item.key ? 'on' : ''}}"
      data-slot="{{item.key}}"
      bindtap="selectSlot"
    >今日·{{item.label}}</view>
    <view class="tap-scale fp-slot fp-slot-week" bindtap="goWeek">本周 ›</view>
  </view>

  <!-- 许愿池：默认折叠一行，点击展开；避免低频功能占位（DEC-UI1） -->
  <view class="fp-wish {{wishExpanded ? 'expanded' : ''}}" wx:if="{{!loading && !(loadError && !hasHomeData)}}">
    <view class="tap-scale fp-wish-head fp-wish-head--toggle" bindtap="toggleWishExpand">
      <view class="fp-wish-title">
        <text class="fp-wish-eyebrow">许愿池</text>
        <text class="fp-wish-slot">{{currentSlot === 'breakfast' ? '今日早餐' : currentSlot === 'lunch' ? '今日午餐' : '今日晚餐'}}</text>
        <text class="fp-wish-count" wx:if="{{wishes.length}}">{{wishes.length}} 个心愿</text>
      </view>
      <view class="fp-wish-add tap-scale" wx:if="{{wishExpanded}}" catchtap="addWish">+ 我想吃</view>
      <view class="fp-wish-caret {{wishExpanded ? 'up' : ''}}" wx:else></view>
    </view>

    <block wx:if="{{wishExpanded}}">
      <view class="fp-wish-list" wx:if="{{wishes.length}}">
        <view class="fp-wish-item" wx:for="{{wishes}}" wx:key="id">
          <view class="fp-wish-text ellipsis">{{item.text}}</view>
          <view class="tap-scale fp-wish-pending" wx:if="{{!item.recipeId}}" catchtap="pickForWish" data-text="{{item.text}}" data-id="{{item.id}}" data-slot="{{item.slot}}">待挑菜 ›</view>
          <view class="fp-wish-by">{{item.by}}</view>
          <view class="fp-wish-del tap-scale" catchtap="removeWish" data-id="{{item.id}}">×</view>
        </view>
      </view>

      <view
        class="fp-wish-confirm tap-scale {{!canConfirm ? 'disabled' : (wishes.length ? '' : 'hint')}}"
        bindtap="{{wishes.length ? 'confirmMenu' : 'addWish'}}"
      >
        {{!canConfirm ? '等做饭人确认' : (wishes.length ? '去挑菜 → 加入菜单' : '＋ 先许个愿，家人一起点今晚的菜')}}
      </view>
    </block>
  </view>

  <!-- ============ SHEET ============ -->
  <view class="mh-sheet" wx:if="{{!loading && !(loadError && !hasHomeData)}}">

    <!-- 今日菜单 暗卡：提到首屏区域，进页第一眼看到（DEC-UI1） -->
    <view class="mh-pad">
      <view class="tap-scale mh-menucard card-dark g-fade-up g-d3" wx:if="{{slotMenu.length}}" bindtap="goMenu">
        <view class="deco-circle"></view>
        <view class="mh-mc-eyebrow">今天这一桌 <text class="mh-mc-slot">{{currentSlot === 'breakfast' ? '早餐' : currentSlot === 'lunch' ? '午餐' : '晚餐'}}</text></view>
        <view class="mh-mc-title">今日菜单</view>
        <view class="mh-mc-names ellipsis">
          <text wx:for="{{slotMenu}}" wx:key="recipeId" class="{{item.status === 'done' ? 'mh-mc-name-done' : ''}}">{{item.recipe.title || '一道菜'}}{{index < slotMenu.length - 1 ? ' · ' : ''}}</text>
        </view>
        <view class="mh-mc-pile">
          <image
            wx:for="{{slotMenu}}"
            wx:key="recipeId"
            wx:if="{{index < 4}}"
            class="mh-mc-d"
            src="{{item.dishImg}}"
            mode="aspectFill"
          />
        </view>
        <view class="mh-mc-bot">
          <view class="mh-mc-stats">
            <view class="mh-mc-stat">
              <view class="mh-mc-num">{{slotDoneCount ? slotDoneCount + '/' + slotMenu.length : slotMenu.length}}<text class="mh-mc-u">道</text></view>
              <view class="mh-mc-cap">{{slotDoneCount ? '已上桌' : '已点'}}</view>
            </view>
            <view class="mh-mc-stat">
              <view class="mh-mc-num">{{shoppingPending || 0}}<text class="mh-mc-u">样</text></view>
              <view class="mh-mc-cap">待买</view>
            </view>
          </view>
          <view class="mh-mc-acts">
            <view class="mh-mc-go2 tap-scale" catchtap="goShopping">买菜</view>
            <view class="mh-mc-go tap-scale" catchtap="goCook">{{cookLabel}}</view>
          </view>
        </view>
      </view>

      <!-- 空态 1：当前餐次还没点菜（但全天有其他餐次） -->
      <view class="mh-empty-menu card-dark g-fade-up g-d3 tap-dim" wx:elif="{{todayMenu.length}}" catchtap="goRecipes">
        <view class="deco-circle"></view>
        <view class="mh-mc-eyebrow">今天这一桌</view>
        <view class="mh-mc-title">{{currentSlot === 'breakfast' ? '早餐' : currentSlot === 'lunch' ? '午餐' : '晚餐'}}还没点菜</view>
        <view class="mh-mc-names">从下面挑几道，凑齐今晚的桌</view>
        <view class="mh-mc-bot">
          <view class="mh-mc-empty-hint">看中哪道，点 ＋ 上桌</view>
          <view class="mh-mc-go tap-scale" catchtap="goRecipes">逛菜谱 ›</view>
        </view>
      </view>

      <!-- 空态 2：全天都没成单 -->
      <view class="mh-empty-menu card-dark g-fade-up g-d3 tap-dim" wx:else catchtap="goRecipes">
        <view class="deco-circle"></view>
        <view class="mh-mc-eyebrow">今天这一桌</view>
        <view class="mh-mc-title">还没点菜</view>
        <view class="mh-mc-names">从下面挑几道，凑齐今晚的桌</view>
        <view class="mh-mc-bot">
          <view class="mh-mc-empty-hint">看中哪道，点 ＋ 上桌</view>
          <view class="mh-mc-go tap-scale" catchtap="goRecipes">逛菜谱 ›</view>
        </view>
      </view>
    </view>

    <!-- 菜系 chips -->
    <scroll-view scroll-x class="mh-chips" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view class="mh-chips-inner">
        <view
          wx:for="{{cuisineTiles}}"
          wx:key="key"
          class="chip tap-scale {{activeCuisine === item.key ? 'on' : ''}}"
          data-cuisine="{{item.key}}"
          bindtap="selectCuisine"
        >{{item.label}}</view>
      </view>
    </scroll-view>

    <!-- 家里常做的菜 -->
    <view class="mh-pad">
      <section-head
        eyebrow="家的味道"
        title="家里"
        popPart="常做"
        titleTail="的菜"
        hint="全部"
        more="{{true}}"
        bind:tapmore="goRecipes"
      />
    </view>

    <scroll-view scroll-x class="mh-hcards" enhanced="{{true}}" show-scrollbar="{{false}}" wx:if="{{visibleRecipes.length}}">
      <view class="mh-hcards-inner">
        <view
          class="mh-rcard-slot {{revealOn ? (reveal[index] ? 'g-fade-up' : 'rv-hold') : 'g-fade-up g-d' + (index % 4 + 1)}}"
          data-rv="{{index}}"
          wx:for="{{visibleRecipes}}"
          wx:key="id"
        >
          <recipe-card
            recipe="{{item}}"
            variant="card"
            density="home"
            showAdd="{{true}}"
            showFav="{{false}}"
            addPlacement="corner"
            bind:tap="goDetail"
            bind:add="addToToday"
          />
        </view>

        <!-- 查看全部卡 -->
        <view class="mh-seeall-card tap-scale" bindtap="goRecipes">
          <view class="mh-sa-circle"><view class="mh-ico-arrow-gold"></view></view>
          <view class="mh-sa-t">查看全部</view>
          <view class="mh-sa-s">{{allRecipes.length}} 道菜谱</view>
        </view>
      </view>
    </scroll-view>

    <!-- 全空兜底 -->
    <state-empty
      wx:if="{{!heroRecipe && !visibleRecipes.length && !loading}}"
      type="pop"
      title="还没有菜谱"
      cta="去添加菜谱"
      bind:action="goRecipes"
    />

    <view class="safe-bottom"></view>
  </view>
</view>

<!-- ============ 自定义许愿弹窗（root-portal 保证脱离页面层级） ============ -->
<root-portal wx:if="{{showWishModal}}">
  <view class="wish-backdrop {{theme === 'dark' ? 'is-dark' : ''}}" catchtap="closeWishModal" catchtouchmove="noopScroll"></view>
  <view class="wish-modal {{theme === 'dark' ? 'is-dark' : ''}}" catchtouchmove="noopScroll">
    <view class="wish-modal-hd">
      <view class="wish-modal-ic">
        <text class="wish-modal-ic-glyph">味</text>
      </view>
      <view class="wish-modal-title">今晚想吃什么？</view>
      <view class="wish-modal-sub">写下来，家人都能看到</view>
    </view>
    <view class="wish-modal-bd">
      <input
        class="wish-modal-input"
        placeholder="番茄炒蛋、红烧排骨…"
        placeholder-class="wish-ph"
        value="{{wishInput}}"
        bindinput="onWishInput"
        bindconfirm="confirmWish"
        focus="{{showWishModal}}"
        maxlength="30"
        confirm-type="done"
      />
    </view>
    <view class="wish-modal-ft">
      <view class="wish-btn-cancel tap-scale" catchtap="closeWishModal">算了</view>
      <view class="wish-btn-ok tap-scale {{wishInput ? '' : 'off'}}" catchtap="confirmWish">许愿 ✦</view>
    </view>
  </view>
</root-portal>
