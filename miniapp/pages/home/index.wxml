<wxs src="/utils/cuisine.wxs" module="cuisine" />
<view class="mag-home {{fontScale === 'lg' ? 'font-lg' : ''}}">

  <view class="hm-scroll-nav" wx:if="{{navSolid}}">
    <nav-bar title="今日点菜" show-back="{{false}}"></nav-bar>
  </view>

  <!-- ============ SKELETON (loading) ============ -->
  <view class="mh-skel" wx:if="{{loading}}">
    <view class="mh-skel-hero shimmer"></view>
    <view class="mh-skel-slots">
      <view class="mh-skel-chip shimmer"></view>
      <view class="mh-skel-chip shimmer"></view>
      <view class="mh-skel-chip shimmer"></view>
    </view>
    <view class="mh-skel-cards">
      <view class="mh-skel-card" wx:for="{{[1,2,3]}}" wx:key="*this">
        <view class="mh-skel-cover shimmer"></view>
        <view class="mh-skel-line strong shimmer"></view>
        <view class="mh-skel-line shimmer"></view>
      </view>
    </view>
  </view>

  <!-- ============ LOAD ERROR ============ -->
  <view class="mh-load-error {{hasHomeData ? 'mh-load-error--soft' : 'mh-load-error--full'}}" wx:if="{{!loading && loadError}}">
    <!-- 整页错误态：与其它 13 个页面统一走 state-empty（原来是自己画「空碗」） -->
    <state-empty wx:if="{{!hasHomeData}}" type="offline" title="连不上厨房了" desc="网络开小差了，检查后再试一次" cta="重新加载" bind:action="loadAll" />
    <!-- 软提示（已有缓存数据、仅刷新失败）：保持紧凑行内样式 -->
    <block wx:else>
      <view class="mh-load-error-mark" aria-hidden="true">
        <view class="mh-load-error-cloud"></view>
        <view class="mh-load-error-bolt"></view>
      </view>
      <view class="mh-load-error-title">连不上厨房了</view>
      <view class="mh-load-error-desc">网络开小差了，检查后再试一次</view>
      <view class="mh-load-error-btn tap-scale" bindtap="loadAll">重新加载</view>
    </block>
  </view>

  <!-- ============ HERO ============ -->
  <view class="mh-hero g-fade-in" wx:if="{{!loading && !(loadError && !hasHomeData) && heroRecipe}}">
    <image class="mh-hero-img" src="{{heroRecipe.dishImg}}" mode="aspectFill" data-id="{{heroRecipe.id}}" bindtap="goDetail" binderror="onHeroImgError" />
    <view class="mh-hero-shade"></view>
    <view class="mh-hero-glow"></view>

    <view class="mh-hero-top" style="top: {{capsuleTop}}; right: {{capsuleRight}};">
      <view class="mh-name">{{currentUser.nickname || '家人'}}，今天想吃点啥</view>
    </view>

    <view class="tap-scale mh-hero-body g-fade-up g-d2" data-id="{{heroRecipe.id}}" bindtap="goDetail">
      <text class="mh-pill-tag">今日推荐</text>
      <view class="mh-hero-title title-stroke {{heroRecipe.titleClass}}">
        {{heroRecipe.title}}
      </view>
      <view class="mh-hero-sub">{{heroRecipe.summary || '就安排它上桌'}}</view>
      <view class="mh-hero-meta"><block wx:if="{{heroRecipe.timeCost}}">{{heroRecipe.timeCost}} 分钟 · </block><block wx:if="{{heroRecipe.servings}}">{{heroRecipe.servings}} 人份 · </block>{{heroRecipe.tasteTags[0] || heroRecipe.cuisine || '家常'}}</view>
      <view class="mh-hero-acts">
        <view class="mh-hero-add tap-scale {{pickedRecipeIds[heroRecipe.id] ? 'is-picked' : ''}}" catchtap="{{pickedRecipeIds[heroRecipe.id] ? 'goMenu' : 'addToToday'}}" data-id="{{heroRecipe.id}}" aria-role="button" aria-label="{{pickedRecipeIds[heroRecipe.id] ? '这道菜已点，查看今日菜单' : '把' + heroRecipe.title + '加入当前餐次'}}">{{pickedRecipeIds[heroRecipe.id] ? '已点 · 看菜单' : '加入' + (currentSlot === 'breakfast' ? '早餐' : currentSlot === 'lunch' ? '午餐' : '晚餐')}}</view>
        <view class="mh-hero-shuffle tap-scale" catchtap="shuffleHero" aria-role="button" aria-label="换一道">
          <view class="mh-ico-shuffle"></view>
          <text class="mh-shuffle-tx">换一道</text>
        </view>
      </view>
    </view>
  </view>

  <!-- Hero 空态：紧凑杂志风，文字驱动。
       必须 !loadError：菜谱接口挂了但别的接口成功时（hasHomeData 仍为 true），
       这里若照常渲染，就会对"其实有菜谱、只是没网"的用户说"录入拿手菜/从第一道菜开始"，
       把网络故障谎报成空数据。 -->
  <view class="mh-hero mh-hero--empty g-fade-in" wx:if="{{!loading && !loadError && !heroRecipe}}">
    <view class="mh-empty-body g-fade-up">
      <view class="mh-greet">
        <view class="mh-name">{{currentUser.nickname || '家人'}}，今天想吃点啥</view>
      </view>
      <view class="mh-empty-headline">从第一道菜开始</view>
      <view class="mh-empty-sub">录入拿手菜，或导入收藏链接找灵感</view>
      <view class="mh-empty-acts">
        <view class="mh-empty-go tap-scale" bindtap="goRecipes" aria-role="button" aria-label="添加菜谱">添加菜谱 ›</view>
      </view>
    </view>
  </view>

  <!-- ============ SHEET ============ -->
  <view class="mh-sheet" wx:if="{{!loading && !(loadError && !hasHomeData)}}">

    <!-- 餐次：轻量分段，和菜单页的分段同一做法 -->
    <view class="fp-slotbar" aria-role="tablist">
      <view
        wx:for="{{slots}}"
        wx:key="key"
        class="tap-scale fp-slot {{currentSlot === item.key ? 'on' : ''}}"
        data-slot="{{item.key}}"
        bindtap="selectSlot"
        aria-role="tab"
        aria-label="{{item.label}}餐"
        aria-selected="{{currentSlot === item.key}}"
      >{{item.label}}餐</view>
    </view>

    <!-- 当前餐次：家庭菜单与厨房动作 -->
    <view class="mh-pad hm-menu-wrap">
      <view class="hm-menu-card {{menuReady ? 'is-ready' : ''}}" wx:if="{{slotMenu.length}}">
        <view class="hm-menu-head">
          <view class="hm-menu-heading">
            <view class="hm-menu-eyebrow">今天这一桌</view>
            <view class="hm-menu-title">{{slotMenu.length}} 道菜<text class="hm-menu-title-progress"> · {{slotDoneCount}} 道已上桌</text></view>
          </view>
          <view class="hm-menu-open tap-scale" bindtap="goMenu" aria-role="button" aria-label="查看完整菜单">完整菜单 ›</view>
        </view>

        <view class="hm-menu-summary">
          <view class="hm-menu-progress" aria-role="progressbar" aria-label="上桌进度" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{menuProgress}}">
            <view class="hm-menu-progress-fill" style="width: {{menuProgress}}%;"></view>
          </view>
        </view>
        <view class="hm-menu-actions">
          <view class="hm-menu-action-secondary tap-scale" bindtap="goShopping" aria-role="button" aria-label="买食材，买菜清单待买 {{shoppingPending || 0}} 样">
            <image class="hm-menu-action-icon" src="/assets/icons/lucide/shopping-basket.svg" mode="aspectFit" aria-hidden="true" />
            <text>买食材</text>
            <text class="hm-menu-shopping-count" wx:if="{{shoppingPending > 0}}">{{shoppingPending}}</text>
          </view>
          <view class="hm-menu-action-primary tap-scale" bindtap="{{menuReady ? 'goCookLog' : 'goCook'}}" aria-role="button" aria-label="{{cookLabel}}">
            <image class="hm-menu-action-icon" src="{{menuReady ? '/assets/icons/lucide/book-open.svg' : '/assets/icons/lucide/cooking-pot.svg'}}" mode="aspectFit" aria-hidden="true" />
            <text>{{cookLabel}}</text>
          </view>
        </view>

        <view class="hm-menu-list">
          <view class="hm-menu-row tap-scale" wx:for="{{homeMenuItems}}" wx:key="recipeId" data-id="{{item.recipeId}}" bindtap="goDetail" aria-role="button" aria-label="{{item.title}}，{{item.statusLabel}}，查看菜谱">
            <image class="hm-menu-thumb" src="{{item.dishImg}}" mode="aspectFill" data-index="{{index}}" binderror="onMenuImgError" aria-hidden="true" />
            <view class="hm-menu-copy">
              <view class="hm-menu-mainline">
                <text class="hm-menu-dish-title">{{item.title}}</text>
                <text class="hm-status hm-status--{{item.statusClass}}">{{item.statusLabel}}</text>
              </view>
              <view class="hm-menu-byline" wx:if="{{item.addedByName}}">{{item.addedByName}} 点的</view>
            </view>
          </view>
        </view>

        <view class="hm-menu-more tap-scale" wx:if="{{menuMoreCount}}" bindtap="goMenu" aria-role="button" aria-label="另有{{menuMoreCount}}道菜，查看完整菜单">另有 {{menuMoreCount}} 道菜 · 查看完整菜单 ›</view>

        <view class="hm-pick-tools">
          <view class="hm-pick-tool btn-text tap-scale" bindtap="goRandomPick" aria-role="button" aria-label="随机点菜，先预览再加入当前餐次">
            <image src="/assets/icons/lucide/sparkles.svg" mode="aspectFit" aria-hidden="true" /><text>随机点菜</text>
          </view>
          <view class="hm-pick-tool btn-text tap-scale" bindtap="goPantryPick" aria-role="button" aria-label="随机挑选冰箱能做的菜">
            <image src="/assets/icons/lucide/refrigerator.svg" mode="aspectFit" aria-hidden="true" /><text>冰箱能做</text>
          </view>
        </view>
      </view>

      <view class="hm-menu-card hm-menu-empty" wx:else>
        <view class="hm-menu-empty-top">
          <view class="hm-menu-empty-copy">
            <view class="hm-menu-eyebrow">今天这一桌</view>
            <view class="hm-menu-title">还没点菜</view>
            <view class="hm-menu-empty-note">{{todayMenu.length ? '其他餐次已安排 ' + todayMenu.length + ' 道菜' : '从菜谱里挑，或让它随机配一桌'}}</view>
          </view>
          <image class="hm-menu-empty-plate" src="/assets/icons/empty-table.svg" mode="aspectFit" aria-hidden="true" />
        </view>
        <view class="hm-menu-action-primary hm-menu-pick tap-scale" bindtap="goRecipes" aria-role="button" aria-label="去挑菜">
          <image class="hm-menu-action-icon" src="/assets/icons/lucide/utensils.svg" mode="aspectFit" aria-hidden="true" />
          <text>去挑菜</text>
        </view>
        <view class="hm-pick-tools">
          <view class="hm-pick-tool btn-text tap-scale" bindtap="goRandomPick" aria-role="button" aria-label="随机点菜，先预览再加入当前餐次">
            <image src="/assets/icons/lucide/sparkles.svg" mode="aspectFit" aria-hidden="true" /><text>随机点菜</text>
          </view>
          <view class="hm-pick-tool btn-text tap-scale" bindtap="goPantryPick" aria-role="button" aria-label="随机挑选冰箱能做的菜">
            <image src="/assets/icons/lucide/refrigerator.svg" mode="aspectFit" aria-hidden="true" /><text>冰箱能做</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 家人许愿：放在菜单与流程之后，默认保持紧凑 -->
    <view class="fp-wish {{wishExpanded ? 'expanded' : ''}}">
      <view class="fp-wish-head">
        <view class="tap-scale fp-wish-head--toggle" bindtap="toggleWishExpand" aria-role="button" aria-expanded="{{wishExpanded}}" aria-label="家人心愿，{{wishExpanded ? '收起' : '展开'}}">
          <view class="fp-wish-title">
            <view class="fp-wish-eyebrow">家人心愿</view>
            <view class="fp-wish-meta">
              <text class="fp-wish-count" wx:if="{{wishes.length}}">{{wishes.length}} 个心愿</text>
              <text class="fp-wish-count" wx:else>一起决定吃什么</text>
            </view>
          </view>
          <view wx:if="{{wishes.length}}" class="fp-wish-caret {{wishExpanded ? 'up' : ''}}" aria-hidden="true"></view>
        </view>
        <view class="fp-wish-add tap-scale" catchtap="addWish" aria-role="button" aria-label="添加想吃的菜">+ 我想吃</view>
      </view>

      <view class="fp-wish-preview tap-scale" wx:if="{{!wishExpanded && wishes.length}}" bindtap="toggleWishExpand" aria-role="button" aria-label="{{wishes[0].by || '家人'}}想吃{{wishes[0].text}}，展开家人心愿">
        <view class="fp-wish-avatar" aria-hidden="true">{{wishes[0].by ? wishes[0].by[0] : '家'}}</view>
        <view class="fp-wish-preview-copy">
          <view class="fp-wish-preview-dish">{{wishes[0].text}}</view>
          <view class="fp-wish-preview-by ellipsis">{{wishes[0].by || '家人'}} 想吃</view>
        </view>
        <text class="fp-wish-preview-rest" wx:if="{{wishes.length > 1}}">+{{wishes.length - 1}}</text>
      </view>

      <block wx:if="{{wishExpanded}}">
        <view class="fp-wish-list" wx:if="{{wishes.length}}">
          <view class="fp-wish-item" wx:for="{{wishes}}" wx:key="id">
            <view class="fp-wish-item-copy">
              <view class="fp-wish-avatar" aria-hidden="true">{{item.by ? item.by[0] : '家'}}</view>
              <view class="fp-wish-text">{{item.text}}</view>
            </view>
            <view class="fp-wish-item-meta">
              <view class="fp-wish-by ellipsis">{{item.by || '家人'}}</view>
              <view class="tap-scale fp-wish-pending" wx:if="{{!item.recipeId}}" catchtap="pickForWish" data-text="{{item.text}}" data-id="{{item.id}}" data-slot="{{item.slot}}" aria-role="button" aria-label="为{{item.text}}挑选菜谱">挑菜谱 ›</view>
              <text class="fp-wish-linked" wx:else>已选菜谱</text>
              <view class="fp-wish-more tap-scale" catchtap="openWishActions" data-id="{{item.id}}" aria-role="button" aria-label="{{item.text}}的更多操作">···</view>
            </view>
          </view>
        </view>

        <view
          class="fp-wish-confirm tap-scale {{!canConfirm ? 'disabled' : (wishes.length ? '' : 'hint')}}"
          bindtap="{{wishes.length ? 'confirmMenu' : 'addWish'}}"
        >
          {{!canConfirm ? '等管理员确认' : (wishes.length ? '去挑菜' : '＋ 先许个愿，家人一起点今晚的菜')}}
        </view>
      </block>
    </view>

    <!-- 推荐区：先标题，再筛选与菜谱 -->
    <view class="mh-pad hm-recipes-head">
      <section-head
        title="家里"
        popPart="常做"
        titleTail="的菜"
        hint="全部"
        more="{{true}}"
        bind:tapmore="goRecipes"
      />
    </view>

    <view class="hm-recipe-search">
      <image class="hm-search-icon" src="/assets/icons/lucide/search.svg" mode="aspectFit" aria-hidden="true" />
      <input class="hm-search-input" value="{{homeSearchText}}" bindinput="onHomeSearchInput" bindconfirm="searchRecipes" confirm-type="search" placeholder="搜菜名、菜系、口味" placeholder-class="hm-search-placeholder" aria-label="搜索家常菜谱" />
      <view class="hm-search-submit tap-scale" bindtap="searchRecipes" aria-role="button" aria-label="搜索菜谱">搜索</view>
    </view>

    <!-- 菜系 chips -->
    <scroll-view scroll-x class="mh-chips" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view class="mh-chips-inner">
        <view
          wx:for="{{cuisineTiles}}"
          wx:key="key"
          class="chip tap-scale {{activeCuisine === item.key ? 'on' : ''}}"
          data-cuisine="{{item.key}}"
          bindtap="selectCuisine"
          aria-role="button"
          aria-label="筛选{{item.label}}菜谱"
          aria-pressed="{{activeCuisine === item.key}}"
        >{{item.label}}</view>
      </view>
    </scroll-view>

    <scroll-view scroll-x class="mh-hcards" enhanced="{{true}}" show-scrollbar="{{false}}" wx:if="{{visibleRecipes.length}}">
      <view class="mh-hcards-inner">
        <view
          class="mh-rcard-slot {{revealOn ? (reveal[index] ? 'g-fade-up' : 'rv-hold') : 'g-fade-up g-d' + (index % 4 + 1)}}"
          data-rv="{{index}}"
          wx:for="{{visibleRecipes}}"
          wx:key="id"
        >
          <recipe-card
            recipe="{{item}}"
            variant="card"
            density="home"
            showAdd="{{true}}"
            showFav="{{false}}"
            addPlacement="corner"
            selected="{{!!pickedRecipeIds[item.id]}}"
            bind:tap="goDetail"
            bind:add="addToToday"
          />
        </view>

        <!-- 查看全部卡 -->
        <view class="mh-seeall-card tap-scale" bindtap="goRecipes">
          <view class="mh-sa-circle"><view class="mh-ico-arrow-gold"></view></view>
          <view class="mh-sa-t">查看全部</view>
          <view class="mh-sa-s">{{allRecipeCount}} 道菜谱</view>
        </view>
      </view>
    </scroll-view>

    <!-- 全空兜底 -->
    <state-empty
      wx:if="{{!heroRecipe && !visibleRecipes.length && !loading}}"
      type="pop"
      title="还没有菜谱"
      cta="去添加菜谱"
      bind:action="goRecipes"
    />

    <view class="safe-bottom"></view>
  </view>
</view>

<!-- ============ 自定义许愿弹窗（root-portal 保证脱离页面层级） ============ -->
<root-portal wx:if="{{showWishModal}}">
  <view class="wish-backdrop {{theme === 'dark' ? 'is-dark' : ''}}" catchtap="closeWishModal" catchtouchmove="noopScroll"></view>
  <view class="wish-modal {{theme === 'dark' ? 'is-dark' : ''}}" catchtouchmove="noopScroll">
    <view class="wish-modal-hd">
      <view class="wish-modal-ic">
        <text class="wish-modal-ic-glyph">味</text>
      </view>
      <view class="wish-modal-title">{{wishEditId ? '改一下这个心愿' : heroMealWord + '想吃什么？'}}</view>
      <view class="wish-modal-sub">{{wishEditId ? '改完家里人都能看到新文案' : '写下来，家人都能看到'}}</view>
    </view>
    <view class="wish-modal-bd">
      <input
        class="wish-modal-input"
        placeholder="番茄炒蛋、红烧排骨…"
        placeholder-class="wish-ph"
        value="{{wishInput}}"
        bindinput="onWishInput"
        bindconfirm="confirmWish"
        focus="{{showWishModal}}"
        maxlength="30"
        confirm-type="done"
      />
    </view>
    <view class="wish-modal-ft">
      <view class="wish-btn-cancel tap-scale" catchtap="closeWishModal" aria-role="button">{{wishEditId ? '不改了' : '算了'}}</view>
      <view class="wish-btn-ok tap-scale {{wishInput ? '' : 'off'}}" catchtap="confirmWish" aria-role="button" aria-disabled="{{!wishInput}}">{{wishEditId ? (wishEditing ? '保存中…' : '保存 ✓') : '许愿 ✦'}}</view>
    </view>
  </view>
</root-portal>
