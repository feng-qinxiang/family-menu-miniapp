/* ============================================================
   pages/me · 杂志撞色「家庭厨房档案」· 对标 me-final.html
   全局 token/工具类见 app.wxss，本文件只写页面专属布局
   px→rpx ×1.923（设计稿 390px 宽）
   ============================================================ */
.me-mag {
  padding: 0 0 calc(var(--tabbar-h) + 40rpx);   /* 同首页：原来 186rpx 不含安全区 */
  background: var(--paper);
}

/* ---------- 紧凑页头里的家庭身份（.cpt-head 本体在 app.wxss） ---------- */
/* 家庭名是用户自己起的，可能很长：最多两行，不截成一行省略号 */
.mag-fam-name {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  word-break: break-all;
}
.mag-fam {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  min-height: var(--ava-cmt);   /* 首屏加载时行是空的，留高度防数据回来跳一下 */
}
.mag-ava {
  width: var(--ava-cmt);
  height: var(--ava-cmt);
  margin-left: -18rpx;
  border-radius: calc(var(--ava-cmt) * var(--r-ava));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: calc(var(--ava-cmt) * var(--ava-glyph) * var(--fs-mul, 1));
  font-weight: 800;
  color: var(--anchor-contrast);
  border: 4rpx solid var(--paper);   /* 堆叠描边取纸色，深色模式随 token 翻转 */
}
.mag-ava:first-child { margin-left: 0; }
.mavt-a { background: linear-gradient(135deg, var(--cat-gold), var(--gold-deep)); color: var(--ink-deep); }
.mavt-b { background: var(--cat-brown); }
.mavt-c { background: var(--pine); }
.mavt-d { background: var(--cat-purple); }
.mavt-e { background: var(--c-info); }
.mag-fam-lbl {
  margin-left: 20rpx;
  font-size: var(--fs-sub);
  color: var(--mut);
}
.mag-fam-lbl .b { color: var(--ink); font-weight: 800; }
/* 「＋ 管理」：次级操作，墨色描边胶囊（番茄红留给本屏主操作「去登录」）；
   视觉 64rpx 高，::after 把热区撑到 88rpx */
.mag-manage {
  position: relative;
  font-size: var(--fs-sub);
  font-weight: 700;
  line-height: 60rpx;
  padding: 0 26rpx;
  color: var(--ink);
  border: 2rpx solid var(--line-deep);
  border-radius: var(--r-pill);
}
.mag-manage::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  height: 88rpx;
  margin-top: -44rpx;
}

/* ---------- 内容区 ---------- */
.mag-sheet {
  padding: 8rpx var(--ctl-x, 48rpx) 0;
}

/* ---------- VIP banner ---------- */
.mag-vip {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx var(--pad-card);
  border-radius: var(--r-card);
  background: linear-gradient(120deg, var(--pop-deep) 0%, var(--pop) 100%);
  box-shadow: var(--sh-soft);
}
.mag-vip-ic {
  width: 80rpx;
  height: 80rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-md);
  background: rgba(255, 255, 255, 0.18);
  color: var(--anchor-contrast);
}
/* VIP 入口：几何星，不用 emoji ★ */
.mag-vip-glyph {
  width: 28rpx;
  height: 28rpx;
  background: var(--c-surface);
  clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
}
.mag-vip-mid { flex: 1; min-width: 0; }
.mag-vip-t { font-size: calc(28rpx * var(--fs-mul, 1)); font-weight: 800; color: var(--anchor-contrast); }
.mag-vip-t .hl { color: var(--gold); }
.mag-vip-s { margin-top: 6rpx; font-size: var(--fs-mini); color: rgba(255, 255, 255, 0.7); }
.mag-vip-go {
  flex: none;
  font-size: var(--fs-cap);
  font-weight: 800;
  color: var(--pop-deep);
  background: var(--c-surface);
  padding: 15rpx 26rpx;
  border-radius: var(--r-pill);
}

/* ---------- 数据卡 ---------- */
.mag-stats {
  display: flex;
  gap: 22rpx;
  margin-top: 34rpx;
}
.mag-stat {
  flex: 1;
  background: var(--c-surface);
  border-radius: var(--r-card);   /* 统计卡回到全站卡片标准 16rpx */
  padding: 30rpx var(--pad-card-sm);
  border: var(--bd-card);
  box-shadow: var(--sh-raised);
}
.mag-snum {
  font-size: var(--fs-stat);
  font-weight: 900;
  color: var(--ink);
  letter-spacing: -2rpx;
  line-height: 1;
}
.mag-snum.num-skel {
  width: 84rpx;
  height: 48rpx;
  border-radius: 14rpx;
  background: var(--skeleton);
  margin: 0 auto;
  color: transparent;
}
/* 列表骨架（最近上桌 / 口味偏好加载态） */
.mag-skel-thumb {
  /* 骨架必须和它替身的那张卡同尺寸，否则数据回来时整行会跳一下。
     原来是 96rpx 而真卡是 120rpx——差 24rpx，实测加载完会看到明显的位移。
     两处一起收敛到紧凑行图块规格 --tile-row-sm(104rpx)。 */
  width: var(--tile-row-sm);
  height: var(--tile-row-sm);
  border-radius: var(--r-chip);   /* = 真卡 .mag-thumb 的圆角，原来骨架是 --r-md(24)、真卡 30 */
  background: var(--skeleton);
  flex: none;
}
.mag-skel-line {
  height: 26rpx;
  border-radius: 12rpx;
  background: var(--skeleton);
  margin-top: 14rpx;
  width: 70%;
}
.mag-skel-line.strong { height: 30rpx; width: 45%; margin-top: 0; }
.mag-skel-bar {
  height: 22rpx;
  border-radius: 11rpx;
  background: var(--skeleton);
  margin-top: 16rpx;
  width: 100%;
}
.mag-scap {
  margin-top: 14rpx;
  font-size: var(--fs-mini);
  font-weight: 600;
  color: var(--mut);
  white-space: nowrap;
}
/* 统计卡补充说明：只留有信息量的（如「自建+导入」），和标题重复的不写 */
.mag-scap-note {
  margin-top: 4rpx;
  font-size: var(--fs-tiny);
  color: var(--mut);
}

/* ---------- 最近上桌 ---------- */
.mag-history { padding: 12rpx 34rpx; }
.mag-hrow {
  display: flex;
  align-items: center;
  gap: 26rpx;
  padding: 25rpx 0;
  border-bottom: 2rpx solid var(--paper-2);
}
.mag-thumb {
  width: var(--tile-row-sm);
  height: var(--tile-row-sm);
  border-radius: var(--r-chip);
  flex: none;
  background: var(--paper-2);
}
.mag-hmid { flex: 1; min-width: 0; }
.mag-hname { font-size: calc(32rpx * var(--fs-mul, 1)); font-weight: 800; color: var(--ink); letter-spacing: -0.5rpx; }
.mag-hsub { margin-top: 9rpx; font-size: var(--fs-cap); color: var(--mut); }
.mag-stars { display: flex; gap: 4rpx; flex: none; }
.mag-star { font-size: var(--fs-cap); color: var(--line-deep); }
.mag-star.on { color: var(--gold-deep); }
.mag-hmore {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 27rpx 0;
  font-size: var(--fs-sub);
  font-weight: 800;
  color: var(--gold-deep);
}

/* ---------- 厨房工具 ---------- */
.mag-tools { padding: 8rpx 34rpx; }
.mag-trow {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 28rpx 0;
  border-bottom: 2rpx solid var(--paper-2);
}
.mag-trow:last-child { border-bottom: none; }
.mag-ticon {
  width: 80rpx;
  height: 80rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 26rpx;
  font-size: calc(32rpx * var(--fs-mul, 1));
  font-weight: 800;
}
.ti-1 { background: var(--c-gold-soft); color: var(--gold-deep); }
.ti-2 { background: var(--c-accent-soft); color: var(--pine); }
.ti-4 { background: var(--c-accent-soft); color: var(--cat-plum-deep); }
.mag-tmid { flex: 1; min-width: 0; }
.mag-tname { font-size: calc(32rpx * var(--fs-mul, 1)); font-weight: 700; color: var(--ink); }
.mag-tdesc { margin-top: 6rpx; font-size: calc(23rpx * var(--fs-mul, 1)); color: var(--mut-strong); }
.mag-tarrow { flex: none; font-size: calc(36rpx * var(--fs-mul, 1)); color: var(--mut-2); }

/* ---------- 口味偏好 ---------- */
.mag-pref { padding: 38rpx 34rpx; }
.mag-prow { margin-bottom: 30rpx; }
.mag-prow:last-child { margin-bottom: 0; }
.mag-ptop {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.mag-pl { font-size: var(--fs-cap); font-weight: 700; color: var(--ink); }
.mag-pr { font-size: var(--fs-cap); font-weight: 700; color: var(--mut); }
.mag-pbar {
  height: 18rpx;
  border-radius: 12rpx;
  background: var(--paper-2);
  overflow: hidden;
}
.mag-pbar-i {
  height: 100%;
  border-radius: 12rpx;
  background: linear-gradient(90deg, var(--orange), var(--pop));
}
.mag-pbar.alt .mag-pbar-i {
  background: linear-gradient(90deg, var(--cat-green), var(--pine));
}

/* ---------- 偏好画像 & 家庭成员 图标色 ---------- */
.ti-pref { background: var(--pop-soft); color: var(--pop-deep); }
.ti-fam  { background: var(--c-info-soft); color: var(--c-info); }

/* ---------- 设置分组 ---------- */
.mag-settings { padding: 0 34rpx; }
.mag-srow {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 38rpx 0;
  border-bottom: 2rpx solid var(--paper-2);
}
.mag-srow.last { border-bottom: none; }
.mag-sname { font-size: calc(32rpx * var(--fs-mul, 1)); font-weight: 600; color: var(--ink); }
.mag-sarrow { font-size: calc(36rpx * var(--fs-mul, 1)); color: var(--mut-2); }

/* ---------- 页脚版本号 ---------- */
.mag-footer {
  text-align: center;
  font-size: calc(23rpx * var(--fs-mul, 1));
  color: var(--mut-2);
  padding: 40rpx 0 60rpx;
}
/* 游客绑定手机引导条 */
/* 普通卡：surface 底 + 细边，深色模式随 token 翻转（原桃色渐变不在色板里）。
   整卡可点；红色只给文字操作「去登录」——它是这一屏唯一的主操作 */
.mag-phone {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 16rpx;
  padding: 24rpx var(--pad-card);
  border-radius: var(--r-card);
  background: var(--c-surface);
  border: 2rpx solid var(--line);
}
.mag-phone-ic {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--ink);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
/* 绑手机：听筒几何标，不用 ☏ */
.mag-phone-glyph {
  width: 22rpx;
  height: 30rpx;
  border: 3rpx solid var(--paper);
  border-radius: 6rpx 6rpx 10rpx 10rpx;
  box-sizing: border-box;
  position: relative;
}
.mag-phone-glyph::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 4rpx;
  width: 10rpx;
  height: 3rpx;
  margin-left: -5rpx;
  border-radius: 2rpx;
  background: var(--paper);
}
.mag-phone-mid { flex: 1; min-width: 0; }
.mag-phone-t { font-size: calc(28rpx * var(--fs-mul, 1)); font-weight: 700; color: var(--ink); }
.mag-phone-s { margin-top: 6rpx; font-size: calc(23rpx * var(--fs-mul, 1)); color: var(--mut); }
.mag-phone-go { font-size: var(--fs-sub); color: var(--pop); font-weight: 800; flex-shrink: 0; }

/* ---------- 加载失败态 ---------- */
.mag-load-error {
  margin: 40rpx 0;
  padding: 56rpx 40rpx;
  border-radius: var(--r-lg);
  background: var(--c-surface);
  box-shadow: var(--sh-card);
  text-align: center;
}
.mag-load-error-title {
  font-size: calc(32rpx * var(--fs-mul, 1));
  font-weight: 800;
  color: var(--ink-deep);
}
.mag-load-error-desc {
  margin-top: 12rpx;
  font-size: calc(25rpx * var(--fs-mul, 1));
  color: var(--mut-strong);
  word-break: break-all;
}
.mag-load-error-btn {
  margin: 32rpx auto 0;
  width: 240rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-pill);
  background: var(--anchor);
  color: var(--anchor-contrast);
  font-size: calc(25rpx * var(--fs-mul, 1));
  font-weight: 700;
}
