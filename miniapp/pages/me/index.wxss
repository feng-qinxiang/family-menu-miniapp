/* ============================================================
   pages/me · 杂志撞色「家庭厨房档案」· 对标 me-final.html
   全局 token/工具类见 app.wxss，本文件只写页面专属布局
   px→rpx ×1.923（设计稿 390px 宽）
   ============================================================ */
.me-mag {
  padding: 0 0 calc(var(--tabbar-h) + 40rpx);   /* 同首页：原来 186rpx 不含安全区 */
  background: var(--paper);
}

/* ---------- 内容区 ---------- */
.mag-sheet {
  padding: 8rpx var(--page-gutter) 0;   /* 与 .cpt-head 同一页边距（原误用删除钮直径 --ctl-x，差 2rpx 对不齐） */
}

/* ---------- VIP banner ---------- */
.mag-vip {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx var(--pad-card);
  border-radius: var(--r-card);
  background: linear-gradient(120deg, var(--pop-deep-fill) 0%, var(--pop-fill) 100%);
  box-shadow: var(--sh-soft);
}
.mag-vip-ic {
  width: 80rpx;
  height: 80rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-md);
  background: rgba(255, 255, 255, 0.18);
  color: var(--anchor-contrast);
}
/* VIP 入口：几何星，不用 emoji ★ */
.mag-vip-glyph {
  width: 28rpx;
  height: 28rpx;
  background: var(--c-surface);
  clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
}
.mag-vip-mid { flex: 1; min-width: 0; }
.mag-vip-t { font-size: calc(28rpx * var(--fs-mul, 1)); font-weight: 800; color: var(--anchor-contrast); }
.mag-vip-t .hl { color: var(--gold-on-dark); }
.mag-vip-s { margin-top: 6rpx; font-size: var(--fs-mini); color: rgba(255, 255, 255, 0.7); }
.mag-vip-go {
  flex: none;
  font-size: var(--fs-cap);
  font-weight: 800;
  color: var(--pop-deep);
  background: var(--c-surface);
  padding: 15rpx 26rpx;
  border-radius: var(--r-pill);
}

/* 列表骨架（最近上桌 / 口味偏好加载态） */
.mag-skel-thumb {
  /* 骨架必须和它替身的那张卡同尺寸，否则数据回来时整行会跳一下。
     原来是 96rpx 而真卡是 120rpx——差 24rpx，实测加载完会看到明显的位移。
     两处一起收敛到紧凑行图块规格 --tile-row-sm(104rpx)。 */
  width: var(--tile-row-sm);
  height: var(--tile-row-sm);
  border-radius: var(--r-sm);   /* = 真卡 .mag-thumb 的圆角；两处一起收到不大于外层卡 */
  background: var(--skeleton);
  flex: none;
}
.mag-skel-line {
  height: 26rpx;
  border-radius: 12rpx;
  background: var(--skeleton);
  margin-top: 14rpx;
  width: 70%;
}
.mag-skel-line.strong { height: 30rpx; width: 45%; margin-top: 0; }
.mag-skel-bar {
  height: 22rpx;
  border-radius: 11rpx;
  background: var(--skeleton);
  margin-top: 16rpx;
  width: 100%;
}
/* ---------- 最近上桌 ---------- */
/* 下面四张列表卡左右原来都是裸 34rpx：比上方统计卡/快捷卡/今日卡（--pad-card-sm）多缩进 10rpx，
   同一屏的卡里文字左边缘错开。统一走 --pad-card-sm */
.mag-history { padding: 12rpx var(--pad-card-sm); }
.mag-hrow {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 25rpx 0;
  border-bottom: 2rpx solid var(--paper-2);
}
.mag-thumb {
  width: var(--dish-thumb);
  height: var(--dish-thumb);
  border-radius: var(--r-sm);   /* 内层圆角不大于外层 .card */
  flex: none;
  background: var(--paper-2);
}
.mag-hmid { flex: 1; min-width: 0; }
.mag-hname { font-size: calc(32rpx * var(--fs-mul, 1)); font-weight: 800; color: var(--ink); line-height: 1.45; word-break: break-all; }
.mag-hsub { margin-top: 9rpx; font-size: var(--fs-cap); color: var(--mut); }
.mag-stars { display: flex; gap: 4rpx; margin-top: 8rpx; }
.mag-star { font-size: var(--fs-cap); color: var(--line-deep); }
.mag-star.on { color: var(--gold-deep); }
.mag-hmore {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 27rpx 0;
  font-size: var(--fs-sub);
  font-weight: 800;
  color: var(--gold-deep);
}

/* ---------- 口味偏好 ---------- */
.mag-pref { padding: 38rpx var(--pad-card-sm); }
.mag-prow { margin-bottom: 30rpx; }
.mag-prow:last-child { margin-bottom: 0; }
.mag-ptop {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.mag-pl { font-size: var(--fs-cap); font-weight: 700; color: var(--ink); }
.mag-pr { font-size: var(--fs-cap); font-weight: 700; color: var(--mut); }
.mag-pbar {
  height: 18rpx;
  border-radius: 12rpx;
  background: var(--paper-2);
  overflow: hidden;
}
.mag-pbar-i {
  height: 100%;
  border-radius: 12rpx;
  background: linear-gradient(90deg, var(--orange), var(--pop-fill));
}
.mag-pbar.alt .mag-pbar-i {
  background: linear-gradient(90deg, var(--cat-green), var(--pine));
}

/* ---------- 设置分组 ---------- */
.mag-settings { padding: 0 var(--pad-card-sm); }
.mag-srow {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 38rpx 0;
  border-bottom: 2rpx solid var(--paper-2);
}
.mag-srow.last { border-bottom: none; }
.mag-sname { font-size: calc(32rpx * var(--fs-mul, 1)); font-weight: 600; color: var(--ink); }
.mag-sarrow { font-size: calc(36rpx * var(--fs-mul, 1)); color: var(--mut-2); }

/* ---------- 页脚版本号 ---------- */
.mag-footer {
  text-align: center;
  font-size: calc(23rpx * var(--fs-mul, 1));
  color: var(--mut);   /* --mut-2 在米白底上对比度不足 */
  padding: 40rpx 0 60rpx;
}
/* 游客绑定手机引导条 */
/* 普通卡：surface 底 + 细边，深色模式随 token 翻转（原桃色渐变不在色板里）。
   整卡可点；红色只给文字操作「去登录」——它是这一屏唯一的主操作 */
.mag-phone {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 16rpx;
  padding: 24rpx var(--pad-card);
  border-radius: var(--r-card);
  background: var(--c-surface);
  border: 2rpx solid var(--line);
}
.mag-phone-ic {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--paper-2);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.mag-phone-ic image { width: 34rpx; height: 34rpx; }
.mag-phone-mid { flex: 1; min-width: 0; }
.mag-phone-t { font-size: calc(28rpx * var(--fs-mul, 1)); font-weight: 700; color: var(--ink); }
.mag-phone-s { margin-top: 6rpx; font-size: calc(23rpx * var(--fs-mul, 1)); color: var(--mut); }
.mag-phone-go { font-size: var(--fs-sub); color: var(--pop); font-weight: 800; flex-shrink: 0; }

/* ---------- 加载失败态 ---------- */
.mag-load-error {
  margin: 40rpx 0;
  padding: 56rpx var(--pad-card);
  border-radius: var(--r-card);
  background: var(--c-surface);
  box-shadow: var(--sh-card);
  text-align: center;
}
.mag-load-error-title {
  font-size: calc(32rpx * var(--fs-mul, 1));
  font-weight: 800;
  color: var(--ink-deep);
}
.mag-load-error-desc {
  margin-top: 12rpx;
  font-size: calc(25rpx * var(--fs-mul, 1));
  color: var(--mut-strong);
  word-break: break-all;
}
.mag-load-error-btn {
  margin: 32rpx auto 0;
  width: 240rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-card);
  background: var(--anchor);
  color: var(--anchor-contrast);
  font-size: calc(25rpx * var(--fs-mul, 1));
  font-weight: 700;
}

.mag-hsub { line-height: 1.5; word-break: break-all; }

/* ---------- 身份卡：我 + 我家 + 一句统计 ---------- */
/* 头像是这页唯一的单字方块（人名头像），底色用暖中性，不和主按钮抢红 */
.mag-id { padding: 8rpx var(--pad-card-sm) 0; }
.mag-id-me, .mag-id-fam { display: flex; align-items: center; gap: 20rpx; min-height: var(--tap-min); }
.mag-id-me { padding: 20rpx 0; border-bottom: 2rpx solid var(--paper-2); }
.mag-id-ava { width: var(--ava-head); height: var(--ava-head); flex: none; border-radius: calc(var(--ava-head) * var(--r-ava)); background: var(--paper-2); }
.mag-id-letter { display: flex; align-items: center; justify-content: center; color: var(--ink); font-size: var(--fs-h2); font-weight: 700; }
.mag-id-copy { flex: 1; min-width: 0; }
.mag-id-name { font-size: var(--fs-lg); font-weight: 800; color: var(--ink); line-height: 1.4; word-break: break-all; }
.mag-id-edit { margin-top: 4rpx; font-size: var(--fs-cap); color: var(--mut-strong); }
.mag-chev { width: 32rpx; height: 32rpx; flex: none; }
.mag-id-fam { padding: 12rpx 0; }
.mag-id-fam-ic { width: 40rpx; height: 40rpx; flex: none; }
/* 家庭名是用户自己起的，可能很长：最多两行 */
.mag-id-fam-name { flex: 1; min-width: 0; font-size: var(--fs-body); font-weight: 700; color: var(--ink); line-height: 1.45; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; word-break: break-all; }
.mag-id-fam-cnt { flex: none; font-size: var(--fs-cap); color: var(--mut-strong); }
.mag-id-stats { padding: 0 0 20rpx 60rpx; font-size: var(--fs-cap); color: var(--mut); line-height: 1.5; }
.mag-id .mag-skel-line.strong { height: 30rpx; width: 45%; }
/* 这页的视觉重点：身份卡是全站「深色锚点卡」（app.wxss .card-dark），其余卡保持白底。
   卡底 --anchor 两档都是深色，所以卡里的字和图标用恒定浅色，不跟主题翻转 */
.mag-id .mag-id-me, .mag-id .mag-id-fam, .mag-id .mag-id-stats { position: relative; z-index: 1; }   /* 压在装饰圆上面 */
.mag-id .mag-id-me { border-bottom-color: rgba(255, 255, 255, 0.12); }
.mag-id .mag-id-ava { background: var(--gold-on-dark); }
.mag-id .mag-id-letter { color: var(--anchor); }
.mag-id .mag-id-name, .mag-id .mag-id-fam-name { color: var(--anchor-contrast); }
.mag-id .mag-id-edit, .mag-id .mag-id-fam-cnt { color: var(--anchor-contrast); opacity: 0.85; }
.mag-id .mag-id-stats { color: var(--gold-on-dark); }
.mag-id .mag-skel-line { background: rgba(255, 255, 255, 0.14); }

/* ---------- 常用入口：三列线性图标，图标底按用途分四种浅色（app.wxss .tint-*） ---------- */
.mag-shortcuts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 4rpx; margin: 16rpx 0 20rpx; padding: 12rpx var(--pad-card-sm); background: var(--c-surface); border: var(--bd-card); border-radius: var(--r-card); }
.mag-shortcut { display: flex; flex-direction: column; align-items: center; gap: 10rpx; padding: 16rpx 0; min-width: 0; min-height: var(--tap-min); }
.mag-sic { width: 80rpx; height: 80rpx; display: flex; align-items: center; justify-content: center; border-radius: var(--r-md); }   /* 底色由 wxml 里的 tint-* 给 */
.mag-sic image { width: 44rpx; height: 44rpx; }
.mag-scname { font-size: var(--fs-sub); font-weight: 600; color: var(--ink); line-height: 1.4; text-align: center; }

/* lucide SVG 的描边色各不相同（深墨/米白/番茄红），统一压成墨色线条；深色档再翻成浅色 */
.mag-sic image, .mag-chev, .mag-id-fam-ic, .mag-phone-ic image { filter: brightness(0); opacity: 0.72; }
.mag-chev { opacity: 0.35; }
@media (prefers-color-scheme: dark) {
  .mag-sic image, .mag-chev, .mag-id-fam-ic, .mag-phone-ic image { filter: brightness(0) invert(1); }
}
.mag-id .mag-chev, .mag-id .mag-id-fam-ic { filter: brightness(0) invert(1); }
.mag-id .mag-chev { opacity: 0.6; }   /* 白底上 .35 够用，深底上要亮一档才看得出能点 */   /* 深色卡上两档都是浅色线条 */
