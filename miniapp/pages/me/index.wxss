/* ============================================================
   pages/me · 杂志撞色「家庭厨房档案」· 对标 me-final.html
   全局 token/工具类见 app.wxss，本文件只写页面专属布局
   px→rpx ×1.923（设计稿 390px 宽）
   ============================================================ */
.me-mag {
  padding: 0 0 186rpx;
  background: var(--paper);
}

/* ---------- HERO ---------- */
.mag-hero {
  position: relative;
  height: 360rpx;
  overflow: hidden;
}
.mag-hero-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.mag-hero-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg,
    rgba(20, 14, 8, 0.5) 0%,
    rgba(20, 14, 8, 0) 28%,
    rgba(20, 14, 8, 0.18) 52%,
    rgba(20, 14, 8, 0.9) 100%);
}
.mag-hero-bignum {
  position: absolute;
  top: 120rpx;
  right: 20rpx;
  font-family: var(--serif);
  font-size: 410rpx;
  font-weight: 700;
  line-height: 1;
  color: rgba(255, 255, 255, 0.07);
}
.mag-hero-top {
  position: absolute;
  top: calc(env(safe-area-inset-top) + 90rpx);
  left: 46rpx;
  right: 46rpx;
  z-index: 3;
}
.mag-hi-en {
  font-size: var(--fs-cap);
  letter-spacing: 4rpx;
  text-transform: uppercase;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.85);
}
.mag-hi-cn {
  margin-top: 8rpx;
  font-size: var(--fs-cap);
  font-weight: 600;
  color: rgba(255, 255, 255, 0.92);
}
.mag-hero-body {
  position: absolute;
  left: 46rpx;
  right: 46rpx;
  bottom: 76rpx;
  z-index: 3;
}
.mag-hero-tag {
  display: inline-block;
  font-family: var(--serif);
  font-style: italic;
  font-size: var(--fs-cap);
  letter-spacing: 2rpx;
  font-weight: 700;
  color: var(--c-surface);
  background: var(--pop);
  padding: 10rpx 26rpx;
  border-radius: var(--r-xs);
}
.mag-hero-title {
  margin: 26rpx 0 16rpx;
  font-size: var(--fs-hero-xl);
  line-height: 0.92;
  letter-spacing: -5rpx;
  -webkit-text-stroke: 3rpx var(--c-surface);
}
.mag-hero-sub {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}
.mag-fam {
  display: flex;
  align-items: center;
  margin-top: 34rpx;
}
.mag-ava {
  width: 88rpx;
  height: 88rpx;
  margin-left: -22rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 800;
  color: var(--c-surface);
  border: 4rpx solid rgba(255, 255, 255, 0.85);
  box-shadow: 0 8rpx 22rpx rgba(0, 0, 0, 0.35);
}
.mag-ava:first-child { margin-left: 0; }
.mavt-a { background: linear-gradient(135deg, var(--cat-gold), var(--gold-deep)); color: var(--ink-deep); }
.mavt-b { background: var(--cat-brown); }
.mavt-c { background: var(--pine); }
.mavt-d { background: var(--cat-purple); }
.mavt-e { background: var(--c-info); }
.mag-fam-lbl {
  margin-left: 26rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}
.mag-fam-lbl .b { color: var(--c-surface); font-weight: 800; font-size: 29rpx; }
.mag-manage {
  margin-left: auto;
  font-size: 24rpx;
  font-weight: 800;
  color: var(--c-surface);
  background: var(--pop);
  padding: 16rpx 28rpx;
  border-radius: var(--r-pill);
}

/* ---------- 奶油 sheet ---------- */
.mag-sheet {
  position: relative;
  margin-top: -50rpx;
  z-index: 5;
  padding: 46rpx 28rpx 0;
  background: var(--paper);
  border-radius: 20rpx 20rpx 0 0;
}

/* ---------- VIP banner ---------- */
.mag-vip {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 30rpx;
  border-radius: var(--r-card);
  background: linear-gradient(120deg, var(--pop-deep) 0%, var(--pop) 100%);
  box-shadow: var(--sh-soft);
}
.mag-vip-ic {
  width: 80rpx;
  height: 80rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-md);
  font-size: 38rpx;
  background: rgba(255, 255, 255, 0.18);
  color: var(--c-surface);
}
.mag-vip-mid { flex: 1; min-width: 0; }
.mag-vip-t { font-size: 28rpx; font-weight: 800; color: var(--c-surface); }
.mag-vip-t .hl { color: var(--gold); }
.mag-vip-s { margin-top: 6rpx; font-size: var(--fs-mini); color: rgba(255, 255, 255, 0.7); }
.mag-vip-go {
  flex: none;
  font-size: var(--fs-cap);
  font-weight: 800;
  color: var(--pop-deep);
  background: var(--c-surface);
  padding: 15rpx 26rpx;
  border-radius: var(--r-pill);
}

/* ---------- 数据卡 ---------- */
.mag-stats {
  display: flex;
  gap: 22rpx;
  margin-top: 34rpx;
}
.mag-stat {
  flex: 1;
  background: var(--c-surface);
  border-radius: var(--r-md);
  padding: 30rpx 26rpx;
  border: var(--bd-card);
  box-shadow: var(--sh-soft), 0 26rpx 58rpx rgba(120, 70, 30, 0.1);
}
.mag-snum {
  font-size: 64rpx;
  font-weight: 900;
  color: var(--ink);
  letter-spacing: -3rpx;
  line-height: 1;
}
.mag-snum.num-skel {
  width: 84rpx;
  height: 48rpx;
  border-radius: 14rpx;
  background: var(--skeleton);
  margin: 0 auto;
  color: transparent;
}
/* 列表骨架（最近上桌 / 口味偏好加载态） */
.mag-skel-thumb {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--r-md);
  background: var(--skeleton);
  flex: none;
}
.mag-skel-line {
  height: 26rpx;
  border-radius: 12rpx;
  background: var(--skeleton);
  margin-top: 14rpx;
  width: 70%;
}
.mag-skel-line.strong { height: 30rpx; width: 45%; margin-top: 0; }
.mag-skel-bar {
  height: 22rpx;
  border-radius: 11rpx;
  background: var(--skeleton);
  margin-top: 16rpx;
  width: 100%;
}
.mag-snum.pop { color: var(--pop); }
.mag-scap {
  margin-top: 14rpx;
  font-size: var(--fs-mini);
  font-weight: 600;
  color: var(--mut);
  white-space: nowrap;
}
.mag-scap-en {
  margin-top: 4rpx;
  font-family: var(--serif);
  font-style: italic;
  font-size: var(--fs-tiny);
  letter-spacing: 1rpx;
  color: var(--gold-deep);
}

/* ---------- 最近上桌 ---------- */
.mag-history { padding: 12rpx 34rpx; }
.mag-hrow {
  display: flex;
  align-items: center;
  gap: 26rpx;
  padding: 25rpx 0;
  border-bottom: 2rpx solid var(--paper-2);
}
.mag-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--r-chip);
  flex: none;
  background: var(--paper-2);
}
.mag-hmid { flex: 1; min-width: 0; }
.mag-hname { font-size: 32rpx; font-weight: 800; color: var(--ink); letter-spacing: -0.5rpx; }
.mag-hsub { margin-top: 9rpx; font-size: var(--fs-cap); color: var(--mut); }
.mag-stars { display: flex; gap: 4rpx; flex: none; }
.mag-star { font-size: var(--fs-cap); color: var(--line-deep); }
.mag-star.on { color: var(--pop); }
.mag-hmore {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 27rpx 0;
  font-size: var(--fs-sub);
  font-weight: 800;
  color: var(--gold-deep);
}

/* ---------- 厨房工具 ---------- */
.mag-tools { padding: 8rpx 34rpx; }
.mag-trow {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 28rpx 0;
  border-bottom: 2rpx solid var(--paper-2);
}
.mag-trow:last-child { border-bottom: none; }
.mag-ticon {
  width: 80rpx;
  height: 80rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 26rpx;
  font-size: 32rpx;
  font-weight: 800;
}
.ti-0 { background: var(--pop-soft); color: var(--pop); }
.ti-1 { background: var(--pop-soft); color: var(--pop); }
.ti-2 { background: var(--c-accent-soft); color: var(--pine); }
.ti-3 { background: var(--c-gold-soft); color: var(--gold-deep); }
.ti-4 { background: var(--c-accent-soft); color: var(--cat-plum-deep); }
.ti-5 { background: var(--c-success-soft); color: var(--c-info); }
.mag-tmid { flex: 1; min-width: 0; }
.mag-tname { font-size: 32rpx; font-weight: 700; color: var(--ink); }
.mag-tvip {
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  color: var(--ink-deep);
  background: var(--gold);
  padding: 4rpx 14rpx;
  border-radius: var(--r-xs);
  margin-left: 10rpx;
}
.mag-tdesc { margin-top: 6rpx; font-size: 22rpx; color: var(--mut-strong); }
.mag-tarrow { flex: none; font-size: 38rpx; color: var(--mut-2); }

/* ---------- 口味偏好 ---------- */
.mag-pref { padding: 38rpx 34rpx; }
.mag-prow { margin-bottom: 30rpx; }
.mag-prow:last-child { margin-bottom: 0; }
.mag-ptop {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.mag-pl { font-size: var(--fs-cap); font-weight: 700; color: var(--ink); }
.mag-pl .pop { color: var(--pop); }
.mag-pr { font-size: var(--fs-cap); font-weight: 700; color: var(--mut); }
.mag-pbar {
  height: 18rpx;
  border-radius: 12rpx;
  background: var(--paper-2);
  overflow: hidden;
}
.mag-pbar-i {
  height: 100%;
  border-radius: 12rpx;
  background: linear-gradient(90deg, var(--orange), var(--pop));
}
.mag-pbar.alt .mag-pbar-i {
  background: linear-gradient(90deg, var(--cat-green), var(--pine));
}

/* ---------- 偏好画像 & 家庭成员 图标色 ---------- */
.ti-pref { background: var(--pop-soft); color: var(--pop-deep); }
.ti-fam  { background: var(--c-info-soft); color: var(--c-info); }

/* ---------- 设置分组 ---------- */
.mag-settings { padding: 0 34rpx; }
.mag-srow {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 38rpx 0;
  border-bottom: 1.5rpx solid var(--paper-2);
}
.mag-srow.last { border-bottom: none; }
.mag-sname { font-size: 32rpx; font-weight: 600; color: var(--ink); }
.mag-sarrow { font-size: 38rpx; color: var(--mut-2); }

/* ---------- 页脚版本号 ---------- */
.mag-footer {
  text-align: center;
  font-size: 22rpx;
  color: var(--mut-2);
  padding: 40rpx 0 60rpx;
}
/* 游客绑定手机引导条 */
.mag-phone {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 24rpx 28rpx 0;
  padding: 22rpx 28rpx;
  border-radius: var(--r-card);
  background: linear-gradient(135deg, var(--banner-grad-a), var(--banner-grad-b));
  border: 1rpx solid var(--banner-bd);
}
.mag-phone-ic {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--pop);
  color: #fff;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.mag-phone-mid { flex: 1; min-width: 0; }
.mag-phone-t { font-size: 28rpx; font-weight: 600; color: var(--ink-deep); }
.mag-phone-s { margin-top: 6rpx; font-size: 23rpx; color: var(--mut-strong); }
.mag-phone-go { font-size: 26rpx; color: var(--pop); font-weight: 600; flex-shrink: 0; }

/* ---------- 加载失败态 ---------- */
.mag-load-error {
  margin: 40rpx 0;
  padding: 56rpx 40rpx;
  border-radius: var(--r-lg, 28rpx);
  background: var(--c-surface);
  box-shadow: var(--sh-card);
  text-align: center;
}
.mag-load-error-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--ink-deep);
}
.mag-load-error-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--mut-strong);
  word-break: break-all;
}
.mag-load-error-btn {
  margin: 32rpx auto 0;
  width: 240rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-pill);
  background: var(--ink-deep);
  color: var(--c-surface);
  font-size: 26rpx;
  font-weight: 700;
}
