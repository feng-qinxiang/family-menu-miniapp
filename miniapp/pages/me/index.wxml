<view class="container me-mag {{fontScale === 'lg' ? 'font-lg' : ''}}">
  <!-- 紧凑页头（结构见 app.wxss .cpt-head）：一个页名；身份、家庭、统计合进下面一张身份卡 -->
  <view class="cpt-head" style="padding-top: {{capsuleTop}};">
    <view class="cpt-row"><view class="cpt-titles"><view class="cpt-title">我的</view></view></view>
  </view>

  <!-- 内容区 -->
  <view class="mag-sheet">
    <!-- 身份卡：左边是我（点进编辑资料），下面一行是家庭（点进成员管理），末行一句统计。
         首屏加载中/失败时成员数不可信，不显示「0 位成员」，骨架占位防跳动 -->
    <view class="mag-id card-dark g-fade-up">
      <view class="deco-circle"></view>
      <view class="mag-id-me tap-scale" bindtap="goProfileEdit" aria-role="button" aria-label="编辑我的资料">
        <image wx:if="{{profile.avatarUrl && !profilePhotoBroken}}" class="mag-id-ava" src="{{profile.avatarUrl}}" mode="aspectFill" data-err-key="profilePhotoBroken" binderror="onPhotoError" />
        <view wx:else class="mag-id-ava mag-id-letter {{loading ? 'shimmer' : ''}}">{{loading ? '' : profile.initial}}</view>
        <view class="mag-id-copy">
          <view class="mag-id-name {{loading ? 'mag-skel-line strong shimmer' : ''}}">{{loading ? '' : profile.nickname}}</view>
          <view class="mag-id-edit">编辑资料</view>
        </view>
        <image class="mag-chev" src="/assets/icons/lucide/chevron-right.svg" mode="aspectFit" aria-hidden="true" />
      </view>
      <view class="mag-id-fam tap-scale" bindtap="goFamilyMembers" aria-role="button" aria-label="管理家庭成员">
        <image class="mag-id-fam-ic" src="/assets/icons/lucide/users.svg" mode="aspectFit" aria-hidden="true" />
        <view class="mag-id-fam-name">{{familyProfile.familyName || '我的家'}}</view>
        <view class="mag-id-fam-cnt" wx:if="{{memberCount || (!loading && !loadError)}}">{{memberCount}} 位成员</view>
        <image class="mag-chev" src="/assets/icons/lucide/chevron-right.svg" mode="aspectFit" aria-hidden="true" />
      </view>
      <!-- 统计只读一行小字：去处已在下面「菜谱库」和底栏「记录」，不再做成第二个入口；0 也不放大 -->
      <view class="mag-id-stats" wx:if="{{!loading && !loadError}}">{{savedCount}} 道菜谱 · 本月做了 {{monthCookCount}} 次</view>
    </view>

    <!-- VIP banner（支付开关关闭时隐藏） -->
    <view class="mag-vip tap-scale" wx:if="{{features.PAYMENT}}" bindtap="goVip" aria-role="button">
      <view class="mag-vip-ic"><view class="mag-vip-glyph"></view></view>
      <view class="mag-vip-mid">
        <view class="mag-vip-t">{{vipStatus.vip ? '已开通' : '开通'}}<text class="hl">家庭云同步</text></view>
        <view class="mag-vip-s">{{vipStatus.vip ? (vipStatus.planName || '全家共享 · 多设备实时同步') : '菜谱与做菜记录全家共享，多设备实时同步'}}</view>
      </view>
      <view class="mag-vip-go">{{vipStatus.vip ? '查看' : '开通'}} ›</view>
    </view>

    <!-- 身份引导：见 pages/me/index.js#buildBindCard。微信登录过的账号不显示 -->
    <view class="mag-phone tap-scale" wx:if="{{bindCard.show}}" bindtap="goBind" aria-role="button">
      <view class="mag-phone-ic"><image src="/assets/icons/lucide/user-round.svg" mode="aspectFit" aria-hidden="true" /></view>
      <view class="mag-phone-mid">
        <view class="mag-phone-t">{{bindCard.title}}</view>
        <view class="mag-phone-s">{{bindCard.desc}}</view>
      </view>
      <view class="mag-phone-go">{{bindCard.cta}} ›</view>
    </view>

    <!-- 加载失败态 -->
    <view class="mag-load-error" wx:if="{{loadError}}">
      <view class="mag-load-error-title">厨房数据没加载出来</view>
      <view class="mag-load-error-desc">{{loadError}}</view>
      <view class="mag-load-error-btn tap-scale" bindtap="retryLoad" aria-role="button">重新加载</view>
    </view>

    <!-- 常用入口：线性图标 + 一行名字，三列 -->
    <view class="mag-shortcuts g-fade-up g-d1">
      <view class="mag-shortcut tap-scale" bindtap="goRecipes" aria-role="button"><view class="mag-sic"><image src="/assets/icons/lucide/book-open.svg" mode="aspectFit" aria-hidden="true" /></view><view class="mag-scname">菜谱库</view></view>
      <view class="mag-shortcut tap-scale" bindtap="goPantry" aria-role="button"><view class="mag-sic"><image src="/assets/icons/lucide/refrigerator.svg" mode="aspectFit" aria-hidden="true" /></view><view class="mag-scname">冰箱库存</view></view>
      <view class="mag-shortcut tap-scale" bindtap="goShopping" aria-role="button"><view class="mag-sic"><image src="/assets/icons/lucide/shopping-basket.svg" mode="aspectFit" aria-hidden="true" /></view><view class="mag-scname">买菜清单</view></view>
      <view class="mag-shortcut tap-scale" bindtap="goWeekly" aria-role="button"><view class="mag-sic"><image src="/assets/icons/lucide/calendar-days.svg" mode="aspectFit" aria-hidden="true" /></view><view class="mag-scname">本周菜单</view></view>
      <view class="mag-shortcut tap-scale" bindtap="goImport" aria-role="button"><view class="mag-sic"><image src="/assets/icons/lucide/download.svg" mode="aspectFit" aria-hidden="true" /></view><view class="mag-scname">导入菜谱</view></view>
      <view wx:if="{{features.COMMUNITY}}" class="mag-shortcut tap-scale" bindtap="goFavorites" aria-role="button"><view class="mag-sic"><image src="/assets/icons/lucide/bookmark.svg" mode="aspectFit" aria-hidden="true" /></view><view class="mag-scname">我的收藏</view></view>
    </view>
    <!-- 最近上桌 -->
    <view class="g-fade-up g-d2" wx:if="{{cookHistory.length}}">
      <section-head title="最近上桌" hint="全部" more="{{true}}" bindtapmore="goCookLog" />
      <view class="card mag-history">
        <view class="mag-hrow {{revealOn ? (reveal[index] ? 'g-fade-up' : 'rv-hold') : ''}}" data-rv="{{index}}" wx:for="{{cookHistory}}" wx:key="id">
          <image class="mag-thumb {{item.coverBroken ? 'img-broken' : ''}}" src="{{item.cover}}" mode="aspectFill" lazy-load data-err-key="{{'cookHistory[' + index + '].coverBroken'}}" binderror="onPhotoError" />
          <view class="mag-hmid">
            <view class="mag-hname">{{item.recipeTitle}}</view>
            <view class="mag-hsub">{{item.whenLabel}}</view>
            <view class="mag-stars" wx:if="{{item.score}}">
            <text class="mag-star {{star <= item.score ? 'on' : ''}}" wx:for="{{[1,2,3,4,5]}}" wx:for-item="star" wx:key="*this">★</text>
            </view>
          </view>
        </view>
        <view class="mag-hmore tap-scale" bindtap="goCookLog" aria-role="button">查看全部记录 ›</view>
      </view>
    </view>
    <!-- 最近上桌：加载骨架 -->
    <view class="g-fade-up g-d2" wx:elif="{{loading}}">
      <section-head title="最近上桌" />
      <view class="card mag-history">
        <view class="mag-hrow" wx:for="{{[1,2]}}" wx:key="*this">
          <view class="mag-skel-thumb shimmer"></view>
          <view class="mag-hmid">
            <view class="mag-skel-line strong shimmer"></view>
            <view class="mag-skel-line shimmer"></view>
          </view>
        </view>
      </view>
    </view>

    <!-- 口味偏好 -->
    <view class="g-fade-up g-d4" wx:if="{{prefBars.length}}">
      <section-head title="家庭口味" />
      <view class="card mag-pref">
        <view class="mag-prow" wx:for="{{prefBars}}" wx:key="label">
          <view class="mag-ptop">
            <view class="mag-pl">{{item.isCuisine ? '偏爱' : ''}}{{item.label}}</view>
            <view class="mag-pr">{{item.right}}</view>
          </view>
          <view class="mag-pbar {{item.alt ? 'alt' : ''}}"><view class="mag-pbar-i" style="width:{{item.pct}}%"></view></view>
        </view>
      </view>
    </view>
    <!-- 口味偏好：加载骨架 -->
    <view class="g-fade-up g-d4" wx:elif="{{loading}}">
      <section-head title="家庭口味" />
      <view class="card mag-pref">
        <view class="mag-prow" wx:for="{{[1,2,3]}}" wx:key="*this">
          <view class="mag-skel-line strong shimmer" style="width: 40%;"></view>
          <view class="mag-skel-bar shimmer"></view>
        </view>
      </view>
    </view>

    <!-- 设置 & 关于 -->
    <view class="g-fade-up g-d6">
      <view class="card mag-settings">
        <view class="mag-srow tap-scale" bindtap="goPreference" aria-role="button">
          <view class="mag-sname">口味和忌口</view>
          <view class="mag-sarrow">›</view>
        </view>
        <view class="mag-srow tap-scale" bindtap="goNotifications" aria-role="button">
          <view class="mag-sname">消息</view>
          <view class="mag-sarrow">›</view>
        </view>
        <view class="mag-srow tap-scale" bindtap="goSettings" aria-role="button">
          <view class="mag-sname">设置</view>
          <view class="mag-sarrow">›</view>
        </view>
        <view class="mag-srow tap-scale" bindtap="goFeedback" aria-role="button">
          <view class="mag-sname">意见反馈</view>
          <view class="mag-sarrow">›</view>
        </view>
        <view class="mag-srow tap-scale" bindtap="goAbout" aria-role="button">
          <view class="mag-sname">关于我们</view>
          <view class="mag-sarrow">›</view>
        </view>
        <view class="mag-srow tap-scale" bindtap="goPrivacy" aria-role="button">
          <view class="mag-sname">隐私政策</view>
          <view class="mag-sarrow">›</view>
        </view>
        <view class="mag-srow tap-scale last" bindtap="goTerms" aria-role="button">
          <view class="mag-sname">用户协议</view>
          <view class="mag-sarrow">›</view>
        </view>
      </view>
    </view>

    <view class="mag-footer">{{appVersion || 'v1.0.0'}} · 家庭版</view>
  </view>
</view>
