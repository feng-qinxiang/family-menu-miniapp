<view class="container me-mag {{fontScale === 'lg' ? 'font-lg' : ''}}">
  <!-- 紧凑页头（结构见 app.wxss .cpt-head）：家庭身份从照片挪到纸面，信息不减 -->
  <view class="cpt-head" style="padding-top: {{capsuleTop}};">
    <view class="cpt-row">
      <view class="cpt-titles">
        <view class="cpt-eyebrow">我的厨房</view>
        <view class="cpt-title mag-fam-name">{{familyProfile.familyName || '我的家'}}</view>
      </view>
      <view class="cpt-action mag-manage tap-scale" bindtap="goMemberManage">＋ 管理</view>
    </view>
    <!-- 成员行：首屏加载中/首屏失败时成员数还不可信，不显示「0 位成员」，行高照留防跳动；
         静默刷新失败时 memberCount 是上一次的真值，照常显示 -->
    <view class="mag-fam">
      <block wx:if="{{memberCount || (!loading && !loadError)}}">
        <view class="mag-ava {{item.tone}}" wx:for="{{familyProfile.members}}" wx:key="userId">{{item.initial}}</view>
        <view class="mag-fam-lbl"><text class="b">{{memberCount}}</text> 位成员</view>
      </block>
    </view>
    <view class="mag-profile tap-scale" wx:if="{{!loading && !loadError}}" bindtap="goProfileEdit" aria-role="button" aria-label="编辑我的资料">
      <image wx:if="{{profile.avatarUrl && !profilePhotoBroken}}" class="mag-profile-avatar" src="{{profile.avatarUrl}}" mode="aspectFill" data-err-key="profilePhotoBroken" binderror="onPhotoError" />
      <view wx:else class="mag-profile-avatar mag-profile-letter">{{profile.initial}}</view>
      <view class="mag-profile-copy"><view class="mag-profile-name">{{profile.nickname}}</view><view class="mag-profile-sub">把家常味，留在自己的厨房</view></view><text class="mag-profile-edit">编辑 ›</text>
    </view>
    <view class="cpt-sub" wx:if="{{monthCookCount > 0}}">本月一起做了 {{monthCookCount}} 道菜</view>
  </view>

  <!-- 内容区 -->
  <view class="mag-sheet">
    <!-- VIP banner（支付开关关闭时隐藏） -->
    <view class="mag-vip tap-scale" wx:if="{{features.PAYMENT}}" bindtap="goVip">
      <view class="mag-vip-ic"><view class="mag-vip-glyph"></view></view>
      <view class="mag-vip-mid">
        <view class="mag-vip-t">{{vipStatus.vip ? '已开通' : '开通'}}<text class="hl">家庭云同步</text></view>
        <view class="mag-vip-s">{{vipStatus.vip ? (vipStatus.planName || '全家共享 · 多设备实时同步') : '菜谱与做菜记录全家共享，多设备实时同步'}}</view>
      </view>
      <view class="mag-vip-go">{{vipStatus.vip ? '查看' : '开通'}} ›</view>
    </view>

    <!-- 身份引导：见 pages/me/index.js#buildBindCard。微信登录过的账号不显示 -->
    <view class="mag-phone tap-scale" wx:if="{{bindCard.show}}" bindtap="goBind">
      <view class="mag-phone-ic"><view class="mag-phone-glyph"></view></view>
      <view class="mag-phone-mid">
        <view class="mag-phone-t">{{bindCard.title}}</view>
        <view class="mag-phone-s">{{bindCard.desc}}</view>
      </view>
      <view class="mag-phone-go">{{bindCard.cta}} ›</view>
    </view>

    <!-- 加载失败态 -->
    <view class="mag-load-error" wx:if="{{loadError}}">
      <view class="mag-load-error-title">厨房数据没加载出来</view>
      <view class="mag-load-error-desc">{{loadError}}</view>
      <view class="mag-load-error-btn tap-scale" bindtap="retryLoad">重新加载</view>
    </view>

    <!-- 数据卡 -->
    <view class="mag-stats g-fade-up g-d1">
      <view class="mag-stat tap-scale" bindtap="goRecipes">
        <view class="mag-snum {{loading ? 'shimmer num-skel' : ''}}">{{savedCount}}</view>
        <view class="mag-scap">我的菜谱</view>
        <view class="mag-scap-note">自建+导入</view>
      </view>
      <view class="mag-stat tap-scale" bindtap="goCookLog">
        <view class="mag-snum {{loading ? 'shimmer num-skel' : ''}}">{{monthCookCount}}</view>
        <view class="mag-scap">本月做菜</view>
      </view>
      <view class="mag-stat tap-scale" bindtap="goFamilyMembers">
        <view class="mag-snum {{loading ? 'shimmer num-skel' : ''}}">{{memberCount}}</view>
        <view class="mag-scap">家庭成员</view>
      </view>
    </view>

    <view class="mag-shortcuts">
      <view class="mag-shortcut tap-scale" bindtap="goRecipes"><view class="mag-ticon ti-1">菜</view><view><view class="mag-tname">我的菜谱</view><view class="mag-tdesc">挑菜与新建</view></view></view>
      <view class="mag-shortcut tap-scale" bindtap="goPantry"><view class="mag-ticon ti-fam">鲜</view><view><view class="mag-tname">冰箱库存</view><view class="mag-tdesc">用料与到期日</view></view></view>
      <view class="mag-shortcut tap-scale" bindtap="goShopping"><view class="mag-ticon ti-2">买</view><view><view class="mag-tname">买菜清单</view><view class="mag-tdesc">一份清单买齐</view></view></view>
      <view class="mag-shortcut tap-scale" bindtap="goWeekly"><view class="mag-ticon ti-1">周</view><view><view class="mag-tname">一周计划</view><view class="mag-tdesc">提前安排三餐</view></view></view>
      <view class="mag-shortcut tap-scale" bindtap="goImport"><view class="mag-ticon ti-4">导</view><view><view class="mag-tname">导入菜谱</view><view class="mag-tdesc">收好喜欢的做法</view></view></view>
      <view wx:if="{{features.COMMUNITY}}" class="mag-shortcut tap-scale" bindtap="goFavorites"><view class="mag-ticon ti-2">藏</view><view><view class="mag-tname">我的收藏</view><view class="mag-tdesc">好菜与好分享</view></view></view>
    </view>
    <view class="mag-today card tap-scale" wx:if="{{!loading && !loadError}}" bindtap="goCooking" aria-role="button" aria-label="查看今天的菜单">
      <view class="mag-today-head"><text>今天这一餐</text><text class="mag-today-status">{{todayTotal ? todayDone + '/' + todayTotal + ' 道已上桌' : '还没点菜'}}</text></view>
      <view wx:if="{{todayDishes.length}}" class="mag-today-dishes"><view class="mag-today-dish" wx:for="{{todayDishes}}" wx:key="recipeId"><image src="{{item.cover}}" class="{{item.coverBroken ? 'img-broken' : ''}}" mode="aspectFill" data-err-key="{{'todayDishes[' + index + '].coverBroken'}}" binderror="onPhotoError" /><view>{{item.title}}</view></view></view>
      <view class="mag-today-footer"><text>{{todayTotal ? '点好的菜，按自己的节奏做' : '先选几道，全家一起开火'}}</text><text>去做菜 ›</text></view>
    </view>
    <!-- 最近上桌 -->
    <view class="g-fade-up g-d2" wx:if="{{cookHistory.length}}">
      <section-head eyebrow="做菜记录" title="最近上桌" hint="全部" more="{{true}}" bindtapmore="goCookLog" />
      <view class="card mag-history">
        <view class="mag-hrow {{revealOn ? (reveal[index] ? 'g-fade-up' : 'rv-hold') : ''}}" data-rv="{{index}}" wx:for="{{cookHistory}}" wx:key="id">
          <image class="mag-thumb" src="{{item.cover}}" mode="aspectFill" lazy-load />
          <view class="mag-hmid">
            <view class="mag-hname">{{item.recipeTitle}}</view>
            <view class="mag-hsub">{{item.whenLabel}}</view>
            <view class="mag-stars">
            <text class="mag-star {{star <= item.score ? 'on' : ''}}" wx:for="{{[1,2,3,4,5]}}" wx:for-item="star" wx:key="*this">★</text>
            </view>
          </view>
        </view>
        <view class="mag-hmore tap-scale" bindtap="goCookLog">查看全部记录 ›</view>
      </view>
    </view>
    <!-- 最近上桌：加载骨架 -->
    <view class="g-fade-up g-d2" wx:elif="{{loading}}">
      <section-head eyebrow="做菜记录" title="最近上桌" />
      <view class="card mag-history">
        <view class="mag-hrow" wx:for="{{[1,2]}}" wx:key="*this">
          <view class="mag-skel-thumb shimmer"></view>
          <view class="mag-hmid">
            <view class="mag-skel-line strong shimmer"></view>
            <view class="mag-skel-line shimmer"></view>
          </view>
        </view>
      </view>
    </view>

    <!-- 口味偏好 -->
    <view class="g-fade-up g-d4" wx:if="{{prefBars.length}}">
      <section-head eyebrow="吃过记得" title="家庭口味" />
      <view class="card mag-pref">
        <view class="mag-prow" wx:for="{{prefBars}}" wx:key="label">
          <view class="mag-ptop">
            <view class="mag-pl">{{item.isCuisine ? '偏爱' : ''}}{{item.label}}</view>
            <view class="mag-pr">{{item.right}}</view>
          </view>
          <view class="mag-pbar {{item.alt ? 'alt' : ''}}"><view class="mag-pbar-i" style="width:{{item.pct}}%"></view></view>
        </view>
      </view>
    </view>
    <!-- 口味偏好：加载骨架 -->
    <view class="g-fade-up g-d4" wx:elif="{{loading}}">
      <section-head eyebrow="吃过记得" title="家庭口味" />
      <view class="card mag-pref">
        <view class="mag-prow" wx:for="{{[1,2,3]}}" wx:key="*this">
          <view class="mag-skel-line strong shimmer" style="width: 40%;"></view>
          <view class="mag-skel-bar shimmer"></view>
        </view>
      </view>
    </view>

    <!-- 偏好画像入口：直接 merge 到设置 card -->
    <view class="g-fade-up g-d5">
      <section-head eyebrow="全家口味" title="偏好画像" />
      <view class="card mag-tools">
        <view class="mag-trow tap-scale" bindtap="goPreference">
          <view class="mag-ticon ti-pref">偏</view>
          <view class="mag-tmid">
            <view class="mag-tname">我的偏好画像</view>
            <view class="mag-tdesc">口味、忌口、菜系偏好设置</view>
          </view>
          <view class="mag-tarrow">›</view>
        </view>
        <view class="mag-trow tap-scale" bindtap="goFamilyMembers">
          <view class="mag-ticon ti-fam">家</view>
          <view class="mag-tmid">
            <view class="mag-tname">家庭成员管理</view>
            <view class="mag-tdesc">添加成员、设置角色权限</view>
          </view>
          <view class="mag-tarrow">›</view>
        </view>
      </view>
    </view>

    <!-- 设置 & 关于 -->
    <view class="g-fade-up g-d6">
      <view class="card mag-settings">
        <view class="mag-srow tap-scale" bindtap="goProfileEdit">
          <view class="mag-sname">编辑资料</view>
          <view class="mag-sarrow">›</view>
        </view>
        <view class="mag-srow tap-scale" bindtap="goNotifications">
          <view class="mag-sname">消息</view>
          <view class="mag-sarrow">›</view>
        </view>
        <view class="mag-srow tap-scale" bindtap="goSettings">
          <view class="mag-sname">设置</view>
          <view class="mag-sarrow">›</view>
        </view>
        <view class="mag-srow tap-scale" bindtap="goFeedback">
          <view class="mag-sname">意见反馈</view>
          <view class="mag-sarrow">›</view>
        </view>
        <view class="mag-srow tap-scale" bindtap="goAbout">
          <view class="mag-sname">关于我们</view>
          <view class="mag-sarrow">›</view>
        </view>
        <view class="mag-srow tap-scale" bindtap="goPrivacy">
          <view class="mag-sname">隐私政策</view>
          <view class="mag-sarrow">›</view>
        </view>
        <view class="mag-srow tap-scale last" bindtap="goTerms">
          <view class="mag-sname">用户协议</view>
          <view class="mag-sarrow">›</view>
        </view>
      </view>
    </view>

    <view class="mag-footer">{{appVersion || 'v1.0.0'}} · 家庭版</view>
  </view>
</view>
