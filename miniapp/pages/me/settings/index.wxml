<!-- 设置页 · 视觉对标 settings.html，配色全部走全局 token -->
<nav-bar title="设置" show-back="{{true}}" status-bar-height="{{statusBarHeight}}"></nav-bar>

<view class="container settings">
  <!-- Hero eyebrow + 镂空标题 -->
  <view class="set-hero g-fade-up">
    <view class="eyebrow-serif">偏好设置</view>
    <view class="set-hero-title">设<text class="pop">置</text></view>
  </view>

  <!-- 账号安全 -->
  <view class="set-group g-fade-up g-d1">
    <view class="set-gtitle">Account &amp; Security</view>
    <view class="card set-card">
      <view
        class="set-item tap-scale"
        wx:for="{{accountList}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="onAccountTap"
      >
        <view class="set-ic"><text class="set-glyph">{{item.icon === 'phone' ? '手' : '微'}}</text></view>
        <view class="set-mid"><view class="set-name">{{item.name}}</view></view>
        <text wx:if="{{item.value}}" class="set-val">{{item.value}}</text>
        <view class="set-chev"></view>
      </view>
    </view>
  </view>

  <!-- 通知 -->
  <view class="set-group g-fade-up g-d2">
    <view class="set-gtitle">消息通知</view>
    <view class="card set-card">
      <view
        class="set-item"
        wx:for="{{notifyList}}"
        wx:key="key"
      >
        <view class="set-ic"><text class="set-glyph">{{item.icon === 'bell' ? '铃' : item.icon === 'chat' ? '评' : '推'}}</text></view>
        <view class="set-mid">
          <view class="set-name">{{item.name}}</view>
          <view wx:if="{{item.desc}}" class="set-desc">{{item.desc}}</view>
        </view>
        <view
          class="set-sw {{item.on ? 'on' : ''}} tap-scale"
          data-key="{{item.key}}"
          catchtap="onSwitchTap"
        >
          <view class="set-sw-knob"></view>
        </view>
      </view>
    </view>
  </view>

  <!-- 通用 -->
  <view class="set-group g-fade-up g-d3">
    <view class="set-gtitle">通用</view>
    <view class="card set-card">
      <view
        class="set-item tap-scale"
        wx:for="{{generalList}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="onGeneralTap"
      >
        <view class="set-ic"><text class="set-glyph">{{item.key === 'font' ? 'A' : '⟳'}}</text></view>
        <view class="set-mid"><view class="set-name">{{item.name}}</view></view>
        <text wx:if="{{item.value}}" class="set-val">{{item.value}}</text>
        <view class="set-chev"></view>
      </view>
    </view>
  </view>

  <!-- 关于 -->
  <view class="set-group g-fade-up g-d4">
    <view class="set-gtitle">关于</view>
    <view class="card set-card">
      <view
        class="set-item tap-scale"
        wx:for="{{aboutList}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="onAboutTap"
      >
        <view class="set-ic"><text class="set-glyph">{{item.icon === 'doc' ? '约' : item.icon === 'shield' ? '隐' : item.icon === 'info' ? '关' : '馈'}}</text></view>
        <view class="set-mid"><view class="set-name">{{item.name}}</view></view>
        <text wx:if="{{item.value}}" class="set-val">{{item.value}}</text>
        <view class="set-chev"></view>
      </view>
    </view>
  </view>

  <!-- 退出登录 红卡 -->
  <view class="set-logout g-fade-up g-d5">
    <view class="card set-logout-card tap-scale" bindtap="onLogoutTap">
      <text class="set-logout-txt">退出登录</text>
    </view>
  </view>

  <!-- 版本号 -->
  <view class="set-ver g-fade-in g-d6">
    家庭点菜 <text class="set-ver-num">{{version}}</text> · © {{year}}
  </view>

  <view class="safe-bottom"></view>
</view>

<!-- 退出确认弹窗 -->
<state-dialog
  visible="{{logoutVisible}}"
  variant="danger"
  title="确认退出登录？"
  content="退出后将清除本地登录状态，需重新登录才能同步家庭菜单。"
  confirm-text="退出登录"
  cancel-text="再想想"
  bind:confirm="onLogoutConfirm"
  bind:cancel="onLogoutCancel"
></state-dialog>

<!-- 轻提示 -->
<state-toast
  visible="{{toastVisible}}"
  type="center"
  text="{{toastText}}"
  bind:close="onToastClose"
></state-toast>
