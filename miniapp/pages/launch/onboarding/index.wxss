/* ============================================================
   pages/launch/onboarding · 启动引导
   全屏 swiper hero + 镂空大数字 + 品牌 badge + 进度点
   仅用全局 token：--paper/--ink/--pop/--gold-deep/--serif/--ink-deep
   ============================================================ */
.ob-root {
  position: relative;
  width: 100%;
  height: 100vh;
  background: var(--paper);
  overflow: hidden;
}

.ob-swiper { width: 100%; height: 100vh; }
.ob-item { width: 100%; height: 100%; position: relative; }

/* ===== hero 图区 ===== */
.ob-hero {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 1078rpx;
  overflow: hidden;
}
.ob-hero-img { width: 100%; height: 100%; display: block; }
.ob-hero-mask {
  position: absolute; inset: 0;
  background: linear-gradient(
    180deg,
    rgba(20, 14, 8, 0.55) 0%,
    rgba(20, 14, 8, 0.1) 24%,
    rgba(58, 46, 35, 0.12) 52%,
    rgba(176, 137, 73, 0.32) 74%,
    rgba(251, 248, 243, 0.86) 88%,
    var(--paper) 100%
  );
}
.ob-bignum {
  position: absolute;
  top: 168rpx; left: 30rpx;
  font-family: var(--serif);
  font-size: 384rpx;
  font-weight: 700;
  line-height: 1;
  color: rgba(255, 255, 255, 0.08);
  pointer-events: none;
}

/* ===== 内容区 ===== */
.ob-content {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  z-index: 20;
  padding: 0 58rpx 84rpx;
}
.ob-tag {
  display: block;
  margin-bottom: 26rpx;
  font-size: 24rpx;
  letter-spacing: 3rpx;
  color: var(--gold-deep);
}
.ob-title {
  font-family: var(--sans);
  font-weight: 900;
  letter-spacing: -6rpx;
  color: var(--ink);
}
.ob-line {
  display: block;
  font-size: 120rpx;
  line-height: 1.04;
}
.ob-line .pop { color: var(--pop); }
.ob-slogan {
  display: block;
  margin-top: 34rpx;
  max-width: 580rpx;
  font-size: 30rpx;
  line-height: 1.6;
  font-weight: 500;
  color: var(--mut-strong);
}

/* ===== 进度点 ===== */
.ob-dots {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 64rpx;
}
.ob-dot {
  width: 16rpx; height: 16rpx;
  border-radius: 999rpx;
  background: var(--paper-2);
  transition: width 0.3s var(--g-power3-out), background 0.3s;
}
.ob-dot.on {
  width: 50rpx;
  background: var(--pop);
}

/* ===== 操作 ===== */
.ob-actions { margin-top: 56rpx; }
.ob-next {
  width: 100%;
  height: 108rpx;
  gap: 14rpx;
  font-size: 32rpx;
  letter-spacing: 1rpx;
}
.ob-arrow {
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1;
}
.ob-skip-link {
  display: block;
  text-align: center;
  margin-top: 34rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--mut-strong);
}

/* ===== 品牌 badge ===== */
.ob-brand {
  position: absolute;
  top: 116rpx; left: 46rpx;
  z-index: 30;
  display: flex;
  align-items: center;
  gap: 18rpx;
  pointer-events: none;
}
.ob-logo {
  width: 74rpx; height: 74rpx;
  border-radius: var(--r-md);
  background: var(--pop);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--sh-pop);
}
.ob-logo-ico {
  color: #fff;
  font-size: 38rpx;
  font-weight: 900;
}
.ob-bname {
  color: #fff;
  font-size: 30rpx;
  font-weight: 800;
  letter-spacing: -0.5rpx;
  line-height: 1.2;
}
.ob-bname-en {
  display: block;
  font-family: var(--serif);
  font-style: italic;
  font-weight: 600;
  font-size: 19rpx;
  letter-spacing: 3rpx;
  opacity: 0.82;
  margin-top: 2rpx;
}

/* ===== 跳过 ===== */
.ob-skip {
  position: absolute;
  top: 120rpx; right: 46rpx;
  z-index: 30;
  display: flex;
  align-items: center;
  gap: 6rpx;
  color: rgba(255, 255, 255, 0.92);
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}
.ob-skip-arrow { font-size: 32rpx; font-weight: 900; line-height: 1; }
