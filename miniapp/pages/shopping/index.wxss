/* ============================================================
   买菜清单 · 精致美食杂志撞色风（设计稿 shopping-final.html）
   全部走 app.wxss 全局 token：--paper/--ink/--pop/--gold-deep/--pine 等
   ============================================================ */
.mkt-page {
  position: relative;
  min-height: 100vh;
  background: var(--paper);
}

/* 工具页采用紧凑页头，清单直接进入首屏。 */
.mkt-sheet { padding: 8rpx 0 calc(40rpx + env(safe-area-inset-bottom)); }
.mkt-pad { padding: 0 var(--page-gutter); }

/* 进度条卡片 */
.mkt-pbar { margin: 0 var(--page-gutter) 16rpx; padding: 20rpx var(--pad-card-sm); box-shadow: none; }
.mkt-pbar-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.mkt-pbar-head .l { font-size: var(--fs-cap); font-weight: 800; color: var(--ink); }
.mkt-pbar-head .r { font-size: var(--fs-cap); font-weight: 900; color: var(--pop); }
.mkt-ptrack {
  height: 10rpx;
  border-radius: 12rpx;
  background: var(--paper-2);
  overflow: hidden;
}
.mkt-pfill {
  height: 100%;
  border-radius: 12rpx;
  background: linear-gradient(90deg, var(--orange), var(--pop-fill));
  box-shadow: 0 2rpx 8rpx rgba(200, 56, 31, 0.4);
}

/* 分组标题 ghead 彩 dot */
.mkt-ghead {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 30rpx 0 16rpx;
}
.mkt-gdot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  flex: none;
}
.mkt-gdot.veg { background: var(--pine); }
.mkt-gdot.meat { background: var(--pop-fill); }
.mkt-gdot.spice { background: var(--gold-deep); }
.mkt-gdot.other { background: var(--mut); }
.mkt-gname { font-size: calc(32rpx * var(--fs-mul, 1)); font-weight: 800; color: var(--ink); }
.mkt-gen { font-family: var(--serif); font-size: var(--fs-cap); color: var(--mut); font-weight: 700; }
.mkt-gcount {
  margin-left: auto;
  font-size: calc(23rpx * var(--fs-mul, 1));
  font-weight: 700;
  color: var(--mut);
  background: var(--paper-2);
  padding: 6rpx 22rpx;
  border-radius: var(--r-pill);
}

/* item：一样一行——小料图 + 名字用量 + 右侧「买好了」「×」（原来左边 168rpx 大图块、按钮另起一行，一屏只放得下三样半） */
.mkt-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--c-surface);
  border-radius: var(--r-card);
  padding: 16rpx var(--pad-card-sm);
  margin-bottom: 12rpx;
  border: var(--bd-card);
  box-shadow: none;
}
.mkt-check {
  box-sizing: border-box;
  width: 52rpx;
  height: 52rpx;
  border-radius: 18rpx;
  border: 4rpx solid var(--line-deep);
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
}
.mkt-thumb {
  width: var(--tile-chip);
  height: var(--tile-chip);
  border-radius: var(--r-sm);
  flex: none;
  background: var(--paper-2);
}
.mkt-thumb--letter {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: calc(32rpx * var(--fs-mul, 1));
  font-weight: 800;
  color: var(--ink);
}
.mkt-thumb--letter.veg { background: var(--c-accent-soft); color: var(--pine-ink); }
.mkt-thumb--letter.meat { background: var(--pop-soft); color: var(--pop); }
.mkt-thumb--letter.seasoning,
.mkt-thumb--letter.season,
.mkt-thumb--letter.spice { background: var(--paper-2); color: var(--gold-deep); }
.mkt-imid { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.mkt-namebar { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4rpx 16rpx; }
.mkt-imid .nm { min-width: 0; font-size: calc(32rpx * var(--fs-mul, 1)); font-weight: 800; color: var(--ink); word-break: break-all; line-height: 1.4; }
.mkt-imid .amt { max-width: 100%; font-size: var(--fs-sub); font-weight: 700; color: var(--pop); line-height: 1.4; word-break: break-all; }
.mkt-tags { display: flex; flex-direction: column; gap: 4rpx; margin-top: 4rpx; }
.mkt-tags .src {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: var(--fs-cap);
  font-weight: 500;
  color: var(--mut-strong);
  padding: 0;
  border-radius: var(--r-pill);
  line-height: 1.5;
}
.mkt-tags .src.pantry { color: var(--pine-ink); }

/* done 态：灰底、删除线、绿勾 */
.mkt-item.done {
  background: var(--paper-2);
  box-shadow: none;
  border-color: var(--paper-2);
}
.mkt-check.done {
  background: var(--pine);
  border-color: var(--pine);
}
.mkt-tick {
  width: 22rpx;
  height: 12rpx;
  border-left: 5rpx solid var(--c-surface);
  border-bottom: 5rpx solid var(--c-surface);
  transform: translateY(-3rpx) rotate(-45deg);
}
.mkt-item.done .nm,
.mkt-item.done .amt {
  color: var(--mut-strong);
  text-decoration: line-through;
}
.mkt-item.done .mkt-thumb { opacity: 0.45; }

/* shead 已入篮 / 加购 */
.mkt-shead { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin: 28rpx 0 14rpx; font-size: calc(32rpx * var(--fs-mul, 1)); font-weight: 800; color: var(--ink); }
.mkt-section-count { font-size: var(--fs-cap); font-weight: 500; color: var(--mut-strong); }
.mkt-stock { min-height: var(--tap-min); display: flex; align-items: center; padding: 0 24rpx; border-radius: var(--r-pill); border: 2rpx solid var(--line-deep); font-size: var(--fs-cap); font-weight: 600; color: var(--pine-ink); }
.mkt-stock.is-busy { opacity: .5; }

/* 临时加购：一行输入 + 次级「添加」，常用食材在下方；配图缩成输入框左侧的小方块 */
.mkt-addbar {
  margin: 0 var(--page-gutter) 8rpx;
  background: var(--c-surface);
  border: var(--bd-card);
  border-radius: var(--r-card);
  padding: 16rpx var(--pad-card-sm) 12rpx;
}
.mkt-add-row { display: flex; align-items: center; gap: 12rpx; }
.mkt-add-pic {
  flex: none;
  box-sizing: border-box;
  width: var(--tap-min);
  height: var(--tap-min);
  border-radius: var(--r-sm);
  border: 2rpx dashed var(--line-deep);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.mkt-add-pic-img { width: 100%; height: 100%; }
.mkt-add-pic-txt { font-size: var(--fs-mini); color: var(--mut-strong); }
.mkt-add-input {
  flex: 1;
  width: 0;
  box-sizing: border-box;
  min-width: 0;
  min-height: 88rpx;
  border: var(--bd-card);
  border-radius: var(--r-sm);
  background: var(--paper-2);
  padding: 0 16rpx;
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--ink);
}
.mkt-add-quantity { display: flex; gap: 12rpx; margin-top: 12rpx; }
.mkt-ph { color: var(--mut); font-weight: 400; }   /* 与冰箱页 .af-ph 同色；--mut-2 在输入底上只有约 2:1，而这几格没有标签，占位字就是标签 */
/* 次级按钮：.btn .btn-ghost 给底色描边，这里只收窄左右留白 */
.mkt-addbtn { flex: none; padding: 0 28rpx; }
.mkt-addbtn.is-busy { opacity: .6; }

/* quick 横滑：在加购卡内，左右贴卡边 */
.mkt-quicks { width: 100%; white-space: nowrap; padding-top: 12rpx; }
.mkt-quicks-inner { display: inline-flex; gap: 12rpx; }
.mkt-quick {
  flex: none;
  font-size: var(--fs-sub);
  font-weight: 500;
  color: var(--mut-strong);
  background: var(--paper-2);
  box-sizing: border-box;
  min-height: var(--tap-min);
  display: inline-flex;
  align-items: center;
  padding: 0 26rpx;
  border-radius: var(--r-pill);
  white-space: nowrap;
}
.mkt-quick .plus { color: var(--mut); margin-right: 6rpx; font-weight: 700; }

.mkt-refresh-wrap { margin-top: 40rpx; }

/* 骨架屏：形状对齐真行 .mkt-item（左侧图块 + 右侧文字），加载完不跳版 */
.mkt-sk {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 12rpx;
  padding: 16rpx var(--pad-card-sm);
  box-shadow: none;
}
/* 图块替身 = 真行左侧的 .mkt-photo（清单行里是 --tile-chip、--r-sm），加载完不跳版 */
.mkt-sk-dot { width: var(--tile-chip); height: var(--tile-chip); border-radius: var(--r-sm); flex: none; }
.mkt-sk-lines { flex: 1; }
.mkt-sk-line { height: 22rpx; border-radius: var(--r-xs); margin-top: 14rpx; width: 60%; }
.mkt-sk-line.strong { width: 40%; height: 30rpx; margin-top: 0; }

/* ====== 购物/库存 tab ====== */
.sp-seg {
  display: flex;
  margin: 0 var(--page-gutter) 24rpx;
  background: var(--paper-2);
  border-radius: var(--r-pill);
  padding: 6rpx;
  gap: 4rpx;
}
.sp-seg-item {
  flex: 1;
  /* 分段 tab 高度 88rpx */
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-body);   /* 与点菜页 .mn-seg-item 同档 */
  font-weight: 700;
  color: var(--mut-strong);
  border-radius: var(--r-pill);
}
.sp-seg-item.on {
  background: var(--seg-thumb);   /* 浅色档 = 卡面；深色档卡面与轨道同色，滑块会消失 */
  color: var(--ink);
  box-shadow: var(--sh-card);
}

/* 库存视图 */
.sp-pantry-wrap { padding: 0 var(--page-gutter) 32rpx; }
.sp-pcat { margin-bottom: 30rpx; }
.sp-pcat-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0 10rpx;
  border-bottom: 2rpx solid var(--paper-2);
  margin-bottom: 6rpx;
}
.sp-pcat-label { font-size: calc(25rpx * var(--fs-mul, 1)); font-weight: 800; color: var(--gold-deep); letter-spacing: 1rpx; }
.sp-pcat-count { font-size: calc(23rpx * var(--fs-mul, 1)); color: var(--mut); }
.sp-pitem {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 0;
  border-bottom: 2rpx solid var(--paper-2);
}
.sp-pitem-name { flex: 1; min-width: 0; font-size: calc(28rpx * var(--fs-mul, 1)); font-weight: 700; color: var(--ink); }
.sp-pitem-qty { font-size: calc(25rpx * var(--fs-mul, 1)); color: var(--mut-strong); font-weight: 600; }
.sp-pitem-del {
  position: relative;
  width: 64rpx; height: 64rpx;   /* 适老触点 ≥64rpx（原 48rpx 偏小） */
  display: flex; align-items: center; justify-content: center;
  border-radius: 50%;
  background: var(--paper-2);
  font-size: calc(28rpx * var(--fs-mul, 1)); color: var(--mut);
  border: 2rpx solid var(--c-border);
}
.sp-pitem-del::after {
  content: '';
  position: absolute;
  left: 50%; top: 50%;
  width: 88rpx; height: 88rpx;
  transform: translate(-50%, -50%);
}
.sp-pantry-empty { padding: 8rpx 0; }
.sp-pantry-add-btn { margin-top: 24rpx; }
.sp-pantry-form {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
  flex-wrap: wrap;
}
.sp-pantry-form > .mkt-add-input:first-child { flex-basis: 100%; }
/* 内层圆角不大于外层 .mkt-item（--r-card） */
.mkt-photo { position: relative; flex: none; width: var(--tile-list-wide); height: var(--tile-list-wide); overflow: hidden; border-radius: var(--r-sm); }
.mkt-photo .mkt-thumb { width: 100%; height: 100%; padding: 0 12rpx; box-sizing: border-box; text-align: center; word-break: break-all; font-size: var(--fs-lg); line-height: 1.4; }
.mkt-photo image.mkt-thumb { padding: 0; }
.mkt-photo .mkt-thumb--letter { padding-bottom: 36rpx; }
.mkt-photo .mkt-thumb--letter > text { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.mkt-photo-hint { position: absolute; right: 6rpx; bottom: 6rpx; padding: 4rpx 10rpx; border-radius: var(--r-xs); background: var(--c-surface); color: var(--mut-strong); font-size: var(--fs-mini); line-height: 1.2; }
/* 清单行里的料图缩回 --tile-chip，只写第一个字（同菜谱详情的用料表）；换图入口在列表底下说一次 */
.mkt-item .mkt-photo { width: var(--tile-chip); height: var(--tile-chip); }
.mkt-item .mkt-photo .mkt-thumb--letter { padding: 0; }
.mkt-photo-note--foot { margin: 8rpx 0 0; }
.mkt-item-actions { flex: none; display: flex; align-items: center; gap: 12rpx; }
/* 「买好了」：没买的时候是白底松绿细边 + 空心圈，像一个还没打勾的框；
   原来的绿底带勾看着像「已经买好了」。点了这样就挪到「已入篮」。
   88rpx 高；「×」用同页「家里已有」的小圆，比它弱一级 */
.mkt-buy { box-sizing: border-box; display: flex; align-items: center; justify-content: center; flex: none; min-height: 88rpx; margin: 0; padding: 0 22rpx; gap: 12rpx; border-radius: var(--r-sm); background: var(--c-surface); border: 2rpx solid currentColor; color: var(--pine-ink); font-size: var(--fs-cap); font-weight: 700; line-height: 1.4; }
.mkt-buy-box { flex: none; width: 30rpx; height: 30rpx; box-sizing: border-box; border: 3rpx solid currentColor; border-radius: 50%; }
.mkt-buy::after { border: 0; }
/* style v2 的 button:not([size=mini]) 默认 width: 184px，优先级比单个类名高，要两级类名才盖得住 */
.mkt-item-actions .mkt-buy { width: auto; }
.mkt-bought { font-size: var(--fs-cap); color: var(--pine-ink); line-height: 1.5; margin-top: 4rpx; }
.sp-pitem-copy { flex: 1; min-width: 0; }
.sp-pitem-name { word-break: break-all; line-height: 1.5; }
.sp-pitem-qty { margin-top: 8rpx; }
.mkt-photo-note { font-size: var(--fs-mini); color: var(--mut); padding: 0 var(--page-gutter); margin-bottom: 16rpx; line-height: 1.5; }

/* 深色档：--pine(#4e6b58) 当文字只有约 2.6:1，与首页/会员页同法换 --c-success
   （「买好了」用的 --pine-ink 在深色档已经是浅松绿，不用另写） */
@media (prefers-color-scheme: dark) {
  .mkt-tags .src.pantry, .mkt-bought, .mkt-thumb--letter.veg { color: var(--c-success); }
}
