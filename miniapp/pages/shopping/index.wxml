<!-- 买菜清单 · 当前菜单的备菜工具 -->
<view class="mkt-page {{fontScale === 'lg' ? 'font-lg' : ''}}">
  <nav-bar title="买菜清单" show-back="{{true}}" />
  <view class="cpt-head">
    <view class="cpt-eyebrow">备好食材，再开火</view>
    <view class="cpt-title">今天的菜篮子</view>
    <view class="cpt-sub">跟着今日菜单买，家里已有的食材先用起来。</view>
  </view>

  <!-- SHEET · 内容区 -->
  <view class="mkt-sheet">
    <!-- 顶部 tab：待买 / 家里已有 -->
    <view class="sp-seg">
      <view class="tap-scale sp-seg-item {{tab === 'shopping' ? 'on' : ''}}" data-tab="shopping" bindtap="switchTab" aria-role="tab" aria-selected="{{tab === 'shopping'}}">待买清单</view>
      <view class="tap-scale sp-seg-item {{tab === 'pantry' ? 'on' : ''}}" data-tab="pantry" bindtap="switchTab" aria-role="tab" aria-selected="{{tab === 'pantry'}}">家里已有 {{pantryCount ? '(' + pantryCount + ')' : ''}}</view>
    </view>

    <!-- 只在当前视图真有食材图位时提示：空态/失败态/骨架下没有图可缺 -->
    <view class="mkt-photo-note" wx:if="{{ingredientPhotosFailed && (tab === 'shopping' ? (!loading && !loadError && shoppingList.items.length) : (!pantryError && pantryCategories.length))}}">食材图片暂未同步</view>

    <!-- 待买清单视图 -->
    <block wx:if="{{tab === 'shopping'}}">
    <!-- 进度条卡片 -->
    <view wx:if="{{!loading && !loadError && summary.totalCount}}" class="mkt-pbar card g-fade-up g-d1">
      <view class="mkt-pbar-head">
        <text class="l">采购进度</text>
        <text class="r">{{summary.purchasedCount}} / {{summary.totalCount}} 样</text>
      </view>
      <view class="mkt-ptrack">
        <view class="mkt-pfill" style="width: {{summary.progressPercent}}%;"></view>
      </view>
    </view>

    <!-- 骨架屏 -->
    <view class="mkt-pad" wx:if="{{loading}}">
      <view class="mkt-sk card" wx:for="{{skeletonRows}}" wx:key="*this">
        <view class="mkt-sk-dot skeleton shimmer"></view>
        <view class="mkt-sk-lines">
          <view class="mkt-sk-line strong skeleton shimmer"></view>
          <view class="mkt-sk-line skeleton shimmer"></view>
        </view>
      </view>
    </view>

    <block wx:if="{{!loading}}">
      <!-- 加载失败态 -->
      <view wx:if="{{loadError}}" class="mkt-pad">
        <state-empty type="offline" title="清单没加载出来" desc="网络开小差了，检查后再试" cta="重新加载" bind:action="retryLoad" />
      </view>

      <!-- 空态：原因两种（没点菜 / 点了的菜没录用料），文案与出路都由 emptyState 给 -->
      <view wx:elif="{{!shoppingList.items.length}}" class="mkt-pad">
        <state-empty
          title="{{emptyState.title}}"
          desc="{{emptyState.desc}}"
          cta="{{emptyState.cta}}"
          bind:action="goRecipes"
        ></state-empty>
      </view>

      <!-- 待买分组 -->
      <view class="mkt-pad" wx:for="{{groupedPending}}" wx:key="key" wx:for-item="group" wx:for-index="gidx">
        <view class="mkt-ghead g-fade-up">
          <view class="mkt-gdot {{group.key === 'seasoning' ? 'spice' : group.key}}"></view>
          <text class="mkt-gname">{{group.label}}</text>
          <text class="mkt-gcount">{{group.items.length}} 样</text>
        </view>

        <view class="tap-scale mkt-item {{revealOn ? (reveal[group.key + '-' + idx] ? 'g-fade-up' : 'rv-hold') : 'g-fade-up g-d' + (idx % 5 + 1)}}" data-rv="{{group.key + '-' + idx}}" wx:for="{{group.items}}" wx:for-item="food" wx:for-index="idx" wx:key="itemId" data-id="{{food.itemId}}" data-purchased="{{food.purchased}}" bindtap="toggleItem">
          <view class="mkt-photo tap-scale" data-name="{{food.ingredientName}}" catchtap="editIngredientPhoto" aria-role="button" aria-label="为{{food.ingredientName}}拍照、从相册选图或恢复文字显示">
            <image wx:if="{{food.cover && !food.coverBroken}}" class="mkt-thumb" src="{{food.cover}}" mode="aspectFill" lazy-load data-err-key="groupedPending[{{gidx}}].items[{{idx}}].coverBroken" binderror="onIngredientPhotoError" />
            <view wx:else class="mkt-thumb mkt-thumb--letter {{food.categoryKey}}"><text>{{food.ingredientName}}</text></view>
          <text class="mkt-photo-hint">{{food.cover && !food.coverBroken ? '换图' : '拍照'}}</text>
          </view>
          <view class="mkt-imid">
            <view class="mkt-namebar"><text class="nm">{{food.ingredientName}}</text><text class="amt">{{food.amount}} {{food.unit}}</text></view>
            <view class="mkt-tags" wx:if="{{food.sourceText || food.pantryText}}"><text class="src" wx:if="{{food.sourceText}}">{{food.sourceText}}</text><text class="src pantry" wx:if="{{food.pantryText}}">{{food.pantryText}}</text></view>
            <view class="mkt-item-actions">
              <button class="mkt-buy tap-scale" hover-class="none" data-id="{{food.itemId}}" data-purchased="{{food.purchased}}" catchtap="toggleItem" aria-label="{{food.ingredientName}}买好了"><image src="/assets/icons/lucide/check.svg" mode="aspectFit" aria-hidden="true" /><text>买好了</text></button>
              <button class="mkt-del tap-scale" hover-class="none" data-id="{{food.itemId}}" catchtap="deleteItem" aria-label="移除{{food.ingredientName}}">移除</button>
            </view>
          </view>
        </view>
      </view>

      <!-- 已入篮分组 -->
      <view class="mkt-pad" wx:if="{{summary.purchasedCount}}">
        <view class="mkt-shead">
          <text>已入篮</text><text class="mkt-section-count">{{summary.purchasedCount}} 样</text>
        </view>

        <block wx:for="{{groupedPurchased}}" wx:key="key" wx:for-item="group" wx:for-index="gidx">
          <view class="tap-scale mkt-item done" wx:for="{{group.items}}" wx:for-item="food" wx:for-index="idx" wx:key="itemId" data-id="{{food.itemId}}" data-purchased="{{food.purchased}}" bindtap="toggleItem">
            <view class="mkt-photo tap-scale" data-name="{{food.ingredientName}}" catchtap="editIngredientPhoto" aria-role="button" aria-label="为{{food.ingredientName}}拍照、从相册选图或恢复文字显示">
              <image wx:if="{{food.cover && !food.coverBroken}}" class="mkt-thumb" src="{{food.cover}}" mode="aspectFill" lazy-load data-err-key="groupedPurchased[{{gidx}}].items[{{idx}}].coverBroken" binderror="onIngredientPhotoError" />
              <view wx:else class="mkt-thumb mkt-thumb--letter {{food.categoryKey}}"><text>{{food.ingredientName}}</text></view>
            <text class="mkt-photo-hint">{{food.cover && !food.coverBroken ? '换图' : '拍照'}}</text>
            </view>
            <view class="mkt-imid">
              <view class="mkt-namebar"><text class="nm">{{food.ingredientName}}</text><text class="amt">{{food.amount}} {{food.unit}}</text></view><view class="mkt-bought">已入篮 · 点击可恢复待买</view>
            </view>
          </view>
        </block>
      </view>

      <!-- 临时加购 -->
      <view class="mkt-pad">
        <view class="mkt-shead">
          <text>临时加购</text><text class="mkt-section-count">顺手再买点</text>
        </view>
      </view>

      <view class="mkt-addbar">
        <view class="mkt-photo mkt-draft-photo tap-scale" catchtap="editNewItemPhoto" aria-role="button" aria-label="为新食材拍照或从相册添加图片">
          <image wx:if="{{newItemCover && !newItemCoverBroken}}" class="mkt-thumb" src="{{newItemCover}}" mode="aspectFill" data-err-key="newItemCoverBroken" binderror="onIngredientPhotoError" />
          <view wx:else class="mkt-thumb mkt-thumb--letter"><text class="mkt-draft-name">{{newItem.ingredientName || '添加图片'}}</text></view>
          <text class="mkt-photo-hint">{{newItemCover && !newItemCoverBroken ? '换图' : '拍照 / 选图'}}</text>
        </view>
        <view class="mkt-add-fields">
          <input class="mkt-add-input" placeholder="食材名，如番茄" placeholder-class="mkt-ph" value="{{newItem.ingredientName}}" data-field="ingredientName" bindinput="onNewItemInput" maxlength="50" />
          <view class="mkt-add-quantity">
            <input class="mkt-add-input sm" placeholder="数量" placeholder-class="mkt-ph" value="{{newItem.amount}}" data-field="amount" bindinput="onNewItemInput" />
            <input class="mkt-add-input sm" placeholder="单位，如个" placeholder-class="mkt-ph" value="{{newItem.unit}}" data-field="unit" bindinput="onNewItemInput" />
          </view>
        </view>
        <view class="mkt-add-footer">
          <text>清单 {{summary.totalCount}} 样 · 可连续添加</text>
          <view class="mkt-addbtn tap-scale {{addItemSubmitting ? 'is-busy' : ''}}" bindtap="addItem" aria-role="button" aria-disabled="{{addItemSubmitting}}">{{addItemSubmitting ? '添加中…' : '添加并继续'}}</view>
        </view>
      </view>

      <scroll-view class="mkt-quicks" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="mkt-quicks-inner">
          <view class="mkt-quick tap-scale {{addItemSubmitting ? 'is-busy' : ''}}" wx:for="{{quickItems}}" wx:key="ingredientName" data-name="{{item.ingredientName}}" data-amount="{{item.amount}}" data-unit="{{item.unit}}" bindtap="addQuickItem" aria-role="button" aria-label="加购{{item.ingredientName}}">
            <text class="plus">＋</text>{{item.ingredientName}}
          </view>
        </view>
      </scroll-view>

      <!-- 重新整理 -->
      <view class="mkt-pad mkt-refresh-wrap">
        <view class="btn btn-dark btn-block tap-scale" bindtap="refreshList" aria-role="button">按今日菜单重新整理</view>
      </view>
    </block>
    </block>

    <!-- 家里已有（库存）视图 -->
    <block wx:if="{{tab === 'pantry'}}">
      <view class="sp-pantry-wrap">
        <!-- 失败态：断网时不能再显示「冰箱还空着」——库存还在，只是没拉到 -->
        <view wx:if="{{pantryError}}" class="sp-pantry-empty">
          <state-empty type="offline" title="冰箱没加载出来" desc="网络开小差了，检查后再试" cta="重新加载" bind:action="retryPantry" />
        </view>
        <!-- 分类列表 -->
        <view wx:elif="{{pantryCategories.length}}">
          <view class="sp-pcat" wx:for="{{pantryCategories}}" wx:key="key" wx:for-index="cidx">
            <view class="sp-pcat-head">
              <text class="sp-pcat-label">{{item.label}}</text>
              <text class="sp-pcat-count">{{item.items.length}} 项</text>
            </view>
            <view class="sp-pitem" wx:for="{{item.items}}" wx:for-item="it" wx:for-index="pidx" wx:key="id">
              <view class="mkt-photo tap-scale" data-name="{{it.ingredientName || it.name}}" catchtap="editIngredientPhoto" aria-role="button" aria-label="为{{it.ingredientName || it.name}}拍照、从相册选图或恢复文字显示">
                <image wx:if="{{it.cover && !it.coverBroken}}" class="mkt-thumb" src="{{it.cover}}" mode="aspectFill" lazy-load data-err-key="pantryCategories[{{cidx}}].items[{{pidx}}].coverBroken" binderror="onIngredientPhotoError" />
                <view wx:else class="mkt-thumb mkt-thumb--letter {{it.categoryKey}}"><text>{{it.ingredientName || it.name}}</text></view>
              <text class="mkt-photo-hint">{{it.cover && !it.coverBroken ? '换图' : '拍照'}}</text>
              </view>
              <view class="sp-pitem-copy"><view class="sp-pitem-name">{{it.ingredientName || it.name}}</view><view class="sp-pitem-qty">{{it.amount || ''}} {{it.unit || ''}}</view></view>
              <view class="sp-pitem-del tap-scale" data-id="{{it.id || it.pantryItemId}}" catchtap="removePantryEntry" aria-role="button" aria-label="移除{{it.ingredientName || it.name}}">×</view>
            </view>
          </view>
        </view>
        <view class="sp-pantry-empty" wx:else>
          <state-empty title="冰箱还空着" desc="把家里的食材记下来，点菜时可以先用现有的" />
        </view>

        <!-- 添加入口 -->
        <view class="sp-pantry-add-btn tap-scale" bindtap="togglePantryForm" aria-role="button" aria-expanded="{{showPantryForm}}">
          {{showPantryForm ? '收起' : '+ 添加食材'}}
        </view>
        <view class="sp-pantry-form" wx:if="{{showPantryForm}}">
          <input class="mkt-add-input" placeholder="食材名" placeholder-class="mkt-ph"
            value="{{newPantryItem.ingredientName}}" data-field="ingredientName" bindinput="onPantryInput" />
          <input class="mkt-add-input sm" placeholder="数量" placeholder-class="mkt-ph"
            value="{{newPantryItem.amount}}" data-field="amount" bindinput="onPantryInput" />
          <input class="mkt-add-input sm" placeholder="单位" placeholder-class="mkt-ph"
            value="{{newPantryItem.unit}}" data-field="unit" bindinput="onPantryInput" />
          <view class="mkt-addbtn tap-scale {{pantryAdding ? 'is-busy' : ''}}" bindtap="addPantryEntry" aria-role="button" aria-disabled="{{pantryAdding}}">{{pantryAdding ? '保存中…' : '记入'}}</view>
        </view>
      </view>
    </block>

    <view class="safe-bottom"></view>
  </view>
</view>
