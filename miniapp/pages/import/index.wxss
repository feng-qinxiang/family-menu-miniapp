/* ============================================================
   pages/import · 导入配方 v2「精致撞色 · 设计稿 import-final」
   配色/工具类全部复用 app.wxss token，本文件不重定义配色。
   ============================================================ */
.imp-page {
  position: relative;
  min-height: 100vh;
  background: var(--paper);
}

/* 固定透明返回栏（叠在 hero 上）*/
.imp-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 60;
}
.imp-nav .navbar-title { color: var(--c-surface); text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.35); }
.imp-nav .navbar-back { background: rgba(255, 255, 255, 0.18); }
.imp-nav .navbar-back-icon { border-color: var(--c-surface); }

/* ============ HERO ============ */
.imp-hero {
  position: relative;
  height: 560rpx;
  overflow: hidden;
}
.imp-hero-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.imp-hero-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(20, 14, 8, 0.5) 0%, rgba(20, 14, 8, 0) 28%, rgba(20, 14, 8, 0.2) 52%, rgba(20, 14, 8, 0.9) 100%);
}
.imp-hero-bignum {
  position: absolute;
  top: 96rpx;
  right: 30rpx;
  font-family: var(--serif);
  font-size: 420rpx;
  font-weight: 700;
  line-height: 1;
  color: rgba(255, 255, 255, 0.07);
  pointer-events: none;
}
.imp-hero-body {
  position: absolute;
  left: 46rpx;
  right: 46rpx;
  bottom: 100rpx;
  z-index: 5;
  color: var(--c-surface);
}
.imp-tag {
  display: inline-block;
  font-family: var(--serif);
  font-style: italic;
  font-size: var(--fs-cap);
  letter-spacing: 2rpx;
  font-weight: 700;
  color: var(--c-surface);
  background: var(--pop);
  padding: 8rpx 22rpx;
  border-radius: var(--r-xs);
}
.imp-hero-title {
  font-size: var(--fs-hero-lg);
  line-height: 0.9;
  letter-spacing: -5rpx;
  margin: 26rpx 0 18rpx;
  -webkit-text-stroke: 3rpx var(--c-surface);
}
.imp-hero-sub {
  font-size: var(--fs-cap);
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.5;
  max-width: 560rpx;
}

/* ============ SHEET ============ */
.imp-sheet {
  position: relative;
  margin-top: -50rpx;
  background: var(--paper);
  border-radius: var(--r-sheet) var(--r-sheet) 0 0;
  padding: 50rpx 0 0;
  z-index: 10;
}
.imp-pad { padding: 0 28rpx; }

/* ============ 导入方式卡 ============ */
.imp-methods { display: flex; gap: 18rpx; padding: 0 28rpx; }
.imp-mcol { display: flex; flex-direction: column; gap: 18rpx; flex: 1; }
.imp-method {
  box-sizing: border-box;
  background: var(--c-surface);
  border-radius: 28rpx;
  padding: 26rpx 24rpx;
  border: var(--bd-card);
  box-shadow: var(--sh-soft);
}
.imp-method-main {
  position: relative;
  overflow: hidden;
  flex: 1;
  background: var(--ink-deep);
  border-color: var(--ink-deep);
  color: var(--paper);
}
.imp-method.on {
  border-color: var(--pop);
}
.imp-method-main.on { border-color: var(--pop); }
.imp-method-main .deco-circle {
  position: absolute;
  right: -40rpx;
  top: -40rpx;
  width: 170rpx;
  height: 170rpx;
  border-radius: 50%;
  background: rgba(232, 71, 42, 0.18);
}
.m-icon {
  position: relative;
  z-index: 2;
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  background: var(--pop-soft);
  display: flex;
  align-items: center;
  justify-content: center;
}
.m-icon-gold { background: rgba(244, 217, 168, 0.16); }
.m-name {
  position: relative;
  z-index: 2;
  font-size: 29rpx;
  font-weight: 800;
  color: var(--ink);
  margin-top: 20rpx;
  letter-spacing: -0.5rpx;
}
.imp-method-main .m-name { color: var(--paper); }
.m-desc {
  position: relative;
  z-index: 2;
  font-size: 22rpx;
  color: var(--mut);
  margin-top: 8rpx;
  line-height: 1.4;
}
.imp-method-main .m-desc { color: rgba(244, 217, 168, 0.8); }
.m-badge {
  position: relative;
  z-index: 2;
  display: inline-block;
  font-family: var(--serif);
  font-style: italic;
  font-size: 20rpx;
  font-weight: 700;
  color: var(--c-surface);
  background: var(--pop);
  padding: 5rpx 16rpx;
  border-radius: var(--r-xs);
  margin-top: 20rpx;
}

/* 图标（纯 CSS 描边）*/
.ic-link, .ic-text, .ic-cam, .ic-shield {
  width: 36rpx;
  height: 36rpx;
  position: relative;
}
.ic-link {
  width: 40rpx;
  height: 18rpx;
  border: 4rpx solid var(--gold);
  border-radius: var(--r-pill);
  transform: rotate(-30deg);
}
.ic-link::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 22rpx;
  height: 4rpx;
  background: var(--gold);
  transform: translate(-50%, -50%);
}
.ic-link-pop { border-color: var(--pop); }
.ic-link-pop::after { background: var(--pop); }
.ic-text {
  width: 40rpx;
  height: 32rpx;
  border: 4rpx solid var(--pop);
  border-radius: 6rpx;
}
.ic-text::after {
  content: "";
  position: absolute;
  left: 8rpx;
  top: 10rpx;
  width: 20rpx;
  border-top: 4rpx solid var(--pop);
  box-shadow: 0 10rpx 0 var(--pop);
}
.ic-cam {
  width: 40rpx;
  height: 30rpx;
  border: 4rpx solid var(--pop);
  border-radius: var(--r-xs);
}
.ic-cam::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 14rpx;
  height: 14rpx;
  border: 4rpx solid var(--pop);
  border-radius: 50%;
  transform: translate(-50%, -50%);
}
.ic-shield {
  width: 32rpx;
  height: 36rpx;
  border: 4rpx solid var(--pop);
  border-radius: 6rpx 6rpx 14rpx 14rpx;
}

/* ============ 粘贴区 ============ */
.sample {
  font-size: 24rpx;
  color: var(--gold-deep);
  font-weight: 700;
  flex: none;
  padding-bottom: 6rpx;
}
.ta-wrap { position: relative; padding: 28rpx; }
.ta-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 200rpx;
  font-size: var(--fs-cap);
  color: var(--ink);
  line-height: 1.65;
}
.ta-ph { color: var(--mut-2); }
.ta-cursor {
  position: absolute;
  left: 28rpx;
  top: 28rpx;
  width: 3rpx;
  height: 30rpx;
  background: var(--pop);
  animation: blink 1s steps(1) infinite;
  pointer-events: none;
}
.ta-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid var(--paper-2);
}
.ta-cnt { font-size: 22rpx; color: var(--mut-2); }
.parsebtn {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: var(--pop);
  color: var(--c-surface);
  font-size: var(--fs-cap);
  font-weight: 800;
  padding: 0 40rpx;
  min-height: 84rpx;
  border-radius: var(--r-pill);
  box-shadow: var(--sh-pop);
}

/* ============ 检测 banner ============ */
.imp-detected {
  display: flex;
  align-items: center;
  gap: 18rpx;
  background: var(--pop-soft);
  border: 2rpx solid var(--pop-mist);
  border-radius: var(--r-md);
  padding: 22rpx 26rpx;
  margin-top: 26rpx;
}
.dt-icon { flex: none; }
.dt-txt { font-size: 24rpx; color: var(--pop-deep); font-weight: 600; line-height: 1.45; }
.dt-txt .b { font-weight: 800; }

/* ============ 解析结果卡 ============ */
.rescard {
  background: var(--c-surface);
  border-radius: var(--r-card);
  border: var(--bd-card);
  overflow: hidden;
  margin-top: 32rpx;
  box-shadow: var(--sh-card);
}
.res-top { display: flex; gap: 24rpx; padding: 28rpx 28rpx 0; }
.res-cover {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 28rpx;
  overflow: hidden;
  flex: none;
  box-shadow: 0 10rpx 28rpx rgba(120, 70, 30, 0.2);
}
.res-cover-img { width: 100%; height: 100%; }
.res-cover-add {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(44, 36, 27, 0.55);
  color: var(--c-surface);
  font-size: 24rpx;
  font-weight: 700;
}
.res-cover-del {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.5);
  color: var(--c-surface);
  font-size: 28rpx;
  line-height: 40rpx;
  text-align: center;
}
.res-info { flex: 1; min-width: 0; padding-top: 4rpx; }
.res-tag {
  display: inline-block;
  font-family: var(--serif);
  font-style: italic;
  font-size: 20rpx;
  font-weight: 700;
  color: var(--c-surface);
  background: var(--pop);
  padding: 5rpx 16rpx;
  border-radius: var(--r-xs);
}
.res-title {
  font-size: 42rpx;
  font-weight: 900;
  color: var(--ink);
  letter-spacing: -1.5rpx;
  margin-top: 14rpx;
  line-height: 1.1;
}
.res-meta { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 18rpx; }
.rm-cuisine, .rm-pill {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--mut);
  background: var(--paper-2);
  padding: 8rpx 18rpx;
  border-radius: var(--r-pill);
}
.rm-cuisine-in { font-size: 22rpx; color: var(--ink); font-weight: 700; min-width: 80rpx; }

.res-block { padding: 30rpx 28rpx 0; }
.blabel {
  display: flex;
  align-items: center;
  gap: 14rpx;
  font-size: 24rpx;
  font-weight: 800;
  color: var(--ink);
}
.blabel .en {
  font-family: var(--serif);
  font-style: italic;
  font-weight: 700;
  color: var(--gold-deep);
  font-size: var(--fs-mini);
}
.res-empty { margin-top: 16rpx; font-size: 24rpx; color: var(--mut); }

.diff-row { display: flex; gap: 16rpx; margin-top: 20rpx; }
.diff-chip { flex: 1; justify-content: center; }
.diff-chip.on { background: var(--pop); color: var(--c-surface); border-color: var(--pop); }

.ing-grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 22rpx; }
.ing {
  background: var(--paper-2);
  border-radius: 20rpx;
  padding: 14rpx 22rpx;
  font-size: 24rpx;
  color: var(--ink);
  font-weight: 600;
}
.ing .amt { color: var(--mut); margin-left: 10rpx; }

.step { display: flex; gap: 22rpx; margin-top: 26rpx; }
.sno {
  width: 50rpx;
  height: 50rpx;
  border-radius: var(--r-sm);
  background: var(--ink-deep);
  color: var(--gold);
  font-size: var(--fs-sub);
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  font-family: var(--serif);
}
.step-main { flex: 1; min-width: 0; padding-top: 4rpx; }
.stext { font-size: 26rpx; color: var(--ink); line-height: 1.55; }
.step-img-add {
  display: inline-block;
  margin-top: 14rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--gold-deep);
  background: var(--paper-2);
  padding: 10rpx 22rpx;
  border-radius: var(--r-pill);
}
.step-img-wrap { position: relative; margin-top: 14rpx; width: 160rpx; height: 160rpx; border-radius: 20rpx; overflow: hidden; }
.step-img { width: 100%; height: 100%; }
.step-img-del {
  position: absolute;
  right: 6rpx;
  top: 6rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.5);
  color: var(--c-surface);
  font-size: 26rpx;
  line-height: 36rpx;
  text-align: center;
}

/* ============ 来源 / 备注 / CTA ============ */
.source {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin: 30rpx 28rpx 0;
  padding: 24rpx 28rpx;
  background: var(--paper-2);
  border-radius: 28rpx;
}
.s-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: var(--c-surface);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  box-shadow: var(--sh-soft);
}
.s-body { flex: 1; min-width: 0; }
.s-body .st { font-size: 24rpx; font-weight: 700; color: var(--ink); }
.s-body .sl { font-size: var(--fs-mini); color: var(--gold-deep); margin-top: 6rpx; }

.note-list { margin: 24rpx 28rpx 0; }
.note-item { font-size: 22rpx; color: var(--mut); line-height: 1.7; }

.res-cta { padding: 30rpx 28rpx 32rpx; }

/* ============ 最近导入 ============ */
.recent-list { background: var(--c-surface); border-radius: var(--r-card); border: var(--bd-card); box-shadow: var(--sh-soft); padding: 6rpx 28rpx; }
.recent {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--paper-2);
}
.recent:last-child { border-bottom: none; }
.r-thumb { width: 112rpx; height: 112rpx; border-radius: 26rpx; flex: none; }
.r-mid { flex: 1; min-width: 0; }
.r-title { font-size: 32rpx; font-weight: 800; color: var(--ink); letter-spacing: -0.5rpx; }
.r-sub { font-size: 22rpx; color: var(--mut); margin-top: 8rpx; }
.r-state {
  font-size: var(--fs-mini);
  font-weight: 700;
  color: var(--pine);
  background: rgba(47, 74, 58, 0.1);
  padding: 8rpx 18rpx;
  border-radius: var(--r-pill);
  flex: none;
}

.imp-botspace { height: 60rpx; }




