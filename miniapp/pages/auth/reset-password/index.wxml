<nav-bar title="重置密码"></nav-bar>

<view class="rp-body">
  <!-- Hero -->
    <view class="rp-head g-fade-up">
    <view class="rp-eyebrow">重置密码</view>
    <view class="rp-title title-shadow">找回<text class="pop">账号</text></view>
    <view class="rp-sub">输入注册时的手机号，验证后即可重新登录。</view>
  </view>

  <view class="rp-form">
    <!-- 手机号 readonly -->
    <view class="rp-field g-fade-up g-d1">
      <view class="rp-label">手机号</view>
      <view class="rp-inp rp-inp--ro">
        <view class="rp-ic">
          <view class="rp-ic-phone"></view>
        </view>
        <text class="rp-txt">{{phone || '未带入手机号'}}</text>
      </view>
    </view>

    <!-- 验证码 -->
    <view class="rp-field codefield g-fade-up g-d2">
      <view class="rp-label">验证码</view>
      <view class="rp-inp {{focusKey === 'code' ? 'focus' : ''}}">
        <view class="rp-ic"><view class="rp-ic-pulse"></view></view>
        <input
          class="rp-txt rp-txt--code"
          type="number"
          maxlength="6"
          placeholder="······"
          placeholder-class="rp-ph"
          value="{{code}}"
          focus="{{focusKey === 'code'}}"
          bindinput="onCodeInput"
          bindfocus="onFocus"
          bindblur="onBlur"
          data-key="code"
        />
        <view
          class="rp-sendcode {{counting ? 'wait' : ''}} tap-scale"
          catchtap="onSendCode"
        >{{counting ? countdown + 's 后重发' : sendLabel}}</view>
      </view>
    </view>

    <!-- 新密码/确认密码已移除：后端为无密码体系，验证码即登录 -->

    <view class="rp-reset btn btn-pop btn-block tap-scale {{canSubmit ? '' : 'disabled'}}" bindtap="onReset">
      <view class="rp-reset-ic"></view>
      <text>验证并登录</text>
    </view>

    <view class="rp-backlink">
      <text class="rp-backlink-a tap-scale" bindtap="goLogin">返回登录</text>
    </view>
  </view>
</view>
