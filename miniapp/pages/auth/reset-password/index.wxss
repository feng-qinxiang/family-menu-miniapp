/* pages/auth/reset-password · 重置密码
   视觉对标 artifacts/auth-reset.html，配色全部走全局 token（--paper/--ink/--pop/--gold-deep/--serif…） */

.rp-body {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 12rpx 46rpx calc(env(safe-area-inset-bottom) + 60rpx);
  background: var(--paper);
}

/* ===== Hero ===== */
.rp-head {
  padding: 58rpx 4rpx 12rpx;
}
.rp-eyebrow {
  font-family: var(--serif);
  font-style: italic;
  font-size: var(--fs-sub);
  letter-spacing: 3rpx;
  color: var(--gold-deep);
  font-weight: 700;
}
.rp-title {
  margin-top: 14rpx;
  font-size: 96rpx;
  line-height: 0.92;
  font-weight: 900;
  letter-spacing: -5rpx;
  color: var(--ink);
}
.rp-title .pop {
  color: var(--pop);
}
.rp-sub {
  max-width: 580rpx;
  margin-top: 26rpx;
  font-size: 26rpx;
  line-height: 1.55;
  color: var(--mut-strong);
}

/* ===== 表单 ===== */
.rp-form {
  padding: 44rpx 0 0;
}
.rp-field {
  position: relative;
  margin-bottom: 34rpx;
}
.rp-label {
  display: block;
  margin-bottom: 16rpx;
  font-size: var(--fs-mini);
  letter-spacing: 2rpx;
  font-weight: 800;
  text-transform: uppercase;
  color: var(--gold-deep);
}

.rp-inp {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 26rpx 30rpx;
  background: var(--c-surface);
  border: 3rpx solid var(--paper-2);
  border-radius: var(--r-sm);
  box-shadow: var(--sh-soft);
  transition: border-color 0.2s var(--ease-out), box-shadow 0.2s var(--ease-out);
}
.rp-inp.focus {
  border-color: var(--pop);
  box-shadow: 0 0 0 6rpx var(--pop-soft);
}
.rp-inp--ro {
  background: var(--paper-2);
  border-color: transparent;
  box-shadow: none;
}

.rp-txt {
  flex: 1;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
}
.rp-txt--code {
  letter-spacing: 10rpx;
  font-size: 36rpx;
  font-weight: 800;
}
.rp-ph {
  color: var(--mut-2);
  font-weight: 600;
  letter-spacing: 10rpx;
}

/* 图标（纯 CSS，避免内联 svg 颜色硬编码失控） */
.rp-ic {
  flex: none;
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.rp-ic-phone {
  width: 24rpx;
  height: 38rpx;
  border: 4rpx solid var(--gold-deep);
  border-radius: var(--r-xs);
}
.rp-ic-lock {
  position: relative;
  width: 32rpx;
  height: 22rpx;
  margin-top: 12rpx;
  background: var(--gold-deep);
  border-radius: var(--r-xs);
}
.rp-ic-lock::before {
  content: "";
  position: absolute;
  left: 50%;
  top: -16rpx;
  width: 18rpx;
  height: 18rpx;
  transform: translateX(-50%);
  border: 4rpx solid var(--gold-deep);
  border-bottom: none;
  border-radius: 10rpx 10rpx 0 0;
}
.rp-ic-pulse {
  width: 34rpx;
  height: 24rpx;
  background:
    linear-gradient(var(--pop), var(--pop)) left center / 8rpx 8rpx no-repeat,
    linear-gradient(var(--pop), var(--pop)) center / 8rpx 24rpx no-repeat,
    linear-gradient(var(--pop), var(--pop)) right center / 8rpx 14rpx no-repeat;
}

/* 验证码发送按钮 */
.rp-sendcode {
  flex: none;
  padding: 14rpx 26rpx;
  border-radius: var(--r-sm);
  font-size: var(--fs-sub);
  font-weight: 800;
  white-space: nowrap;
  color: var(--pop);
  background: var(--pop-soft);
}
.rp-sendcode.wait {
  color: var(--mut-strong);
  background: var(--paper-2);
}

/* 眼睛切换 */
.rp-eye {
  flex: none;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.rp-eye-dot {
  width: 30rpx;
  height: 18rpx;
  border: 3rpx solid var(--mut);
  border-radius: 0 0 var(--r-chip) var(--r-chip) / 0 0 22rpx 22rpx;
  border-top: none;
  position: relative;
}
.rp-eye-dot::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 2rpx;
  width: 10rpx;
  height: 10rpx;
  transform: translateX(-50%);
  border-radius: 50%;
  background: var(--mut);
}
.rp-eye-dot.on {
  border-color: var(--pop);
}
.rp-eye-dot.on::after {
  background: var(--pop);
}

/* 提示行 */
.rp-hint {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 14rpx;
  padding-left: 4rpx;
  font-size: var(--fs-cap);
  color: var(--mut-strong);
}
.rp-hint-mark {
  flex: none;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--mut-2);
}
.rp-hint.ok {
  color: var(--gold-deep);
}
.rp-hint.ok .rp-hint-mark {
  background: var(--gold-deep);
}
.rp-hint.bad {
  color: var(--pop);
}
.rp-hint.bad .rp-hint-mark {
  background: var(--pop);
}

/* 重置按钮（复用 .btn .btn-pop .btn-block） */
.rp-reset {
  gap: 16rpx;
  margin-top: 20rpx;
  min-height: 100rpx;
  border-radius: var(--r-sm);
  font-size: 32rpx;
  letter-spacing: 1rpx;
}
.rp-reset.disabled {
  opacity: 0.55;
}
.rp-reset-ic {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid var(--c-surface);
  border-top-color: transparent;
  border-radius: 50%;
  position: relative;
}
.rp-reset-ic::after {
  content: "";
  position: absolute;
  right: -2rpx;
  top: -6rpx;
  border-left: 9rpx solid var(--c-surface);
  border-top: 6rpx solid transparent;
  border-bottom: 6rpx solid transparent;
}

/* 返回登录 */
.rp-backlink {
  margin-top: 42rpx;
  text-align: center;
}
.rp-backlink-a {
  display: inline-block;
  padding: 14rpx 8rpx;
  font-size: var(--fs-cap);
  font-weight: 700;
  color: var(--ink-deep);
  border-bottom: 2rpx solid var(--mut-2);
}
