<!-- pages/auth/login-phone · 手机号登录(二级页) -->
<view class="lp safe-bottom">
  <nav-bar title="手机号登录" show-back="{{true}}">
    <text class="lp-help" catchtap="onHelp">Need Help?</text>
  </nav-bar>

  <view class="lp-body">
    <view class="lp-hero g-fade-up">
      <text class="lp-eyebrow">Sign In With Phone</text>
      <view class="lp-title title-stroke">手机号<text class="pop">登录</text></view>
      <text class="lp-sub">输入手机号获取验证码，一步登录你的家庭饭桌。</text>
    </view>

    <!-- 手机号 -->
    <view class="lp-field g-fade-up g-d1">
      <text class="lp-label">手机号码</text>
      <view class="lp-inp {{phoneFocus ? 'is-focus' : ''}}">
        <view class="lp-ic">
          <view class="ic-phone"></view>
        </view>
        <text class="lp-pre">+86</text>
        <input
          class="lp-input"
          type="number"
          maxlength="11"
          placeholder="138 8888 6666"
          placeholder-class="lp-ph"
          value="{{phone}}"
          bindinput="onPhoneInput"
          bindfocus="onPhoneFocus"
          bindblur="onPhoneBlur"
        />
      </view>
    </view>

    <!-- 验证码 -->
    <view class="lp-field g-fade-up g-d2">
      <text class="lp-label">短信验证码</text>
      <view class="lp-inp {{codeFocus ? 'is-focus' : ''}}">
        <view class="lp-ic">
          <view class="ic-mail"></view>
        </view>
        <input
          class="lp-input grow"
          type="number"
          maxlength="6"
          placeholder="请输入验证码"
          placeholder-class="lp-ph"
          value="{{code}}"
          bindinput="onCodeInput"
          bindfocus="onCodeFocus"
          bindblur="onCodeBlur"
        />
        <view
          class="lp-codebtn tap-scale {{counting ? 'is-wait' : ''}}"
          catchtap="onSendCode"
        >
          <text>{{counting ? countdown + 's 后重发' : '获取验证码'}}</text>
        </view>
      </view>
    </view>

    <!-- 登录 -->
    <view class="lp-loginbtn btn-pop tap-scale g-fade-up g-d3" catchtap="onLogin">
      <text>登录</text>
      <view class="ic-arrow"></view>
    </view>

    <!-- 协议 -->
    <view class="lp-agree g-fade-up g-d4">
      <view class="lp-box tap-scale {{agreed ? 'is-on' : ''}}" catchtap="onToggleAgree">
        <view wx:if="{{agreed}}" class="lp-check"></view>
      </view>
      <text class="lp-agree-tx" catchtap="onToggleAgree">我已阅读并同意<text class="lp-link" catchtap="onProtocol">用户协议</text>与<text class="lp-link" catchtap="onProtocol">隐私政策</text>，验证码仅用于登录验证你的身份。</text>
    </view>

    <!-- 分隔 -->
    <view class="lp-divider g-fade-up g-d5">
      <view class="lp-ln"></view>
      <text class="lp-or">Or Continue With</text>
      <view class="lp-ln"></view>
    </view>

    <!-- 微信备选 -->
    <view class="lp-wxbtn btn-wx tap-scale g-fade-up g-d6" catchtap="onWxLogin">
      <view class="ic-wx"></view>
      <text>微信登录</text>
    </view>

    <!-- 注册 -->
    <view class="lp-reg g-fade-up g-d7" catchtap="onRegister">
      <text>还没有账号？<text class="lp-reg-pop">注册新账号</text></text>
    </view>
  </view>

  <state-toast
    visible="{{toast.visible}}"
    type="{{toast.type}}"
    text="{{toast.text}}"
    bind:close="onToastClose"
  ></state-toast>
</view>
