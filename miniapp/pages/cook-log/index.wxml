<view class="cl-page {{fontScale === 'lg' ? 'font-lg' : ''}}">
  <scroll-view class="cl-scroll" scroll-y enhanced show-scrollbar="{{false}}" scroll-top="{{scrollTopTo}}" scroll-with-animation bindscroll="onScrollBody">
    <view class="cpt-head" style="padding-top: {{capsuleTop}};"><view class="cpt-eyebrow">每一餐，都值得记住</view><view class="cpt-title">我家的餐桌记忆</view><view class="cpt-sub">做过的菜、家人的评价，下次还想吃的味道。</view></view>
    <view class="cl-content">
      <!-- 本月概况只是一行小字：数字少时放大反而显得冷清；为 0 的项不写；全新用户什么都不显示，交给下面的空态 -->
      <view class="cl-stats-none" wx:if="{{!loading && !loadError && totalCount}}">{{statsLine}}</view>
      <view class="calwrap card" wx:if="{{!loading && !loadError}}"><view class="cal-top"><text class="ct">这周有好好吃饭</text><text class="cs">{{weekDoneText}}</text></view><view class="cal-days"><view wx:for="{{week}}" wx:key="key" class="cal-day {{item.state}}"><text class="dw">{{item.dw}}</text><image wx:if="{{item.cover && !item.coverBroken}}" class="dd dd-img" src="{{item.cover}}" mode="aspectFill" aria-label="{{item.dd}} 日做过饭" data-err-key="{{'week[' + index + '].coverBroken'}}" binderror="onPhotoError" /><view wx:else class="dd">{{item.dd}}</view><view class="cal-dot" /></view></view></view>
      <scroll-view wx:if="{{totalCount && !loadError}}" class="cl-chips hscroll" scroll-x enhanced show-scrollbar="{{false}}"><view class="hscroll-inner"><view class="chip tap-scale {{activeFilter === 'all' ? 'on' : ''}}" data-value="all" aria-role="button" aria-selected="{{activeFilter === 'all'}}" bindtap="onSelectFilter">全部</view><view wx:for="{{cooks}}" wx:key="name" class="chip tap-scale {{activeFilter === 'cook:' + item.name ? 'on' : ''}}" data-value="cook:{{item.name}}" aria-role="button" aria-selected="{{activeFilter === 'cook:' + item.name}}" bindtap="onSelectFilter">{{item.name}}掌勺</view><view class="chip tap-scale {{activeFilter === 'star5' ? 'on' : ''}}" data-value="star5" aria-role="button" aria-selected="{{activeFilter === 'star5'}}" bindtap="onSelectFilter">五星好评</view></view></scroll-view>
      <state-empty wx:if="{{loadError}}" type="offline" title="记录没加载出来" desc="网络开小差了，检查后再试" cta="重新加载" bind:action="loadHistory" />
      <view wx:elif="{{loading}}"><view class="sk-card shimmer" wx:for="{{[1,2,3]}}" wx:key="*this" /></view>
      <state-empty wx:elif="{{!totalCount}}" size="compact" type="gray" title="还没有做菜记录" desc="做完一道菜打个分，就会记在这里。" cta="去做菜" cta-style="ghost" bind:action="goCooking" />
      <state-empty wx:elif="{{!filteredCount}}" size="compact" type="search" title="这个筛选下还没有记录" desc="换个条件，看看家里做过的其他菜。" cta="查看全部记录" bind:action="clearFilter" />
      <view wx:else class="timeline">
        <block wx:for="{{visibleGroups}}" wx:key="key" wx:for-item="group" wx:for-index="groupIndex"><view class="month-sep"><text class="mtag">{{group.year}}年{{group.label}}</text><text class="mcnt">{{group.count}} 道</text></view>
          <view wx:for="{{group.items}}" wx:key="id" wx:for-item="rec" class="tcard {{rec.highlight ? 'is-new' : ''}}">
            <view wx:if="{{rec.highlight}}" class="cl-new">刚刚做好的家常味</view>
            <view class="tcard-main tap-scale" aria-role="button" aria-label="{{rec.title}}，{{rec.dateLabel}}" bindtap="onCardTap" data-recipe-id="{{rec.recipeId}}" data-title="{{rec.title}}"><image class="thumb-img {{rec.coverBroken ? 'img-broken' : ''}}" src="{{rec.cover}}" mode="aspectFill" lazy-load data-id="{{rec.id}}" data-err-key="{{'visibleGroups[' + groupIndex + '].items[' + index + '].coverBroken'}}" binderror="onPhotoError" /><view class="tbody"><view class="th4">{{rec.title}}</view><view class="date">{{rec.dateLabel}} · {{rec.cookName}}掌勺</view><view class="cl-rating"><text wx:if="{{rec.score}}" class="cl-star {{filled ? 'on' : ''}}" wx:for="{{rec.stars}}" wx:key="index" wx:for-item="filled">★</text><text wx:if="{{!rec.score}}" class="cl-unrated">还没评分</text></view><view wx:if="{{rec.remark}}" class="note">{{rec.remark}}</view></view></view>
            <view wx:if="{{rec.recipeId || rec.recipeId === 0}}" class="cl-actions"><view class="redo tap-scale" aria-role="button" aria-label="再点一次{{rec.title}}" bindtap="redoCook" data-recipe-id="{{rec.recipeId}}">再点一次</view><view wx:if="{{features.COMMUNITY}}" class="cl-share tap-scale" aria-role="button" aria-label="把{{rec.title}}晒到社区" bindtap="shareDish" data-recipe-id="{{rec.recipeId}}" data-title="{{rec.title}}">晒到社区 ›</view></view>
          </view>
        </block>
        <view wx:if="{{!expanded && hiddenCount > 0}}" class="loadmore tap-scale" aria-role="button" bindtap="onToggleExpand">展开更早的 {{hiddenCount}} 条记录</view><view wx:else class="listend">认真吃饭的日子，都在这里</view>
      </view>
    </view>
  </scroll-view>
  <back-top show="{{showBackTop}}" bottom="200rpx" bind:totop="backToTop" />
</view>
