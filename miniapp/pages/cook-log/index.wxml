<view class="cl-page {{fontScale === 'lg' ? 'font-lg' : ''}}">
  <scroll-view class="cl-scroll" scroll-y enhanced show-scrollbar="{{false}}" scroll-top="{{scrollTopTo}}" scroll-with-animation bindscroll="onScrollBody">
    <view class="cpt-head" style="padding-top: {{capsuleTop}};"><view class="cpt-eyebrow">每一餐，都值得记住</view><view class="cpt-title">我家的餐桌记忆</view><view class="cpt-sub">做过的菜、家人的评价，下次还想吃的味道。</view></view>
    <view class="cl-content">
      <view class="cl-stats card" wx:if="{{!loading && !loadError}}"><view class="cl-stat"><view class="cl-stat-num">{{stats.dishes}}</view><text>本月做菜</text></view><view class="cl-stat"><view class="cl-stat-num">{{stats.fireDays}}</view><text>开火天数</text></view><view class="cl-stat"><view class="cl-stat-num">{{stats.praise}}</view><text>四星及以上</text></view></view>
      <view class="calwrap card" wx:if="{{!loading && !loadError}}"><view class="cal-top"><text class="ct">这周有好好吃饭</text><text class="cs">{{weekDoneText}}</text></view><view class="cal-days"><view wx:for="{{week}}" wx:key="key" class="cal-day {{item.state}}"><text class="dw">{{item.dw}}</text><view class="dd">{{item.dd}}</view><view class="cal-dot" /></view></view></view>
      <scroll-view wx:if="{{totalCount && !loadError}}" class="cl-chips hscroll" scroll-x enhanced show-scrollbar="{{false}}"><view class="hscroll-inner"><view class="chip tap-scale {{activeFilter === 'all' ? 'on' : ''}}" data-value="all" bindtap="onSelectFilter">全部</view><view wx:for="{{cooks}}" wx:key="name" class="chip tap-scale {{activeFilter === 'cook:' + item.name ? 'on' : ''}}" data-value="cook:{{item.name}}" bindtap="onSelectFilter">{{item.name}} 掌勺</view><view class="chip tap-scale {{activeFilter === 'star5' ? 'on' : ''}}" data-value="star5" bindtap="onSelectFilter">五星好评</view></view></scroll-view>
      <state-empty wx:if="{{loadError}}" type="offline" title="记录没加载出来" desc="网络开小差了，检查后再试" cta="重新加载" bind:action="loadHistory" />
      <view wx:elif="{{loading}}"><view class="sk-card shimmer" wx:for="{{[1,2,3]}}" wx:key="*this" /></view>
      <state-empty wx:elif="{{!totalCount}}" type="gold" title="第一顿家常味，从今天开始" desc="做菜完成后，给这道菜打个分，留一句下次做时想记住的话。" cta="去做一顿饭" bind:action="goCooking" />
      <state-empty wx:elif="{{!filteredCount}}" type="search" title="这个筛选下还没有记录" desc="换个条件，看看家里做过的其他菜。" cta="查看全部记录" bind:action="clearFilter" />
      <view wx:else class="timeline">
        <block wx:for="{{visibleGroups}}" wx:key="key" wx:for-item="group"><view class="month-sep"><text class="mtag">{{group.year}} 年 {{group.label}}</text><text class="mcnt">{{group.count}} 道</text></view>
          <view wx:for="{{group.items}}" wx:key="id" wx:for-item="rec" class="tcard {{rec.highlight ? 'is-new' : ''}}">
            <view wx:if="{{rec.highlight}}" class="cl-new">刚刚做好的家常味</view>
            <view class="tcard-main tap-scale" bindtap="onCardTap" data-recipe-id="{{rec.recipeId}}" data-title="{{rec.title}}"><image class="thumb-img" src="{{rec.cover}}" mode="aspectFill" lazy-load /><view class="tbody"><view class="th4">{{rec.title}}</view><view class="date">{{rec.dateLabel}} · {{rec.cookName}} 掌勺</view><view class="cl-rating"><text class="cl-star {{filled ? 'on' : ''}}" wx:for="{{rec.stars}}" wx:key="index" wx:for-item="filled">★</text><text wx:if="{{!rec.score}}" class="cl-unrated">还没评分</text></view><view wx:if="{{rec.remark}}" class="note">{{rec.remark}}</view></view></view>
            <view wx:if="{{rec.recipeId || rec.recipeId === 0}}" class="cl-actions"><view class="redo tap-scale" bindtap="redoCook" data-recipe-id="{{rec.recipeId}}">再点一次</view><view wx:if="{{features.COMMUNITY}}" class="cl-share tap-scale" bindtap="shareDish" data-recipe-id="{{rec.recipeId}}" data-title="{{rec.title}}">晒到社区 ›</view></view>
          </view>
        </block>
        <view wx:if="{{!expanded && hiddenCount > 0}}" class="loadmore tap-scale" bindtap="onToggleExpand">展开更早的 {{hiddenCount}} 条记录</view><view wx:else class="listend">认真吃饭的日子，都在这里</view>
      </view>
    </view>
  </scroll-view>
  <back-top show="{{showBackTop}}" bottom="200rpx" bind:totop="backToTop" />
</view>
