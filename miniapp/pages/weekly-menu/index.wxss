/* ============================================================
   pages/weekly-menu · 本周菜单「照片 hero + 七日点选 + 日卡」
   配色/工具类复用 app.wxss，禁止重定义 token
   ============================================================ */
.wm-page {
  min-height: 100vh;
  background: var(--paper);
}

/* 顶部导航：浮于照片之上 */
.wm-nav-fixed {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 60;
}
.wm-refresh {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 28rpx;
  border-radius: var(--r-pill);
  background: var(--pop);
  color: var(--c-surface);
  font-size: var(--fs-sub);
  font-weight: 800;
  box-shadow: var(--sh-pop);
}
.wm-refresh-ic {
  width: 26rpx;
  height: 26rpx;
  border: 4rpx solid var(--c-surface);
  border-top-color: transparent;
  border-radius: 50%;
  position: relative;
}
.wm-refresh-ic::after {
  content: "";
  position: absolute;
  top: -4rpx;
  right: -3rpx;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-bottom: 9rpx solid var(--c-surface);
  transform: rotate(40deg);
}

/* 照片 hero */
.wm-hero {
  position: relative;
  height: 862rpx;
  overflow: hidden;
}
.wm-hero-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.wm-hero-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(20, 14, 8, 0.5) 0%, rgba(20, 14, 8, 0) 28%, rgba(20, 14, 8, 0.18) 52%, rgba(20, 14, 8, 0.9) 100%);
}
.wm-bignum {
  position: absolute;
  top: 130rpx;
  right: 24rpx;
  z-index: 2;
  font-family: var(--serif);
  font-size: 420rpx;
  font-weight: 700;
  line-height: 1;
  color: rgba(255, 255, 255, 0.07);
}

.wm-hero-body {
  position: absolute;
  left: 46rpx;
  right: 46rpx;
  bottom: 50rpx;
  z-index: 10;
  color: var(--c-surface);
}
.wm-tag {
  display: inline-block;
  font-family: var(--serif);
  font-style: italic;
  font-size: var(--fs-cap);
  letter-spacing: 3rpx;
  font-weight: 700;
  color: var(--c-surface);
  background: var(--pop);
  padding: 10rpx 26rpx;
  border-radius: var(--r-xs);
}
.wm-title {
  font-size: var(--fs-hero-xl);
  line-height: 0.9;
  letter-spacing: -6rpx;
  margin: 26rpx 0 18rpx;
  -webkit-text-stroke: 3rpx var(--c-surface);
}
.wm-sub {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 400;
}
/* 七日点选条 */
.wm-weekbar {
  display: flex;
  gap: 14rpx;
  margin-top: 30rpx;
}
.wm-wb {
  flex: 1;
  text-align: center;
  padding: 18rpx 0 16rpx;
  border-radius: 25rpx;
  background: rgba(255, 255, 255, 0.16);
  border: 2rpx solid rgba(255, 255, 255, 0.2);
}
.wm-wb.today {
  background: var(--pop);
  border-color: var(--pop);
  box-shadow: var(--sh-pop);
}
.wm-wb.on:not(.today) {
  background: rgba(255, 255, 255, 0.34);
  border-color: rgba(255, 255, 255, 0.5);
}
.wm-wb-d {
  display: block;
  font-size: 24rpx;
  font-weight: 800;
  color: var(--c-surface);
}
.wm-wb-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--gold);
  margin: 10rpx auto 0;
}
.wm-wb-dot.empty { background: rgba(255, 255, 255, 0.3); }
.wm-wb.today .wm-wb-dot { background: var(--c-surface); }

/* 内容 sheet */
.wm-sheet {
  position: relative;
  margin-top: -50rpx;
  background: var(--paper);
  border-radius: 54rpx 54rpx 0 0;
  padding: 46rpx 46rpx 40rpx;
  z-index: 20;
}

/* 统计卡 */
.wm-summary {
  display: flex;
  gap: 18rpx;
}
.wm-scell {
  flex: 1;
  background: var(--c-surface);
  border-radius: 34rpx;
  padding: 28rpx 26rpx;
  box-shadow: var(--sh-soft), 0 26rpx 58rpx rgba(120, 70, 30, 0.12);
  border: var(--bd-card);
}
.wm-num {
  font-size: 52rpx;
  font-weight: 900;
  color: var(--ink);
  letter-spacing: -2rpx;
  line-height: 1;
}
.wm-num.pop { color: var(--pop); }
.wm-num .u {
  font-size: var(--fs-cap);
  font-weight: 700;
  color: var(--mut);
  margin-left: 4rpx;
}
.wm-cap {
  font-size: 22rpx;
  color: var(--mut-strong);
  font-weight: 600;
  margin-top: 8rpx;
}
/* 日卡 */
.wm-daycard {
  background: var(--c-surface);
  border-radius: var(--r-card);
  padding: 30rpx 32rpx 16rpx;
  margin-bottom: 26rpx;
  box-shadow: var(--sh-soft), 0 30rpx 70rpx rgba(120, 70, 30, 0.13);
  border: var(--bd-card);
}
.wm-daycard.today {
  border: 2rpx solid var(--pop);
  box-shadow: 0 4rpx 12rpx rgba(232, 71, 42, 0.1), 0 34rpx 76rpx rgba(232, 71, 42, 0.18);
}
.wm-dhead {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 24rpx;
  border-bottom: 2rpx solid var(--paper-2);
}
.wm-dl {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}
.wm-wk {
  font-size: 36rpx;
  font-weight: 900;
  color: var(--ink);
  letter-spacing: -1rpx;
}
.wm-dt {
  font-size: 24rpx;
  color: var(--mut);
  font-weight: 600;
}
.wm-todaytag {
  font-size: var(--fs-tiny);
  font-weight: 800;
  letter-spacing: 2rpx;
  color: var(--c-surface);
  background: var(--pop);
  padding: 6rpx 16rpx;
  border-radius: var(--r-pill);
}
.wm-dcount {
  font-size: var(--fs-cap);
  font-weight: 700;
  color: var(--gold-deep);
}
.wm-dcount.mut { color: var(--mut); }

/* 菜行 */
.wm-dish {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 22rpx 0;
  border-bottom: 2rpx solid var(--c-border-light);
}
.wm-dish:last-child { border-bottom: none; }
.wm-slot {
  font-size: 22rpx;
  font-weight: 800;
  color: var(--mut-2);
  width: 40rpx;
  flex: none;
  letter-spacing: 1rpx;
}
.wm-thumb {
  width: 104rpx;
  height: 104rpx;
  border-radius: 28rpx;
  flex: none;
  background: var(--paper-2);
}
.wm-dmid {
  flex: 1;
  min-width: 0;
}
.wm-dname {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--ink);
  letter-spacing: -1rpx;
}
.wm-dmeta {
  font-size: var(--fs-cap);
  color: var(--mut-strong);
  margin-top: 6rpx;
}
.wm-arr {
  width: 18rpx;
  height: 18rpx;
  border-top: 4rpx solid var(--mut-2);
  border-right: 4rpx solid var(--mut-2);
  transform: rotate(45deg);
  flex: none;
}
/* 空位行 */
.wm-dish.empty .wm-ic {
  width: 104rpx;
  height: 104rpx;
  border-radius: 28rpx;
  background: var(--pop-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}
.wm-plus {
  position: relative;
  width: 36rpx;
  height: 36rpx;
}
.wm-plus::before,
.wm-plus::after {
  content: "";
  position: absolute;
  background: var(--pop);
  border-radius: 4rpx;
}
.wm-plus::before {
  left: 50%;
  top: 0;
  width: 5rpx;
  height: 100%;
  transform: translateX(-50%);
}
.wm-plus::after {
  top: 50%;
  left: 0;
  height: 5rpx;
  width: 100%;
  transform: translateY(-50%);
}
.wm-et {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--pop);
}
.wm-es {
  font-size: 22rpx;
  color: var(--mut);
  margin-top: 4rpx;
}
