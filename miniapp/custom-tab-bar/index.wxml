<view class="tab-bar">
  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    class="tab-item {{selected === index ? 'active' : ''}}"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <view class="tab-icon-wrap">
      <image class="tab-icon" src="{{selected === index ? item.activeIcon : item.icon}}" mode="aspectFit" />
      <view wx:if="{{item.pagePath === '/pages/menu/index' && badge > 0}}" class="tab-badge">{{badge > 99 ? '99+' : badge}}</view>
    </view>
    <view class="tab-text">{{item.text}}</view>
  </view>
</view>
