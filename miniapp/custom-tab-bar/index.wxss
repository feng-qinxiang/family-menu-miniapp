.tab-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  height: 96rpx;
  padding: 8rpx 10rpx calc(env(safe-area-inset-bottom) + 24rpx);
  box-sizing: content-box;
  border-top: 1rpx solid rgba(236, 229, 217, 0.96);
  background: rgba(251, 248, 243, 0.96);
  backdrop-filter: blur(18px);
  box-shadow: 0 -6rpx 24rpx rgba(60, 40, 20, 0.08);
}

.tab-item {
  position: relative;
  display: flex;
  flex: 1;
  min-width: 0;
  min-height: 88rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  color: var(--mut-strong);
  transition: transform 0.18s ease;
}

.tab-item.active {
  color: var(--pop);
}

.tab-item.active::before {
  position: absolute;
  top: 0;
  width: 36rpx;
  height: 5rpx;
  border-radius: 0 0 var(--r-pill) var(--r-pill);
  background: var(--pop);
  content: "";
  animation: tab-indicator-in 0.28s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes tab-indicator-in {
  from { transform: scaleX(0.3); opacity: 0; }
  to { transform: scaleX(1); opacity: 1; }
}

.tab-icon-wrap {
  position: relative;
}

.tab-item.active .tab-icon {
  animation: tab-icon-pop 0.32s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes tab-icon-pop {
  0% { transform: scale(0.82); }
  60% { transform: scale(1.12); }
  100% { transform: scale(1); }
}

.tab-badge {
  position: absolute;
  top: -8rpx;
  left: 50%;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
  border: 2rpx solid var(--paper);
  border-radius: var(--r-pill);
  background: var(--pop);
  box-shadow: 0 2rpx 8rpx rgba(224, 49, 34, 0.35);
  color: var(--c-surface);
  font-size: 18rpx;
  font-weight: 700;
  line-height: 26rpx;
  text-align: center;
  transform: translateX(6rpx);
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
}

.tab-text {
  max-width: 100%;
  overflow: hidden;
  font-size: var(--fs-mini);
  font-weight: 600;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tab-item.active .tab-text {
  color: var(--pop);
  font-weight: 800;
}
