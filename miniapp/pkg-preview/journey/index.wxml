<view class="journey design-{{design}} view-{{view}} {{fontScale === 'lg' ? 'font-lg' : ''}} {{dark ? 'is-dark' : ''}}">
  <!-- These controls belong to the design preview, not to the proposed product. -->
  <view wx:if="{{previewChrome}}" class="preview-controls" style="padding-top: {{capsuleTop}};">
    <view class="preview-caption" style="padding-right: {{capsuleRight}};">设计预览 · 示例数据</view>
    <view class="preview-designs">
      <button wx:for="{{designs}}" wx:key="key" class="preview-option tap-scale {{design === item.key ? 'on' : ''}}" data-design="{{item.key}}" bindtap="selectDesign">{{item.label}}</button>
    </view>
    <view class="preview-desc">{{designInfo.desc}}</view>
  </view>

  <view class="j-body">
    <view class="j-top" style="padding-top: {{previewChrome ? '24rpx' : capsuleTop}};">
      <view class="j-eyebrow" style="padding-right: {{capsuleRight}};">{{dateText}}</view>
      <view class="j-heading">
        <block wx:if="{{view === 'order'}}"><view class="j-title">{{design === 'b' ? '今晚，吃点好的。' : design === 'c' ? '今天吃什么' : '家的味道，今天继续。'}}</view><view class="j-subtitle">{{design === 'b' ? '你点一道，我点一道，一起凑成这一餐。' : '家人一起点，厨房接着做。'}}</view></block>
        <block wx:elif="{{view === 'cook'}}"><view class="j-title">{{design === 'c' ? '做菜' : '把这一餐，慢慢做好。'}}</view><view class="j-subtitle">{{mealLabel}} · {{doneCount}} / {{orders.length}} 道已上桌</view></block>
        <block wx:elif="{{view === 'record'}}"><view class="j-title">{{design === 'c' ? '做菜记录' : '认真吃过，都记得。'}}</view><view class="j-subtitle">记下味道，也记下家人的喜欢。</view></block>
        <block wx:elif="{{view === 'community'}}"><view class="j-title">{{design === 'c' ? '邻里厨房' : '看看别人家的饭桌。'}}</view><view class="j-subtitle">今天上桌的好味道，明天也来你家。</view></block>
        <block wx:else><view class="j-title">我家的厨房</view><view class="j-subtitle">一家人的口味，一起慢慢攒。</view></block>
      </view>
    </view>

    <!-- ORDER: A keeps the short photographic opening; B opens on the menu; C opens on discovery. -->
    <block wx:if="{{view === 'order'}}">
      <view class="meal-switch">
        <button wx:for="{{meals}}" wx:key="key" class="meal-option tap-scale {{meal === item.key ? 'on' : ''}}" data-meal="{{item.key}}" bindtap="selectMeal">{{item.label}}</button>
      </view>

      <view wx:if="{{design === 'a'}}" class="order-feature">
        <image class="feature-photo" src="/assets/dishes/hongshao-pork.jpg" mode="aspectFill" />
        <view class="feature-shade"></view>
        <view class="feature-copy"><view class="feature-label">这一餐的主角</view><view class="feature-title">红烧肉</view><view class="feature-meta">慢火炖软，留点汤汁拌饭。</view></view>
        <button class="feature-action tap-scale" data-id="pork" bindtap="pickRecipe">点这道 +</button>
      </view>

      <view wx:if="{{design === 'b'}}" class="family-note"><view class="family-faces"><text class="family-avatar one">爸</text><text class="family-avatar two">妈</text><text class="family-avatar three">我</text></view><view><view class="family-note-title">今天也一起好好吃饭</view><view class="j-muted">爸爸想吃红烧肉，我想吃点青菜。</view></view></view>

      <view class="menu-ticket">
        <view class="ticket-head"><view><view class="ticket-kicker">{{design === 'b' ? '一家人的点菜单' : '这一餐已点'}}</view><view class="ticket-title">{{mealLabel}} <text class="ticket-count">{{orders.length}} 道菜</text></view></view><button wx:if="{{design === 'c'}}" class="j-text-button tap-scale" bindtap="toggleMenu">{{menuExpanded ? '收起' : '展开菜单'}} ›</button><view wx:else class="ticket-family">一家人一起点</view></view>
        <view class="menu-list" wx:if="{{design !== 'c' || menuExpanded}}">
          <view class="menu-row" wx:for="{{orders}}" wx:key="id">
            <image class="menu-photo" src="{{item.image}}" mode="aspectFill" />
            <view class="row-copy"><view class="row-title">{{item.title}}</view><view class="j-muted">{{item.by}}点的 · {{item.minutes}} 分钟</view></view>
            <text class="row-status {{item.status}}">{{item.statusText}}</text>
            <button wx:if="{{item.status === 'todo'}}" class="remove-button tap-scale" aria-label="移除{{item.title}}" data-id="{{item.id}}" bindtap="removeRecipe">−</button>
          </view>
        </view>
        <view wx:elif="{{orders.length}}" class="menu-compact"><image wx:for="{{orders}}" wx:key="id" class="compact-photo" src="{{item.image}}" mode="aspectFill" /><text>家人的心愿都在这儿</text></view>
        <view wx:if="{{!orders.length}}" class="empty-order"><view class="empty-title">这一餐还没点菜</view><view class="j-muted">从下面挑一道，给这顿饭开个头。</view></view>
        <view class="ticket-footer"><view><view class="footer-count">{{remainingCount ? remainingCount + ' 道等你开火' : orders.length ? '这一餐全部上桌' : '从第一道开始'}}</view><view class="j-muted">{{remainingCount ? '先做慢菜，快手菜最后下锅' : '好好吃饭，也把这一餐留下来'}}</view></view><button class="j-primary tap-scale start-cook" bindtap="startCook">{{remainingCount ? '去做菜' : orders.length ? '看记录' : '去挑菜'}} <text>→</text></button></view>
      </view>

      <view class="context-tools"><button class="tool-link tap-scale" data-tool="recipes" bindtap="openTool">菜谱库 <text>›</text></button><button class="tool-link tap-scale" data-tool="pantry" bindtap="openTool">冰箱里有什么 <text>›</text></button><button class="tool-link tap-scale" data-tool="shopping" bindtap="openTool">要买什么 <text>›</text></button></view>
      <view class="section-heading"><view class="section-title">{{design === 'b' ? '再添一道，刚刚好' : design === 'c' ? '今天推荐' : '简单好做，不用想太久'}}</view><text class="section-caption">家常 · 快手</text></view>
      <view class="recipe-grid">
        <view class="recipe-tile" wx:for="{{recommendations}}" wx:key="id"><image class="recipe-photo" src="{{item.image}}" mode="aspectFill" /><view class="recipe-info"><view class="recipe-title">{{item.title}}</view><view class="j-muted">{{item.minutes}} 分钟 · {{item.id === 'soup' ? '热汤' : '家常'}}</view></view><button class="pick-button pick-{{item.id}} tap-scale {{item.picked ? 'picked' : ''}}" aria-label="{{item.picked ? '已点' : '点'}}{{item.title}}" data-id="{{item.id}}" bindtap="pickRecipe">{{item.picked ? '✓' : '+'}}</button></view>
      </view>
    </block>

    <!-- COOK: a working surface, with one primary step and all other dishes in reach. -->
    <block wx:elif="{{view === 'cook'}}">
      <view class="kitchen-overview"><view class="kitchen-progress"><view class="progress-track"><view class="progress-fill" style="width: {{orders.length ? doneCount / orders.length * 100 : 0}}%;"></view></view><view class="j-muted">{{remainingCount ? '慢菜先开火，快手菜最后出锅。' : orders.length ? '这一餐做好了，开饭吧。' : '先点几道菜，再回来开火。'}}</view></view><button class="j-text-button tap-scale" data-view="order" bindtap="selectView">看菜单 ›</button></view>
      <view class="cook-switch"><button class="cook-chip tap-scale {{activeId === item.id ? 'on' : ''}}" wx:for="{{orders}}" wx:key="id" data-id="{{item.id}}" bindtap="selectCook"><image class="cook-chip-photo" src="{{item.image}}" mode="aspectFill" /><view><view class="cook-chip-title">{{item.title}}</view><view class="cook-chip-state">{{item.statusText}}</view></view></button></view>
      <view wx:if="{{active}}" class="cook-focus">
        <view class="cook-focus-head"><image wx:if="{{design !== 'b'}}" class="cook-focus-photo" src="{{active.image}}" mode="aspectFill" /><view wx:else class="step-number">{{active.stepNumber}}<text>/{{active.steps.length}}</text></view><view class="cook-focus-meta"><view class="focus-kicker">{{active.status === 'done' ? '已经上桌' : '正在做这一道'}}</view><view class="focus-title">{{active.title}}</view><view class="j-muted">{{active.minutes}} 分钟 · 家常做法</view></view></view>
        <block wx:if="{{active.status !== 'done'}}">
          <view class="step-line"><text>第 {{active.stepNumber}} / {{active.steps.length}} 步</text><text>{{active.lastStep ? '准备上桌' : active.step === 0 ? '先把食材准备好' : '跟着步骤，不着急'}}</text></view>
          <view class="step-copy">{{active.stepText}}</view>
          <view class="step-dots"><view wx:for="{{active.steps}}" wx:key="*this" class="step-dot {{index <= active.step ? 'done' : ''}}"></view></view>
          <view class="timer-panel"><view><view class="timer-caption">厨房计时器</view><view class="timer-number">{{timerLabel}}</view></view><button class="timer-button tap-scale" bindtap="toggleTimer">{{timerRunning ? '暂停' : timerLabel === '05:00' ? '开始计时' : '继续计时'}}</button></view>
          <button class="j-primary full-width tap-scale next-step" bindtap="nextStep">{{active.lastStep ? '做好了，记一笔' : '这步好了，下一步'}} <text>→</text></button>
        </block>
        <block wx:else><view class="step-copy">这道菜已经做好了。</view><button class="j-primary full-width tap-scale" data-view="record" bindtap="selectView">看看刚刚的记录 →</button></block>
      </view>
      <view wx:else class="empty-card"><view class="empty-title">先选好这一餐的菜</view><view class="j-muted">做菜页会接住菜单、步骤和计时。</view><button class="j-primary tap-scale" data-view="order" bindtap="selectView">去点菜 →</button></view>
      <view class="journey-hint"><text class="hint-label">接下来</text><text>做完记一笔，把好吃的晒到社区。</text></view>
    </block>

    <!-- RECORD: the latest meal comes before aggregate statistics. -->
    <block wx:elif="{{view === 'record'}}">
      <view wx:if="{{design === 'c'}}" class="week-row"><view wx:for="{{week}}" wx:key="key" class="week-day {{item.today ? 'today' : ''}}"><text>周{{item.label}}</text><view>{{item.day}}</view><text class="week-dot {{item.done ? 'done' : ''}}"></text></view></view>
      <view wx:elif="{{design === 'b'}}" class="journal-date"><text class="journal-day">{{dateDay}}</text><view><view class="journal-month">{{recordMonth}}</view><view class="j-muted">一餐一记，慢慢攒成家的味道。</view></view></view>
      <view class="record-latest" wx:if="{{latest}}"><image class="record-photo" src="{{latest.image}}" mode="aspectFill" /><view class="record-main"><view class="focus-kicker">最近上桌 · {{latest.when}}</view><view class="record-title">{{latest.title}}</view><view class="record-stars">{{latest.score}} 分 <text>· {{latest.by}}做的</text></view><view class="record-remark">“{{latest.remark}}”</view><view class="record-actions"><button wx:if="{{showCommunity}}" class="j-primary tap-scale share-record" data-id="{{latest.id}}" bindtap="shareRecord">晒到社区 →</button><button class="j-text-button tap-scale" data-id="{{latest.recipeId}}" bindtap="orderPost">再点一次 →</button></view></view></view>
      <view class="record-stats"><view><view class="stat-number">{{history.length}}<text> 道</text></view><view class="j-muted">示例记录</view></view><view><view class="stat-number">{{fireDays}}<text> 天</text></view><view class="j-muted">开火日</view></view><view><view class="stat-number">{{praiseCount}}<text> 次</text></view><view class="j-muted">五星好评</view></view></view>
      <view class="section-heading"><view class="section-title">前几次的好味道</view><text class="section-caption">按时间</text></view>
      <view class="history-list"><view class="history-row" wx:for="{{recentHistory}}" wx:key="id"><image class="menu-photo" src="{{item.image}}" mode="aspectFill" /><view class="row-copy"><view class="row-title">{{item.title}}</view><view class="j-muted">{{item.when}} · {{item.by}}做的</view></view><view class="history-score">{{item.score}}<text>分</text></view><button wx:if="{{showCommunity}}" class="history-share tap-scale" aria-label="分享{{item.title}}" data-id="{{item.id}}" bindtap="shareRecord">→</button></view></view>
    </block>

    <!-- COMMUNITY: a finished dish links back to ordering, rather than ending at likes. -->
    <block wx:elif="{{view === 'community' && showCommunity}}">
      <view class="community-toolbar"><view class="community-section">今日饭桌 <text>· 家常好味道</text></view><button class="j-primary tap-scale" bindtap="shareRecord">晒晒这一餐 +</button></view>
      <view class="post-grid"><view class="post-card" wx:for="{{posts}}" wx:key="id"><view class="post-author"><text class="post-avatar">{{item.initial}}</text><view><view class="post-author-name">{{item.author}}</view><view class="post-tag">{{item.tag}}</view></view><button class="like-button tap-scale {{item.liked ? 'liked' : ''}}" aria-label="点赞{{item.title}}" data-id="{{item.id}}" bindtap="likePost">♡ {{item.likes}}</button></view><image class="post-photo" src="{{item.recipe.image}}" mode="aspectFill" /><view class="post-info"><view class="post-title">{{item.title}}</view><view class="post-content">{{item.content}}</view><view class="post-recipe"><view><view class="post-recipe-name">{{item.recipe.title}}</view><view class="j-muted">{{item.recipe.minutes}} 分钟 · 关联菜谱</view></view><button class="post-order post-order-{{item.id}} tap-scale" data-id="{{item.recipeId}}" bindtap="orderPost">我也点这道 +</button></view></view></view></view>
    </block>

    <block wx:elif="{{view === 'me'}}"><view class="profile-card"><text class="profile-avatar">我</text><view><view class="focus-title">我家的饭桌</view><view class="j-muted">爸爸、妈妈和我 · 示例家庭</view></view></view><view class="section-heading"><view class="section-title">厨房工具</view></view><view class="profile-tools"><button class="profile-row tap-scale" data-tool="recipes" bindtap="openTool">我的菜谱 <text>›</text></button><button class="profile-row tap-scale" data-tool="pantry" bindtap="openTool">冰箱里的食材 <text>›</text></button><button class="profile-row tap-scale" data-tool="shopping" bindtap="openTool">买菜清单 <text>›</text></button><button class="profile-row tap-scale" data-view="record" bindtap="selectView">做菜记录 <text>›</text></button></view><view class="section-heading"><view class="section-title">预览设置</view></view><view class="profile-tools"><button class="profile-row tap-scale" bindtap="toggleFont">{{fontScale === 'lg' ? '恢复标准字号' : '试试大字模式'}} <text>›</text></button><button class="profile-row tap-scale" bindtap="toggleDark">{{dark ? '查看浅色效果' : '查看深色效果'}} <text>›</text></button><button class="profile-row tap-scale" bindtap="resetDemo">重置示例菜单与记录 <text>›</text></button></view></block>

    <view class="j-bottom-space"></view>
  </view>

  <view class="journey-nav"><button wx:for="{{tabs}}" wx:key="key" class="journey-tab journey-tab-{{item.key}} tap-scale {{view === item.key ? 'on' : ''}}" aria-label="{{item.label}}" data-view="{{item.key}}" bindtap="selectView"><image class="journey-tab-icon" src="/assets/icons/{{view === item.key ? item.active : item.icon}}.svg" /><text>{{item.label}}</text><view class="tab-indicator"></view></button></view>

  <view wx:if="{{sheet}}" class="sheet-mask" bindtap="closeSheet"><view class="j-sheet" catchtap="eatTap"><view class="sheet-heading"><view class="section-title">{{sheet === 'record' ? '这一道，记下来' : sheet === 'share' ? '把这顿好味道分享出去' : sheet === 'recipes' ? '菜谱库 · 示例' : tool}}</view><button class="sheet-close tap-scale" aria-label="关闭" bindtap="closeSheet">×</button></view>
    <block wx:if="{{sheet === 'record'}}"><view class="sheet-dish"><image class="menu-photo" src="{{active.image}}" mode="aspectFill" /><view><view class="row-title">{{active.title}}</view><view class="j-muted">{{mealLabel}} · 我做的</view></view></view><view class="rating-row"><button wx:for="{{stars}}" wx:key="*this" class="rating-star rating-{{item}} tap-scale {{item <= rating ? 'on' : ''}}" aria-label="{{item}}分" data-rating="{{item}}" bindtap="setRating">★</button></view><textarea class="sheet-input" placeholder="今天的味道怎么样？下次可以怎么做？" value="{{remark}}" maxlength="160" bindinput="inputRemark" /><button class="j-primary full-width tap-scale save-record" bindtap="saveRecord">记下这一餐 →</button></block>
    <block wx:elif="{{sheet === 'share'}}"><view class="sheet-dish"><image class="menu-photo" src="{{shareRecord.image}}" mode="aspectFill" /><view><view class="row-title">{{shareRecord.title}}</view><view class="j-muted">会带上这道菜的菜谱</view></view></view><textarea class="sheet-input" placeholder="分享一点做菜心得" value="{{postText}}" maxlength="160" bindinput="inputPost" /><button class="j-primary full-width tap-scale publish-post" bindtap="publishPost">分享到示例社区 →</button></block>
    <block wx:elif="{{sheet === 'recipes'}}"><view class="library-scroll"><view class="library-row" wx:for="{{library}}" wx:key="id"><image class="menu-photo" src="{{item.image}}" mode="aspectFill" /><view class="row-copy"><view class="row-title">{{item.title}}</view><view class="j-muted">{{item.minutes}} 分钟</view></view><button class="pick-button tap-scale" aria-label="点{{item.title}}" data-id="{{item.id}}" bindtap="pickRecipe">+</button></view></view></block>
    <block wx:else><view class="tool-demo-note">示例食材，用来体验工具入口的位置。</view><view wx:for="{{toolItems}}" wx:key="*this" class="tool-item">{{item}}</view><button class="j-primary full-width tap-scale" bindtap="closeSheet">知道了</button></block>
  </view></view>
</view>
