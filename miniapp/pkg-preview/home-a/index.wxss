/* ============================================================
   首页风格预览 · 方案 A「清爽卡片流」
   近白冷灰底 + 白卡；层级只靠字重（700/600/400）和留白，不靠颜色。
   番茄红每屏只用一次（主卡主按钮），其余操作一律墨色或中性灰。
   局部 token 只定义在本页 page 上，不改全局；深色档在文件末尾整组覆盖。
   ============================================================ */
page {
  /* 配色 */
  --a-bg: #f6f7f9;
  --a-surface: #ffffff;
  --a-fill: #eff1f4;
  --a-ink: #1d1f23;
  --a-ink-2: #6b7078;
  --a-ink-3: #9aa0a8;
  --a-accent: var(--pop);
  --a-on-accent: #ffffff;
  /* 阴影：两层极淡冷灰，深色档换成 1px 描边环 */
  --a-sh-card: 0 2rpx 6rpx rgba(20, 24, 31, 0.04), 0 12rpx 32rpx rgba(20, 24, 31, 0.06);
  --a-sh-seg: 0 2rpx 8rpx rgba(20, 24, 31, 0.10);
  --a-sh-pop: 0 8rpx 20rpx rgba(232, 71, 42, 0.24);
  /* 圆角：主卡 32 / 内容卡 24 / 分段块 16 / 按钮全胶囊 */
  --a-r-xl: 32rpx;
  --a-r-lg: 24rpx;
  --a-r-md: 16rpx;
  --a-r-pill: 999rpx;
  /* 间距 */
  --a-gap: 32rpx;
  --a-pad: 32rpx;
  /* 按钮三档：大 96 / 小 64 / 圆图标 56（小于 88 的都用 ::after 撑热区） */
  --a-btn-h: 96rpx;
  --a-btn-sm-h: 64rpx;
  --a-btn-ico: 56rpx;

  background: var(--a-bg);
}

.pa {
  box-sizing: border-box;
  min-height: 100vh;
  padding-left: var(--a-gap);
  padding-right: var(--a-gap);
  padding-bottom: 24rpx;
  background: var(--a-bg);
  color: var(--a-ink);
}

/* ---------- 1. 顶部问候 ---------- */
.pa-top {
  min-height: 64rpx;
  padding-bottom: 28rpx;
}
.pa-hello {
  font-size: var(--fs-sub);
  font-weight: 400;
  line-height: 1.5;
  color: var(--a-ink-2);
}
.pa-family {
  margin-top: 4rpx;
  font-size: var(--fs-h1);
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: -1rpx;
  color: var(--a-ink);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ---------- 刷新失败提示条 ---------- */
.pa-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding-left: 24rpx;
  border-radius: var(--a-r-md);
  background: var(--a-surface);
  box-shadow: var(--a-sh-card);
}
.pa-banner-text {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-cap);
  color: var(--a-ink-2);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.pa-banner-retry {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 0 28rpx;
  font-size: var(--fs-sub);
  font-weight: 600;
  color: var(--a-ink);
}

/* ---------- 2. 今天吃什么 主卡 ---------- */
.pa-today {
  box-sizing: border-box;
  padding: var(--a-pad);
  border-radius: var(--a-r-xl);
  background: var(--a-surface);
  box-shadow: var(--a-sh-card);
}
.pa-today-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.pa-today-title {
  font-size: var(--fs-h2);
  font-weight: 700;
  line-height: 1.3;
  color: var(--a-ink);
}
.pa-today-date {
  font-size: var(--fs-cap);
  color: var(--a-ink-3);
}

/* 分段控件：灰轨 + 白色选中块，选中只变底色和字重，不用红 */
.pa-seg {
  display: flex;
  margin-top: 24rpx;
  padding: 6rpx;
  border-radius: var(--a-r-md);
  background: var(--a-fill);
}
.pa-seg-item {
  position: relative;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  border-radius: 12rpx;
  font-size: var(--fs-body);
  font-weight: 400;
  color: var(--a-ink-2);
  transition: background 0.18s ease, color 0.18s ease;
}
/* 视觉 64rpx，热区上下各扩 12rpx 到 88rpx */
.pa-seg-item::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: -12rpx;
  bottom: -12rpx;
}
.pa-seg-item.is-on {
  background: var(--a-surface);
  font-weight: 600;
  color: var(--a-ink);
  box-shadow: var(--a-sh-seg);
}
.pa-seg-press { opacity: 0.6; }

/* 已点统计：大数字 + 叠放菜图 */
.pa-stat {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 80rpx;
  margin-top: 28rpx;
}
.pa-stat-main {
  display: flex;
  align-items: baseline;
}
.pa-stat-num {
  font-size: var(--fs-stat);
  font-weight: 700;
  line-height: 1.1;
  color: var(--a-ink);
}
.pa-stat-unit {
  margin-left: 10rpx;
  font-size: var(--fs-sub);
  color: var(--a-ink-2);
}
.pa-stat-empty {
  font-size: var(--fs-lg);
  font-weight: 600;
  color: var(--a-ink-2);
}
.pa-stack {
  display: flex;
  align-items: center;
  padding-left: 20rpx;
}
.pa-stack-img,
.pa-stack-more {
  box-sizing: border-box;
  width: 72rpx;
  height: 72rpx;
  margin-left: -20rpx;
  border-radius: 50%;
  border: 4rpx solid var(--a-surface);
  background: var(--a-fill);
}
.pa-stack-more {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-mini);
  font-weight: 600;
  color: var(--a-ink-2);
}

/* ---------- 按钮系统（全胶囊、字重统一 600） ---------- */
.pa-btn {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: var(--a-btn-h);
  margin-top: 28rpx;
  border-radius: var(--a-r-pill);
  font-size: var(--fs-btn);
  font-weight: 600;
  letter-spacing: 1rpx;
}
.pa-btn-pop {
  background: var(--a-accent);
  color: var(--a-on-accent);
  box-shadow: var(--a-sh-pop);
}
.pa-btn-dark {
  background: var(--a-ink);
  color: var(--a-surface);
}

/* 小按钮：中性灰底 + 墨字，视觉 64rpx，热区 88rpx */
.pa-btn-sm {
  position: relative;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  height: var(--a-btn-sm-h);
  padding: 0 28rpx;
  border-radius: var(--a-r-pill);
  background: var(--a-fill);
  font-size: var(--fs-sub);
  font-weight: 600;
  color: var(--a-ink);
  white-space: nowrap;
}
.pa-btn-sm::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  height: 88rpx;
  transform: translateY(-50%);
}
.pa-btn-sm.is-joined { color: var(--a-ink-3); }

/* 圆形加号：墨色实心，已加入时退成灰底对勾 */
.pa-btn-ico {
  position: relative;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--a-btn-ico);
  height: var(--a-btn-ico);
  border-radius: 50%;
  background: var(--a-ink);
  color: var(--a-surface);
}
.pa-btn-ico::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 88rpx;
  height: 88rpx;
  transform: translate(-50%, -50%);
}
.pa-btn-ico.is-joined {
  background: var(--a-fill);
  color: var(--a-ink-2);
}
.pa-plus {
  position: relative;
  width: 24rpx;
  height: 24rpx;
}
.pa-plus::before,
.pa-plus::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  background: currentColor;
  border-radius: 2rpx;
  transform: translate(-50%, -50%);
}
.pa-plus::before { width: 24rpx; height: 4rpx; }
.pa-plus::after { width: 4rpx; height: 24rpx; }
.is-joined .pa-plus::before {
  left: 30%;
  top: 8%;
  width: 10rpx;
  height: 18rpx;
  background: transparent;
  border-right: 4rpx solid currentColor;
  border-bottom: 4rpx solid currentColor;
  border-radius: 0;
  transform: rotate(45deg);
}
.is-joined .pa-plus::after { display: none; }

/* ---------- 区块标题 ---------- */
.pa-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 40rpx;
  margin-bottom: 8rpx;
}
.pa-head-title {
  font-size: var(--fs-h2);
  font-weight: 700;
  line-height: 1.3;
  color: var(--a-ink);
}
.pa-head-link {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding-left: 24rpx;
  font-size: var(--fs-sub);
  font-weight: 600;
  color: var(--a-ink-2);
}
.pa-meta {
  margin-top: 6rpx;
  font-size: var(--fs-cap);
  line-height: 1.4;
  color: var(--a-ink-3);
}
.pa-empty {
  padding: 48rpx var(--a-pad);
  border-radius: var(--a-r-lg);
  background: var(--a-surface);
  font-size: var(--fs-sub);
  color: var(--a-ink-2);
  text-align: center;
}

/* ---------- 3. 推荐横滑大卡 ---------- */
.pa-hs {
  width: calc(100% + 2 * var(--a-gap));
  margin-left: calc(-1 * var(--a-gap));
  white-space: nowrap;
}
.pa-hs-track {
  display: inline-flex;
  gap: 20rpx;
  padding: 8rpx var(--a-gap) 24rpx;
}
.pa-rec {
  flex: none;
  width: 456rpx;
  border-radius: var(--a-r-lg);
  background: var(--a-surface);
  box-shadow: var(--a-sh-card);
  white-space: normal;
}
.pa-rec-img {
  display: block;
  width: 456rpx;
  height: 342rpx;
  border-radius: var(--a-r-lg) var(--a-r-lg) 0 0;
  background: var(--a-fill);
}
.pa-rec-body {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 20rpx 24rpx 24rpx;
}
.pa-rec-info {
  flex: 1;
  min-width: 0;
}
.pa-rec-name {
  font-size: var(--fs-lg);
  font-weight: 600;
  line-height: 1.35;
  color: var(--a-ink);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ---------- 4. 两列菜谱网格 ---------- */
.pa-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding-top: 8rpx;
}
.pa-cell {
  box-sizing: border-box;
  width: calc((100% - 20rpx) / 2);
  border-radius: var(--a-r-lg);
  background: var(--a-surface);
  box-shadow: var(--a-sh-card);
}
.pa-cell-img {
  display: block;
  width: 100%;
  height: 250rpx;
  border-radius: var(--a-r-lg) var(--a-r-lg) 0 0;
  background: var(--a-fill);
}
.pa-cell-body {
  padding: 18rpx 20rpx 20rpx;
}
.pa-cell-name {
  min-height: 2.8em;
  font-size: var(--fs-body);
  font-weight: 600;
  line-height: 1.4;
  color: var(--a-ink);
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.pa-cell-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 8rpx;
}
.pa-cell-meta {
  flex: 1;
  min-width: 0;
  margin-top: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ---------- 失败态 ---------- */
.pa-fail {
  margin-top: 40rpx;
  padding: 64rpx var(--a-pad) var(--a-pad);
  border-radius: var(--a-r-xl);
  background: var(--a-surface);
  box-shadow: var(--a-sh-card);
  text-align: center;
}
.pa-fail-title {
  font-size: var(--fs-lg);
  font-weight: 600;
  color: var(--a-ink);
}
.pa-fail-desc {
  margin-top: 12rpx;
  font-size: var(--fs-sub);
  line-height: 1.5;
  color: var(--a-ink-2);
}

/* ---------- 骨架（与真实块同尺寸） ---------- */
.pa-sk {
  background: var(--a-fill);
  animation: paPulse 1.2s ease-in-out infinite;
}
.pa-sk-family {
  width: 280rpx;
  height: 56rpx;
  margin-top: 8rpx;
  border-radius: 12rpx;
}
.pa-sk-today {
  height: 432rpx;
  border-radius: var(--a-r-xl);
}
.pa-sk-h {
  width: 200rpx;
  height: 44rpx;
  margin: 62rpx 0 30rpx;
  border-radius: 12rpx;
}
.pa-sk-row {
  display: flex;
  gap: 20rpx;
  overflow: hidden;
}
.pa-sk-rec {
  flex: none;
  width: 456rpx;
  height: 470rpx;
  border-radius: var(--a-r-lg);
}
.pa-sk-cell {
  width: calc((100% - 20rpx) / 2);
  height: 420rpx;
  border-radius: var(--a-r-lg);
}
@keyframes paPulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.55; }
}

/* 预览页没有 tabBar：底部让出真实 tab 页同样的高度 */
.pa-tabbar-space {
  height: var(--tabbar-h);
}

/* ---------- 深色档：整组 token 覆盖，结构不变 ---------- */
@media (prefers-color-scheme: dark) {
  page {
    --a-bg: #141414;
    --a-surface: #1f1f1f;
    --a-fill: #2a2a2a;
    --a-ink: #f2f2f2;
    --a-ink-2: #a3a3a3;
    --a-ink-3: #767676;
    --a-sh-card: 0 0 0 2rpx #2a2a2a;
    --a-sh-seg: none;
    --a-sh-pop: none;
  }
}
