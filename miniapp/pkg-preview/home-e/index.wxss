/* ============================================================
   首页风格预览 · 方案 E「家庭点菜单」
   一屏一张主卡：这顿的点菜单（问句标题 + 家人进度 + 已点 + 下锅顺序），
   底部一道撕口，存根上是这顿要多久和「开始做菜」；下面几排横滑推荐（新手 / 常做 / 当季），点「+」直接进单子。
   不放悬浮底栏（正式版有 tabbar，会叠两层）。
   颜色、圆角、阴影、字号全走 app.wxss 的全站 token（米纸底 + 墨色字，番茄红只给行动点），
   深色模式跟着 token 翻转，本页不再自带一套色表。
   ============================================================ */
page { --e-gutter: var(--sp-lg); background: var(--paper); }
.pe { min-height: 100vh; background: var(--paper); color: var(--ink); font-size: var(--fs-body); }
.pe-wrap { padding: 0 var(--e-gutter); }
.pe-press { opacity: 0.7; }

/* 1. 顶栏：和胶囊同高的一行小字，下面餐次分段（每段就是 88rpx 热区） */
.pe-top { padding: 0 var(--e-gutter) 32rpx; }
.pe-date {
  height: 64rpx; line-height: 64rpx; font-size: var(--fs-cap); font-weight: 600; letter-spacing: 2rpx; color: var(--mut-strong);
  overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
}
.pe-seg { display: flex; gap: 8rpx; margin-top: 20rpx; padding: 6rpx; border-radius: var(--r-pill); background: var(--paper-2); }
.pe-seg-tab {
  flex: 1; height: 88rpx; display: flex; align-items: center; justify-content: center; gap: 8rpx;
  border-radius: var(--r-pill); color: var(--mut-strong); font-size: var(--fs-body); font-weight: 600;
}
/* 选中反色：浅色档墨底米字，深色档跟着 token 翻成浅底深字 */
.pe-seg-tab.is-on { background: var(--ink); color: var(--paper); font-weight: 800; box-shadow: var(--sh-card); }
.pe-seg-badge {
  min-width: 36rpx; height: 36rpx; padding: 0 10rpx; box-sizing: border-box; border-radius: var(--r-pill);
  background: var(--pop); color: var(--anchor-contrast); font-size: var(--fs-mini); font-weight: 800; line-height: 36rpx; text-align: center;
}
.pe-tip {
  display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin: 0 var(--e-gutter) 24rpx;
  padding: 0 var(--pad-card-sm); border-radius: var(--r-card); background: var(--pop-soft);
}
.pe-tip-text { font-size: var(--fs-cap); color: var(--pop); }
.pe-tip-retry { min-height: 88rpx; min-width: 88rpx; display: flex; align-items: center; justify-content: flex-end; font-size: var(--fs-cap); font-weight: 700; color: var(--pop); }

/* 2. 主卡：这顿的点菜单 */
.pe-ticket { position: relative; padding: 32rpx var(--pad-card) 0; border-radius: var(--r-card); background: var(--c-surface); box-shadow: var(--sh-raised); }
/* 标题就是问句，餐次那个词用番茄红点一下（杂志标题的撞色字） */
.pe-ask { font-size: var(--fs-h1); font-weight: 800; line-height: 1.2; letter-spacing: -1rpx; color: var(--ink); }
.pe-ask-meal { color: var(--pop); }
.pe-fam { display: flex; align-items: center; gap: 20rpx; min-height: 88rpx; margin-top: 12rpx; }
.pe-avas { display: flex; flex-shrink: 0; }
.pe-ava {
  width: var(--ava-cmt); height: var(--ava-cmt); margin-left: -16rpx; box-sizing: border-box;
  border-radius: calc(var(--ava-cmt) * var(--r-ava)); border: 4rpx solid var(--c-surface);
  display: flex; align-items: center; justify-content: center;
  font-size: calc(var(--ava-cmt) * var(--ava-glyph) * var(--fs-mul, 1)); font-weight: 800; color: var(--anchor-contrast);
}
.pe-ava:first-child { margin-left: 0; }
/* 家人五色和「我的」页同一套（按成员顺序轮）；金色底上的字用恒定深棕，深色档也看得清。
   蓝色深色档会翻成浅蓝，米白字看不清，字改取卡面色（浅色档白、深色档深灰，两档都是镂空字） */
.tone-0 { background: linear-gradient(135deg, var(--cat-gold), var(--gold-deep)); color: var(--anchor); }
.tone-1 { background: var(--cat-brown); }
.tone-2 { background: var(--pine); }
.tone-3 { background: var(--cat-purple); }
.tone-4 { background: var(--c-info); color: var(--c-surface); }
.pe-ava.is-off { background: var(--paper-2); color: var(--mut-strong); }
.pe-ava.is-add { background: var(--pop-soft); color: var(--pop); }
.pe-fam-note { flex: 1; min-width: 0; font-size: var(--fs-sub); color: var(--mut-strong); overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }

/* 已点：菜图走全站行内缩略图规格，序号压在图的左上角 */
.pe-seq-tip { margin-top: 8rpx; font-size: var(--fs-cap); color: var(--mut); }
.pe-order { display: flex; align-items: center; gap: 24rpx; padding: 24rpx 0; border-bottom: 2rpx solid var(--line); }
.pe-order-pic { position: relative; flex-shrink: 0; }
.pe-order-thumb { width: var(--dish-thumb); height: var(--dish-thumb); display: block; border-radius: var(--r-card); background: var(--paper-2); }
/* 下锅序号：恒定深棕底（两档都不翻转），描边取卡面色，像从图上抠出来 */
.pe-order-seq {
  position: absolute; left: -10rpx; top: -10rpx; width: 48rpx; height: 48rpx; box-sizing: border-box;
  border-radius: 50%; border: 4rpx solid var(--c-surface); background: var(--anchor); color: var(--anchor-contrast);
  display: flex; align-items: center; justify-content: center; font-size: var(--fs-mini); font-weight: 800;
}
.pe-order-info { flex: 1; min-width: 0; }
.pe-order-name { font-size: var(--fs-lg); font-weight: 800; color: var(--ink); overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.pe-order-name.is-done { color: var(--mut); text-decoration: line-through; }
.pe-order-meta { margin-top: 10rpx; font-size: var(--fs-cap); color: var(--mut); overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
/* 右栏：用时数字放大右对齐，和左边的菜名一左一右 */
.pe-order-side { flex-shrink: 0; display: flex; align-items: center; gap: 12rpx; }
.pe-order-sidecol { display: flex; flex-direction: column; align-items: flex-end; gap: 8rpx; }
.pe-order-time { font-size: var(--fs-h2); font-weight: 800; color: var(--ink); line-height: 1.2; }
.pe-order-time.is-done { color: var(--mut); }
.pe-order-unit { margin-left: 4rpx; font-size: var(--fs-cap); font-weight: 400; color: var(--mut); }
.pe-order-arrow { font-size: var(--fs-h2); color: var(--mut-2); line-height: 1; }
.pe-status { padding: 4rpx 16rpx; border-radius: var(--r-pill); font-size: var(--fs-cap); font-weight: 700; }
.pe-status.is-cooking { background: var(--c-gold-soft); color: var(--gold-deep); }
.pe-status.is-done { background: var(--c-success-soft); color: var(--c-success); }

/* 再点一道：安静的一行字，虚线留给下面的撕口 */
.pe-again { display: flex; align-items: center; gap: 12rpx; min-height: 96rpx; }
.pe-again-plus { font-size: var(--fs-h2); color: var(--pop); line-height: 1; }
.pe-again-text { flex: 1; font-size: var(--fs-body); font-weight: 700; color: var(--pop); }
.pe-again-hint { font-size: var(--fs-cap); color: var(--mut); }

/* 撕口存根：一道虚线 + 两侧半圆缺口（圆取页面纸色，压在卡边上就是咬进去的口子） */
.pe-stub {
  position: relative; display: flex; align-items: center; justify-content: space-between; gap: 24rpx;
  margin: 0 calc(-1 * var(--pad-card)); padding: 32rpx var(--pad-card) var(--pad-card);
  border-top: 2rpx dashed var(--line-deep);
}
.pe-stub::before, .pe-stub::after {
  content: ''; position: absolute; top: -21rpx; width: 40rpx; height: 40rpx; border-radius: 50%; background: var(--paper);
}
.pe-stub::before { left: -20rpx; }
.pe-stub::after { right: -20rpx; }
.pe-stub-sum { flex: 1; min-width: 0; }
.pe-stub-big { display: flex; align-items: baseline; gap: 6rpx; font-size: var(--fs-sub); color: var(--mut-strong); }
.pe-stub-num { font-size: var(--fs-h1); font-weight: 800; color: var(--ink); line-height: 1.1; letter-spacing: -1rpx; }
.pe-stub-sub { margin-top: 6rpx; font-size: var(--fs-cap); color: var(--mut); overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.pe-cta {
  flex-shrink: 0; min-height: 96rpx; padding: 0 56rpx; display: flex; align-items: center; justify-content: center;
  border-radius: var(--r-pill); background: var(--pop); color: var(--anchor-contrast);
  font-size: var(--fs-lg); font-weight: 800; letter-spacing: 2rpx; box-shadow: var(--sh-pop);
}
/* 微信内置 button:not([size=mini]) 固定 184px 宽，单类名压不过，带上父级提高优先级撑满 */
.pe-stub .pe-share {
  flex: 1; width: 100%; max-width: none; margin: 0; padding: 0; min-height: 88rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: var(--r-pill); background: var(--pop-soft); color: var(--pop);
  font-size: var(--fs-btn); font-weight: 700; line-height: 1;
}
.pe-share::after { border: 0; }

/* 空单：一个「等着放菜」的虚线空位 */
.pe-slot {
  display: flex; align-items: center; gap: 24rpx; margin: 16rpx 0 32rpx; padding: var(--pad-card-sm);
  border: 2rpx dashed var(--line-deep); border-radius: var(--r-card); background: var(--paper);
}
.pe-slot-plus {
  flex-shrink: 0; width: 112rpx; height: 112rpx; border-radius: var(--r-card); background: var(--c-surface);
  display: flex; align-items: center; justify-content: center;
  font-size: calc(56rpx * var(--fs-mul, 1)); font-weight: 300; color: var(--pop);
}
.pe-slot-info { flex: 1; min-width: 0; }
.pe-slot-title { font-size: var(--fs-lg); font-weight: 800; color: var(--ink); }
.pe-slot-sub { margin-top: 8rpx; font-size: var(--fs-cap); color: var(--mut); }

/* 3. 推荐几排：每排横滑，露出第三张的一角提示能滑 */
.pe-sec { margin-top: 56rpx; }
/* 上一排滚动区底下已经留了 20rpx 给卡片阴影，这里扣掉，排与排的间距和主卡到第一排一样 */
.pe-sec + .pe-sec { margin-top: 36rpx; }
.pe-sec-head { display: flex; align-items: baseline; gap: 16rpx; margin-bottom: 20rpx; }
.pe-sec-title { flex-shrink: 0; font-size: var(--fs-h2); font-weight: 800; color: var(--ink); }
.pe-sec-sub { flex: 1; min-width: 0; font-size: var(--fs-cap); color: var(--mut); overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.pe-sec-more {
  flex-shrink: 0; align-self: center; min-height: 88rpx; margin: -24rpx 0; padding-left: 16rpx;
  display: flex; align-items: center; font-size: var(--fs-cap); font-weight: 600; color: var(--mut-strong);
}
/* 滚动区贴到屏幕两边，卡片仍和上面内容左对齐 */
.pe-hscroll { margin: 0 calc(-1 * var(--e-gutter)); width: auto; white-space: nowrap; }
.pe-hrow { display: inline-flex; gap: 20rpx; padding: 4rpx 0 20rpx var(--e-gutter); }
.pe-hrow-end { flex-shrink: 0; width: calc(var(--e-gutter) - 20rpx); }
.pe-card {
  position: relative; flex-shrink: 0; width: 264rpx; box-sizing: border-box; white-space: normal;
  border-radius: var(--r-card); border: var(--bd-card); background: var(--c-surface); box-shadow: var(--sh-card);
  overflow: hidden; transform: translateZ(0);
}
.pe-card.is-picked { border-color: var(--pop); box-shadow: 0 0 0 4rpx var(--pop-soft), var(--sh-card); }
.pe-card-img { display: block; width: 100%; height: 220rpx; background: var(--paper-2); }
.pe-card-body { padding: 20rpx var(--pad-card-sm) 24rpx; }
.pe-card-name { font-size: var(--fs-body); font-weight: 800; color: var(--ink); overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
/* 卡片窄，大字模式下「60分钟 · 费点功夫」会折行把整排撑高，一律单行截断 */
.pe-card-meta { margin-top: 6rpx; font-size: var(--fs-cap); color: var(--mut); overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
/* 「+」压在图片右下角：视觉 56rpx，热区 88rpx。没点是白底红「+」，点了反成红底白勾，一排里点过哪几道一眼分出来 */
.pe-plus { position: absolute; right: 4rpx; top: 140rpx; width: 88rpx; height: 88rpx; display: flex; align-items: center; justify-content: center; }
.pe-plus-dot {
  width: 56rpx; height: 56rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center;
  background: var(--c-surface); color: var(--pop); box-shadow: var(--sh-card); font-size: var(--fs-h2); font-weight: 700; line-height: 1;
}
.pe-plus-dot.is-on { background: var(--pop); color: var(--anchor-contrast); font-size: var(--fs-body); box-shadow: var(--sh-pop); }
/* 末尾一张「查看全部」，滑到头有去处 */
.pe-card-all {
  width: 168rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12rpx;
  background: var(--paper-2); border-color: transparent; box-shadow: none;
}
.pe-card-all-icon {
  width: 64rpx; height: 64rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center;
  background: var(--c-surface); color: var(--ink); font-size: var(--fs-h2); line-height: 1;
}
.pe-card-all-text { font-size: var(--fs-cap); font-weight: 600; color: var(--mut-strong); }

/* 当季那排换成杂志式大图宽卡，菜名压在图上。
   遮罩是照片上的固定暗色、两档都不翻转，所以按全站 hero 遮罩的写法直接给 rgba */
.pe-sec--season .pe-card { width: 520rpx; }
.pe-sec--season .pe-card-img { height: 340rpx; }
.pe-sec--season .pe-card-body {
  position: absolute; left: 0; right: 0; bottom: 0; padding: 96rpx var(--pad-card) 24rpx;
  background: linear-gradient(180deg, rgba(20, 14, 8, 0) 0%, rgba(20, 14, 8, 0.72) 100%);
}
.pe-sec--season .pe-card-name { font-size: var(--fs-lg); color: var(--anchor-contrast); }
.pe-sec--season .pe-card-meta { color: var(--anchor-contrast); opacity: 0.85; }
.pe-sec--season .pe-plus { top: 4rpx; }
.pe-sec--season .pe-card-all { width: 168rpx; }

.pe-fail { padding-top: 80rpx; }
.pe-sk-ticket { height: 560rpx; }
.pe-sk-head { width: 240rpx; height: 44rpx; margin-top: 56rpx; }
/* 骨架那排也贴到屏幕右边，和加载完的横滑排一样露半张 */
.pe-sk-row { display: flex; gap: 20rpx; margin: 20rpx calc(-1 * var(--e-gutter)) 0 0; overflow: hidden; }
.pe-sk-card { flex-shrink: 0; width: 264rpx; height: 320rpx; }

/* 正式版底部是 tabbar，留出它的高度（token 已含安全区） */
.pe-bottom-space { height: calc(var(--tabbar-h) + 32rpx); }
