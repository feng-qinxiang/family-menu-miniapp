/* 设置页 · 视觉对标 settings.html，配色/字体全部走 app.wxss 全局 token */
.settings {
  padding: 0 46rpx 50rpx;
}

/* —— 分组 —— */
.set-group {
  margin-top: 12rpx;
}
.set-group:first-of-type .set-gtitle {
  margin-top: 24rpx;   /* 导航栏已给出页名，首组贴近顶部 */
}
.set-gtitle {
  font-family: var(--serif);
  font-size: var(--fs-cap);
  letter-spacing: 1rpx;
  color: var(--gold-deep);
  font-weight: 700;
  margin: 46rpx 8rpx 21rpx;
}

/* 卡片复用全局 .card，仅覆盖 padding/圆角以贴合分组列表 */
.set-card {
  padding: 0;
  border-radius: var(--r-card);
  overflow: hidden;
}

/* —— 列表项 —— */
.set-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: var(--tap-min);
  padding: 28rpx var(--pad-card-sm);
  border-bottom: 2rpx solid var(--c-border-light);
}
.set-item:last-child {
  border-bottom: none;
}

.set-mid {
  flex: 1;
  min-width: 0;
}
.set-name {
  font-size: calc(28rpx * var(--fs-mul, 1));
  font-weight: 700;
  color: var(--ink);
  letter-spacing: -0.4rpx;
}
.set-desc {
  margin-top: 4rpx;
  font-size: calc(23rpx * var(--fs-mul, 1));
  color: var(--mut-strong);
  line-height: 1.4;
}

.set-val {
  flex: none;
  font-size: var(--fs-sub);
  font-weight: 600;
  color: var(--mut-strong);
}

/* 右箭头雪佛龙：用边框旋转模拟。
   --line-deep 是分隔线色，压在白卡上只有 1.6:1（深色档 1.4:1，几乎看不见）；与关于页、创建家庭页同用 --mut-2 */
.set-chev {
  flex: none;
  width: 16rpx;
  height: 16rpx;
  border-right: 4rpx solid var(--mut-2);
  border-top: 4rpx solid var(--mut-2);
  border-radius: 2rpx;
  transform: rotate(45deg);
}

/* —— 开关 —— */
.set-sw {
  position: relative;
  width: 92rpx;
  height: 56rpx;
  border-radius: var(--r-pill);
  background: var(--c-border);
  flex: none;
  transition: background 0.2s ease;
}
.set-sw.on {
  background: var(--pop-fill);
}
.set-sw-knob {
  position: absolute;
  top: 5rpx;
  left: 5rpx;
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  background: var(--c-surface);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.2);
  transition: left 0.2s ease;
}
.set-sw.on .set-sw-knob {
  left: 41rpx;
}
/* 深色档关态：轨道 --c-border 翻成 #3a3a3a、滑块 --c-surface 翻成 #242424，两者 1.4:1，
   关着的开关只剩一块看不出形状的灰。轨道换成 --mut-2（深色档 #757570，3.4:1），滑块重新浮出来 */
@media (prefers-color-scheme: dark) {
  .set-sw { background: var(--mut-2); }
}

/* —— 退出登录 红卡 —— */
.set-logout {
  margin-top: 50rpx;
}
.set-logout-card {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--pad-card);
  border-radius: var(--r-card);
}
.set-logout-txt {
  font-size: calc(32rpx * var(--fs-mul, 1));
  font-weight: 800;
  color: var(--pop);
  letter-spacing: 0.6rpx;
}

/* —— 版本号 —— */
.set-ver {
  text-align: center;
  font-size: var(--fs-cap);
  color: var(--mut-strong);
  margin-top: 36rpx;
}
.set-ver-num {
  font-family: var(--serif);
}

/* 注销账号：危险操作，不进列表、不用红，弱化成底部文字链 */
.set-delete { display: flex; align-items: center; justify-content: center; min-height: var(--tap-min); margin-top: 16rpx; font-size: var(--fs-sub); color: var(--mut-strong); }
