<!-- pages/me/notifications · 消息中心（二级页） -->
<view class="notif-page {{fontScale === 'lg' ? 'font-lg' : ''}}">
  <nav-bar title="消息中心" show-back="{{true}}" />

  <scroll-view scroll-y class="notif-scroll" enhanced show-scrollbar="{{false}}">
    <view class="cpt-head g-fade-up">
      <view class="cpt-row notif-title-row">
        <view class="cpt-titles">
          <view class="cpt-eyebrow">家里的动静</view>
          <view class="cpt-title">消息通知</view>
        </view>
        <view wx:if="{{!loading && !loadError && unreadCount > 0}}" class="notif-readall tap-scale" catchtap="onReadAll" aria-role="button" aria-label="将全部未读消息标为已读">
          <view class="notif-readall-label"><image class="notif-readall-icon" src="/assets/icons/lucide/check.svg" mode="aspectFit" aria-hidden="true" /><text>全部标为已读</text></view>
        </view>
      </view>
      <view class="cpt-sub">{{loading ? '正在加载消息…' : loadError ? '消息暂未同步' : unreadCount ? '你有 ' + unreadCount + ' 条未读消息' : '暂无未读消息'}}</view>
    </view>

    <!-- Tab chips -->
    <scroll-view scroll-x class="tabs hscroll" enhanced show-scrollbar="{{false}}">
      <view class="tabs-inner">
        <view
          wx:for="{{tabs}}"
          wx:key="key"
          class="chip tap-scale {{activeTab === item.key ? 'on' : ''}}"
          data-key="{{item.key}}"
          catchtap="onTabChange"
        >
          <text>{{item.label}}</text>
          <view wx:if="{{item.unread > 0}}" class="dot tab-dot"></view>
        </view>
      </view>
    </scroll-view>

    <!-- 列表 -->
    <view class="list">
      <block wx:for="{{groups}}" wx:key="label" wx:for-item="group">
        <view wx:if="{{group.items.length > 0}}" class="day-block">
          <view class="daylbl">{{group.label}}</view>

          <view
            wx:for="{{group.items}}"
            wx:key="id"
            wx:for-item="n"
            class="ncard tap-scale g-fade-up {{n.unread ? 'unread' : ''}}"
            data-id="{{n.id}}"
            catchtap="onCardTap"
          >
            <view class="nhead">
            <view class="ic ic-{{n.kind}}">
              <image
                wx:if="{{n.avatar}}"
                class="ic-img"
                src="{{n.avatar}}"
                mode="aspectFill"
                lazy-load
              />
              <image wx:elif="{{n.kind === 'pantry'}}" class="ic-pantry-img" src="/assets/icons/tab-fridge.svg" mode="aspectFit" aria-hidden="true" />
              <view wx:else class="ic-svg ic-{{n.icon}}"></view>
            </view>
              <view class="nt">
                <text class="nt-h3">{{n.title}}</text>
                <view class="nt-meta"><text>{{n.kind === 'com' ? '社区动态' : n.kind === 'sys' ? '系统通知' : '家庭动态'}}</text></view>
              </view>
              <text class="nt-time">{{n.time}}</text>
            </view>
            <view class="nmid">
              <view class="nt-body">
                <text wx:for="{{n.body}}" wx:key="index" wx:for-item="seg" class="seg seg-{{seg.t}}">{{seg.v}}</text>
              </view>

              <view class="nfoot">
                <image
                  wx:if="{{n.thumb}}"
                  class="thumb-dish"
                  src="{{n.thumb}}"
                  mode="aspectFill"
                  lazy-load
                />
                <view class="nread-state {{n.unread ? 'is-unread' : ''}}"><view wx:if="{{n.unread}}" class="reddot"></view>{{n.unread ? '未读' : '已读'}}</view>
                <view
                  wx:if="{{n.action}}"
                  class="nbtn tap-scale {{n.action.ghost ? 'ghost' : ''}}"
                  data-id="{{n.id}}"
                  catchtap="onAction"
                >
                  <text>{{n.action.label}}</text>
                  <view class="nbtn-arrow {{n.action.ghost ? 'arrow-ink' : ''}}"></view>
                </view>
              </view>
            </view>

          </view>
        </view>
      </block>

      <state-empty
        wx:if="{{loadError}}"
        type="offline"
        title="消息没加载出来"
        desc="网络开小差了，检查后再试"
        cta="重新加载"
        bind:action="retryLoad"
      />

      <state-empty
        wx:elif="{{!loading && visibleCount === 0}}"
        title="暂无消息"
        desc="这里会显示家庭、社区与系统的动态"
      />
    </view>

    <view class="safe-bottom"></view>
  </scroll-view>

  <state-toast
    visible="{{toast.visible}}"
    type="{{toast.type}}"
    text="{{toast.text}}"
    bind:close="onToastClose"
  />
</view>
