/* 意见反馈 · 二级页样式 —— 复用全局 token，禁硬编码配色 */

.fb { padding-top: 0; }

/* nav-bar 右侧提交 */

/* —— Hero —— */
.fb-head { padding: 24rpx 0 8rpx; }
.fb-desc {
  margin-top: 0;
  font-size: var(--fs-sub);
  line-height: 1.5;
  color: var(--mut-strong);
}

/* —— Section —— */
.fb-sec { margin-top: 50rpx; }
.fb-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
  font-size: calc(25rpx * var(--fs-mul, 1));
  font-weight: 800;
  letter-spacing: 2rpx;
  color: var(--ink-deep);
  text-transform: uppercase;
}
.fb-label .star { color: var(--pop); font-size: calc(25rpx * var(--fs-mul, 1)); }
.fb-label .label-tip {
  font-weight: 600;
  letter-spacing: 0;
  text-transform: none;
  color: var(--mut-strong);
}

/* —— 类型 chip —— */
.fb-chips { display: flex; flex-wrap: wrap; gap: 18rpx; }
.fb-chips .chip {
  background: var(--paper-2);
  color: var(--mut-strong);
  border: 3rpx solid transparent;
}
.fb-chips .chip.on {
  background: var(--pop-soft);
  color: var(--pop);
  border-color: var(--pop);
}

/* —— 描述 textarea —— */
.ta-wrap {
  position: relative;
  background: var(--c-surface);
  border: var(--bd-card);
  border-radius: var(--r-card);
  box-shadow: var(--sh-soft);
  padding: 30rpx var(--pad-card) 64rpx;
}
.ta {
  width: 100%;
  height: 240rpx;
  font-size: calc(29rpx * var(--fs-mul, 1));
  line-height: 1.6;
  color: var(--ink);
}
.ta-ph { color: var(--mut); }
.counter {
  position: absolute;
  right: var(--pad-card);   /* 与输入文字同一条右边 */
  bottom: 24rpx;
  font-size: calc(23rpx * var(--fs-mul, 1));
  font-weight: 600;
  color: var(--mut);
}

/* —— 图片上传 —— */
.uploads { display: flex; flex-wrap: wrap; gap: 22rpx; }
.up-img {
  position: relative;
  width: 162rpx;
  height: 162rpx;
  border-radius: var(--r-sm);
  overflow: hidden;
  flex: none;
  box-shadow: var(--sh-soft);
}
.up-pic { width: 100%; height: 100%; display: block; }
.up-img .del {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--anchor);
  display: flex;
  align-items: center;
  justify-content: center;
}
.up-img .del::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 88rpx;
  height: 88rpx;
  transform: translate(-50%, -50%);
}
.del-x {
  position: relative;
  width: 20rpx;
  height: 20rpx;
}
.del-x::before, .del-x::after {
  content: "";
  position: absolute;
  left: 0;
  top: 9rpx;
  width: 20rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: var(--anchor-contrast);   /* --anchor 底上的前景用配套的 --anchor-contrast；--paper 深色档翻成 #1c1c1c，× 从浅色变成了黑色 */
}
.del-x::before { transform: rotate(45deg); }
.del-x::after { transform: rotate(-45deg); }

.up-add {
  width: 162rpx;
  height: 162rpx;
  border-radius: var(--r-sm);
  border: 3rpx dashed var(--mut-2);
  background: var(--paper-2);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  flex: none;
}
.up-plus {
  position: relative;
  width: 40rpx;
  height: 40rpx;
}
.up-plus::before, .up-plus::after {
  content: "";
  position: absolute;
  background: var(--mut-strong);
  border-radius: 3rpx;
}
.up-plus::before { left: 18rpx; top: 2rpx; width: 4rpx; height: 36rpx; }
.up-plus::after { left: 2rpx; top: 18rpx; width: 36rpx; height: 4rpx; }
.up-t { font-size: var(--fs-mini); font-weight: 700; color: var(--mut-strong); }

/* —— 联系方式 —— */
.input-wrap {
  display: flex;
  align-items: center;
  gap: 20rpx;
  height: 104rpx;
  padding: 0 var(--pad-card);
  background: var(--c-surface);
  border: var(--bd-card);
  border-radius: var(--r-card);   /* 与上面的描述框同一个圆角（原 --r-md，两个输入框一方一圆） */
  box-shadow: var(--sh-soft);
}
.mail-ic {
  position: relative;
  width: 34rpx;
  height: 26rpx;
  border: 3rpx solid var(--gold-deep);
  border-radius: 5rpx;
  flex: none;
}
.mail-ic::after {
  content: "";
  position: absolute;
  left: 2rpx;
  top: 1rpx;
  width: 26rpx;
  height: 16rpx;
  border-left: 3rpx solid var(--gold-deep);
  border-right: 3rpx solid var(--gold-deep);
  transform: skewX(0) rotate(0);
  border-top: 3rpx solid var(--gold-deep);
  border-radius: 0 0 var(--r-xs) var(--r-xs);
}
.contact-input { flex: 1; font-size: calc(28rpx * var(--fs-mul, 1)); color: var(--ink); }
.contact-ph { color: var(--mut); }

/* —— 提交 —— */
/* padding 简写会盖掉 .safe-bottom，底部安全区写在这里 */
.submit-area { padding: 60rpx 0 calc(80rpx + env(safe-area-inset-bottom)); }
.submit-area .btn-pop {
  gap: 14rpx;
  min-height: 104rpx;
  font-size: calc(32rpx * var(--fs-mul, 1));
  letter-spacing: 1rpx;
}
.submit-area .btn-pop.is-busy { opacity: 0.7; }
.send-ic {
  width: 30rpx;
  height: 30rpx;
  background: var(--anchor-contrast);   /* 红底白图标：与按钮文字同色、恒浅 */
  flex: none;
  /* 纸飞机三角 */
  clip-path: polygon(100% 0, 0 45%, 42% 56%, 55% 100%);
}
.hint {
  margin-top: 26rpx;
  text-align: center;
  font-size: calc(23rpx * var(--fs-mul, 1));
  color: var(--mut-strong);
}

/* ===== 我的历史反馈 ===== */
/* 左右不再内缩 30rpx：上面的输入卡、按钮都贴页边距，这一块原先缩进一截、边缘对不齐 */
.fh { margin: 26rpx 0 60rpx; }
.fh-head {
  font-size: calc(28rpx * var(--fs-mul, 1));
  font-weight: 800;
  color: var(--ink);
  margin-bottom: 18rpx;
}
.fh-empty {
  font-size: var(--fs-sub);
  color: var(--mut);
  padding: 30rpx 0;
}
/* 失败态可点重试：颜色必须区别于普通灰提示，否则看不出是个热区 */
.fh-empty--retry { color: var(--pop); font-weight: 600; text-align: center; }
.fh-list { display: flex; flex-direction: column; gap: 18rpx; }
.fh-item {
  background: var(--paper-2);
  border-radius: var(--r-card);
  padding: 24rpx var(--pad-card-sm);
}
.fh-row { display: flex; align-items: center; justify-content: space-between; }
.fh-badge {
  font-size: var(--fs-mini);
  font-weight: 800;
  color: var(--gold-deep);
  background: rgba(176, 137, 73, 0.14);
  padding: 4rpx 16rpx;
  border-radius: var(--r-pill);
}
.fh-badge.ok {
  color: var(--pine-ink);
  background: rgba(47, 74, 58, 0.12);
}
.fh-time { font-size: var(--fs-mini); color: var(--mut); }
.fh-content {
  margin-top: 12rpx;
  font-size: calc(28rpx * var(--fs-mul, 1));
  line-height: 1.6;
  color: var(--mut-strong);
}
.fh-reply {
  margin-top: 14rpx;
  padding: 16rpx 20rpx;
  background: rgba(47, 74, 58, 0.06);
  border-radius: var(--r-xs);
  display: flex;
  gap: 12rpx;
  align-items: flex-start;
}
.fh-reply-k {
  flex: none;
  font-size: var(--fs-mini);
  font-weight: 800;
  color: var(--pine-ink);
}
.fh-reply-v {
  font-size: var(--fs-sub);
  line-height: 1.6;
  color: var(--mut-strong);
}
/* 深色档：浅色档写死的低透明度墨绿/金底（rgba 47,74,58 / 176,137,73）压在深色卡面上几乎看不出，
   换成会翻转的 soft 底。墨绿字本身归 lead 的 --pine → --pine-ink 统一替换，这里不动 */
@media (prefers-color-scheme: dark) {
  .fh-badge { background: var(--c-gold-soft); }
  .fh-badge.ok { background: var(--c-accent-soft); }
  .fh-reply { background: var(--c-accent-soft); }
}
