<!-- pages/recipes/search · 搜索结果页 -->
<view class="search-page {{fontScale === 'lg' ? 'font-lg' : ''}}">
  <!-- sticky 搜索栏：状态栏占位 + 返回 + 输入 + 清除 + 取消 -->
  <view class="searchbar" style="padding-top: {{statusBarHeight}}px;">
    <view class="searchbar-inner" style="padding-right: {{capsuleRight}}px;">
      <view class="backbtn hit-88 tap-scale" catchtap="onBack" aria-role="button" aria-label="返回">
        <view class="backbtn-icon"></view>
      </view>

      <view class="sbox">
        <view class="sbox-ic"></view>
        <input
          class="sbox-input"
          value="{{keyword}}"
          placeholder="搜菜名 / 菜系"
          placeholder-class="sbox-ph"
          confirm-type="search"
          bindinput="onInput"
        />
        <view wx:if="{{keyword}}" class="clr tap-scale" catchtap="onClear" aria-role="button" aria-label="清空搜索词">
          <view class="clr-x"></view>
        </view>
      </view>

    </view>
  </view>

  <!-- 结果区 -->
  <scroll-view class="scroll" scroll-y enhanced show-scrollbar="{{false}}"
    scroll-top="{{scrollTopTo}}" scroll-with-animation bindscroll="onScrollBody">
    <view class="pad">
      <!-- 结果标题 -->
      <view class="rtitle g-fade-up">
        <block wx:if="{{keyword}}"><text class="rtitle-t">搜「</text><text class="rtitle-kw pop">{{keyword}}</text><text class="rtitle-t">」</text></block>
        <text wx:else class="rtitle-t">全部菜谱</text>
      </view>
      <!-- 计数只在拿到数据后出：加载中/失败时原来会先显示「共 0 道菜」，和下面的加载失败态自相矛盾 -->
      <view wx:if="{{loaded && !loading && !loadError}}" class="rcount g-fade-up g-d2">
        <block wx:if="{{noExactHit && nearbyMode}}">没有正好叫这个的，下面是沾边的 <text class="rcount-n">{{total}}</text> 道</block>
        <block wx:elif="{{noExactHit}}">一道都没有，看看下面的办法</block>
        <block wx:else>共 <text class="rcount-n">{{total}}</text> 道菜 · 按「{{sortLabel}}」排列</block>
      </view>

      <!-- 关键词一条都没命中：给出路，而不是只让人「换个关键词」。
           最常见的入口是从心愿池的「待挑菜」跳过来的——家人想吃的那道菜，自家库里本来就没有。
           这里三个出口按"多快能吃到"排序：自己录一道 > 从链接导入 > 去社区找。 -->
      <view wx:if="{{loaded && !loadError && noExactHit}}" class="nohit g-fade-up g-d2">
        <view class="nohit-t">库里还没有《{{keyword}}》</view>
        <view class="nohit-d">{{nearbyMode ? '这些是名字沾边的，也可以直接把它收进来' : '换个说法再找找，或者直接把它收进来'}}</view>
        <view class="nohit-acts">
          <view class="nohit-act tap-scale" bindtap="createForKeyword">＋ 新建这道菜</view>
          <view class="nohit-act tap-scale" bindtap="goImport">从链接导入</view>
          <view class="nohit-act tap-scale" bindtap="goCommunity">去社区找</view>
        </view>
      </view>

      <!-- 排序 / 筛选 chip 横滑 -->
      <scroll-view class="sortrow hscroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="hscroll-inner">
          <view
            wx:for="{{sorts}}"
            wx:key="key"
            class="chip tap-scale {{activeSort === item.key ? 'on' : ''}}"
            data-key="{{item.key}}"
            catchtap="onSortTap"
          >{{item.label}}</view>
        </view>
      </scroll-view>

      <!-- 2 列网格 -->
      <view wx:if="{{list.length}}" class="grid">
        <view
          wx:for="{{list}}"
          wx:key="id"
          class="gcard tap-scale g-fade-up"
          style="animation-delay: {{index * 0.04 + 0.1}}s"
          data-id="{{item.id}}"
          bindtap="onCardTap"
        >
          <view class="gc-ph">
            <image class="gc-img" src="{{item.cover}}" mode="aspectFill" lazy-load />
          </view>
          <view class="gc-info">
            <view class="gc-name ellipsis">
              <text wx:for="{{item.titleParts}}" wx:for-item="seg" wx:key="index" class="{{seg.hl ? 'hl' : ''}}">{{seg.t}}</text>
            </view>
            <view class="gc-meta">
              <text class="gc-meta-i">{{item.cuisine}}</text>
              <text wx:if="{{item.timeText}}" class="gc-meta-i">{{item.cuisine ? '· ' : ''}}{{item.timeText}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 加载中 -->
      <state-loading wx:if="{{loading}}" text="搜索中…" />

      <!-- 加载失败：错误态 + 重试，不伪装成无结果 -->
      <state-empty
        wx:elif="{{loadError}}"
        type="search"
        title="加载失败"
        desc="网络似乎不太顺，检查一下再试"
        cta="重新加载"
        bind:action="onRetry"
      />

      <!-- 空状态：只在真的一道都没渲染出来时才出。
           原先条件只写了 {{loaded}}，而网格是另一条 wx:if 链——所以**有结果时它照样渲染**，
           插画会挂在结果列表下面（实测：搜「番茄」出 2 道菜，下面还有一张放大镜）。
           有关键词时的出口在上面 nohit 区块里，这里只管「库里一道菜都没有」这一种。 -->
      <state-empty
        wx:elif="{{loaded && !list.length && !keyword}}"
        type="pop"
        title="还没有菜谱"
        desc="录一道拿手菜，或从链接导入"
        cta="去添加"
        ctaStyle="ghost"
        bind:action="goAddRecipe"
      />

      <view class="safe-bottom"></view>
    </view>
  </scroll-view>

  <!-- 结果流滚深后回顶 -->
  <back-top show="{{showBackTop}}" bottom="200rpx" bind:totop="backToTop" />
</view>
