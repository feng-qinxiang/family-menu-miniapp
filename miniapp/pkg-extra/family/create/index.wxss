/* pages/family/create · 创建家庭（配色全部走 app.wxss 新 token）*/
.fc-page {
  min-height: 100vh;
  background: var(--paper);
}
.fc-sheet { padding: 0 var(--page-gutter) calc(40rpx + env(safe-area-inset-bottom)); }

/* ===== 头像上传 ===== */
.fc-ava-wrap {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx var(--pad-card-sm);
  background: var(--c-surface);
  border: var(--bd-card);
  border-radius: var(--r-card);
}
.fc-ava {
  position: relative;
  flex: none;
  width: 104rpx;
  height: 104rpx;
  border-radius: var(--r-md);
  background: var(--pop-soft);
  border: 2rpx solid var(--pop-mist);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  overflow: hidden;
}
.fc-ava.has {
  border-style: solid;
  border-color: var(--pop);
}
.fc-ava-img {
  width: 100%;
  height: 100%;
}
.fc-ava-cam {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--pop-soft);
  display: flex;
  align-items: center;
  justify-content: center;
}
.fc-ava-badge {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--pop-fill);
  border: 6rpx solid var(--paper);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--sh-pop);
}
.fc-ava-copy { flex: 1; min-width: 0; }
.fc-ava-title { font-size: calc(32rpx * var(--fs-mul, 1)); font-weight: 800; color: var(--ink); line-height: 1.4; }
.fc-ava-hint {
  margin-top: 8rpx;
  line-height: 1.6;
  font-size: var(--fs-cap);
  color: var(--mut-strong);
  font-weight: 500;
}

/* ===== 表单 ===== */
.fc-form {
  margin-top: 20rpx;
  padding: 24rpx var(--pad-card-sm);
  background: var(--c-surface);
  border: var(--bd-card);
  border-radius: var(--r-card);
}
.fc-field {
  margin-bottom: 24rpx;
}
.fc-label {
  font-size: var(--fs-sub);
  font-weight: 800;
  text-transform: uppercase;
  color: var(--ink);
  margin-bottom: 12rpx;
}
.fc-opt {
  font-size: var(--fs-mini);
  font-weight: 600;
  color: var(--mut);
  text-transform: none;
  letter-spacing: 0;
}
.fc-inp {
  display: flex;
  align-items: center;
  gap: 21rpx;
  background: var(--paper);
  border: 2rpx solid var(--line-deep);
  border-radius: var(--r-sm);
  min-height: 104rpx;
  box-sizing: border-box;
  padding: 16rpx 20rpx;
}
.fc-inp.focus {
  border-color: var(--pop);
  box-shadow: 0 0 0 6rpx rgba(200, 56, 31, 0.08);
}
.fc-input {
  flex: 1;
  min-width: 0;
  height: 56rpx;
  font-size: calc(32rpx * var(--fs-mul, 1));
  font-weight: 700;
  color: var(--ink);
}
.fc-inp-txt {
  flex: 1;
  min-width: 0;
  font-size: calc(32rpx * var(--fs-mul, 1));
  line-height: 1.5;
  font-weight: 700;
  color: var(--ink);
}
.fc-ph {
  color: var(--mut-2);
  font-weight: 600;
}
.fc-chev {
  margin-left: auto;
  width: 18rpx;
  height: 18rpx;
  border-top: 4rpx solid var(--mut-2);
  border-right: 4rpx solid var(--mut-2);
  transform: rotate(45deg);
}

/* ===== 创建按钮 ===== */
.fc-createbtn {
  margin-top: 16rpx;
  width: 100%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 17rpx;
  background: var(--pop-fill);
  color: var(--anchor-contrast);
  border-radius: var(--r-card);
  min-height: 96rpx;
  padding: 18rpx 0;
  font-size: calc(32rpx * var(--fs-mul, 1));
  font-weight: 800;
  letter-spacing: 1rpx;
  box-shadow: var(--sh-pop);
}

/* ===== Tip 卡片 ===== */
.fc-tipcard {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 20rpx;
  background: var(--pop-soft);
  border-radius: var(--r-sm);
  padding: 18rpx 20rpx;
}
.fc-tip-tx {
  font-size: calc(25rpx * var(--fs-mul, 1));
  color: var(--ink-deep);
  line-height: 1.55;
  font-weight: 500;
}
.fc-tip-b {
  color: var(--pop);
  font-weight: 800;
}

/* ===== 加入链接 ===== */
.fc-joinlink {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-top: 12rpx;
}
.fc-join-small {
  font-size: var(--fs-sub);
  color: var(--mut-strong);
}
.fc-join-a {
  display: inline-flex;
  align-items: center;
  font-size: var(--fs-cap);
  font-weight: 800;
  color: var(--pop-deep);
  min-height: 88rpx;
}

/* ===== 纯 CSS 图标 ===== */
.fc-ic {
  flex: none;
  box-sizing: border-box;
}
/* 相机：圆角矩形 + 圆心 */
.fc-ic-cam {
  position: relative;
  width: 38rpx;
  height: 30rpx;
  border: 4rpx solid var(--pop);
  border-radius: var(--r-xs);
}
.fc-ic-cam::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 14rpx;
  height: 14rpx;
  border: 4rpx solid var(--pop);
  border-radius: 50%;
  transform: translate(-50%, -50%);
}
.fc-ic-cam::after {
  content: "";
  position: absolute;
  top: -8rpx;
  left: 9rpx;
  width: 14rpx;
  height: 7rpx;
  background: var(--pop-fill);
  border-radius: 4rpx 4rpx 0 0;
}
/* 加号（白） */
.fc-ic-plus {
  position: relative;
  width: 26rpx;
  height: 26rpx;
}
.fc-ic-plus::before,
.fc-ic-plus::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  background: var(--anchor-contrast);   /* 红底上的白：恒浅，--c-surface 深色档会变深灰 */
  border-radius: 2rpx;
  transform: translate(-50%, -50%);
}
.fc-ic-plus::before { width: 24rpx; height: 5rpx; }
.fc-ic-plus::after { width: 5rpx; height: 24rpx; }
/* 房子 */
.fc-ic-home {
  position: relative;
  width: 34rpx;
  height: 30rpx;
}
.fc-ic-home::before {
  content: "";
  position: absolute;
  top: 0;
  left: 50%;
  width: 22rpx;
  height: 22rpx;
  border: 4rpx solid var(--pop);
  border-bottom: none;
  border-radius: 4rpx 4rpx 0 0;
  transform: translateX(-50%);
  margin-top: 8rpx;
}
.fc-ic-home::after {
  content: "";
  position: absolute;
  top: 2rpx;
  left: 50%;
  width: 24rpx;
  height: 24rpx;
  border-left: 4rpx solid var(--pop);
  border-top: 4rpx solid var(--pop);
  transform: translateX(-50%) rotate(45deg);
  border-radius: 4rpx 0 0 0;
}
/* 定位针 */
.fc-ic-pin {
  position: relative;
  width: 30rpx;
  height: 32rpx;
}
.fc-ic-pin::before {
  content: "";
  position: absolute;
  top: 0;
  left: 50%;
  width: 24rpx;
  height: 24rpx;
  border: 4rpx solid var(--mut-2);
  border-radius: 50% 50% 50% 0;
  transform: translateX(-50%) rotate(-45deg);
}
.fc-ic-pin::after {
  content: "";
  position: absolute;
  top: 9rpx;
  left: 50%;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--mut-2);
  transform: translateX(-50%);
}
/* 箭头（白，与按钮文字同色：恒浅） */
.fc-ic-arrow {
  width: 16rpx;
  height: 16rpx;
  border-top: 5rpx solid var(--anchor-contrast);
  border-right: 5rpx solid var(--anchor-contrast);
  transform: rotate(45deg);
}
/* 灯泡 */
.fc-ic-bulb {
  position: relative;
  width: 30rpx;
  height: 34rpx;
  margin-top: 2rpx;
}
.fc-ic-bulb::before {
  content: "";
  position: absolute;
  top: 0;
  left: 50%;
  width: 24rpx;
  height: 24rpx;
  border: 4rpx solid var(--pop);
  border-radius: 50%;
  transform: translateX(-50%);
}
.fc-ic-bulb::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 50%;
  width: 14rpx;
  height: 8rpx;
  border: 4rpx solid var(--pop);
  border-top: none;
  border-radius: 0 0 4rpx 4rpx;
  transform: translateX(-50%);
}

/* 页名只留导航栏，正文顶部一行说明 */
.fc-hint { padding: 8rpx var(--page-gutter) 12rpx; font-size: var(--fs-sub); color: var(--mut-strong); line-height: 1.5; }
