<view class="fc-page {{fontScale === 'lg' ? 'font-lg' : ''}}">
    <nav-bar title="创建家庭" status-bar-height="{{statusBarHeight}}" />
    <view class="fc-hint">建好后把邀请码发给家人，一起点菜。</view>

    <!-- ===== Sheet 内容 ===== -->
    <view class="fc-sheet">

      <!-- 家庭头像上传 -->
      <view class="fc-ava-wrap g-fade-up">
        <view class="fc-ava tap-scale {{avatar ? 'has' : ''}}" bindtap="chooseAvatar" aria-role="button" aria-label="{{avatar ? '更换家庭合影' : '上传家庭合影'}}">
          <image wx:if="{{avatar}}" class="fc-ava-img" src="{{avatar}}" mode="aspectFill" />
          <block wx:else>
            <view class="fc-ava-cam">
              <view class="fc-ic fc-ic-cam"></view>
            </view>
          </block>
          <view class="fc-ava-badge">
            <view class="fc-ic fc-ic-plus"></view>
          </view>
        </view>
        <view class="fc-ava-copy"><view class="fc-ava-title">给小家一张合影</view><view class="fc-ava-hint">选填，之后也可以更换</view></view>
      </view>

      <!-- 表单 -->
      <view class="fc-form g-fade-up g-d1">
        <view class="fc-field">
          <view class="fc-label">家庭名称</view>
          <view class="fc-inp {{focusName ? 'focus' : ''}} {{nameError ? 'field-error' : ''}}">
            <view class="fc-ic fc-ic-home"></view>
            <input
              class="fc-input"
              placeholder="张家厨房"
              placeholder-class="fc-ph"
              value="{{familyName}}"
              maxlength="20"
              bindinput="onNameInput"
              bindfocus="onNameFocus"
              bindblur="onNameBlur"
            />
          </view>
          <view class="field-error-msg" wx:if="{{nameError}}">请填写家庭名称</view>
        </view>

        <view class="fc-field">
          <view class="fc-label">所在地区 <text class="fc-opt">（选填）</text></view>
          <picker mode="region" value="{{region}}" bindchange="onRegionChange">
            <view class="fc-inp">
              <view class="fc-ic fc-ic-pin"></view>
              <text class="fc-inp-txt {{regionText ? '' : 'fc-ph'}}">{{regionText || '选择所在城市'}}</text>
              <view class="fc-chev"></view>
            </view>
          </picker>
        </view>

        <view class="fc-createbtn tap-scale" bindtap="onCreate" aria-role="button" aria-label="创建家庭" aria-disabled="{{submitting}}">
          <text>{{submitting ? '创建中…' : '创建家庭'}}</text>
          <view class="fc-ic fc-ic-arrow"></view>
        </view>

        <!-- Tip 卡片 -->
        <view class="fc-tipcard">
          <view class="fc-ic fc-ic-bulb"></view>
          <view class="fc-tip-tx">建好后，用<text class="fc-tip-b">专属邀请码</text>邀请家人，一起点菜、共享清单。</view>
        </view>
      </view>

      <!-- 加入链接 -->
      <view class="fc-joinlink g-fade-up g-d2">
        <text class="fc-join-small">家人已经建好家了？</text>
        <text class="fc-join-a tap-scale" bindtap="goJoin">去加入 ›</text>
      </view>

    </view>

    <view class="safe-bottom"></view>
</view>
