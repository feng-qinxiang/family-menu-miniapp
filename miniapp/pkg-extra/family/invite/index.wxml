<!-- 邀请家人 · 二级页 -->
<nav-bar title="邀请家人" status-bar-height="{{statusBarHeight}}"></nav-bar>

<view class="container fi-page {{fontScale === 'lg' ? 'font-lg' : ''}}">
  <!-- 邀请暗卡 -->
  <view class="card-dark fi-invite g-fade-up g-d1">
    <view class="fi-iv-cap">家庭邀请码</view>

    <!-- 8 位邀请码（拉取失败时格子留空，不显示任何伪码） -->
    <view class="fi-code">
      <view class="fi-dg" wx:for="{{codeDigits}}" wx:key="index">{{item}}</view>
    </view>

    <!-- 失败态：重试按钮；成功态：复制按钮 -->
    <view
      wx:if="{{!codeFailed}}"
      class="fi-copybtn tap-scale"
      catchtap="onCopyCode"
    >
      <image class="fi-ic" src="/assets/icons/lucide/copy.svg" mode="aspectFit" aria-hidden="true" />
      <text>复制邀请码</text>
    </view>
    <view wx:else class="fi-copybtn fi-copybtn--retry tap-scale" catchtap="loadFamily">
      <image class="fi-ic fi-ic--ink" src="/assets/icons/lucide/refresh-cw.svg" mode="aspectFit" aria-hidden="true" />
      <text>邀请码没拿到，点此重试</text>
    </view>

  </view>

  <!-- 微信分享（失败时渲染禁用态普通节点，避免 open-type=share 泄出无码链接） -->
  <button
    wx:if="{{inviteCode}}"
    class="btn btn-wx btn-block fi-wxbtn tap-scale g-fade-up g-d2"
    open-type="share"
  >
    <view class="fi-ic-wx"></view>
    微信分享给家人
  </button>
  <view wx:else class="btn btn-wx btn-block fi-wxbtn fi-disabled g-fade-up g-d2" catchtap="loadFamily">
    <view class="fi-ic-wx"></view>
    微信分享给家人
  </view>

  <!-- 复制邀请信息（实为复制文本，非图片，按钮名须与行为一致） -->
  <view
    wx:if="{{inviteCode}}"
    class="fi-savebtn tap-scale g-fade-up g-d3"
    catchtap="onSaveImage"
  >
    <image class="fi-ic fi-ic--ink" src="/assets/icons/lucide/copy.svg" mode="aspectFit" aria-hidden="true" />
    <text>复制邀请信息</text>
  </view>
  <view wx:else class="fi-savebtn fi-disabled g-fade-up g-d3" catchtap="loadFamily">
    <image class="fi-ic fi-ic--ink" src="/assets/icons/lucide/copy.svg" mode="aspectFit" aria-hidden="true" />
    <text>复制邀请信息</text>
  </view>

  <!-- Tip：邀请码长期有效（family 表没有过期列，toInviteCode 也是取到就复用），
       所以这里不能说"24 小时内有效"——用户若信了这个说法，可能把它丢进
       后来混进陌生人的群聊或截图外传，而它其实永远不会失效。 -->
  <view class="fi-note g-fade-up g-d4">
    <image class="fi-ic fi-ic--ink fi-note-ic" src="/assets/icons/lucide/info.svg" mode="aspectFit" aria-hidden="true" />
    <view class="fi-note-text">家人在小程序里<text class="b">输入邀请码</text>即可加入这桌，一起点菜、凑齐今晚的菜单。邀请码<text class="b">长期有效</text>，请只发给自己信任的家人。</view>
  </view>

  <view class="safe-bottom"></view>
</view>

<state-toast
  visible="{{toast.visible}}"
  type="{{toast.type}}"
  text="{{toast.text}}"
  duration="1800"
  bind:close="onToastClose"
></state-toast>
