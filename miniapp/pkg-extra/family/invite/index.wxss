/* 邀请家人 · 页面样式 · 复用 app.wxss token，禁止硬编码配色 */
.fi-page {
  padding: 20rpx 46rpx 60rpx;
}

/* HERO */
.fi-hero {
  text-align: center;
  margin-top: 8rpx;
}
.fi-eyebrow {
  font-family: var(--serif);
  font-size: var(--fs-cap);
  letter-spacing: 2rpx;
  color: var(--gold-deep);
  font-weight: 700;
}
.fi-title {
  font-size: calc(56rpx * var(--fs-mul, 1));
  font-weight: 900;
  color: var(--ink);
  letter-spacing: -2rpx;
  line-height: 1;
  margin-top: 14rpx;
  font-family: var(--sans);
}

/* 邀请暗卡（基于 .card-dark） */
.fi-invite {
  margin-top: 46rpx;
  padding: 58rpx 50rpx 50rpx;   /* 例外：8 格邀请码要按 81rpx 一格排开，左右收到 --pad-card 会把格子撑宽、整卡变样 */
  border-radius: var(--r-card);   /* 原 54rpx：同屏按钮与家庭管理页暗卡都是 --r-card，这张单独圆一大截 */
  text-align: center;
}
.fi-iv-cap {
  position: relative;
  z-index: 2;
  font-family: var(--serif);
  font-size: var(--fs-cap);
  letter-spacing: 2rpx;
  color: var(--gold-on-dark);
  font-weight: 700;
}

/* 6 位 code 分组 */
.fi-code {
  position: relative;
  z-index: 2;
  display: flex;
  justify-content: center;
  gap: 17rpx;
  margin-top: 27rpx;
}
.fi-dg {
  width: 81rpx;
  height: 108rpx;
  border-radius: 23rpx;
  background: rgba(255, 255, 255, 0.07);
  border: 2rpx solid rgba(255, 255, 255, 0.14);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--serif);
  font-size: calc(62rpx * var(--fs-mul, 1));
  font-weight: 700;
  color: var(--anchor-contrast);
}

/* 复制按钮 */
.fi-copybtn {
  position: relative;
  z-index: 2;
  margin-top: 35rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  width: 100%;
  box-sizing: border-box;
  min-height: var(--tap-min);   /* 22rpx 上下内边距 + 25rpx 字：截图实测约 84rpx 高 */
  padding: 22rpx 0;
  border-radius: var(--r-card);
  background: rgba(255, 255, 255, 0.1);
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  color: var(--anchor-contrast);
  font-size: calc(25rpx * var(--fs-mul, 1));
  font-weight: 700;
}
/* 拉取失败态：重试按钮（金色描边突出可点） */
.fi-copybtn--retry {
  background: var(--gold);
  border-color: var(--gold-deep);
  color: var(--ink-deep);
}
/* 邀请码说明（替代伪二维码：真实邀请走输码/分享路径） */
.fi-qr-hint {
  position: relative;
  z-index: 2;
  text-align: center;
  margin-top: 25rpx;
  font-size: calc(23rpx * var(--fs-mul, 1));
  letter-spacing: 1rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* 微信分享按钮（基于 .btn-wx） */
.fi-wxbtn {
  margin-top: 50rpx;
  gap: 17rpx;
  font-size: calc(32rpx * var(--fs-mul, 1));
  font-weight: 800;
  border-radius: var(--r-card);
  box-shadow: 0 20rpx 46rpx rgba(7, 193, 96, 0.32);
  display: flex;
  align-items: center;
  justify-content: center;
}
/* 无真实邀请码时的禁用态（点击触发重试而非分享） */
.fi-disabled {
  opacity: 0.45;
  box-shadow: none;
}
.fi-wxbtn::after { border: none; }
/* 真分享按钮是原生 <button>：微信内置 button:not([size=mini]) 固定 184px 宽，
   .btn-block 单类名压不过（登录页同款按钮实测就是 184px 居中）。本次截图是拿码失败态、渲染的是 view，
   拿到码后的 button 态未截到。带上父级提高优先级撑满 */
.fi-page .fi-wxbtn {
  width: 100%;
  margin-left: 0;
  margin-right: 0;
}
/* 绿底上的白色气泡：恒浅，--c-surface 深色档会变深灰 */
.fi-ic-wx {
  width: 38rpx;
  height: 32rpx;
  border-radius: 50% 50% 50% var(--r-xs);
  background: var(--anchor-contrast);
  position: relative;
}
.fi-ic-wx::after {
  content: "";
  position: absolute;
  right: -12rpx;
  bottom: -10rpx;
  width: 30rpx;
  height: 26rpx;
  border-radius: 50% 50% var(--r-xs) 50%;
  background: var(--anchor-contrast);
  box-shadow: 0 0 0 4rpx var(--wx);
}

/* 保存邀请图按钮 */
.fi-savebtn {
  margin-top: 25rpx;
  width: 100%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 17rpx;
  padding: 29rpx 0;
  border-radius: var(--r-card);
  background: var(--c-surface);
  color: var(--ink);
  font-size: calc(29rpx * var(--fs-mul, 1));
  font-weight: 700;
  border: var(--bd-card);
  box-shadow: var(--sh-soft);
}
/* 邀请码说明：中性提示，不用警示红 */
.fi-note {
  display: flex;
  align-items: flex-start;
  gap: 17rpx;
  margin-top: 46rpx;
  padding: 27rpx var(--pad-card);
  background: var(--paper-2);
  border-radius: var(--r-card);
}
.fi-ic {
  flex: none;
  width: 32rpx;
  height: 32rpx;
}
/* 浅色线框 SVG：浅底上压成墨色，深色模式还原（同 post-detail 的 reaction-icon） */
.fi-ic--ink {
  filter: brightness(0);
  opacity: .7;
}
@media (prefers-color-scheme: dark) {
  .fi-ic--ink { filter: none; }
  /* 重试按钮的字是 --ink-deep，深色档翻成浅字（金底也翻成深金 #8a6a3a），
     图标原先强制压黑就成了「深底黑图标 + 浅色字」，跟着字一起还原 */
}
.fi-note-ic {
  margin-top: 4rpx;
}
.fi-note-text {
  font-size: calc(25rpx * var(--fs-mul, 1));
  line-height: 1.6;
  color: var(--mut-strong);
}
.fi-note-text .b {
  color: var(--ink);
  font-weight: 800;
}
