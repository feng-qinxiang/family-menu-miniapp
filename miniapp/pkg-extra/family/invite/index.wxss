/* 邀请家人 · 页面样式 · 复用 app.wxss token，禁止硬编码配色 */
.fi-page {
  padding: 20rpx 46rpx 60rpx;
}

/* HERO */
.fi-hero {
  text-align: center;
  margin-top: 8rpx;
}
.fi-eyebrow {
  font-family: var(--serif);
  font-size: var(--fs-cap);
  letter-spacing: 2rpx;
  color: var(--gold-deep);
  font-weight: 700;
}
.fi-title {
  font-size: calc(56rpx * var(--fs-mul, 1));
  font-weight: 900;
  color: var(--ink);
  letter-spacing: -2rpx;
  line-height: 1;
  margin-top: 14rpx;
  font-family: var(--sans);
}

/* 邀请暗卡（基于 .card-dark） */
.fi-invite {
  margin-top: 46rpx;
  padding: 58rpx 50rpx 50rpx;
  border-radius: 54rpx;
  text-align: center;
}
.fi-iv-cap {
  position: relative;
  z-index: 2;
  font-family: var(--serif);
  font-size: var(--fs-cap);
  letter-spacing: 2rpx;
  color: var(--gold);
  font-weight: 700;
}

/* 6 位 code 分组 */
.fi-code {
  position: relative;
  z-index: 2;
  display: flex;
  justify-content: center;
  gap: 17rpx;
  margin-top: 27rpx;
}
.fi-dg {
  width: 81rpx;
  height: 108rpx;
  border-radius: 23rpx;
  background: rgba(255, 255, 255, 0.07);
  border: 2rpx solid rgba(255, 255, 255, 0.14);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--serif);
  font-size: calc(62rpx * var(--fs-mul, 1));
  font-weight: 700;
  color: var(--anchor-contrast);
}

/* 复制按钮 */
.fi-copybtn {
  position: relative;
  z-index: 2;
  margin-top: 35rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  width: 100%;
  padding: 22rpx 0;
  border-radius: var(--r-pill);
  background: rgba(255, 255, 255, 0.1);
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  color: var(--anchor-contrast);
  font-size: calc(25rpx * var(--fs-mul, 1));
  font-weight: 700;
}
/* 拉取失败态：重试按钮（金色描边突出可点） */
.fi-copybtn--retry {
  background: var(--gold);
  border-color: var(--gold-deep);
  color: var(--ink-deep);
}
/* 邀请码说明（替代伪二维码：真实邀请走输码/分享路径） */
.fi-qr-hint {
  position: relative;
  z-index: 2;
  text-align: center;
  margin-top: 25rpx;
  font-size: calc(23rpx * var(--fs-mul, 1));
  letter-spacing: 1rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* 微信分享按钮（基于 .btn-wx） */
.fi-wxbtn {
  margin-top: 50rpx;
  gap: 17rpx;
  font-size: calc(32rpx * var(--fs-mul, 1));
  font-weight: 800;
  border-radius: 35rpx;
  box-shadow: 0 20rpx 46rpx rgba(7, 193, 96, 0.32);
  display: flex;
  align-items: center;
  justify-content: center;
}
/* 无真实邀请码时的禁用态（点击触发重试而非分享） */
.fi-disabled {
  opacity: 0.45;
  box-shadow: none;
}
.fi-wxbtn::after { border: none; }
.fi-ic-wx {
  width: 38rpx;
  height: 32rpx;
  border-radius: 50% 50% 50% var(--r-xs);
  background: var(--c-surface);
  position: relative;
}
.fi-ic-wx::after {
  content: "";
  position: absolute;
  right: -12rpx;
  bottom: -10rpx;
  width: 30rpx;
  height: 26rpx;
  border-radius: 50% 50% var(--r-xs) 50%;
  background: var(--c-surface);
  box-shadow: 0 0 0 4rpx var(--wx);
}

/* 保存邀请图按钮 */
.fi-savebtn {
  margin-top: 25rpx;
  width: 100%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 17rpx;
  padding: 29rpx 0;
  border-radius: 35rpx;
  background: var(--c-surface);
  color: var(--ink);
  font-size: calc(29rpx * var(--fs-mul, 1));
  font-weight: 700;
  border: var(--bd-card);
  box-shadow: var(--sh-soft);
}
/* 邀请码说明：中性提示，不用警示红 */
.fi-note {
  display: flex;
  align-items: flex-start;
  gap: 17rpx;
  margin-top: 46rpx;
  padding: 27rpx 31rpx;
  background: var(--paper-2);
  border-radius: 31rpx;
}
.fi-ic {
  flex: none;
  width: 32rpx;
  height: 32rpx;
}
/* 浅色线框 SVG：浅底上压成墨色，深色模式还原（同 post-detail 的 reaction-icon） */
.fi-ic--ink {
  filter: brightness(0);
  opacity: .7;
}
@media (prefers-color-scheme: dark) {
  .fi-ic--ink { filter: none; }
  .fi-copybtn--retry .fi-ic--ink { filter: brightness(0); }   /* 金色按钮两种模式都是浅底 */
}
.fi-note-ic {
  margin-top: 4rpx;
}
.fi-note-text {
  font-size: calc(25rpx * var(--fs-mul, 1));
  line-height: 1.6;
  color: var(--mut-strong);
}
.fi-note-text .b {
  color: var(--ink);
  font-weight: 800;
}
