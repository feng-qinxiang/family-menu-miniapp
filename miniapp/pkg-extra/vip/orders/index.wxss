/* pages/vip/orders · 我的订单 —— 全程使用 app.wxss 新 token，零硬编码配色 */
/* nav-bar 在流内占位，滚动区用 flex 撑满剩余高度（100vh 会溢出底部） */
.ord-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--paper);
}
.ord-page nav-bar {
  flex: none;
}
.page {
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
  background: var(--paper);
  padding: 0 46rpx 40rpx;
}

/* ===== Hero 标题 ===== */
.head {
  padding: 34rpx 0 12rpx;
}
.head .lead {
  margin-top: 16rpx;
  font-size: var(--fs-sub);
  line-height: 1.5;
  color: var(--mut-strong);
}

/* ===== 统计条暗卡 ===== */
.strip {
  margin: 38rpx 0 8rpx;
  padding: 34rpx 38rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.strip .strip-e {
  font-family: var(--serif);
  font-size: var(--fs-mini);
  letter-spacing: 2rpx;
  font-weight: 700;
  color: var(--gold-on-dark);
}
.strip .strip-n {
  margin-top: 8rpx;
  font-size: calc(42rpx * var(--fs-mul, 1));
  font-weight: 900;
  letter-spacing: -1rpx;
}
.strip .strip-r {
  text-align: right;
}
.strip .strip-v {
  font-size: calc(42rpx * var(--fs-mul, 1));
  font-weight: 900;
  letter-spacing: -1rpx;
}
.strip .strip-v .strip-u {
  margin-left: 2rpx;
  font-size: var(--fs-cap);
  font-weight: 600;
  color: rgba(251, 248, 243, 0.6);
}
.strip .strip-c {
  margin-top: 4rpx;
  font-size: var(--fs-mini);
  color: rgba(251, 248, 243, 0.6);
}

/* ===== 订单卡列表 ===== */
.list {
  padding-top: 34rpx;
}
.ocard {
  position: relative;
  overflow: hidden;
  padding: 34rpx 34rpx 30rpx;
  margin-bottom: 30rpx;
}

/* 状态 badge */
.badge {
  position: absolute;
  top: 30rpx;
  right: 30rpx;
  display: flex;
  align-items: center;
  gap: 9rpx;
  padding: 9rpx 21rpx;
  border-radius: var(--r-pill);
  font-size: calc(21rpx * var(--fs-mul, 1));
  font-weight: 800;
  letter-spacing: 1rpx;
}
.badge .badge-dot {
  width: 11rpx;
  height: 11rpx;
  border-radius: 50%;
}
.badge--live {
  color: var(--pine-ink);
  background: rgba(47, 74, 58, 0.1);
}
.badge--live .badge-dot {
  /* 跟徽章字同色：浅色档就是 --pine（不变）；lead 把字色换成 --pine-ink 后点自动跟上，
     不用再单独追一处 background（按 color: 扫描替换时找不到它） */
  background: currentColor;
  box-shadow: 0 0 0 5rpx rgba(47, 74, 58, 0.16);
}
.badge--warn {
  color: var(--pop);
  background: var(--pop-soft);
}
.badge--warn .badge-dot {
  background: var(--pop-fill);
}
.badge--gray {
  color: var(--mut-strong);
  background: var(--paper-2);
}
.badge--gray .badge-dot {
  background: var(--mut);
}

/* 产品行 */
.ocard-top {
  display: flex;
  align-items: flex-start;
  gap: 26rpx;
}
.ocard-ic {
  flex: none;
  width: 104rpx;
  height: 104rpx;
  border-radius: var(--r-md);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--pop-soft);
}
.ocard-ic--gold {
  background: var(--gold);
}
/* 礼盒图标：纯 CSS 拼（原 SVG data-uri 里的 {{item.iconColor}} 不参与 WXML 编译，
   描边永远落在 SVG 默认黑上，故改为走 token 的 CSS 图标） */
.ocard-gift {
  box-sizing: border-box;
  width: 50rpx;
  height: 42rpx;
  position: relative;
  border: 4rpx solid var(--pop);
  border-radius: 4rpx;
}
.ocard-gift::before {
  content: "";
  position: absolute;
  left: -4rpx;
  right: -4rpx;
  top: -12rpx;
  height: 10rpx;
  border: 4rpx solid var(--pop);
  border-radius: 4rpx;
}
.ocard-gift::after {
  content: "";
  position: absolute;
  left: 50%;
  top: -12rpx;
  bottom: -4rpx;
  width: 4rpx;
  margin-left: -2rpx;
  background: var(--pop-fill);
}
/* 生效中的订单：深色图标压在浅金底上 */
.ocard-ic--gold .ocard-gift,
.ocard-ic--gold .ocard-gift::before { border-color: var(--anchor); }
.ocard-ic--gold .ocard-gift::after { background: var(--anchor); }
/* 深色档：
   1) 金底礼盒：--gold 翻成深金 #8a6a3a，--anchor 描边（深色档 #735a44）压上去只有 1.3:1。
      改成跟着翻的浅色 --ink-deep（3.9:1），不依赖 --anchor 的深色取值
   2) 「生效中」徽章底：写死的 10% 墨绿压在深色卡面上几乎看不出，换成会翻转的 --c-accent-soft。
      徽章字色归 lead 的 --pine → --pine-ink 统一替换，这里不动 */
@media (prefers-color-scheme: dark) {
  .ocard-ic--gold .ocard-gift,
  .ocard-ic--gold .ocard-gift::before { border-color: var(--ink-deep); }
  .ocard-ic--gold .ocard-gift::after { background: var(--ink-deep); }
  .badge--live { background: var(--c-accent-soft); }
}
.ocard-mid {
  flex: 1;
  min-width: 0;
  padding-top: 4rpx;
}
.ocard-name {
  font-size: calc(32rpx * var(--fs-mul, 1));
  font-weight: 800;
  color: var(--ink);
  letter-spacing: -0.6rpx;
}
.ocard-tag {
  margin-top: 8rpx;
  font-size: calc(23rpx * var(--fs-mul, 1));
  color: var(--mut-strong);
}
.ocard-price {
  flex: none;
  text-align: right;
  padding-top: 4rpx;
}
.ocard-amt {
  font-size: calc(40rpx * var(--fs-mul, 1));
  font-weight: 900;
  color: var(--pop);
  letter-spacing: -1rpx;
}
.ocard-amt .ocard-y {
  font-size: var(--fs-sub);
  font-weight: 700;
}

/* 日期分栏 */
.dates {
  display: flex;
  margin-top: 30rpx;
  padding-top: 28rpx;
  border-top: 2rpx dashed var(--c-border);
}
.dcol {
  flex: 1;
}
.dcol + .dcol {
  padding-left: 30rpx;
  border-left: 2rpx solid var(--paper-2);
}
.dlab {
  font-size: calc(21rpx * var(--fs-mul, 1));
  letter-spacing: 1.4rpx;
  font-weight: 800;
  text-transform: uppercase;
  color: var(--gold-deep);
}
.dval {
  margin-top: 10rpx;
  font-size: var(--fs-cap);
  font-weight: 800;
  color: var(--ink);
}
.dval--muted {
  color: var(--mut-strong);
}

/* 订单号 + 续费 */
.oid {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 26rpx;
}
.oid-no {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-mini);
  color: var(--mut);
}
.oid-re {
  flex: none;
  display: flex;
  align-items: center;
  gap: 5rpx;
  padding-left: 18rpx;
  font-size: var(--fs-cap);
  font-weight: 800;
  color: var(--pop);
}
.oid-arr {
  width: 25rpx;
  height: 25rpx;
}

/* ===== 空态 ===== */
.empty-wrap {
  padding-top: 40rpx;
}
/* 加载骨架 */
.order-skel-ic {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  background: var(--paper-2);
}
.order-skel-line {
  width: 200rpx;
  height: 28rpx;
  border-radius: 12rpx;
  background: var(--paper-2);
  margin-bottom: 14rpx;
}
.order-skel-line.short { width: 130rpx; margin-bottom: 0; }
.order-skel-amt {
  width: 90rpx;
  height: 34rpx;
  border-radius: 12rpx;
  background: var(--paper-2);
}
.order-skel-dates {
  margin-top: 24rpx;
  height: 40rpx;
  border-radius: 12rpx;
  background: var(--paper-2);
  width: 70%;
}
