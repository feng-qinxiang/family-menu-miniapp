/* pages/vip/upgrade · 开通家庭同步会员 · 实质使用全局 token */
/* nav-bar / 底部支付栏在流内，滚动区 flex 撑满中间（100vh 会溢出底部） */
.vu-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--paper);
}
.vu-page nav-bar {
  flex: none;
}
.vu-scroll {
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
  background: var(--paper);
}
.vu-wrap {
  padding: 16rpx 46rpx 300rpx;
}

/* 引导文案 */
.vu-lead {
  position: relative;
  margin: 12rpx 0 42rpx;
  padding-left: 29rpx;
}
.vu-lead::before {
  content: "";
  position: absolute;
  left: 0;
  top: 6rpx;
  bottom: 6rpx;
  width: 8rpx;
  border-radius: 6rpx;
  background: var(--pop);
}
.vu-eyebrow {
  font-family: var(--serif);
  font-style: italic;
  font-size: var(--fs-cap);
  letter-spacing: 2rpx;
  color: var(--gold-deep);
  font-weight: 700;
}
.vu-h1 {
  font-size: calc(60rpx * var(--fs-mul, 1));
  font-weight: 900;
  letter-spacing: -3rpx;
  line-height: 1.04;
  margin-top: 12rpx;
  color: var(--ink);
}
.vu-lead-p {
  font-size: var(--fs-sub);
  color: var(--mut-strong);
  margin-top: 18rpx;
  line-height: 1.5;
}

/* Hero 图 */
.vu-hero {
  position: relative;
  height: 266rpx;
  padding: 0;
  overflow: hidden;
  margin-bottom: 42rpx;
}
.vu-hero-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.vu-hero-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, rgba(20, 14, 8, 0.82) 0%, rgba(20, 14, 8, 0.3) 60%, rgba(20, 14, 8, 0) 100%);
}
.vu-hero-ic {
  position: absolute;
  left: 35rpx;
  top: 50%;
  transform: translateY(-50%);
  color: var(--anchor-contrast);
}
.vu-hero-et {
  font-family: var(--serif);
  font-style: italic;
  font-size: var(--fs-mini);
  letter-spacing: 3rpx;
  color: var(--gold);
  font-weight: 700;
}
.vu-hero-ht {
  font-size: calc(40rpx * var(--fs-mul, 1));
  font-weight: 900;
  letter-spacing: -1rpx;
  margin-top: 8rpx;
}
.vu-hero-hs {
  font-size: var(--fs-cap);
  color: rgba(255, 255, 255, 0.82);
  margin-top: 10rpx;
}

.vu-shead { margin: 0 0 25rpx; }

/* 套餐切换 */
.vu-plans {
  display: flex;
  gap: 25rpx;
  margin-bottom: 42rpx;
}
.vu-plan {
  flex: 1;
  position: relative;
  box-sizing: border-box;
  background: var(--c-surface);
  border: 4rpx solid var(--paper-2);
  border-radius: var(--r-card);
  padding: 38rpx 31rpx 35rpx;
  box-shadow: var(--sh-soft);
}
.vu-plan.on {
  border-color: var(--pop);
  box-shadow: var(--sh-soft), var(--sh-pop);
}
.vu-badge {
  position: absolute;
  top: -21rpx;
  right: 27rpx;
  font-family: var(--serif);
  font-style: italic;
  font-size: calc(20rpx * var(--fs-mul, 1));
  letter-spacing: 1rpx;
  font-weight: 700;
  color: var(--anchor-contrast);
  background: var(--pop);
  padding: 8rpx 21rpx;
  border-radius: var(--r-pill);
  box-shadow: 0 12rpx 27rpx rgba(232, 71, 42, 0.4);
}
.vu-tick {
  position: absolute;
  top: 27rpx;
  left: 27rpx;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  border: 4rpx solid var(--c-border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: calc(24rpx * var(--fs-mul, 1));
  font-weight: 900;
  color: var(--anchor-contrast);
}
.vu-plan.on .vu-tick {
  background: var(--pop);
  border-color: var(--pop);
}
.vu-ptop { padding-left: 58rpx; }
.vu-pname {
  font-size: var(--fs-cap);
  font-weight: 800;
  color: var(--ink);
  letter-spacing: -1rpx;
}
.vu-pprice {
  font-size: calc(58rpx * var(--fs-mul, 1));
  font-weight: 900;
  color: var(--ink);
  letter-spacing: -3rpx;
  margin-top: 15rpx;
  line-height: 1;
}
.vu-plan.on .vu-pprice { color: var(--pop); }
.vu-yuan {
  font-size: calc(32rpx * var(--fs-mul, 1));
  font-weight: 800;
  vertical-align: top;
  margin-right: 2rpx;
}
.vu-per {
  font-size: var(--fs-cap);
  font-weight: 600;
  color: var(--mut);
  letter-spacing: 0;
}
.vu-pnote {
  font-size: calc(22rpx * var(--fs-mul, 1));
  color: var(--mut-strong);
  margin-top: 13rpx;
}
.vu-del {
  color: var(--mut-2);
  text-decoration: line-through;
}

/* 价格明细 */
.vu-detail { margin-bottom: 42rpx; }
.vu-drow {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 17rpx 0;
  font-size: var(--fs-cap);
}
.vu-k { color: var(--mut-strong); font-weight: 600; }
.vu-v { color: var(--ink); font-weight: 700; }
.vu-drow.disc .vu-v { color: var(--pop); font-weight: 800; }
.vu-dline {
  height: 2rpx;
  background: var(--paper-2);
  margin: 12rpx 0;
}
.vu-drow.total {
  padding-top: 27rpx;
  align-items: flex-end;
}
.vu-drow.total .vu-k {
  font-size: calc(29rpx * var(--fs-mul, 1));
  color: var(--ink);
  font-weight: 800;
}
.vu-v-big {
  font-size: calc(58rpx * var(--fs-mul, 1));
  color: var(--pop);
  font-weight: 900;
  letter-spacing: -2rpx;
  line-height: 1;
}
.vu-savetip {
  margin-top: 23rpx;
  background: var(--pop-soft);
  border-radius: var(--r-sm);
  padding: 19rpx 25rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: var(--fs-cap);
  font-weight: 700;
  color: var(--pop);
}
.vu-star-mark {
  width: 22rpx;
  height: 22rpx;
  flex: none;
  background: var(--pop);
  clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
}

/* 会员权益 */
.vu-benes {
  padding: 15rpx 38rpx;
  margin-bottom: 20rpx;
}
.vu-bene {
  display: flex;
  align-items: center;
  gap: 25rpx;
  padding: 27rpx 0;
  border-bottom: 2rpx solid var(--paper-2);
}
.vu-bene:last-child { border-bottom: none; }
.vu-bi {
  width: 77rpx;
  height: 77rpx;
  border-radius: var(--r-sm);
  background: var(--pop-soft);
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-h2);
  font-weight: 800;
  color: var(--pop);
}
.vu-bm { flex: 1; min-width: 0; }
.vu-bh {
  font-size: calc(28rpx * var(--fs-mul, 1));
  font-weight: 800;
  color: var(--ink);
  letter-spacing: -0.5rpx;
}
.vu-bp {
  font-size: calc(22rpx * var(--fs-mul, 1));
  color: var(--mut-strong);
  margin-top: 6rpx;
  line-height: 1.4;
}
.vu-chk {
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  background: var(--pop);
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: calc(24rpx * var(--fs-mul, 1));
  font-weight: 900;
  color: var(--anchor-contrast);
  box-shadow: 0 12rpx 27rpx rgba(232, 71, 42, 0.32);
}

/* 底部支付栏 */
.vu-paybar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 50;
  box-sizing: border-box;
  background: var(--glass);
  backdrop-filter: blur(18rpx);
  border-top: 2rpx solid var(--paper-2);
  padding: 27rpx 46rpx calc(27rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 27rpx;
}
.vu-amt { flex: none; }
.vu-cap {
  font-size: var(--fs-mini);
  color: var(--mut-strong);
  font-weight: 600;
}
.vu-big {
  font-size: calc(52rpx * var(--fs-mul, 1));
  font-weight: 900;
  color: var(--pop);
  letter-spacing: -2rpx;
  line-height: 1.05;
}
.vu-big .vu-yuan { font-size: calc(32rpx * var(--fs-mul, 1)); }
.vu-paybtn {
  flex: 1;
  min-height: 104rpx;
  height: 104rpx;
  font-size: calc(32rpx * var(--fs-mul, 1));
  font-weight: 800;
  letter-spacing: 1rpx;
  gap: 17rpx;
  border-radius: var(--r-md);
}
.vu-paybtn.loading { opacity: 0.7; }
.vu-wxic { font-size: var(--fs-h2); font-weight: 700; }
