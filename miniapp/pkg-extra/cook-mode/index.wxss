/* pages/cook-mode/index.wxss · 烹饪模式（沉浸暗底）
   配色全部复用 app.wxss 全局 token：--pop / --gold-deep / --serif / --ink-deep 等
   仅本页特有的暗底层级用局部 rgba，不重定义品牌色 */
.cook {
  position: relative;
  display: flex;
  flex-direction: column;
  /* height 而不是 min-height：这页是「一屏内换步」的沉浸页，底部 上一步/下一步 必须常驻屏内。
     写成 min-height 时容器高度由内容决定（长步骤正文 + 计时卡能把页面撑到 900px 以上），
     flex:1 的正文区拿不到收缩目标，footer 被顶到屏外——实测 390×844 上 footer 底边在 y=911，
     整条主按钮在折线以下，做菜时得先把页面滚一下才点得到「下一步」。 */
  height: 100vh;
  background: var(--cook-bg);
  color: var(--cook-ink);
}

/* ============ 顶部栏 ============ */
.topbar {
  position: relative;
  z-index: 30;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 16rpx 38rpx 12rpx;
}
.nbtn {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.1);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
}
.nbtn.keep {
  /* 计时按钮：圆钮改胶囊，图标+「计时」文字，语义可读（CSS 小图标单独看不懂） */
  width: auto;
  padding: 0 24rpx;
  border-radius: 44rpx;
  gap: 10rpx;
  background: rgba(232, 71, 42, 0.16);
  border-color: rgba(232, 71, 42, 0.4);
}
.nbtn.keep.on {
  background: var(--cook-pop);
  border-color: var(--cook-pop);
}
.nbtn.keep .keep-ic { border-color: var(--pop); }
.nbtn.keep .keep-ic::after { background: var(--pop); }
.nbtn.keep.on .keep-ic { border-color: var(--anchor-contrast); }
.nbtn.keep.on .keep-ic::after { background: var(--cook-mark); }
.keep-tx {
  font-size: calc(25rpx * var(--fs-mul, 1));
  font-weight: 800;
  color: var(--pop);
  letter-spacing: 1rpx;
}
.nbtn.keep.on .keep-tx { color: var(--anchor-contrast); }
.dishbar {
  flex: 1;
  min-width: 0;
  text-align: center;
}
.dishbar .dn {
  font-size: calc(36rpx * var(--fs-mul, 1));
  font-weight: 900;
  color: var(--cook-ink);
  letter-spacing: -1rpx;
  font-family: var(--sans);
}
.dishbar .prog {
  font-family: var(--serif);
  font-style: italic;
  font-size: var(--fs-cap);
  color: var(--gold-deep);
  font-weight: 700;
  margin-top: 4rpx;
  letter-spacing: 1rpx;
}

/* —— icons（纯 CSS 描边）—— */
.ic-x, .ic-clock, .ic-clock-sm,
.ic-play, .ic-pause, .ic-reset,
.ic-arrow-l, .ic-arrow-r {
  position: relative;
  display: block;
}
.ic-x {
  width: 34rpx;
  height: 34rpx;
}
.ic-x::before, .ic-x::after {
  content: "";
  position: absolute;
  top: 50%;
  left: 0;
  width: 100%;
  height: 4rpx;
  border-radius: 4rpx;
  background: var(--cook-ink);
}
.ic-x::before { transform: translateY(-50%) rotate(45deg); }
.ic-x::after { transform: translateY(-50%) rotate(-45deg); }

.ic-clock, .ic-clock-sm {
  border-radius: 50%;
  border: 4rpx solid var(--pop);
}
.ic-clock { width: 34rpx; height: 34rpx; }
.ic-clock-sm { width: 22rpx; height: 22rpx; border-width: 3rpx; border-color: var(--anchor-contrast); }
.nbtn.keep.on .ic-clock { border-color: var(--anchor-contrast); }
.ic-clock::after, .ic-clock-sm::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 22%;
  width: 3rpx;
  height: 32%;
  background: var(--pop);
  transform-origin: bottom center;
}
.nbtn.keep.on .ic-clock::after { background: var(--cook-mark); }
.ic-clock-sm::after { background: var(--cook-mark); height: 30%; }

/* ============ 加载/空态 ============ */
.loading {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}
.spinner {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 255, 255, 0.15);
  border-top-color: var(--pop);
  animation: cookspin 0.8s linear infinite;
}
@keyframes cookspin { to { transform: rotate(360deg); } }
.loading-tx {
  font-size: calc(25rpx * var(--fs-mul, 1));
  color: var(--cook-ink-mut);
  font-family: var(--serif);
  font-style: italic;
}
.empty-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 40rpx;
}

/* ============ 正文 ============ */
.body {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
}

/* 进度点条 */
.dots {
  display: flex;
  gap: 12rpx;
  padding: 0 46rpx;
  margin: 8rpx 0 30rpx;
}
.dot {
  flex: 1;
  position: relative;
  height: 8rpx;
  border-radius: 6rpx;
  background: rgba(255, 255, 255, 0.12);
  transition: background 0.25s ease;
}
/* 按下时整段提亮（不用 .tap-scale：进度条缩放会让相邻段看起来在抖）。
   交互体检 A 类要求"绑了事件就得有按下反馈"，这条就是。 */
.dot:active { background: rgba(255, 255, 255, 0.34); }
/* 段本身 8rpx 高，手指点不准：热区撑到 88rpx（上下各 40rpx、左右各留 6rpx 防误触相邻段）。
   视觉一点没动，只是能点了。 */
.dot::after {
  content: "";
  position: absolute;
  left: -6rpx;
  right: -6rpx;
  top: 50%;
  height: 88rpx;
  margin-top: -44rpx;
}
.dot.done { background: var(--gold-deep); }
.dot.now { background: var(--pop); }

/* 离开的那一步还在倒数时的小条（本页是恒定暗底：只用 --cook-* 常量，勿用会翻转的 token） */
.bgchip {
  flex: none;
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 0 46rpx 18rpx;
  padding: 14rpx 24rpx;
  border-radius: var(--r-pill);
  background: var(--cook-surface);
  border: 2rpx solid rgba(255, 255, 255, 0.12);
}
.bgchip-ic {
  width: 22rpx;
  height: 22rpx;
  border-width: 3rpx;
  border-color: var(--cook-pop);
  flex: none;
}
.bgchip-tx {
  font-size: calc(25rpx * var(--fs-mul, 1));
  font-weight: 700;
  color: var(--cook-ink);
}
.bgchip-more {
  font-size: var(--fs-mini);
  color: var(--cook-ink-mut);
}
.bgchip-go {
  margin-left: auto;
  font-size: calc(25rpx * var(--fs-mul, 1));
  font-weight: 800;
  color: var(--cook-pop);
}

/* 步骤大图 */
.stepimg {
  position: relative;
  flex: none;
  margin: 0 46rpx 30rpx;
  height: var(--photo-focus-h);
  border-radius: 46rpx;
  overflow: hidden;
  box-shadow: 0 14rpx 36rpx rgba(0, 0, 0, 0.5);
}
.stepimg-pic {
  width: 100%;
  height: 100%;
  display: block;
}
.stepimg-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(20, 14, 8, 0.1) 40%, rgba(20, 14, 8, 0.85) 100%);
}
.stepimg .bignum {
  position: absolute;
  bottom: 22rpx;
  left: 34rpx;
  z-index: 2;
  font-family: var(--serif);
  font-size: calc(150rpx * var(--fs-mul, 1));
  font-weight: 700;
  line-height: 0.8;
  -webkit-text-stroke: 3rpx rgba(255, 255, 255, 0.85);
}
.stepimg .small {
  position: absolute;
  bottom: 40rpx;
  left: 220rpx;
  right: 30rpx;
  z-index: 2;
}
.stepimg .small .t {
  font-size: var(--fs-cap);
  font-weight: 800;
  color: var(--anchor-contrast);
  margin-top: 6rpx;
}
.stepimg .timetag {
  position: absolute;
  top: 26rpx;
  right: 26rpx;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: var(--fs-cap);
  font-weight: 700;
  color: var(--anchor-contrast);
  background: rgba(232, 71, 42, 0.85);
  padding: 12rpx 22rpx;
  border-radius: var(--r-pill);
}

/* 步骤文本滚动区 */
.stepwrap {
  flex: 1;
  min-height: 0;
  padding: 0 46rpx;
  /* scroll-view 原生默认 width:100% + content-box，padding 会把总宽撑出视口导致文字被裁 */
  box-sizing: border-box;
}
.stepeyebrow {
  font-family: var(--serif);
  font-style: italic;
  font-size: var(--fs-sub);
  color: var(--gold-deep);
  font-weight: 700;
  letter-spacing: 1rpx;
}
.steptext {
  /* 厨房场景手机放得远、手上有油：字号行高放大一档，扫读不费劲（对齐懒饭大字风格） */
  font-size: calc(50rpx * var(--fs-mul, 1));
  line-height: 1.6;
  font-weight: 800;
  color: var(--cook-ink);
  letter-spacing: -0.5rpx;
  margin-top: 16rpx;
  font-family: var(--sans);
}

/* 食材 tags */
.ings {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-top: 38rpx;
}
.ing {
  display: flex;
  align-items: center;
  gap: 14rpx;
  /* 配料标签同步放大一档，与步骤正文匹配 */
  font-size: calc(28rpx * var(--fs-mul, 1));
  font-weight: 600;
  color: var(--cook-ink);
  background: var(--cook-surface);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  padding: 18rpx 30rpx;
  border-radius: var(--r-pill);
}
/* 未勾选态用中性空心圈：--pop 在本项目里是「待采购」的语义色
   （见 recipe-detail 的 .rd-dot.miss），借用它会让人以为家里没这些食材 */
.ing .dotmark {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: transparent;
  box-shadow: inset 0 0 0 2rpx currentColor;
  opacity: 0.45;
  flex: none;
}
/* 勾选态：圆点变对勾、文字划线变淡（暗底沉浸式下的"备齐"反馈） */
.ing.checked {
  opacity: 0.55;
}
.ing.checked text {
  text-decoration: line-through;
}
.ing.checked .dotmark {
  width: 26rpx;
  height: 14rpx;
  border-radius: 2rpx;
  background: transparent;
  border-left: 4rpx solid var(--pop);
  border-bottom: 4rpx solid var(--pop);
  transform: rotate(-45deg) translateX(2rpx);
}
/* 当前这一步要点名的料：边框+底色一起动。暗底上只改字色/字重，一臂外用余光扫不出来 */
.ings.has-hit .ing:not(.on) {
  opacity: 0.45;
}
.ing.on {
  background: rgba(232, 71, 42, 0.18);
  border-color: rgba(232, 71, 42, 0.55);
  font-weight: 800;
}
.ing.on .dotmark {
  opacity: 1;
  box-shadow: inset 0 0 0 2rpx var(--pop);
}
/* 勾过的料如果正是这一步要用的，别被 .ing.checked 的淡出盖掉（备齐了也还得看得见它在哪） */
.ing.on.checked {
  opacity: 1;
}

/* 计时卡 */
.timer {
  margin-top: 38rpx;
  background: var(--cook-surface);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 38rpx;
  padding: 34rpx 38rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.timer .tl .cap {
  font-size: var(--fs-mini);
  letter-spacing: 3rpx;
  color: var(--cook-ink-mut);
  font-weight: 700;
}
/* 换时长入口：点时间区域随时重选 */
.timer .tl .cap .cap-pick {
  margin-left: 10rpx;
  color: var(--gold-deep);
  letter-spacing: 1rpx;
}
.timer .tl .num {
  font-family: var(--serif);
  font-size: calc(88rpx * var(--fs-mul, 1));
  font-weight: 700;
  color: var(--cook-ink);
  line-height: 1;
  margin-top: 8rpx;
  letter-spacing: 2rpx;
}
.timer .tl .num .pop { color: var(--pop); }
.timer-acts {
  display: flex;
  align-items: center;
  gap: 18rpx;
}
.tbtn {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(232, 71, 42, 0.16);
  border: 2rpx solid rgba(232, 71, 42, 0.4);
}
.tbtn.ghost {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.06);
  border-color: rgba(255, 255, 255, 0.12);
}
/* 「上一步」是做菜中途最常按的键，视觉 80rpx 不变、命中区补到 88rpx */
.tbtn.ghost::after {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 88rpx;
  height: 88rpx;
  content: "";
  transform: translate(-50%, -50%);
}

/* play / pause / reset icons */
.ic-play {
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 18rpx 0 18rpx 30rpx;
  border-color: transparent transparent transparent var(--pop);
  margin-left: 6rpx;
}
.ic-pause {
  width: 30rpx;
  height: 34rpx;
  position: relative;
}
.ic-pause::before, .ic-pause::after {
  content: "";
  position: absolute;
  top: 0;
  width: 10rpx;
  height: 100%;
  border-radius: 3rpx;
  background: var(--pop);
}
.ic-pause::before { left: 2rpx; }
.ic-pause::after { right: 2rpx; }
.ic-reset {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 4rpx solid var(--cook-line);
  border-top-color: transparent;
  position: relative;
}
.ic-reset::after {
  content: "";
  position: absolute;
  top: -4rpx;
  right: -2rpx;
  border-style: solid;
  border-width: 6rpx 0 0 8rpx;
  border-color: transparent transparent transparent var(--cook-line);
}

.scroll-pad { height: 24rpx; }

/* ============ 底部上/下一步 ============ */
.footer {
  flex: none;
  display: flex;
  gap: 22rpx;
  padding: 24rpx 46rpx calc(env(safe-area-inset-bottom) + 28rpx);
  background: linear-gradient(180deg, rgba(26, 20, 16, 0), var(--cook-bg) 30%);
}
.btn {
  box-sizing: border-box;
  height: 100rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  font-weight: 800;
  letter-spacing: 0.5rpx;
}
.btn.prev {
  flex: none;
  width: 220rpx;
  font-size: calc(29rpx * var(--fs-mul, 1));
  color: var(--cook-ink);
  background: var(--cook-surface);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
}
.btn.prev.disabled {
  opacity: 0.4;
}
.btn.next {
  flex: 1;
  min-width: 0;
  font-size: calc(32rpx * var(--fs-mul, 1));
  color: var(--anchor-contrast);
  background: var(--cook-pop);
  box-shadow: 0 2rpx 4rpx rgba(180, 40, 20, 0.3), 0 12rpx 26rpx rgba(232, 71, 42, 0.4);
}
.btn.next text {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* arrow icons */
.ic-arrow-l, .ic-arrow-r {
  width: 22rpx;
  height: 22rpx;
  flex: none;
  border-top: 5rpx solid currentColor;
  border-right: 5rpx solid currentColor;
}
.ic-arrow-l {
  transform: rotate(-135deg);
  color: var(--cook-ink);
}
.ic-arrow-r {
  transform: rotate(45deg);
  color: var(--anchor-contrast);
}
