<!-- pages/cook-mode/index.wxml · 烹饪模式（沉浸暗底分步引导） -->
<view class="cook {{fontScale === 'lg' ? 'font-lg' : ''}}" style="--sbh: {{statusBarHeight}}px;">

  <!-- 顶部只放菜名和步骤，计时集中到底部。 -->
  <view class="topbar" style="padding-top: {{statusBarHeight}}px; padding-right: {{capsulePad || 96}}px;">
    <view class="nbtn tap-scale" catchtap="onClose">
      <view class="ic-x"></view>
    </view>
    <view class="dishbar">
      <view class="dn ellipsis">{{dishName || '烹饪模式'}}</view>
      <view class="prog" wx:if="{{total}}">{{steps[current].cn}} · {{current + 1}}/{{total}}</view>
    </view>
  </view>

  <!-- 加载态 -->
  <view wx:if="{{loading}}" class="loading">
    <view class="spinner"></view>
    <text class="loading-tx">正在备菜…</text>
  </view>

  <!-- 加载失败态（网络错误/缺参，可重试） -->
  <view wx:elif="{{loadError}}" class="empty-wrap">
    <state-empty type="offline" theme="dark" title="菜谱没加载出来" desc="网络开小差了，检查后再试一次" cta="重新加载" bind:action="retryLoad" />
  </view>

  <!-- 空数据守护 -->
  <view wx:elif="{{!total}}" class="empty-wrap">
    <state-empty type="gray" theme="dark" title="暂无烹饪步骤" desc="这道菜还没有录入分步教程，去菜谱看看吧" cta="返回" cta-style="ghost" bind:action="onClose" />
  </view>

  <!-- 正文 -->
  <view wx:else class="body">


    <!-- 进度条每段可点，直接跳到那一步（段本身只有 8rpx 高，热区靠 .dot::after 撑到 88rpx） -->
    <view class="dots">
      <view
        wx:for="{{dots}}"
        wx:key="index"
        class="dot {{item}}"
        data-idx="{{index}}"
        catchtap="onDotTap"
        aria-label="跳到第 {{index + 1}} 步"
      ></view>
    </view>
    <text wx:if="{{dotsHint}}" class="dots-hint">轻点进度条，可直接跳到那一步</text>

    <!-- 图文一起滚动，长步骤也给底部操作留足空间。 -->
    <scroll-view class="stepwrap" scroll-y scroll-with-animation scroll-top="{{stepTop}}">
    <view class="stepimg g-fade-in">
      <image class="stepimg-pic {{steps[current].imgBroken ? 'img-broken' : ''}}" src="{{steps[current].image}}" mode="aspectFill"
        data-err-key="{{'steps[' + current + '].imgBroken'}}" binderror="onPhotoError" />
      <view class="stepimg-mask"></view>
      <view class="bignum title-stroke"><text>{{steps[current].num}}</text></view>
      <view class="small">
        <view class="t ellipsis">{{steps[current].cn}}</view>
      </view>
    </view>

      <view class="stepeyebrow">正在烹饪</view>
      <view class="steptext">{{steps[current].text}}</view>

      <!-- 食材 tags（点一下勾选：备齐一样勾一样）。当前步骤正文里点到名的料会高亮：
           服务端步骤与配料之间没有结构化关联，靠 utils/dish-logic.js 的文本匹配挑出来，
           匹配不到就整排保持中性（不高亮也不压暗），任何一条都不会被藏起来 -->
      <view wx:if="{{ingredients.length}}" class="ings {{hasStepHit ? 'has-hit' : ''}}">
        <view
          wx:for="{{ingredients}}"
          wx:key="name"
          class="ing tap-scale {{item.checked ? 'checked' : ''}} {{item.use ? 'on' : ''}}"
          data-idx="{{index}}"
          catchtap="toggleIng"
        >
          <view class="dotmark"></view>
          <text>{{item.label}}</text>
        </view>
      </view>

      <view class="scroll-pad"></view>
    </scroll-view>

    <view class="cook-dock">
      <view wx:if="{{bgIdx >= 0}}" class="bgchip tap-scale" catchtap="jumpToBgStep" role="button" aria-label="返回{{bgName}}，剩余{{bgText}}">
        <view class="ic-clock-sm bgchip-ic"></view>
        <text class="bgchip-tx">{{bgName}} · {{bgText}}</text>
        <text wx:if="{{bgExtra}}" class="bgchip-more">另有 {{bgExtra}} 步</text>
        <text class="bgchip-go">查看 ›</text>
      </view>
      <!-- 常驻计时在步骤内容下方、翻步操作上方。 -->
      <view wx:if="{{hasTimer}}" class="timer {{running ? 'is-running' : ''}}">
        <view class="tap-scale tl" catchtap="pickDuration" role="button" aria-label="更换本步计时时长">
          <view class="cap">{{running ? '计时中' : (timerLeft === 0 ? '计时结束' : (timerLeft < timerTotal ? '已暂停' : '这一步计时'))}}<text class="cap-pick">换时长 ›</text></view>
          <view class="num">{{timerText}}</view>
        </view>
        <view class="timer-acts">
          <view class="tbtn ghost tap-scale" catchtap="resetTimer" role="button" aria-label="重置本步计时">
            <text>重置</text>
          </view>
          <view class="tbtn tap-scale" catchtap="toggleTimer" role="button" aria-label="{{running ? '暂停计时' : '开始或继续计时'}}">
            <text>{{running ? '暂停' : (timerLeft < timerTotal && timerLeft > 0 ? '继续' : '开始')}}</text>
          </view>
        </view>
      </view>

      <view wx:else class="timer-add tap-scale" catchtap="pickDuration" role="button" aria-label="为这一步添加计时">
        <view class="ic-clock-sm"></view><text>这一步需要计时？</text><text class="timer-add-action">＋ 添加计时</text>
      </view>

    <!-- 底部上/下一步 -->
    <view class="footer">
      <view
        class="btn prev tap-scale {{current === 0 ? 'disabled' : ''}}"
        catchtap="onPrev"
      >
        <view class="ic-arrow-l"></view>
        <text class="btn-prev-label">上一步</text>
      </view>
      <view class="btn next tap-scale" catchtap="onNext" aria-disabled="{{finishing}}">
        <text wx:if="{{finishing}}">正在记录…</text>
        <text wx:elif="{{finished}}">已记录 · 查看记录</text>
        <text wx:elif="{{current < total - 1}}">下一步：{{steps[current + 1].cn}}</text>
        <text wx:else>完成 · 记一笔</text>
        <view class="ic-arrow-r"></view>
      </view>
    </view>
    </view>
  </view>
</view>
