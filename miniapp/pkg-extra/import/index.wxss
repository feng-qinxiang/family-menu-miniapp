/* ============================================================
   pages/import · 导入配方 v2「精致撞色 · 设计稿 import-final」
   配色/工具类全部复用 app.wxss token，本文件不重定义配色。
   ============================================================ */
.imp-page {
  position: relative;
  min-height: 100vh;
  background: var(--paper);
}

.imp-sheet { padding: 0 0 calc(env(safe-area-inset-bottom) + 40rpx); }
.imp-pad { padding: 0 var(--page-gutter); }
.imp-methods { display: flex; gap: 8rpx; padding: 4rpx; margin: 0 var(--page-gutter); background: var(--paper-2); border-radius: var(--r-md); }
.imp-method {
  flex: 1;
  min-width: 0;
  box-sizing: border-box;
  min-height: 88rpx;
  padding: 16rpx 20rpx;
  border: 2rpx solid transparent;
  border-radius: var(--r-sm);
}
.imp-method.on { border-color: var(--pop-mist); background: var(--c-surface); box-shadow: var(--sh-card); }
.m-name { font-size: var(--fs-sub); font-weight: 800; color: var(--ink); }
.imp-method.on .m-name { color: var(--pop-deep); }
.m-desc { margin-top: 4rpx; font-size: var(--fs-cap); line-height: 1.5; color: var(--mut-strong); }

/* 图标（纯 CSS 描边）*/
.ic-link, .ic-shield {
  width: 36rpx;
  height: 36rpx;
  position: relative;
}
.ic-link {
  width: 40rpx;
  height: 18rpx;
  border: 4rpx solid var(--gold);
  border-radius: var(--r-pill);
  transform: rotate(-30deg);
}
.ic-link::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 22rpx;
  height: 4rpx;
  background: var(--pop);
  transform: translate(-50%, -50%);
}
.ic-link-pop { border-color: var(--pop); }
.ic-link-pop::after { background: var(--pop); }
.ic-shield {
  width: 32rpx;
  height: 36rpx;
  border: 4rpx solid var(--pop);
  border-radius: 6rpx 6rpx 14rpx 14rpx;
}

/* ============ 粘贴区 ============ */
.imp-shead-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16rpx;
}
.imp-input-title { flex: 1; min-width: 0; font-size: calc(32rpx * var(--fs-mul, 1)); font-weight: 800; color: var(--ink); }
.sample {
  font-size: calc(25rpx * var(--fs-mul, 1));
  color: var(--gold-deep);
  font-weight: 700;
  flex: none;
  min-height: 88rpx;
  display: flex;
  align-items: center;
}
.ta-wrap { position: relative; padding: 24rpx; box-shadow: none; }
.ta-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 240rpx;
  font-size: var(--fs-sub);
  color: var(--ink);
  line-height: 1.65;
}
.ta-ph { color: var(--mut-2); }
.ta-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid var(--paper-2);
}
.ta-cnt { font-size: calc(23rpx * var(--fs-mul, 1)); color: var(--mut-2); }
.parsebtn.disabled {
  opacity: 0.5;
}
.parsebtn {
  display: flex;
  align-items: center;
  gap: 10rpx;
  justify-content: center;
  background: var(--pop);
  color: var(--anchor-contrast);
  font-size: var(--fs-cap);
  font-weight: 800;
  padding: 0 40rpx; /* 例外：这是按钮不是卡表面，左右内边距按按钮文字宽度定 */
  min-height: 88rpx;
  border-radius: var(--r-card); /* 实心主按钮统一 --r-card */
  box-shadow: var(--sh-pop);
}

/* ============ 检测 banner ============ */
.imp-detected {
  display: flex;
  align-items: center;
  gap: 18rpx;
  background: var(--pop-soft);
  border: 2rpx solid var(--pop-mist);
  border-radius: var(--r-md);
  padding: 22rpx 26rpx;
  margin-top: 26rpx;
}
.dt-icon { flex: none; }
.dt-txt { font-size: calc(25rpx * var(--fs-mul, 1)); color: var(--pop-deep); font-weight: 600; line-height: 1.45; }
.dt-txt .b { font-weight: 800; }

/* ============ 解析结果卡 ============ */
.rescard {
  background: var(--c-surface);
  border-radius: var(--r-card);
  border: var(--bd-card);
  overflow: hidden;
  margin-top: 32rpx;
  box-shadow: var(--sh-card);
}
.res-top { display: flex; gap: 24rpx; padding: 28rpx 28rpx 0; }
.res-cover {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 28rpx;
  overflow: hidden;
  flex: none;
  box-shadow: 0 10rpx 28rpx rgba(120, 70, 30, 0.2);
}
.res-cover-img { width: 100%; height: 100%; }
.res-cover-add {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(44, 36, 27, 0.55);
  color: var(--anchor-contrast);
  font-size: calc(25rpx * var(--fs-mul, 1));
  font-weight: 700;
}
.res-cover-del {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.5);
  color: var(--anchor-contrast);
  /* 触控热区 88rpx（视觉仍是 40rpx 的圆） */
  position: absolute;
  font-size: calc(28rpx * var(--fs-mul, 1));
  line-height: 40rpx;
  text-align: center;
}
.res-info { flex: 1; min-width: 0; padding-top: 4rpx; }
.res-tag {
  display: inline-block;
  font-family: var(--serif);
  font-size: calc(21rpx * var(--fs-mul, 1));
  font-weight: 700;
  color: var(--anchor-contrast);
  background: var(--pop);
  padding: 5rpx 16rpx;
  border-radius: var(--r-xs);
}
.res-title {
  font-size: calc(42rpx * var(--fs-mul, 1));
  font-weight: 900;
  color: var(--ink);
  letter-spacing: -1.5rpx;
  margin-top: 14rpx;
  line-height: 1.1;
}
.res-meta { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 18rpx; }
.rm-cuisine, .rm-pill {
  display: flex;
  align-items: center;
  font-size: calc(23rpx * var(--fs-mul, 1));
  font-weight: 600;
  color: var(--mut);
  background: var(--paper-2);
  padding: 8rpx 18rpx;
  border-radius: var(--r-pill);
}
.rm-cuisine-in { font-size: calc(23rpx * var(--fs-mul, 1)); color: var(--ink); font-weight: 700; min-width: 80rpx; }

.res-block { padding: 30rpx 28rpx 0; }
.blabel {
  display: flex;
  align-items: center;
  gap: 14rpx;
  font-size: calc(25rpx * var(--fs-mul, 1));
  font-weight: 800;
  color: var(--ink);
}
.blabel .en {
  font-family: var(--serif);
  font-weight: 700;
  color: var(--gold-deep);
  font-size: var(--fs-mini);
}
.res-empty { margin-top: 16rpx; font-size: calc(25rpx * var(--fs-mul, 1)); color: var(--mut); }

.diff-row { display: flex; gap: 16rpx; margin-top: 20rpx; }
.diff-chip { flex: 1; justify-content: center; }
.diff-chip.on { background: var(--pop); color: var(--anchor-contrast); border-color: var(--pop); }

.ing-grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 22rpx; }
.ing {
  background: var(--paper-2);
  border-radius: 20rpx;
  padding: 14rpx 22rpx;
  font-size: calc(25rpx * var(--fs-mul, 1));
  color: var(--ink);
  font-weight: 600;
}
.ing .amt { color: var(--mut); margin-left: 10rpx; }

.step { display: flex; gap: 22rpx; margin-top: 26rpx; }
.sno {
  width: 50rpx;
  height: 50rpx;
  border-radius: var(--r-sm);
  background: var(--anchor);
  color: var(--gold);
  font-size: var(--fs-sub);
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  font-family: var(--serif);
}
.step-main { flex: 1; min-width: 0; padding-top: 4rpx; }
.stext { font-size: calc(25rpx * var(--fs-mul, 1)); color: var(--ink); line-height: 1.55; }
.step-img-add {
  display: inline-block;
  margin-top: 14rpx;
  font-size: calc(23rpx * var(--fs-mul, 1));
  font-weight: 700;
  color: var(--gold-deep);
  background: var(--paper-2);
  padding: 10rpx 22rpx;
  border-radius: var(--r-pill);
}
.step-img-wrap { position: relative; margin-top: 14rpx; width: 160rpx; height: 160rpx; border-radius: 20rpx; overflow: hidden; }
.step-img { width: 100%; height: 100%; }
.step-img-del::after,
.res-cover-del::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 88rpx;
  height: 88rpx;
  transform: translate(-50%, -50%);
}

.step-img-del {
  position: absolute;
  right: 6rpx;
  top: 6rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.5);
  color: var(--anchor-contrast);
  font-size: calc(25rpx * var(--fs-mul, 1));
  line-height: 36rpx;
  text-align: center;
}

/* ============ 来源 / 备注 / CTA ============ */
.source {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin: 30rpx 28rpx 0;
  padding: 24rpx 28rpx;
  background: var(--paper-2);
  border-radius: 28rpx;
}
.s-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: var(--c-surface);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  box-shadow: var(--sh-soft);
}
.s-body { flex: 1; min-width: 0; }
.s-body .st { font-size: calc(25rpx * var(--fs-mul, 1)); font-weight: 700; color: var(--ink); }
.s-body .sl { font-size: var(--fs-mini); color: var(--gold-deep); margin-top: 6rpx; }

.note-list { margin: 24rpx 28rpx 0; }
.note-item { font-size: calc(23rpx * var(--fs-mul, 1)); color: var(--mut); line-height: 1.7; }

.res-cta { padding: 30rpx 28rpx 32rpx; }

/* ============ 最近导入 ============ */
.recent-list { background: var(--c-surface); border-radius: var(--r-card); border: var(--bd-card); box-shadow: var(--sh-soft); padding: 6rpx var(--pad-card); }
.recent {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--paper-2);
}
.recent:last-child { border-bottom: none; }
.r-thumb { width: var(--tile-row-sm); height: var(--tile-row-sm); border-radius: 26rpx; flex: none; }
.r-mid { flex: 1; min-width: 0; }
.r-title { font-size: calc(32rpx * var(--fs-mul, 1)); font-weight: 800; color: var(--ink); letter-spacing: -0.5rpx; }
.r-sub { font-size: calc(23rpx * var(--fs-mul, 1)); color: var(--mut); margin-top: 8rpx; }
.r-state {
  font-size: var(--fs-mini);
  font-weight: 700;
  color: var(--pine);
  background: rgba(47, 74, 58, 0.1);
  padding: 8rpx 18rpx;
  border-radius: var(--r-pill);
  flex: none;
}

.imp-botspace { height: 60rpx; }





/* 最近导入加载失败的重试入口 */
.recent-failed {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  margin-top: 16rpx;
  font-size: var(--fs-cap);
  color: var(--mut-strong);
  border: 2rpx solid var(--c-border-light);
  border-radius: var(--r-md);
}
