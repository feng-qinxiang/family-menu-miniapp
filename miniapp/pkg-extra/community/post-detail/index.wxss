/* pages/community/post-detail · 帖子详情 */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--c-surface);
}

/* 滚动区占满 nav-bar 与输入框之间 */
.scroll {
  flex: 1;
  min-height: 0;
}
.body {
  box-sizing: border-box;
  padding: 12rpx 32rpx 48rpx;
}

/* ===== 头像 ===== */
/* 人名头像：暖中性底（与社区信息流一致）；红色只留给操作 */
.ava {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--ava-head);
  height: var(--ava-head);
  border-radius: calc(var(--ava-head) * var(--r-ava));
  font-weight: 700;
  font-size: calc(var(--ava-head) * var(--ava-glyph) * var(--fs-mul, 1));
  color: var(--ink);
  background: var(--paper-2);
}
.ava-sm { width: var(--ava-cmt); height: var(--ava-cmt); border-radius: calc(var(--ava-cmt) * var(--r-ava)); font-size: calc(var(--ava-cmt) * var(--ava-glyph) * var(--fs-mul, 1)); }

/* ===== 作者块 ===== */
.author {
  display: flex;
  align-items: center;
  gap: 18rpx;
}
.acol { flex: 1; min-width: 0; }
.aname {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--ink);
  letter-spacing: 0;
}
.atime {
  margin-top: 6rpx;
  font-size: var(--fs-cap);
  color: var(--mut-strong);
  white-space: normal;
  line-height: 1.5;
}

/* ===== 标题 ===== */
.post-copy { padding-top: 24rpx; }
.post-title { font-size: var(--fs-h2); font-weight: 600; line-height: 1.4; letter-spacing: 0; color: var(--ink); word-break: normal; overflow-wrap: break-word; }

/* ===== 正文 ===== */
.post-text { margin-top: 16rpx; }
.ptext-p {
  font-size: var(--fs-lg);
  font-weight: 400;
  line-height: 1.6;
  color: var(--ink-deep);
  word-break: normal;
  overflow-wrap: break-word;
  text-align: left;
  margin-bottom: 16rpx;
}
.ptext-p:last-child { margin-bottom: 0; }

/* ===== 标签 ===== */
.ptags {
  display: flex;
  flex-wrap: wrap;
  flex: 1;
  min-width: 0;
  gap: 6rpx 16rpx;
}
/* 标签只读：浅底小胶囊，不带 #，不用强调色（不像链接） */
.ptag {
  padding: 2rpx 16rpx;
  border-radius: var(--r-pill);
  background: var(--paper);
  font-size: var(--fs-cap);
  font-weight: 500;
  color: var(--mut-strong);
  line-height: 1.5;
  word-break: break-all;
}

/* ===== 关联菜谱卡 ===== */
.recipe-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  background: var(--paper);
  border-radius: var(--r-card);
  padding: var(--pad-card-sm);
  margin-top: 12rpx;
  border: var(--bd-card);
  box-shadow: none;
}
.rc-img {
  width: var(--tile-rc);
  height: var(--tile-rc);
  border-radius: var(--r-sm);   /* 嵌在 --r-card 卡里：原来 --r-chip(30rpx) 比外卡还圆 */
  flex: none;
}
.rc-mid { flex: 1; min-width: 0; }
.rc-kick {
  font-size: var(--fs-cap);
  color: var(--pine-ink);
  font-weight: 600;
}
.rc-name {
  margin-top: 6rpx;
  font-size: calc(32rpx * var(--fs-mul, 1));
  font-weight: 800;
  color: var(--ink);
  letter-spacing: 0;
  white-space: normal;
  word-break: break-all;
  line-height: 1.45;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.rc-meta {
  margin-top: 10rpx;
  font-size: var(--fs-cap);
  color: var(--mut-strong);
}
.rc-go {
  flex: none;
  width: 32rpx;
  height: 88rpx;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
}
.rc-arrow {
  width: 18rpx;
  height: 18rpx;
  border-top: 3rpx solid var(--mut-strong);
  border-right: 3rpx solid var(--mut-strong);
  transform: translateX(-3rpx) rotate(45deg);
  border-radius: 2rpx;
}

/* ===== 操作栏 ===== */
.react-bar {
  display: flex;
  align-items: center;
  flex: none;
  gap: 4rpx;
}
.react {
  display: flex;
  align-items: center;
  flex-direction: column;
  gap: 8rpx;
  flex: none;
  width: 88rpx;
  min-height: 88rpx;
  box-sizing: border-box;
  justify-content: center;
  padding: 8rpx 0;
  color: var(--mut-strong);
  font-size: var(--fs-mini);
  font-weight: 500;
}
.reaction-icon {
  width: 32rpx;
  height: 32rpx;
  flex: none;
}
.reaction-icon { filter: brightness(0); opacity: .55; }
.react.liked .reaction-icon, .react.fav-on .reaction-icon { filter: none; opacity: 1; }
.react .n { font-weight: 500; word-break: break-all; line-height: 1.3; }
.react.liked, .react.fav-on { color: var(--pop); }

/* ===== 评论区 ===== */
.csec { margin-top: 24rpx; padding-top: 20rpx; border-top: var(--bd-card); }
.cs-head {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx 12rpx;
}
.cs-title {
  font-size: calc(32rpx * var(--fs-mul, 1));
  font-weight: 700;
  color: var(--ink);
  letter-spacing: 0;
}
.cnt {
  margin-left: auto;
  font-size: var(--fs-sub);
  font-weight: 700;
  color: var(--mut-strong);
}
.cmt-list { margin-top: 8rpx; }
.cmt {
  display: flex;
  gap: 22rpx;
  padding: 30rpx 0;
  border-bottom: 2rpx solid var(--paper-2);
}
.cmt:last-child { border-bottom: none; }
.ccol { flex: 1; min-width: 0; }
.crow {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.cmeta { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.cname {
  font-size: calc(25rpx * var(--fs-mul, 1));
  font-weight: 800;
  color: var(--ink);
  line-height: 1.5;
  word-break: break-all;
}
.ctime {
  font-size: var(--fs-mini);
  color: var(--mut);
  flex: none;
}
.ctext {
  margin-top: 10rpx;
  font-size: calc(25rpx * var(--fs-mul, 1));
  line-height: 1.6;
  color: var(--ink-deep);
}

/* ===== 底部输入框 ===== */
.inputbar {
  flex: none;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 24rpx calc(14rpx + env(safe-area-inset-bottom));
  background: var(--c-surface);
  border-top: 2rpx solid var(--paper-2);
}
.comment-compose { flex: 1; min-width: 0; display: flex; align-items: center; gap: 10rpx; box-sizing: border-box; padding: 0 18rpx; border-radius: var(--r-pill); background: var(--paper-2); }
.comment-compose.is-writing { border-radius: var(--r-md); }
.compose-icon { width: 28rpx; height: 28rpx; flex: none; filter: brightness(0); opacity: .45; }
/* 深色档：心形/书签 SVG 的描边写死是红色，原来 filter:none 让「未点赞」也显示成暗红，
   和「已点赞」的红只差一点透明度；评论气泡 SVG 是浅色描边，三个图标两种颜色。
   未激活一律压成单色浅灰（与首页 .hm-journey-icon 同一做法），激活态保持原色。 */
@media (prefers-color-scheme: dark) {
  .compose-icon { filter: none; opacity: .7; }
  .react:not(.liked):not(.fav-on) .reaction-icon { filter: brightness(0) invert(1); opacity: .7; }
}
.field {
  flex: 1;
  min-width: 0;
  box-sizing: border-box;
  min-height: 88rpx;
  max-height: 200rpx;
  width: 100%;
  background: transparent;
  border: 0;
  padding: 24rpx 0;
  font-size: calc(25rpx * var(--fs-mul, 1));
  color: var(--ink);
}
.field-ph { color: var(--mut); }
.send {
  flex: none;
  min-width: 104rpx;
  min-height: 88rpx;
  padding: 0 14rpx;
  box-sizing: border-box;
  border-radius: var(--r-pill);
  font-size: var(--fs-cap);
  font-weight: 700;
  color: var(--anchor-contrast);
  background: var(--pop-fill);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--sh-pop);
}
.send { position: relative; }
.send-busy { opacity: 0.55; }
/* ===== 加载骨架 ===== */
.loading { padding: 40rpx 30rpx; }
.sk-line {
  height: 34rpx;
  border-radius: 12rpx;
  background: var(--paper-2);
  margin-bottom: 22rpx;
}
.sk-w60 { width: 60%; }
.sk-w80 { width: 80%; }
.sk-w90 { width: 90%; }
.sk-img {
  width: 100%;
  height: var(--photo-head-h);   /* = .dish-img，骨架和真卡同高，加载完不跳版 */
  margin: 12rpx 0 28rpx;
}

/* ===== 作者/评论删除入口（仅 mine 可见） ===== */
.adel {
  flex: none;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  font-size: var(--fs-cap);
  color: var(--mut);
  padding: 8rpx 4rpx 8rpx 20rpx;
}
.cdel {
  flex: none;
  margin-left: 8rpx;
  font-size: var(--fs-mini);
  color: var(--mut);
  padding: 4rpx 0 4rpx 12rpx;
}

/* ===== 帖子图集 + 分享按钮 ===== */
.pimgs {
  position: relative;
  margin: 18rpx 0 0;
}
.pimg {
  display: block;
  width: 100%;
  height: var(--photo-head-h);
  border-radius: var(--r-md);
  background: var(--paper-2);
}
.post-gallery { height: var(--photo-head-h); border-radius: var(--r-md); overflow: hidden; }
.post-photo-counter { position: absolute; right: 16rpx; bottom: 16rpx; pointer-events: none; padding: 8rpx 14rpx; border-radius: var(--r-pill); background: rgba(30, 25, 20, .64); color: #fff; font-size: var(--fs-mini); }
.comment-empty { margin-top: 16rpx; padding: 24rpx; border-radius: var(--r-md); background: var(--paper-2); }   /* 原来贴着「全部评论」标题 */
.comment-empty view { font-size: var(--fs-sub); font-weight: 700; color: var(--ink); }
.comment-empty text { display: block; margin-top: 10rpx; font-size: var(--fs-cap); color: var(--mut-strong); line-height: 1.6; }
.comment-retry { display: flex; align-items: center; gap: 16rpx; color: var(--mut-strong); font-size: var(--fs-cap); }
.comment-retry > text { flex: 1; }
.comment-retry > view { display: flex; align-items: center; min-height: 88rpx; color: var(--pop-deep); font-weight: 700; }
.post-footer { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 16rpx; }
.react-share,
.react-report {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  background: transparent;
  border: none;
  min-width: 88rpx;
  min-height: 88rpx;
  flex: none;
  box-sizing: border-box;
  margin: 0;
  padding: 0 8rpx;
  line-height: inherit;
  color: var(--mut-strong);
  font-size: var(--fs-cap);
}
.react-share .ricon { font-size: var(--fs-sub); }
.react-share { width: 120rpx; }
.react-share::after {
  border: none;
}

/* ===== 审核状态角标 ===== */
.post-title-row { display: flex; flex-direction: column; gap: 12rpx; }
.pd-pending {
  align-self: flex-start;
  font-size: var(--fs-cap);
  font-weight: 700;
  color: var(--gold-deep);
  background: rgba(176, 137, 73, 0.14);
  padding: 8rpx 20rpx;
  border-radius: var(--r-pill);
}
.cd-pending {
  font-size: var(--fs-mini);
  color: var(--gold-deep);
  margin-left: 8rpx;
}

.rc-img-text { display: flex; align-items: center; justify-content: center; padding: 12rpx; box-sizing: border-box; background: var(--paper-2); color: var(--pine-ink); font-size: var(--fs-sub); text-align: center; word-break: break-all; }
.rc-name, .rc-meta { white-space: normal; line-height: 1.5; word-break: break-all; }
.adel, .cdel { min-height: 88rpx; min-width: 88rpx; display: flex; align-items: center; justify-content: center; box-sizing: border-box; }
