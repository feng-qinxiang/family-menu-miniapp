/* pages/community/post-detail · 帖子详情 */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--paper);
}

/* 滚动区占满 nav-bar 与输入框之间 */
.scroll {
  flex: 1;
  min-height: 0;
}
.body {
  box-sizing: border-box;
  padding: 12rpx 46rpx 48rpx;
}

/* ===== 头像 ===== */
.ava {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--ava-head);
  height: var(--ava-head);
  border-radius: calc(var(--ava-head) * var(--r-ava));
  font-family: var(--serif);
  font-weight: 700;
  font-size: calc(var(--ava-head) * var(--ava-glyph) * var(--fs-mul, 1));
  color: var(--anchor-contrast);
  box-shadow: 0 4rpx 12rpx rgba(60, 40, 20, 0.12);
}
.ava-sm { width: var(--ava-cmt); height: var(--ava-cmt); font-size: calc(var(--ava-cmt) * var(--ava-glyph) * var(--fs-mul, 1)); }
.ava-lin { background: linear-gradient(135deg, var(--pop), var(--orange)); }
.ava-lan { background: linear-gradient(135deg, var(--pine), var(--cat-green)); }
.ava-zhao { background: linear-gradient(135deg, var(--cat-purple-deep), var(--cat-purple-light)); }
.ava-gold { background: linear-gradient(135deg, var(--gold-deep), var(--gold)); }
.ava-pine { background: linear-gradient(135deg, var(--pine), var(--cat-green-light)); }

/* ===== 作者块 ===== */
.author {
  display: flex;
  align-items: center;
  gap: 22rpx;
}
.acol { flex: 1; min-width: 0; }
.aname {
  font-size: calc(32rpx * var(--fs-mul, 1));
  font-weight: 800;
  color: var(--ink);
  letter-spacing: -0.4rpx;
}
.atime {
  margin-top: 6rpx;
  font-size: var(--fs-cap);
  color: var(--mut-strong);
}

/* ===== 标题 ===== */
.eyebrow-mt { margin-top: 42rpx; display: block; }
.post-title {
  margin-top: 14rpx;
  font-size: var(--fs-h1);
  line-height: 1.08;
  letter-spacing: -2rpx;
  /* title-stroke/title-shadow 已提供描边白字 */
}

/* ===== 正文 ===== */
.post-text { margin-top: 26rpx; }
.ptext-p {
  font-size: calc(29rpx * var(--fs-mul, 1));
  line-height: 1.75;
  color: var(--ink-deep);
  margin-bottom: 22rpx;
}
.ptext-p:last-child { margin-bottom: 0; }

/* ===== 菜图 ===== */
.dish-img {
  width: 100%;
  height: var(--photo-head-h);
  border-radius: var(--r-card);
  margin-top: 34rpx;
  display: block;
  box-shadow: var(--sh-card);
}
.imgcap {
  margin-top: 18rpx;
  text-align: center;
  font-family: var(--serif);
  font-style: italic;
  font-size: var(--fs-cap);
  color: var(--mut-strong);
}

/* ===== 标签 ===== */
.ptags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 30rpx;
}
.ptag {
  font-size: var(--fs-cap);
  font-weight: 700;
  color: var(--gold-deep);
  background: var(--paper-2);
  padding: 12rpx 24rpx;
  border-radius: var(--r-pill);
}

/* ===== 关联菜谱卡 ===== */
.recipe-card {
  display: flex;
  align-items: center;
  gap: 26rpx;
  background: var(--c-surface);
  border-radius: var(--r-card);
  padding: var(--pad-card-sm);
  margin-top: 38rpx;
  border: var(--bd-card);
  box-shadow: var(--sh-card);
}
.rc-img {
  width: 138rpx;
  height: 138rpx;
  border-radius: var(--r-chip);
  flex: none;
}
.rc-mid { flex: 1; min-width: 0; }
.rc-kick {
  font-family: var(--serif);
  font-style: italic;
  font-size: var(--fs-mini);
  color: var(--gold-deep);
  font-weight: 700;
}
.rc-name {
  margin-top: 6rpx;
  font-size: calc(32rpx * var(--fs-mul, 1));
  font-weight: 800;
  color: var(--ink);
  letter-spacing: -0.6rpx;
}
.rc-meta {
  margin-top: 10rpx;
  font-size: var(--fs-cap);
  color: var(--mut-strong);
}
.rc-go {
  flex: none;
  width: 76rpx;
  height: 76rpx;
  border-radius: 26rpx;
  background: var(--anchor);
  display: flex;
  align-items: center;
  justify-content: center;
}
.rc-arrow {
  width: 18rpx;
  height: 18rpx;
  border-top: 5rpx solid var(--paper);
  border-right: 5rpx solid var(--paper);
  transform: translateX(-3rpx) rotate(45deg);
  border-radius: 2rpx;
}

/* ===== 操作栏 ===== */
/* 实测（390×844 档）：可用宽 664rpx，五个胶囊按内容实际需要约 800rpx，
   所以原来既不换行也不缩字号，只能被挤扁——「收藏 0」竖排成两行、
   三个胶囊高度 38/22/58px 各不相同。改成：字号锁死不折行，
   装不下就**整胶囊换到第二行**，两行都左对齐，观感与列表页动作行一致。 */
.react-bar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 14rpx 10rpx;
  margin-top: 42rpx;
  padding-bottom: 42rpx;
  border-bottom: 2rpx solid var(--paper-2);
}
.react {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: none;
  white-space: nowrap;
  padding: 18rpx 26rpx;
  border-radius: var(--r-pill);
  background: var(--paper-2);
  color: var(--mut-strong);
  font-size: var(--fs-sub);
  font-weight: 700;
}
/* 图标一律 22rpx 见方：.ricon-heart / .ricon-star 是定宽高的 CSS 形状，
   而 app.wxss 的 .ico-* 用 em（1em≈图标框），所以这里把字号压到 22rpx 让一排对齐。 */
.react .ricon { font-size: calc(23rpx * var(--fs-mul, 1)); line-height: 1; }
/* 几何心/星，不用 emoji */
.ricon-heart,
.ricon-star {
  width: 22rpx;
  height: 22rpx;
  flex: none;
}
.ricon-heart {
  border-radius: 50%;
  border: 3rpx solid currentColor;
  box-sizing: border-box;
}
.ricon-heart.on {
  background: currentColor;
}
.ricon-star {
  background: currentColor;
  clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
  opacity: 0.45;
}
.ricon-star.on { opacity: 1; }
.react .n { font-weight: 800; }
.react.liked { background: var(--pop-soft); color: var(--pop); }
.react.fav-on { background: var(--pop-soft); color: var(--pop); }
/* 原来这里靠 .react-end{margin-left:auto} 把评论顶到行尾；改成一排左对齐后
   换行才不会跑出"半行右对齐"的孤儿胶囊，所以这个类连同它在 WXML 里的用法一起删。 */

/* ===== 评论区 ===== */
.csec { margin-top: 44rpx; }
.cs-head {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}
.cs-title {
  font-size: calc(36rpx * var(--fs-mul, 1));
  font-weight: 900;
  color: var(--ink);
  letter-spacing: -0.8rpx;
}
.cnt {
  font-size: var(--fs-sub);
  font-weight: 700;
  color: var(--mut-strong);
}
.cmt-list { margin-top: 8rpx; }
.cmt {
  display: flex;
  gap: 22rpx;
  padding: 30rpx 0;
  border-bottom: 2rpx solid var(--paper-2);
}
.cmt:last-child { border-bottom: none; }
.ccol { flex: 1; min-width: 0; }
.crow {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.cname {
  font-size: calc(25rpx * var(--fs-mul, 1));
  font-weight: 800;
  color: var(--ink);
  flex: 1;
  min-width: 0;
}
.ctime {
  font-size: var(--fs-mini);
  color: var(--mut);
  flex: none;
}
.ctext {
  margin-top: 10rpx;
  font-size: calc(25rpx * var(--fs-mul, 1));
  line-height: 1.6;
  color: var(--ink-deep);
}

/* ===== 底部输入框 ===== */
.inputbar {
  flex: none;
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 22rpx 34rpx calc(22rpx + env(safe-area-inset-bottom));
  background: var(--glass);
  border-top: 2rpx solid var(--paper-2);
}
.field {
  flex: 1;
  box-sizing: border-box;
  height: 84rpx;
  border-radius: var(--r-pill);
  background: var(--paper-2);
  border: 2rpx solid var(--c-border);
  padding: 0 34rpx;
  font-size: calc(25rpx * var(--fs-mul, 1));
  color: var(--ink);
}
.field-ph { color: var(--mut); }
.send {
  flex: none;
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: var(--pop);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--sh-pop);
}
.send { position: relative; }
/* 单手打字时拇指要够到发送键：视觉 84rpx 不变，命中区补到 88rpx */
.send::after {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 88rpx;
  height: 88rpx;
  content: "";
  transform: translate(-50%, -50%);
}
.send-busy { opacity: 0.55; }
/* 发送箭头：CSS 三角 */
.send-icon {
  width: 18rpx;
  height: 18rpx;
  border-top: 5rpx solid var(--c-surface);
  border-right: 5rpx solid var(--c-surface);
  transform: translateX(-2rpx) rotate(45deg);
  border-radius: 2rpx;
}

/* ===== 加载骨架 ===== */
.loading { padding: 40rpx 30rpx; }
.sk-line {
  height: 34rpx;
  border-radius: 12rpx;
  background: var(--paper-2);
  margin-bottom: 22rpx;
}
.sk-w60 { width: 60%; }
.sk-w80 { width: 80%; }
.sk-w90 { width: 90%; }
.sk-img {
  width: 100%;
  height: var(--photo-head-h);   /* = .dish-img，骨架和真卡同高，加载完不跳版 */
  margin: 12rpx 0 28rpx;
}

/* ===== 作者/评论删除入口（仅 mine 可见） ===== */
.adel {
  flex: none;
  font-size: var(--fs-cap);
  color: var(--mut);
  padding: 8rpx 4rpx 8rpx 20rpx;
}
.cdel {
  flex: none;
  margin-left: 8rpx;
  font-size: var(--fs-mini);
  color: var(--mut);
  padding: 4rpx 0 4rpx 12rpx;
}

/* ===== 帖子图集 + 分享按钮 ===== */
.pimgs {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin: 26rpx 0 10rpx;
}
.pimg {
  width: 100%;
  aspect-ratio: 1;
  border-radius: 14rpx;
  background: var(--paper-2);
}
/* 次级动作行：占满一整行、两端对齐（分享在左、举报在右）。
   flex: 1 1 100% 是"强制另起一行"的写法，不依赖上面那排装不装得下。 */
.react-sub {
  display: flex;
  flex: 1 1 100%;
  align-items: center;
  justify-content: space-between;
}
/* 分享 / 举报 = 次级文字动作（与社区列表页 .pa-report 同一层级：主操作是胶囊，
   次级是弱色文字），所以不给胶囊底色。button 的 UA 默认样式要显式压掉。 */
.react-share,
.react-report {
  background: transparent;
  border: none;
  min-width: 0;
  flex: 0 0 auto;
  margin: 0;
  padding: 18rpx 8rpx;
  line-height: inherit;
  color: var(--mut-strong);
  font-size: inherit;
}
.react-share::after {
  border: none;
}

/* ===== 审核状态角标 ===== */
.post-title-row { display: flex; flex-direction: column; gap: 12rpx; }
.pd-pending {
  align-self: flex-start;
  font-size: var(--fs-cap);
  font-weight: 700;
  color: var(--gold-deep);
  background: rgba(176, 137, 73, 0.14);
  padding: 8rpx 20rpx;
  border-radius: var(--r-pill);
}
.cd-pending {
  font-size: var(--fs-mini);
  color: var(--gold-deep);
  margin-left: 8rpx;
}
