<view class="wm-page {{fontScale === 'lg' ? 'font-lg' : ''}}">
  <!-- 本页原来一个加载态都没有：首屏直接显示统计卡的「0 天 / 0 道 / 0 个」，
       等数据回来才跳成真实数字——和 R1 修掉的那批"把没加载完说成没有"同一类。 -->
  <state-loading visible="{{loading}}" text="正在排本周的桌…" />
  <nav-bar title="本周菜单" status-bar-height="{{statusBarHeight}}" />
  <!-- 页名只留导航栏；一行概况 + 次级「重新排」 -->
  <view class="wm-top">
    <view class="wm-top-sub">{{!loading && !loadError ? heroSub : ''}}</view>
    <view class="btn btn-ghost wm-refresh tap-scale" bindtap="regenerate" aria-role="button" aria-label="重新安排本周菜单">
      <image class="wm-refresh-ic" src="/assets/icons/lucide/refresh-cw.svg" mode="aspectFit" aria-hidden="true" />
      <text>重新排</text>
    </view>
  </view>

  <!-- 内容 sheet -->
  <view class="wm-sheet">
    <!-- 错误态必须排在 sheet 开头。原来它在七天卡片之后：本页 onShow 会静默重取，
         一旦失败，用户先看见的是 0 天 / 0 道 / 0 个的统计卡（像数据被清空了），
         而真正说明"是网络问题"的那条提示要滚到底才看得到。 -->
    <state-empty
      wx:if="{{loadError}}"
      size="compact"
      type="offline"
      title="本周菜单没加载出来"
      desc="网络开小差了，检查后再试"
      cta="重新加载"
      bind:action="retryLoad"
    />

    <block wx:if="{{!loadError && !loading}}">
    <view class="wm-weekbar" wx:if="{{weekbar.length}}">
      <view
        class="wm-wb {{item.isToday ? 'today' : ''}} {{activeIndex === item.index ? 'on' : ''}} tap-scale"
        wx:for="{{weekbar}}" wx:key="index" data-index="{{item.index}}" bindtap="onWeekTap"
        aria-role="button" aria-label="查看周{{item.short}}的菜单{{item.isToday ? '，今天' : ''}}" aria-pressed="{{activeIndex === item.index}}"
      >
        <text class="wm-wb-d">{{item.short}}</text>
        <text class="wm-wb-date">{{item.dateNumber}}</text>
        <view class="wm-wb-dot {{item.filled ? '' : 'empty'}}"></view>
      </view>
    </view>
    <!-- 统计卡 -->
    <view wx:if="{{menuSummary.recipeCount}}" class="wm-summary g-fade-up">
      <view class="wm-scell">
        <view class="wm-num">{{menuSummary.dayCount}}<text class="u">天</text></view>
        <view class="wm-cap">本周安排</view>
      </view>
      <view class="wm-scell">
        <view class="wm-num">{{menuSummary.recipeCount}}<text class="u">道</text></view>
        <view class="wm-cap">已排菜品</view>
      </view>
      <view class="wm-scell">
        <view class="wm-num {{menuSummary.blankCount ? 'pop' : ''}}">{{menuSummary.blankCount}}<text class="u">个</text></view>
        <view class="wm-cap">空位待补</view>
      </view>
    </view>

    <view class="wm-listhead"><text>逐日菜单</text></view>

    <!-- 7 个 daycard -->
    <view
      class="wm-daycard {{item.isToday ? 'today' : ''}} {{activeIndex === index ? 'chosen' : ''}} g-fade-up g-d{{index % 5 + 1}}"
      wx:for="{{weeklyMenu.days}}"
      wx:key="date"
      id="day-{{index}}"
    >
      <view class="wm-dhead">
        <view class="wm-dl">
          <text class="wm-wk">{{item.wkLabel}}</text>
          <text class="wm-dt">{{item.dateLabel}}</text>
          <text wx:if="{{item.isToday}}" class="wm-todaytag">今天</text>
        </view>
        <text class="wm-dcount {{item.recipeCount ? '' : 'mut'}}">{{item.recipeCount ? item.recipeCount + ' 道' : '还没排'}}</text>
      </view>

      <!-- 午餐 -->
      <view
        wx:if="{{item.lunch}}"
        class="wm-dish tap-scale"
        data-id="{{item.lunch.id}}"
        bindtap="onDishTap"
      >
        <image class="wm-thumb {{item.lunch.imageBroken ? 'img-broken' : ''}}" src="{{item.lunch.image}}" mode="aspectFill" lazy-load data-err-key="weeklyMenu.days[{{index}}].lunch.imageBroken" binderror="onPhotoError" />
        <view class="wm-dmid">
          <view class="wm-mealmeta"><text class="wm-slot">午餐</text><text>{{item.lunch.timeCost ? item.lunch.timeCost + ' 分钟' : '耗时未填'}}</text></view>
          <view class="wm-dname ellipsis">{{item.lunch.title}}</view>
        </view>
        <view class="wm-arr"></view>
      </view>
      <view wx:else class="wm-dish empty tap-scale" bindtap="onAddTap" aria-role="button" aria-label="为午餐挑选菜谱">
        <text class="wm-slot">午餐</text><text class="wm-et">还没安排</text><text class="wm-es">＋ 挑一道</text>
      </view>

      <!-- 晚餐 -->
      <view
        wx:if="{{item.dinner}}"
        class="wm-dish tap-scale"
        data-id="{{item.dinner.id}}"
        bindtap="onDishTap"
      >
        <image class="wm-thumb {{item.dinner.imageBroken ? 'img-broken' : ''}}" src="{{item.dinner.image}}" mode="aspectFill" lazy-load data-err-key="weeklyMenu.days[{{index}}].dinner.imageBroken" binderror="onPhotoError" />
        <view class="wm-dmid">
          <view class="wm-mealmeta"><text class="wm-slot dinner">晚餐</text><text>{{item.dinner.timeCost ? item.dinner.timeCost + ' 分钟' : '耗时未填'}}</text></view>
          <view class="wm-dname ellipsis">{{item.dinner.title}}</view>
        </view>
        <view class="wm-arr"></view>
      </view>
      <view wx:else class="wm-dish empty tap-scale" bindtap="onAddTap" aria-role="button" aria-label="为晚餐挑选菜谱">
        <text class="wm-slot dinner">晚餐</text><text class="wm-et">还没安排</text><text class="wm-es">＋ 挑一道</text>
      </view>
    </view>

    <view wx:if="{{!loading && !weeklyMenu.days.length}}" class="empty-state">
      <view class="empty-text">本周还没排菜，点上方「重新排」</view>
    </view>
    </block>

    <view class="safe-bottom"></view>
  </view>
</view>
