/* ============================================================
   pages/weekly-menu · 本周菜单「照片 hero + 七日点选 + 日卡」
   配色/工具类复用 app.wxss，禁止重定义 token
   ============================================================ */
.wm-page {
  min-height: 100vh;
  background: var(--paper);
}

.wm-refresh {
  display: flex;
  align-items: center;
  gap: 10rpx;
  box-sizing: border-box;
  min-height: 88rpx;
  padding: 18rpx 24rpx; /* 例外：这是 hero 上的按钮不是卡表面 */
  border-radius: var(--r-card); /* 实心主按钮统一 --r-card */
  background: var(--pop);
  color: var(--anchor-contrast);
  font-size: var(--fs-sub);
  font-weight: 800;
  box-shadow: var(--sh-pop);
}
.wm-refresh-ic {
  width: 26rpx;
  height: 26rpx;
  border: 4rpx solid var(--c-surface);
  border-top-color: transparent;
  border-radius: 50%;
  position: relative;
}
.wm-refresh-ic::after {
  content: "";
  position: absolute;
  top: -4rpx;
  right: -3rpx;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-bottom: 9rpx solid var(--c-surface);
  transform: rotate(40deg);
}

/* 七日选择紧跟页头；今天与当前选中日各有独立状态。 */
.wm-weekbar { display: flex; gap: 6rpx; margin-bottom: 16rpx; }
.wm-wb {
  flex: 1;
  min-width: 0;
  box-sizing: border-box;
  min-height: 88rpx;
  padding: 12rpx 0;
  text-align: center;
  border: 2rpx solid var(--c-border-light);
  border-radius: var(--r-sm);
  background: var(--c-surface);
  color: var(--ink);
}
.wm-wb.today { border-color: var(--pop); }
.wm-wb.on { background: var(--pop); border-color: var(--pop); color: var(--anchor-contrast); }
.wm-wb-d { display: block; font-size: var(--fs-cap); font-weight: 800; }
.wm-wb-date { display: block; font-size: calc(32rpx * var(--fs-mul, 1)); font-weight: 800; line-height: 1.3; margin-top: 4rpx; }
.wm-wb-dot { width: 8rpx; height: 8rpx; border-radius: 50%; background: var(--pop); margin: 10rpx auto 0; }
.wm-wb-dot.empty { background: var(--line-deep); }
.wm-wb.on .wm-wb-dot { background: var(--anchor-contrast); }
.wm-wb.on .wm-wb-dot.empty { opacity: 0.35; }
.wm-sheet { padding: 0 var(--page-gutter) calc(40rpx + env(safe-area-inset-bottom)); }

/* 统计卡 */
.wm-summary {
  display: flex;
  background: var(--c-surface);
  border: var(--bd-card);
  border-radius: var(--r-md);
  padding: 18rpx 0;
}
.wm-scell {
  flex: 1;
  min-width: 0;
  padding: 0 20rpx;
}
.wm-scell + .wm-scell { border-left: 2rpx solid var(--c-border-light); }
.wm-num {
  font-size: calc(36rpx * var(--fs-mul, 1));
  font-weight: 900;
  color: var(--ink);
  line-height: 1.2;
}
.wm-num.pop { color: var(--pop); }
.wm-num .u {
  font-size: var(--fs-cap);
  font-weight: 700;
  color: var(--mut);
  margin-left: 4rpx;
}
.wm-cap {
  font-size: var(--fs-cap);
  color: var(--mut-strong);
  font-weight: 600;
  margin-top: 8rpx;
}
.wm-listhead { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin: 24rpx 0 12rpx; font-size: var(--fs-lg); font-weight: 800; color: var(--ink); }
.wm-listhint { font-size: var(--fs-cap); color: var(--mut-strong); font-weight: 500; }
/* 日卡 */
.wm-daycard {
  background: var(--c-surface);
  border-radius: var(--r-card);
  padding: 16rpx var(--pad-card-sm) 4rpx;
  margin-bottom: 16rpx;
  border: var(--bd-card);
}
.wm-daycard.today {
  border: 2rpx solid var(--pop);
}
.wm-daycard.chosen { border-color: var(--anchor); }
.wm-dhead {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 12rpx;
  border-bottom: 2rpx solid var(--paper-2);
}
.wm-dl {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  flex-wrap: wrap;
  flex: 1;
  min-width: 0;
}
.wm-wk {
  font-size: var(--fs-sub);
  font-weight: 800;
  color: var(--ink);
  letter-spacing: -1rpx;
}
.wm-dt {
  font-size: var(--fs-cap);
  color: var(--mut);
  font-weight: 600;
}
.wm-todaytag {
  font-size: var(--fs-tiny);
  font-weight: 800;
  letter-spacing: 2rpx;
  color: var(--anchor-contrast);
  background: var(--pop);
  padding: 6rpx 16rpx;
  border-radius: var(--r-pill);
}
.wm-dcount {
  font-size: var(--fs-cap);
  font-weight: 700;
  color: var(--gold-deep);
}
.wm-dcount.mut { color: var(--mut); }

/* 菜行 */
.wm-dish {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 0;
  border-bottom: 2rpx solid var(--c-border-light);
}
.wm-dish:last-child { border-bottom: none; }
.wm-slot {
  font-size: var(--fs-mini);
  font-weight: 700;
  color: var(--pine);
  background: var(--c-accent-soft);
  padding: 2rpx 8rpx;
  border-radius: var(--r-xs);
  flex: none;
}
.wm-slot.dinner { background: var(--pop-soft); color: var(--pop-deep); }
.wm-mealmeta { display: flex; align-items: center; gap: 12rpx; font-size: var(--fs-mini); color: var(--mut-strong); margin-bottom: 6rpx; }
.wm-thumb {
  width: var(--tile-row-sm);
  height: var(--tile-row-sm);
  border-radius: var(--r-sm);
  flex: none;
  background: var(--paper-2);
}
.wm-dmid {
  flex: 1;
  min-width: 0;
}
.wm-dname {
  font-size: calc(32rpx * var(--fs-mul, 1));
  font-weight: 800;
  color: var(--ink);
  line-height: 1.4;
  white-space: normal;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  word-break: break-all;
}
.wm-arr {
  width: 18rpx;
  height: 18rpx;
  border-top: 4rpx solid var(--mut-2);
  border-right: 4rpx solid var(--mut-2);
  transform: rotate(45deg);
  flex: none;
}
/* 空餐次是一条可点的补位入口，不占用菜品图片的面积。 */
.wm-dish.empty { min-height: 88rpx; box-sizing: border-box; }
.wm-et {
  flex: 1;
  font-size: var(--fs-sub);
  color: var(--mut);
}
.wm-es {
  font-size: var(--fs-sub);
  font-weight: 700;
  color: var(--pop-deep);
}
