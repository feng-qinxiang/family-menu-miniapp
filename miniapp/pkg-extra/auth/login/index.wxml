<!-- pages/auth/login/index · 登录落地页（hero + 微信一键登录 + 手机号 + 游客） -->
<view class="login-page {{fontScale === 'lg' ? 'font-lg' : ''}}">
  <scroll-view class="login-scroll" scroll-y enhanced show-scrollbar="{{false}}">

    <!-- Hero -->
    <view class="hero">
      <image class="hero-img" src="{{heroImage}}" mode="aspectFill" binderror="onHeroImageError" />
      <view class="hero-mask"></view>

      <view class="brandbar g-fade-down g-d1">
        <view class="logo">
          <text class="logo-glyph">家</text>
        </view>
        <view class="bt">
          <text class="en">家庭点菜系统</text>
          <text class="cn">家庭点菜</text>
        </view>
      </view>

      <view class="hero-body">
        <text class="tag g-fade-up g-d2">欢迎回家</text>
        <view class="hero-title title-stroke g-fade-up g-d3">今天吃什么<text class="br"></text>一家人<text class="pop">说了算</text></view>
      </view>
    </view>

    <!-- Sheet -->
    <view class="sheet g-fade-up g-d4">
      <button class="btn-wx login-wx tap-scale" hover-class="none" bindtap="onWechatLogin">
        <text class="wx-glyph">✦</text>
        微信一键登录
      </button>

      <view class="btn-phone tap-scale" wx:if="{{features.PHONE_LOGIN}}" bindtap="onPhoneLogin">
        <text class="phone-glyph">▢</text>
        手机号登录
      </view>

      <view class="guest">
        <text class="guest-link hit-88 tap-scale" aria-role="button" bindtap="onGuest">先随便逛逛 ›</text>
      </view>

      <view class="divider-deco">
        <view class="ln"></view>
        <text class="dt">为什么选择家庭点菜</text>
        <view class="ln"></view>
      </view>

      <view class="trust">
        <view class="ti" wx:for="{{trustList}}" wx:key="h">
          <view class="tic"><image class="tic-ic" src="/assets/icons/lucide/{{item.icon}}.svg" mode="aspectFit" aria-hidden="true" /></view>
          <view class="ttx">
            <text class="th">{{item.h}}</text>
            <text class="ts">{{item.s}}</text>
          </view>
        </view>
      </view>

      <view class="tap-scale agree" bindtap="onToggleAgree">
        <view class="tap-scale box {{agreed ? 'on' : ''}}" aria-role="checkbox" aria-checked="{{agreed}}" aria-label="同意用户协议与隐私政策">
          <text wx:if="{{agreed}}" class="check">✓</text>
        </view>
        <view class="tx">
          登录即表示你已阅读并同意
          <text class="tap-scale lk" catchtap="onTerms">用户协议</text>
          与
          <text class="tap-scale lk" catchtap="onPrivacy">隐私政策</text>
          ，我们仅用微信昵称和头像帮你和家人互相认出。
        </view>
      </view>
    </view>
  </scroll-view>

  <state-toast
    visible="{{toast.visible}}"
    text="{{toast.text}}"
    type="top"
    bind:close="onToastClose"
  ></state-toast>
</view>
