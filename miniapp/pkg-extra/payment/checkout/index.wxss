.pay-page { height: 100vh; display: flex; flex-direction: column; background: var(--paper); color: var(--ink); }
.pay-scroll { flex: 1; min-height: 0; }
.pay-content { padding: 12rpx var(--page-gutter) 40rpx; }
.pay-steps { display: flex; justify-content: space-between; gap: 12rpx; margin: 16rpx 0 28rpx; font-size: var(--fs-cap); color: var(--mut-strong); line-height: 1.5; }
.pay-steps .on { color: var(--pine); font-weight: 700; }
.merchant { padding: 28rpx; background: var(--c-surface); border: var(--bd-card); }
.pay-plan-top { display: flex; align-items: center; gap: 18rpx; }
.mlogo { display: flex; align-items: center; justify-content: center; flex: none; width: 92rpx; height: 92rpx; background: var(--pine); color: var(--anchor-contrast); font-size: var(--fs-h2); font-weight: 800; border-radius: var(--r-md); }
.pay-plan-copy { flex: 1; min-width: 0; }
.mname { color: var(--mut-strong); font-size: var(--fs-cap); }
.msub { font-size: var(--fs-lg); font-weight: 800; margin-top: 6rpx; line-height: 1.5; word-break: break-all; }
.pay-selected { flex: none; padding: 6rpx 12rpx; color: var(--pine); background: var(--c-accent-soft); border-radius: var(--r-xs); font-size: var(--fs-mini); }
.pay-plan-bottom { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 12rpx; border-top: var(--bd-card); margin-top: 24rpx; padding-top: 22rpx; color: var(--mut-strong); font-size: var(--fs-sub); }
.sym { font-size: var(--fs-lg); color: var(--ink); margin-right: 4rpx; }
.big { font-size: var(--fs-stat); font-weight: 800; color: var(--ink); }
.pay-section-title { margin: 28rpx 0 14rpx; font-size: var(--fs-lg); font-weight: 700; }
.rows { padding: 6rpx 24rpx; }
.row { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; padding: 22rpx 0; border-bottom: var(--bd-card); font-size: var(--fs-sub); line-height: 1.5; }
.row:last-child { border: 0; }
.lbl { flex: none; color: var(--mut-strong); }
.val { min-width: 0; text-align: right; word-break: break-all; }
.pay-total { font-weight: 700; }
.val-pay { color: var(--pop-deep); }
.paymethod { display: flex; align-items: center; gap: 18rpx; padding: 24rpx; }
.pm-icon { display: flex; align-items: center; justify-content: center; flex: none; width: 76rpx; height: 76rpx; border-radius: var(--r-md); color: var(--anchor-contrast); background: var(--wx); font-size: var(--fs-lg); font-weight: 700; }
.pm-info { flex: 1; min-width: 0; }
.pm-name { font-size: var(--fs-sub); font-weight: 700; }
.pm-note { font-size: var(--fs-cap); color: var(--mut-strong); margin-top: 6rpx; line-height: 1.5; }
.pm-check { flex: none; color: var(--pine); font-size: var(--fs-lg); font-weight: 800; }
.pay-note { margin: 24rpx 4rpx 0; font-size: var(--fs-cap); color: var(--mut-strong); line-height: 1.6; }
.payarea { display: flex; align-items: center; gap: 20rpx; flex: none; padding: 20rpx var(--page-gutter) calc(20rpx + env(safe-area-inset-bottom)); background: var(--c-surface); border-top: var(--bd-card); }
.pay-due { flex: 1; min-width: 0; font-size: var(--fs-cap); color: var(--mut-strong); }
.pay-due view { color: var(--ink); font-size: var(--fs-sub); margin-top: 4rpx; }
.pay-due view text { font-size: var(--fs-h2); font-weight: 800; word-break: break-all; }
.btn-pay { flex: 1; display: flex; align-items: center; justify-content: center; min-height: 96rpx; min-width: 0; padding: 16rpx; margin: 0; font-size: var(--fs-sub); font-weight: 700; line-height: 1.5; color: var(--anchor-contrast); background: var(--pine); border-radius: var(--r-md); }
.btn-pay::after { border: 0; }
.btn-pay.is-unavailable { color: var(--mut-strong) !important; background: var(--paper-2) !important; }
