<view class="pay-page {{fontScale === 'lg' ? 'font-lg' : ''}}">
  <nav-bar title="开通确认" show-back="{{true}}" />
  <scroll-view class="pay-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="pay-content">
      <view class="pay-steps"><text>01 选择套餐</text><text class="on">02 确认开通</text><text>03 完成</text></view>
      <view class="merchant card">
        <view class="pay-plan-top"><view class="mlogo">家</view><view class="pay-plan-copy"><view class="mname">{{merchantName}}</view><view class="msub">{{productName}}</view></view><text class="pay-selected">已选套餐</text></view>
        <view class="pay-plan-bottom"><text>{{durationDays}} 天服务期</text><view><text class="sym">¥</text><text class="big">{{payAmount}}</text></view></view>
      </view>
      <view class="pay-section-title">订单明细</view>
      <view class="rows card">
        <view class="row"><text class="lbl">开通套餐</text><text class="val">{{productName}}</text></view>
        <view class="row"><text class="lbl">服务时长</text><text class="val">{{durationDays}} 天</text></view>
        <view class="row"><text class="lbl">套餐金额</text><text class="val">¥{{payAmount}}</text></view>
        <view class="row pay-total"><text class="lbl">应付金额</text><text class="val val-pay">¥{{payAmount}}</text></view>
      </view>
      <view class="pay-section-title">支付方式</view>
      <view class="paymethod card"><view class="pm-icon">微</view><view class="pm-info"><view class="pm-name">微信支付</view><view class="pm-note">在微信支付页面选择付款方式</view></view><view class="pm-check">✓</view></view>
      <view class="pay-note">{{paymentEnabled ? '请核对套餐和金额，确认后进入支付。' : '会员开通暂未开放。'}}</view>
    </view>
  </scroll-view>
  <view class="payarea safe-bottom">
    <view class="pay-due"><text>应付</text><view>¥ <text>{{payAmount}}</text></view></view>
    <button class="btn-pay tap-scale {{paying ? 'is-paying' : ''}} {{!paymentEnabled ? 'is-unavailable' : ''}}" disabled="{{paying || !paymentEnabled}}" bindtap="onPay">{{!paymentEnabled ? '暂未开放' : (paying ? '开通中…' : '确认开通')}}</button>
  </view>
  <state-toast visible="{{toast.visible}}" type="{{toast.type}}" text="{{toast.text}}" duration="1600" bind:close="onToastClose" />
</view>
