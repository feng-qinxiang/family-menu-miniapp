/* ============================================================
   pages/recipe-detail · 头图后连续阅读，用料左图右文
   配色/工具类复用 app.wxss，本文件仅页面特有结构
   ============================================================ */
.rd-page {
  position: relative;
  min-height: 100vh;
  background: var(--paper);
}
.rd-scroll {
  height: 100vh;
}

/* ===== Hero 大图 ===== */
.rd-hero {
  position: relative;
  height: 430rpx;
  min-height: 320rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
/* 没照片：占位图是方的，完整摆在中间，两边用占位图自己的底色补齐 */
.rd-hero--plain { background: #e5e1da; }
.rd-hero-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.rd-hero-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(20, 14, 8, 0.5), transparent 60%);
}

.rd-intro { padding-bottom: 28rpx; margin-bottom: 16rpx; border-bottom: var(--bd-card); }
.rd-title-row { display: flex; align-items: flex-start; gap: 16rpx; }
.rd-title-row .rd-title { flex: 1; min-width: 0; }
.rd-edit { flex: none; color: var(--mut-strong); }
.rd-title { font-size: var(--fs-h1); font-weight: 700; line-height: 1.35; word-break: break-all; }
.rd-meta text + text::before { content: "·"; margin-right: 12rpx; }
.rd-meta { display: flex; flex-wrap: wrap; gap: 8rpx 12rpx; font-size: var(--fs-sub); color: var(--mut-strong); line-height: 1.5; margin-top: 16rpx; }
.rd-summary { font-size: var(--fs-body); color: var(--ink); line-height: 1.7; margin-top: 20rpx; }
.rd-section-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12rpx 20rpx; margin-bottom: 16rpx; }
.rd-section-head > view:first-child { display: flex; flex-wrap: wrap; align-items: baseline; gap: 16rpx; }
/* 与同页 section-head（家人评价/大家晒的）同一字重：同级标题原来 600 对 800，并排看一轻一重 */
.rd-section-title { font-size: var(--fs-h2); font-weight: 800; line-height: 1.5; }
.rd-stock-count, .rd-method-count { font-size: var(--fs-cap); color: var(--mut-strong); }
.rd-method-head { margin-top: 36rpx; }

/* 圆形份量 stepper */
.rd-srv {
  display: inline-flex;
  align-items: center;
  flex: none;
  background: var(--paper-2);
  border-radius: var(--r-md);
}
.rd-sbtn {
  width: var(--tap-min);
  height: var(--tap-min);
  border-radius: var(--r-md);
  display: flex;
  align-items: center;
  justify-content: center;
}
.rd-sbtn.is-disabled { opacity: 0.35; }
.rd-sbtn.is-disabled:active { transform: none; }
.rd-sbtn-minus,
.rd-sbtn-plus {
  position: relative;
  width: 24rpx;
  height: 5rpx;
  background: var(--ink);
  border-radius: 3rpx;
}
.rd-sbtn-plus::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 5rpx;
  height: 24rpx;
  background: var(--ink);
  border-radius: 3rpx;
}
.rd-sval {
  font-size: var(--fs-cap);
  font-weight: 700;
  color: var(--ink);
  min-width: 80rpx;
  text-align: center;
}
/* ===== Sheet ===== */
.rd-sheet {
  position: relative;
  margin-top: 0;
  background: var(--paper);
  padding: 32rpx 32rpx calc(240rpx + env(safe-area-inset-bottom));
  z-index: 5;
}
.rd-card { margin: 0; }

.rd-empty-mini {
  color: var(--mut);
  font-size: calc(25rpx * var(--fs-mul, 1));
  text-align: center;
  padding: 48rpx 28rpx;
}

/* —— 食材行 —— */
.rd-ing {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 16rpx 0;
  border-bottom: 2rpx solid var(--paper-2);
}
.rd-ing:last-child { border-bottom: none; }
.rd-dot {
  display: inline-block;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex: none;
}
.rd-dot.have { background: var(--pine); }
.rd-dot.miss { background: var(--pop-fill); }
/* flex:1 不给 min-width:0 时，长食材名拒绝收缩，会把右边的用量顶出卡片右缘 */
.rd-iname { flex: 1; min-width: 0; }
.rd-iname-h {
  font-size: calc(28rpx * var(--fs-mul, 1));
  font-weight: 800;
  color: var(--ink);
  /* 原来有 letter-spacing: -0.4rpx——28rpx 的中文上收 0.4rpx 看不出紧凑，
     只让最后一个字的右侧空隙变得不均匀。全站同类微负值一并去掉。 */
  line-height: 1.5;
  word-break: break-all;
}
.rd-note {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: calc(23rpx * var(--fs-mul, 1));
  color: var(--mut-strong);
  margin-top: 4rpx;
}
.rd-note.miss { color: var(--pop); font-weight: 600; }
.rd-ingredient-top { display: flex; align-items: baseline; justify-content: space-between; gap: 20rpx; }
.rd-ingredient-top .rd-iname-h { flex: 1; min-width: 0; font-weight: 600; }
.rd-amt {
  flex: none;
  max-width: 45%;
  font-size: var(--fs-cap);
  font-weight: 600;
  color: var(--ink-deep);
  margin: 0;
  text-align: right;
  line-height: 1.5;
  word-break: break-all;
}
.rd-photo-hint { font-size: var(--fs-cap); color: var(--mut-strong); line-height: 1.5; padding-bottom: 8rpx; }
.rd-photo-hint--foot { padding: 16rpx 0 0; }
.rd-ingredient-photo { position: relative; flex: none; width: var(--tile-row-sm); height: var(--tile-row-sm); background: var(--paper-2); border-radius: var(--r-sm); overflow: hidden; }
.rd-ingredient-image { display: block; width: 100%; height: 100%; }
/* 无照片时只露首字，不与右侧全名重复 */
.rd-ingredient-text { box-sizing: border-box; display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; padding: 4rpx 8rpx; font-size: var(--fs-lg); font-weight: 700; color: var(--pine-ink); line-height: 1.2; }
.rd-ingredient-label { overflow: hidden; }

/* 加入买菜清单按钮：同屏只留一颗实心红（底栏「开始做菜」），这里降为浅红底次按钮。
   保留红系是因为它说的是「缺料/待采购」（与 .rd-note.miss 同义）。 */
.rd-ing-cart { padding: 0 0 22rpx; }
.rd-cart-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  min-height: 92rpx;
  border-radius: var(--r-card);
  background: var(--pop-soft);
  color: var(--pop-deep);
  font-size: calc(28rpx * var(--fs-mul, 1));
  font-weight: 800;
}
.rd-cnum {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 42rpx;
  height: 42rpx;
  padding: 0 12rpx;
  border-radius: 21rpx;
  background: var(--c-surface);   /* 按钮改浅红底后，原来的白 .25 叠在浅底上看不出胶囊 */
  font-size: calc(25rpx * var(--fs-mul, 1));
  font-weight: 900;
}

/* —— 做法视频 —— */
.rd-video {
  position: relative;
  height: 320rpx;
  margin: 0 0 8rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: var(--anchor);
}
.rd-video-poster,
.rd-video-player {
  width: 100%;
  height: 100%;
  display: block;
}
.rd-video-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, transparent 38%, rgba(28, 22, 16, 0.58));
}
.rd-video-play {
  position: absolute;
  left: 50%;
  top: 46%;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.94);
  display: flex;
  align-items: center;
  justify-content: center;
  transform: translate(-50%, -50%);
}
.rd-ic-play-lg {
  /* 播放圆底是恒定的白（压在视频封面上，不随主题翻转），三角必须用恒定深色：
     原先的 --ink-deep 深色档翻成 #e2e2e2，白圆里放一个白三角 = 播放键看起来是空的 */
  border-left-color: var(--anchor);
  margin-left: 8rpx;
}
.rd-video-meta {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 20rpx;
  color: #fff;
}
.rd-video-kicker {
  display: block;
  font-size: calc(23rpx * var(--fs-mul, 1));
  font-weight: 700;
  opacity: 0.86;
}
.rd-video-sub {
  display: block;
  margin-top: 4rpx;
  font-size: calc(28rpx * var(--fs-mul, 1));
  font-weight: 800;
}

/* —— 做法步骤 —— */
.rd-step {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--paper-2);
}
.rd-step:last-child { border-bottom: none; }
.rd-sno {
  width: 48rpx;
  height: 48rpx;
  border-radius: var(--r-sm);
  background: var(--paper-2);
  color: var(--pine-ink);
  font-size: var(--fs-sub);
  font-weight: 600;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
}
.rd-stx { flex: 1; min-width: 0; padding-top: 2rpx; }
.rd-stx-p {
  font-size: calc(28rpx * var(--fs-mul, 1));
  line-height: 1.55;
  color: var(--ink);
}
.rd-step-img {
  width: 100%;
  height: var(--photo-step-h);
  margin-top: 18rpx;
  border-radius: 20rpx;
  background: var(--paper-2);
}
.rd-tip {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 16rpx;
  font-size: calc(23rpx * var(--fs-mul, 1));
  font-weight: 700;
  /* 小号提示字用 --mut-strong：--gold-deep 在 --paper-2 上约 3.0:1，偏淡；金色留给左侧星标 */
  color: var(--mut-strong);
  background: var(--paper-2);
  padding: 10rpx 20rpx;
  border-radius: var(--r-chip);
}

/* —— 评价 —— */
.rd-rev {
  display: flex;
  gap: 25rpx;
  padding: 28rpx 0;
  border-bottom: 2rpx solid var(--paper-2);
}
.rd-av {
  width: 80rpx;
  height: 80rpx;
  border-radius: 26rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: calc(28rpx * var(--fs-mul, 1));
  font-weight: 900;
  color: var(--anchor-contrast);
  font-family: var(--serif);
}
.rd-rc { flex: 1; }
.rd-rtop {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
/* 昵称可能很长（微信允许 16 字），不收缩就会把右侧时间挤出屏幕 */
.rd-who { font-size: calc(28rpx * var(--fs-mul, 1)); font-weight: 800; color: var(--ink); min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; margin-right: 12rpx; }
.rd-when { font-size: var(--fs-mini); color: var(--mut); flex: none; }
.rd-stars { display: flex; gap: 4rpx; margin: 8rpx 0 12rpx; }
.rd-star {
  width: 24rpx;
  height: 24rpx;
  background: var(--c-border);
  clip-path: polygon(50% 0, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
}
.rd-star.on { background: var(--pop-fill); }
.rd-cm { font-size: var(--fs-sub); line-height: 1.5; color: var(--mut); }

/* 写评价入口 */
.rd-rev-entry {
  display: flex;
  align-items: center;
  gap: 21rpx;
  padding: 28rpx 0 8rpx;
  border-top: 2rpx solid var(--paper-2);
  margin-top: 6rpx;
}
.rd-rev-entry.no-top { border-top: none; margin-top: 0; padding-top: 8rpx; }
/* 上一行（评价/作品）自带底线，入口再画顶线就是两条线叠着 */
.rd-rev + .rd-rev-entry, .rd-work + .rd-rev-entry { border-top: none; margin-top: 0; }
.rd-meav {
  width: 80rpx;
  height: 80rpx;
  border-radius: 26rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: calc(28rpx * var(--fs-mul, 1));
  font-weight: 900;
  color: var(--anchor-contrast);
  font-family: var(--serif);
  background: var(--pop-fill);
}
.rd-fakein {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: var(--r-card);   /* 嵌在 --r-card 卡里：原来 26rpx 比外卡还圆 */
  background: var(--paper-2);
  border: 2rpx solid var(--c-border);
  padding: 0 var(--pad-card);
  font-size: var(--fs-sub);
  color: var(--mut-strong);
  font-weight: 600;
}
.rd-gobtn {
  flex: none;
  min-width: 100rpx;
  height: 88rpx;
  border-radius: var(--r-card);
  background: var(--anchor);
  color: var(--gold-on-dark);
  font-size: var(--fs-sub);
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* —— 大家晒的（这道菜的社区作品） ——
   一行一件：左边帖首图（没配图时退成作者首字，不留空洞），右边标题 + 作者/赞数。 */
.rd-work {
  display: flex;
  align-items: center;
  gap: 21rpx;
  padding: 22rpx 0;
  border-bottom: 2rpx solid var(--paper-2);
}
.rd-work-thumb {
  flex: none;
  width: var(--dish-thumb);
  height: var(--dish-thumb);
  border-radius: var(--r-sm);   /* 嵌在 --r-card 卡里，圆角不能比外卡大 */
}
.rd-work-thumb--none {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--paper-2);
  color: var(--mut-strong);
  font-family: var(--serif);
  font-size: calc(36rpx * var(--fs-mul, 1));
  font-weight: 900;
}
.rd-work-body {
  flex: 1;
  min-width: 0;
}
.rd-work-title {
  color: var(--ink);
  font-size: calc(28rpx * var(--fs-mul, 1));
  font-weight: 700;
  line-height: 1.4;
}
.rd-work-meta {
  margin-top: 10rpx;
  color: var(--mut-strong);
  font-size: calc(23rpx * var(--fs-mul, 1));
}
/* ===== 底部 footbar ===== */
.rd-footbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 50;
  display: flex;
  gap: 16rpx;
  padding: 40rpx 30rpx calc(24rpx + env(safe-area-inset-bottom));
  padding-top: 20rpx;
  background: var(--paper);
  border-top: 2rpx solid var(--line);
}
.rd-ghost-btn {
  flex: none;
  width: 156rpx;
  height: 104rpx;
  border-radius: var(--r-card);   /* 底栏三键统一 --r-card（实心主按钮约定，同排次按钮跟随） */
  background: var(--paper-2);
  color: var(--ink-deep);
  font-size: calc(25rpx * var(--fs-mul, 1));
  font-weight: 800;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  border: 2rpx solid var(--c-border);
}
/* 主按钮 = 开始做菜（做饭动线入口，占满剩余宽度） */
.rd-primary-btn {
  flex: 1;
  height: 104rpx;
  border-radius: var(--r-card);
  background: var(--pop-fill);
  color: var(--anchor-contrast);
  font-size: calc(28rpx * var(--fs-mul, 1));
  font-weight: 900;
  letter-spacing: 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: var(--sh-pop);
}
/* 次按钮 = 加菜单（窄条，保持加入中/已加入状态反馈） */
.rd-secondary-btn {
  flex: none;
  width: 170rpx;
  height: 104rpx;
  border-radius: var(--r-card);
  background: var(--paper-2);
  color: var(--ink-deep);
  border: 2rpx solid var(--c-border);
  font-size: calc(25rpx * var(--fs-mul, 1));
  font-weight: 800;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}
/* 请求进行中：压暗提示不可重复点 */
.rd-secondary-btn--busy {
  opacity: 0.6;
}
/* 已在今日菜单：松绿描边 + 对勾，与"待加入"深色底区分 */
.rd-secondary-btn--added {
  background: var(--paper-2);
  color: var(--pine-ink);
  border: 2rpx solid var(--pine);
}
.rd-secondary-btn--added .rd-ic-check {
  border-left-color: var(--pine);
  border-bottom-color: var(--pine);
}

/* ===== 悬浮快捷键（回顶/退出）：右侧竖排，避开底部操作栏 ===== */
.rd-topbar { position: fixed; top: 0; left: 0; right: 0; z-index: 50; }
.rd-topbar.solid { background: var(--paper); box-shadow: 0 2rpx 0 var(--line); }
.rd-quicknav {
  position: fixed;
  right: 20rpx;
  bottom: calc(360rpx + env(safe-area-inset-bottom));
  z-index: 60;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}
.rd-qbtn {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  /* 轻微半透明：悬浮在内容上时不完全遮字 */
  background: var(--glass);
  border: 2rpx solid var(--c-border);
  box-shadow: 0 10rpx 30rpx rgba(60, 40, 20, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
}
/* 上箭头（chevron） */
.rd-qic-up {
  width: 26rpx;
  height: 26rpx;
  border-left: 5rpx solid var(--ink-deep);
  border-top: 5rpx solid var(--ink-deep);
  transform: rotate(45deg) translate(4rpx, 4rpx);
  border-radius: 2rpx;
}
/* ===== 纯 CSS 图标 ===== */
.rd-ic { position: relative; flex: none; }
/* 加号 */
.rd-ic-plus {
  width: 32rpx; height: 32rpx;
}
.rd-ic-plus::before, .rd-ic-plus::after {
  content: ""; position: absolute; left: 50%; top: 50%; background: currentColor; border-radius: 3rpx;
}
/* 加号跟随所在按钮文字色（次按钮深色底→金色，主按钮红底→白色） */
.rd-ic-plus { color: currentColor; }
.rd-ic-plus::before { width: 30rpx; height: 5rpx; transform: translate(-50%, -50%); }
.rd-ic-plus::after { width: 5rpx; height: 30rpx; transform: translate(-50%, -50%); }
/* 对勾 */
.rd-ic-check {
  width: 34rpx; height: 22rpx;
  border-left: 5rpx solid var(--ink-deep);
  border-bottom: 5rpx solid var(--ink-deep);
  transform: rotate(-45deg) translateY(-4rpx);
  border-radius: 2rpx;
}
/* 播放三角：跟随所在按钮文字色（主按钮红底白字→白色三角） */
.rd-ic-play {
  width: 0; height: 0;
  border-left: 24rpx solid currentColor;
  border-top: 14rpx solid transparent;
  border-bottom: 14rpx solid transparent;
}
/* 星形 tip */
.rd-ic-star {
  width: 22rpx; height: 22rpx; background: var(--gold-deep);
  clip-path: polygon(50% 0, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
}

/* ===== 加载骨架 ===== */
/* 高度沿用 rd-hero，加载前后保持一致。 */
.rd-hero-skel {
  background: linear-gradient(135deg, var(--paper-2), var(--c-border-light));
}
.rd-skel-row { display: flex; align-items: center; gap: 24rpx; padding: 24rpx 0; }
.rd-skel-dot { width: 80rpx; height: 80rpx; border-radius: var(--r-md); flex: none; }
.rd-skel-line { flex: 1; height: 32rpx; border-radius: var(--r-sm); }

/* ===== 空态 ===== */
.rd-empty-page { padding-top: 0; }

/* ===== 深色档 ===== */
/* --gold 深色档翻成 #8a6a3a，压在 --anchor 上看不清（旧深色 --anchor #3a2e23 上约 2.6:1，
   深色档提亮后的 #866a50 上约 1:1）。深色档改用恒定浅字 --anchor-contrast（两种 --anchor 上都 ≥4.7:1）；
   浅色档不进这条，金字观感不变。「已在菜单」态自己换了底色和字色，必须排除，否则会被这里盖掉。 */
@media (prefers-color-scheme: dark) {
  .rd-gobtn { color: var(--anchor-contrast); }
}
