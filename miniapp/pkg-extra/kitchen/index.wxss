/* pages/kitchen/index.wxss · 厨房总控 */
.kitchen {
  min-height: 100vh;
  background: var(--paper);
  /* 左右留白原来偷偷用 26rpx，全站其它页都是 46rpx——同一排卡片在这页明显更宽。
     底部必须含安全区，否则最后一张灶台卡的操作行压在 home indicator 上。 */
  padding: 0 46rpx calc(env(safe-area-inset-bottom) + 40rpx);
  box-sizing: border-box;
}
.k-nav { display: block; margin: 0 -46rpx; }   /* 导航栏不吃页面左右留白，返回键与其它二级页同位 */

/* —— 加载态 —— */
.k-loading {
  padding: 120rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 22rpx;
}
.k-loading-tx {
  font-size: var(--fs-sub);
  color: var(--mut);
}
.spinner {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 6rpx solid var(--paper-2);
  border-top-color: var(--pop);
  animation: k-spin 0.9s linear infinite;
}
@keyframes k-spin {
  to { transform: rotate(360deg); }
}

/* —— 顶部：餐次 chips + 进度 —— */
.k-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 18rpx;
}
.k-slots {
  display: flex;
  gap: 14rpx;
  flex: 1;
  min-width: 0;
  flex-wrap: wrap;
}
.k-slot {
  min-height: 88rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  border-radius: var(--r-pill);
  background: var(--paper-2);
  font-size: calc(28rpx * var(--fs-mul, 1));
  font-weight: 700;
  color: var(--mut-strong);
}
.k-slot.on {
  background: var(--pop-soft);
  color: var(--pop-deep);
}
.k-slot-n {
  margin-left: 8rpx;
  font-size: var(--fs-mini);
  opacity: 0.7;
}
.k-progress {
  flex: none;
  font-size: var(--fs-cap);
  color: var(--mut-strong);
  font-weight: 700;
}

/* —— 顺序建议 —— */
.k-order {
  margin-top: 20rpx;
  padding: 20rpx 26rpx;
  background: rgba(200, 56, 31, 0.07);
  border: 2rpx solid rgba(200, 56, 31, 0.14);
  border-radius: var(--r-card, 16rpx);
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}
/* 原来这里是一枚 💡。换成一个纯排版的「建议」标签：
   26rpx 的灯泡用 CSS 画出来在截图里读作"气球"，而彩色 emoji 吃不到 color、
   不跟深色档翻——标签既是单色可着色，又比小图标更好认。 */
.k-order-tag {
  font-size: calc(23rpx * var(--fs-mul, 1));
  line-height: 1.55;
  font-weight: 800;
  letter-spacing: 1rpx;
  color: var(--pop);
  flex: none;
}
.k-order-tx {
  font-size: calc(25rpx * var(--fs-mul, 1));
  line-height: 1.55;
  color: var(--mut-strong);
  font-weight: 600;
}

/* —— 灶台卡片 —— */
.k-list {
  margin-top: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.k-card {
  position: relative;
  display: flex;
  flex-direction: column;
  background: var(--c-surface);
  border: var(--bd-card);
  border-radius: var(--r-card, 16rpx);
  padding: 24rpx;
  box-sizing: border-box;
  overflow: hidden;
}
.k-card.main {
  border-color: var(--pop);
}
.k-card.is-done {
  opacity: 0.62;
}
.k-img {
  flex: none;
  width: var(--tile-list-wide);
  height: var(--tile-list-tall);
  border-radius: var(--r-sm);   /* 嵌在 --r-card 卡里：原来 --r-md(24rpx) 比外卡还圆 */
  background: var(--paper);
}
.k-main-flag {
  background: var(--pop-soft);
  color: var(--pop-deep);
  font-size: var(--fs-cap);
  font-weight: 800;
  padding: 4rpx 12rpx;
  border-radius: var(--r-xs);
}
.k-card-head { display: flex; align-items: flex-start; gap: 20rpx; }
.k-status-row { display: flex; flex-wrap: wrap; align-items: center; gap: 10rpx; margin-top: 10rpx; }
.k-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.k-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.k-title {
  flex: 1;
  min-width: 0;
  font-size: calc(32rpx * var(--fs-mul, 1));
  font-weight: 800;
  color: var(--ink);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  word-break: break-all;
}
.k-tag {
  flex: none;
  font-size: var(--fs-cap);
  font-weight: 800;
  padding: 4rpx 12rpx;
  border-radius: var(--r-xs);
}
.k-tag.todo {
  background: rgba(176, 137, 73, 0.14);
  color: var(--gold-deep);
}
.k-tag.cooking {
  background: rgba(200, 56, 31, 0.12);
  color: var(--pop);
}
.k-tag.done {
  background: rgba(47, 74, 58, 0.12);
  color: var(--pine-ink);
}
.k-meta {
  margin-top: 8rpx;
  font-size: var(--fs-cap);
  color: var(--mut-strong);
  line-height: 1.5;
}

/* —— 计时行 —— */
.k-timer {
  margin-top: 14rpx;
  padding: 12rpx;
  background: var(--paper);
  border-radius: var(--r-sm);   /* 嵌套面板不比外卡圆 */
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  flex-wrap: wrap;
}
.k-timer-copy { flex: 1 1 100%; min-width: 0; display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 6rpx; }
.k-timer-label { color: var(--mut-strong); font-size: var(--fs-cap); line-height: 1.5; }
.k-clock {
  display: block;
  font-size: calc(40rpx * var(--fs-mul, 1));
  font-weight: 800;
  font-variant-numeric: tabular-nums;
  color: var(--ink);
  letter-spacing: 2rpx;
}
.k-clock.running {
  color: var(--pop);
}
.k-tbtns {
  display: flex;
  flex: 1 1 100%;
  gap: 10rpx;
}
.k-tbtn {
  flex: 1;
  min-width: 0;
  min-height: 88rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 8rpx;
  line-height: 1.5;
  text-align: center;
  border-radius: var(--r-sm);   /* 与外层 .k-timer 同档，不再比它圆 */
  background: var(--pop-soft);
  color: var(--pop-deep);
  font-size: var(--fs-cap);
  font-weight: 800;
}
.k-tbtn.ghost {
  background: transparent;
  /* 原先写死 rgba(0,0,0,.14)：深色档它就是"深底上加一点更黑"，幽灵按钮直接看不见边框。
     --line-deep 浅色 #d5c9b8（与原像素几乎一致）、深色 #3a3a3a，两档都成立 */
  border: 2rpx solid var(--line-deep);
  color: var(--mut-strong);
}

/* —— 动作行 —— */
.k-acts {
  margin-top: 14rpx;
  display: flex;
  gap: 14rpx;
}
.k-act {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  /* 开做/上桌是厨房总控最主要的一步，高度抬到 88rpx 命中标准；
     两键横向 flex:1 且留有 14rpx 间距，加高不会互相误触 */
  min-height: 88rpx;
  /* 实心主按钮统一 --r-card（项目约定：只有小 chip/标签保留胶囊） */
  border-radius: var(--r-card);
  font-size: calc(28rpx * var(--fs-mul, 1));
  font-weight: 800;
  box-sizing: border-box;
}
.k-act.primary {
  background: var(--anchor);
  color: var(--anchor-contrast);
}
/* 同屏只留一颗实心红：只有主灶那张卡的「开做/继续做」用 --pop，其余卡降为深色锚点
   （与菜单页 .m-act-cook 同一做法）。主灶一定是未上桌的菜，所以有菜可做时恰好一颗红。 */
.k-card.main .k-act.primary {
  background: var(--pop-fill);
}
.k-act.ghost {
  border: 2rpx solid var(--line-deep);
  color: var(--mut-strong);
  background: transparent;
}

/* —— 全上桌横幅 —— */
.k-done-banner {
  margin-top: 26rpx;
  padding: 30rpx;
  border-radius: var(--r-card, 16rpx);
  /* 恒定深底配恒定浅字：原来底用 --ink，深色档翻成 #efefef，压着恒定浅色字 = 整条横幅没字 */
  background: var(--anchor);
  color: var(--anchor-contrast);
  text-align: center;
  font-size: calc(29rpx * var(--fs-mul, 1));
  font-weight: 800;
}

.k-pad-bottom { height: 30rpx; }
