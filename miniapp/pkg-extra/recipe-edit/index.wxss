page { background: var(--paper); }

.rc-seg {
  display: flex;
  margin: 8rpx 46rpx 0;
  background: var(--paper-2);
  border-radius: var(--r-pill);
  padding: 6rpx;
  gap: 4rpx;
}
.rc-seg-item {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-sub);   /* 与同页难度分段 .rc-dseg-i 同档：两条同样的胶囊分段原来字号 23 对 25 */
  font-weight: 700;
  color: var(--mut-strong);
  border-radius: var(--r-pill);
}
.rc-seg-item.on {
  background: var(--anchor);
  color: var(--anchor-contrast);
}

.rc-body { padding: 20rpx 46rpx calc(240rpx + env(safe-area-inset-bottom)); }

.rc-tip {
  display: block;
  margin-bottom: 12rpx;
  font-size: calc(25rpx * var(--fs-mul, 1));
  color: var(--pop);
}

.rc-cover {
  position: relative;
  height: 240rpx;
  margin: 0 -46rpx 8rpx;
  overflow: hidden;
  background: var(--paper-2);
}
.rc-cover-img { width: 100%; height: 100%; display: block; }
/* 热区是真实元素（88rpx），视觉圆点搬到 ::before。
   原先用 ::after 把 48rpx 按钮扩成 88rpx：伪元素外溢 20rpx，
   而 .rc-cover 是 overflow:hidden 且按钮距角仅 16rpx，四边全被裁，
   实际命中区反而缩到 48x48 —— 扩热区那个伪元素一直在做负功。
   挪到 -(88-48)/2-16 = -4rpx，圆点圆心仍在离角 16rpx 处，视觉不变。 */
.rc-cover-x {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  width: var(--tap-min);
  height: var(--tap-min);
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  color: #fff;
  font-size: 0;   /* 节点里的 × 只留给读屏；视觉 × 由 ::before 画，否则两个 × 并排 */
}
.rc-cover-x::before {
  font-size: calc(28rpx * var(--fs-mul, 1));
  content: '×';
  width: var(--ctl-x);
  height: var(--ctl-x);
  border-radius: 50%;
  background: rgba(40, 30, 20, 0.45);
  line-height: var(--ctl-x);
  text-align: center;
}
.rc-addcover {
  display: inline-block;
  margin-bottom: 8rpx;
  font-size: calc(25rpx * var(--fs-mul, 1));
  font-weight: 600;
  color: var(--gold-deep);
}

.rc-title {
  width: 100%;
  height: 88rpx;
  min-height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  font-size: calc(44rpx * var(--fs-mul, 1));
  font-weight: 800;
  color: var(--ink);
  background: transparent;
}
.rc-summary {
  width: 100%;
  min-height: 64rpx;
  padding: 0 0 16rpx;
  font-size: calc(25rpx * var(--fs-mul, 1));
  color: var(--mut-strong);
  line-height: 1.5;
  background: transparent;
}
.rc-ph { color: var(--mut-2); }

.rc-picks { margin-top: 20rpx; }
.rc-pickline {
  display: flex;
  align-items: baseline;
  gap: 20rpx;
  padding: 14rpx 0;
}
.rc-pickline-k { flex: none; font-size: calc(25rpx * var(--fs-mul, 1)); color: var(--mut); }
.rc-pickline-v { font-size: calc(28rpx * var(--fs-mul, 1)); font-weight: 700; color: var(--ink); }

.rc-facts {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
}
.rc-fact {
  flex: 1;
  background: var(--paper-2);
  padding: 20rpx 12rpx 22rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.rc-fact-k {
  font-size: calc(23rpx * var(--fs-mul, 1));
  color: var(--mut);
  margin-bottom: 12rpx;
}
.rc-stepper { display: flex; align-items: center; gap: 12rpx; }
.rc-sbtn {
  /* 步进器 ± 按钮：52rpx 偏小，放大到 72rpx 便于连续点按 */
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  /* 嵌在 --paper-2 的耗时/人份卡里：深色档卡面 #242424 对 #2e2e2e 只有 1.14:1，± 圆钮看不见。
     --seg-thumb 是同一角色（井里的凸起控件）：浅色档 = --c-surface，观感不变 */
  background: var(--seg-thumb);
  color: var(--ink);
  font-size: calc(32rpx * var(--fs-mul, 1));
  line-height: 70rpx;
  text-align: center;
}
.rc-fact-v {
  min-width: 48rpx;
  font-size: calc(40rpx * var(--fs-mul, 1));
  font-weight: 800;
  color: var(--ink);
  text-align: center;
}
.rc-fact-u { margin-top: 6rpx; font-size: calc(23rpx * var(--fs-mul, 1)); color: var(--mut); }

.rc-dseg {
  display: flex;
  margin-top: 16rpx;
  background: var(--paper-2);
  border-radius: var(--r-pill);
  padding: 6rpx;
  gap: 4rpx;
}
.rc-dseg-i {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: calc(25rpx * var(--fs-mul, 1));
  font-weight: 700;
  color: var(--mut-strong);
  border-radius: var(--r-pill);
}
.rc-dseg-i.on {
  background: var(--anchor);
  color: var(--anchor-contrast);
}

.rc-pick-list { padding: 8rpx 0 16rpx; }
.rc-pick-opt {
  height: 88rpx;
  display: flex;
  align-items: center;
  font-size: calc(28rpx * var(--fs-mul, 1));
  color: var(--ink);
  border-bottom: 2rpx solid var(--paper-2);
}
.rc-pick-opt.on { font-weight: 800; color: var(--pop); }

.rc-ing {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 0;
  border-bottom: 2rpx solid var(--line);
}
.rc-ing-name {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  min-height: 72rpx;
  line-height: 72rpx;
  font-size: calc(28rpx * var(--fs-mul, 1));
  color: var(--ink);
  background: transparent;
}
.rc-ing-amt,
.rc-ing-unit {
  flex: none;
  width: 88rpx;
  height: 72rpx;
  min-height: 72rpx;
  line-height: 72rpx;
  font-size: calc(28rpx * var(--fs-mul, 1));
  color: var(--mut-strong);
  text-align: right;
  background: transparent;
}
.rc-ing-unit { width: 64rpx; }
.rc-ing-x {
  flex: none;
  /* 删除键热区 88rpx：原 40rpx 宽，手指很难点中 */
  width: 88rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--mut);   /* 可点的删除键不用 --mut-2（约 2.2:1，规范里只给装饰） */
  font-size: calc(28rpx * var(--fs-mul, 1));
  text-align: center;
}

.rc-more {
  box-sizing: border-box;
  min-height: var(--tap-min);   /* 文字位置不变（仍是上 28rpx），只把下方空白算进热区 */
  padding: 28rpx 0 8rpx;
  font-size: calc(25rpx * var(--fs-mul, 1));
  font-weight: 600;
  color: var(--gold-deep);
}

.rc-video-line {
  margin-bottom: 24rpx;
  font-size: calc(25rpx * var(--fs-mul, 1));
  font-weight: 600;
  color: var(--gold-deep);
}
.rc-video {
  position: relative;
  width: 100%;
  height: 220rpx;
  margin-bottom: 28rpx;
  overflow: hidden;
  background: var(--anchor);
}
.rc-video-player { width: 100%; height: 100%; }

.rc-step { padding: 8rpx 0 36rpx; }
.rc-step-bar {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.rc-step-n {
  font-size: calc(28rpx * var(--fs-mul, 1));
  font-weight: 800;
  color: var(--ink);
}
.rc-step-del { font-size: calc(25rpx * var(--fs-mul, 1)); color: var(--mut); }   /* 同 .rc-ing-x：可点文字不用 --mut-2 */

.rc-shot {
  height: 168rpx;
  margin-bottom: 16rpx;
  background: var(--paper-2);
  color: var(--mut);
  font-size: calc(25rpx * var(--fs-mul, 1));
  display: flex;
  align-items: center;
  justify-content: center;
}
.rc-shot.has {
  position: relative;
  height: 280rpx;
  padding: 0;
}
.rc-shot-img { width: 100%; height: 100%; display: block; }

.rc-stx-p {
  font-size: calc(28rpx * var(--fs-mul, 1));
  line-height: 1.6;
  color: var(--ink);
}
.rc-steptext {
  width: 100%;
  min-height: 80rpx;
  font-size: calc(28rpx * var(--fs-mul, 1));
  color: var(--ink);
  line-height: 1.6;
  background: transparent;
}

.rc-pick { padding: 8rpx 0 24rpx; }
/* 上传失败重试行：比主按钮低一档（描边、非实心），不能抢「从相册或拍摄」的位置 */
.rc-retry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: var(--tap-min);
  margin-bottom: 16rpx;
  padding: 0 var(--pad-card-sm);
  border: 2rpx solid var(--pop-soft);
  border-radius: var(--r-card);
  background: var(--c-surface);
}
.rc-retry-txt {
  font-size: calc(25rpx * var(--fs-mul, 1));
  color: var(--pop);
}
.rc-retry-btn {
  flex: none;
  min-width: 120rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: var(--r-card);
  background: var(--pop-fill);
  color: var(--anchor-contrast);
  font-size: calc(var(--fs-btn) * var(--fs-mul, 1));
  font-weight: 700;
}
/* 展开热区到 88rpx：按钮本体 64rpx 低于触控下限，靠伪元素补，
   且 .rc-retry 没有 overflow:hidden，伪元素不会被裁（对照 .rc-cover-x 的教训） */
.rc-retry-btn { position: relative; }
.rc-retry-btn::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: -12rpx;
  bottom: -12rpx;
}
.rc-pick-btn {
  height: 88rpx;
  border-radius: var(--r-card);
  background: var(--anchor);
  color: var(--gold-on-dark);   /* 深色档见文末 @media */
  font-size: calc(28rpx * var(--fs-mul, 1));
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
.rc-pick-grid { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 20rpx; }
.rc-pick-cell { width: var(--tile-pick); height: var(--tile-pick); background: var(--paper-2); }

/* 深色档：--gold 翻成 #8a6a3a，压在 --anchor 上看不清（旧 #3a2e23 上约 2.6:1，提亮后的 #866a50 上约 1:1）；
   改用恒定浅字 --anchor-contrast（两种 --anchor 上都 ≥4.7:1） */
@media (prefers-color-scheme: dark) {
  .rc-pick-btn { color: var(--anchor-contrast); }
}

.rc-footbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 20;
  padding: 20rpx 46rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--paper);
}
