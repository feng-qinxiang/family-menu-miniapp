page { background: var(--paper); }

.rc-seg {
  display: flex;
  margin: 8rpx 46rpx 0;
  background: var(--paper-2);
  border-radius: var(--r-pill);
  padding: 6rpx;
  gap: 4rpx;
}
.rc-seg-item {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-cap);
  font-weight: 700;
  color: var(--mut-strong);
  border-radius: var(--r-pill);
}
.rc-seg-item.on {
  background: var(--ink-deep);
  color: var(--c-surface);
}

.rc-body { padding: 20rpx 46rpx calc(240rpx + env(safe-area-inset-bottom)); }

.rc-tip {
  display: block;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: var(--pop);
}

.rc-cover {
  position: relative;
  height: 240rpx;
  margin: 0 -46rpx 8rpx;
  overflow: hidden;
  background: var(--paper-2);
}
.rc-cover-img { width: 100%; height: 100%; display: block; }
.rc-cover-x {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(40, 30, 20, 0.45);
  color: #fff;
  font-size: 30rpx;
  line-height: 46rpx;
  text-align: center;
}
.rc-cover-x::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 88rpx;
  height: 88rpx;
  transform: translate(-50%, -50%);
}
.rc-addcover {
  display: inline-block;
  margin-bottom: 8rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--gold-deep);
}

.rc-title {
  width: 100%;
  height: 88rpx;
  min-height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  font-size: 44rpx;
  font-weight: 800;
  color: var(--ink);
  background: transparent;
}
.rc-summary {
  width: 100%;
  min-height: 64rpx;
  padding: 0 0 16rpx;
  font-size: 26rpx;
  color: var(--mut-strong);
  line-height: 1.5;
  background: transparent;
}
.rc-ph { color: var(--mut-2); }

.rc-picks { margin-top: 20rpx; }
.rc-pickline {
  display: flex;
  align-items: baseline;
  gap: 20rpx;
  padding: 14rpx 0;
}
.rc-pickline-k { flex: none; font-size: 24rpx; color: var(--mut); }
.rc-pickline-v { font-size: 28rpx; font-weight: 700; color: var(--ink); }

.rc-facts {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
}
.rc-fact {
  flex: 1;
  background: var(--paper-2);
  padding: 20rpx 12rpx 22rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.rc-fact-k {
  font-size: 22rpx;
  color: var(--mut);
  margin-bottom: 12rpx;
}
.rc-stepper { display: flex; align-items: center; gap: 12rpx; }
.rc-sbtn {
  /* 步进器 ± 按钮：52rpx 偏小，放大到 72rpx 便于连续点按 */
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--c-surface);
  color: var(--ink);
  font-size: 32rpx;
  line-height: 70rpx;
  text-align: center;
}
.rc-fact-v {
  min-width: 48rpx;
  font-size: 40rpx;
  font-weight: 800;
  color: var(--ink);
  text-align: center;
}
.rc-fact-u { margin-top: 6rpx; font-size: 22rpx; color: var(--mut); }

.rc-dseg {
  display: flex;
  margin-top: 16rpx;
  background: var(--paper-2);
  border-radius: var(--r-pill);
  padding: 6rpx;
  gap: 4rpx;
}
.rc-dseg-i {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--mut-strong);
  border-radius: var(--r-pill);
}
.rc-dseg-i.on {
  background: var(--ink-deep);
  color: var(--c-surface);
}

.rc-pick-list { padding: 8rpx 0 16rpx; }
.rc-pick-opt {
  height: 88rpx;
  display: flex;
  align-items: center;
  font-size: 30rpx;
  color: var(--ink);
  border-bottom: 2rpx solid var(--paper-2);
}
.rc-pick-opt.on { font-weight: 800; color: var(--pop); }

.rc-ing {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 0;
  border-bottom: 2rpx solid var(--line);
}
.rc-ing-name {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  min-height: 72rpx;
  line-height: 72rpx;
  font-size: 30rpx;
  color: var(--ink);
  background: transparent;
}
.rc-ing-amt,
.rc-ing-unit {
  flex: none;
  width: 88rpx;
  height: 72rpx;
  min-height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  color: var(--mut-strong);
  text-align: right;
  background: transparent;
}
.rc-ing-unit { width: 64rpx; }
.rc-ing-x {
  flex: none;
  /* 删除键热区 88rpx：原 40rpx 宽，手指很难点中 */
  width: 88rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--mut-2);
  font-size: 30rpx;
  text-align: center;
}

.rc-more {
  padding: 28rpx 0 8rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--gold-deep);
}

.rc-video-line {
  margin-bottom: 24rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--gold-deep);
}
.rc-video {
  position: relative;
  width: 100%;
  height: 220rpx;
  margin-bottom: 28rpx;
  overflow: hidden;
  background: var(--ink-deep);
}
.rc-video-player { width: 100%; height: 100%; }

.rc-step { padding: 8rpx 0 36rpx; }
.rc-step-bar {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.rc-step-n {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--ink);
}
.rc-step-del { font-size: 24rpx; color: var(--mut-2); }

.rc-shot {
  height: 168rpx;
  margin-bottom: 16rpx;
  background: var(--paper-2);
  color: var(--mut);
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.rc-shot.has {
  position: relative;
  height: 280rpx;
  padding: 0;
}
.rc-shot-img { width: 100%; height: 100%; display: block; }

.rc-stx-p {
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--ink);
}
.rc-steptext {
  width: 100%;
  min-height: 80rpx;
  font-size: 28rpx;
  color: var(--ink);
  line-height: 1.6;
  background: transparent;
}

.rc-pick { padding: 8rpx 0 24rpx; }
.rc-pick-btn {
  height: 88rpx;
  border-radius: var(--r-card);
  background: var(--ink-deep);
  color: var(--gold);
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
.rc-pick-grid { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 20rpx; }
.rc-pick-cell { width: 148rpx; height: 148rpx; background: var(--paper-2); }

.rc-footbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 20;
  padding: 20rpx 46rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--paper);
}
