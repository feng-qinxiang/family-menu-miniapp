<nav-bar title="{{isEdit ? '编辑菜谱' : '新建菜谱'}}"></nav-bar>

<state-loading wx:if="{{pageLoading}}" text="加载菜谱中…"></state-loading>

<block wx:else>
<view class="rc-seg">
  <view class="tap-scale rc-seg-item {{editTab === 'info' ? 'on' : ''}}" data-tab="info" bindtap="switchTab">介绍</view>
  <view class="tap-scale rc-seg-item {{editTab === 'ings' ? 'on' : ''}}" data-tab="ings" bindtap="switchTab">用料</view>
  <view class="tap-scale rc-seg-item {{editTab === 'steps' ? 'on' : ''}}" data-tab="steps" bindtap="switchTab">步骤</view>
</view>

<view class="rc-body">
  <text class="rc-tip" wx:if="{{tipText}}">{{tipText}}</text>

  <block wx:if="{{editTab === 'info'}}">
    <view class="tap-scale rc-cover" wx:if="{{form.coverImage}}" bindtap="chooseCover">
      <image class="rc-cover-img" src="{{form.coverImage}}" mode="aspectFill" />
      <view class="tap-scale rc-cover-x" catchtap="removeCover">×</view>
    </view>
    <view class="tap-scale rc-addcover" wx:else bindtap="chooseCover">添加封面</view>

    <input
      class="rc-title"
      placeholder="菜名"
      placeholder-class="rc-ph"
      value="{{form.title}}"
      bindinput="onInput"
      data-field="title"
    />
    <textarea
      class="rc-summary"
      placeholder="一句话介绍，可不填"
      placeholder-class="rc-ph"
      value="{{form.summary}}"
      bindinput="onInput"
      data-field="summary"
      auto-height
    />

    <view class="rc-picks">
      <view class="rc-pickline tap-scale" bindtap="openCuisineSheet">
        <text class="rc-pickline-k">菜系</text>
        <text class="rc-pickline-v">{{form.cuisine || '未选'}}</text>
      </view>
      <view class="rc-pickline tap-scale" bindtap="openTagSheet">
        <text class="rc-pickline-k">标签</text>
        <text class="rc-pickline-v {{tagsLabel === '未选' ? 'rc-ph' : ''}}">{{tagsLabel}}</text>
      </view>
    </view>

    <view class="rc-facts">
      <view class="rc-fact">
        <text class="rc-fact-k">耗时</text>
        <view class="rc-stepper">
          <view class="rc-sbtn tap-scale" data-field="timeCost" data-delta="-1" bindtap="stepperChange">−</view>
          <text class="rc-fact-v">{{form.timeCost}}</text>
          <view class="rc-sbtn tap-scale" data-field="timeCost" data-delta="1" bindtap="stepperChange">+</view>
        </view>
        <text class="rc-fact-u">分钟</text>
      </view>
      <view class="rc-fact">
        <text class="rc-fact-k">几人份</text>
        <view class="rc-stepper">
          <view class="rc-sbtn tap-scale" data-field="servings" data-delta="-1" bindtap="stepperChange">−</view>
          <text class="rc-fact-v">{{form.servings}}</text>
          <view class="rc-sbtn tap-scale" data-field="servings" data-delta="1" bindtap="stepperChange">+</view>
        </view>
        <text class="rc-fact-u">人</text>
      </view>
    </view>

    <view class="rc-dseg">
      <view
        class="tap-scale rc-dseg-i {{form.difficulty === item.key ? 'on' : ''}}"
        wx:for="{{difficultyOptions}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="selectDifficulty"
      >{{item.label}}</view>
    </view>
  </block>

  <block wx:if="{{editTab === 'ings'}}">
    <view class="rc-ing" wx:for="{{form.ingredients}}" wx:key="index">
      <input class="rc-ing-name" placeholder="食材" placeholder-class="rc-ph" value="{{item.name}}" bindinput="onIngredientInput" data-index="{{index}}" data-field="name" />
      <input class="rc-ing-amt" placeholder="用量" placeholder-class="rc-ph" value="{{item.amount}}" bindinput="onIngredientInput" data-index="{{index}}" data-field="amount" />
      <input class="rc-ing-unit" placeholder=" " placeholder-class="rc-ph" value="{{item.unit}}" bindinput="onIngredientInput" data-index="{{index}}" data-field="unit" />
      <text class="tap-scale rc-ing-x" data-index="{{index}}" bindtap="removeIngredient">×</text>
    </view>
    <view class="rc-more tap-scale" bindtap="addIngredient">再加一行</view>
  </block>

  <block wx:if="{{editTab === 'steps'}}">
    <view class="rc-video-line tap-scale" wx:if="{{!form.videoUrl}}" bindtap="chooseLessonVideo">添加教学视频</view>
    <view class="rc-video" wx:else>
      <video class="rc-video-player" src="{{form.videoUrl}}" controls object-fit="cover" />
      <view class="tap-scale rc-cover-x" catchtap="removeLessonVideo">×</view>
    </view>

    <view class="rc-step" wx:for="{{form.steps}}" wx:key="index">
      <view class="rc-step-bar">
        <text class="rc-step-n">{{index + 1}}</text>
        <text class="tap-scale rc-step-del" data-index="{{index}}" bindtap="removeStep">删除</text>
      </view>
      <view class="tap-scale rc-shot" wx:if="{{!item.image}}" data-index="{{index}}" bindtap="chooseStepImage">加一张图</view>
      <view class="tap-scale rc-shot has" wx:else>
        <image class="rc-shot-img" src="{{item.image}}" mode="aspectFill" data-index="{{index}}" bindtap="chooseStepImage" />
        <view class="tap-scale rc-cover-x" data-index="{{index}}" catchtap="removeStepImage">×</view>
      </view>
      <textarea
        wx:if="{{editingStep === index}}"
        class="rc-steptext"
        placeholder="这一步怎么做"
        placeholder-class="rc-ph"
        value="{{item.text}}"
        bindinput="onStepInput"
        bindblur="blurStep"
        data-index="{{index}}"
        auto-height
        focus
        disable-default-padding
      />
      <view
        wx:else
        class="rc-stx-p {{item.text ? '' : 'rc-ph'}}"
        data-index="{{index}}"
        bindtap="editStep"
      >{{item.text || '写这一步'}}</view>
    </view>
    <view class="rc-more tap-scale" bindtap="addStep">再加一步</view>
  </block>
</view>

<view class="rc-footbar">
  <view class="btn btn-pop btn-block tap-scale {{saving ? 'is-busy' : ''}}" bindtap="submit">{{saving ? '保存中…' : '保存'}}</view>
</view>

<state-sheet visible="{{pickSheet.visible}}" title="{{pickSheet.mode === 'cuisine' ? '菜系' : '标签'}}" bind:close="closePickSheet">
  <view class="rc-pick-list">
    <block wx:if="{{pickSheet.mode === 'cuisine'}}">
      <view
        class="tap-scale rc-pick-opt {{form.cuisine === item ? 'on' : ''}}"
        wx:for="{{cuisineOptions}}"
        wx:key="*this"
        data-value="{{item}}"
        bindtap="selectCuisine"
      >{{item}}</view>
    </block>
    <block wx:else>
      <view
        class="tap-scale rc-pick-opt {{item.active ? 'on' : ''}}"
        wx:for="{{commonTags}}"
        wx:key="name"
        data-tag="{{item.name}}"
        bindtap="toggleCommonTag"
      >{{item.name}}</view>
    </block>
  </view>
</state-sheet>

<state-sheet visible="{{mediaSheet.visible}}" title="{{mediaSheet.mode === 'video' ? '教学视频' : (mediaSheet.mode === 'cover' ? '封面' : '步骤配图')}}" bind:close="closeMediaSheet">
  <view wx:if="{{mediaSheet.mode === 'video'}}" class="rc-pick">
    <view class="rc-pick-btn tap-scale" catchtap="pickVideoFromAlbum">从相册或拍摄</view>
  </view>
  <view wx:else class="rc-pick">
    <view class="rc-pick-btn tap-scale" catchtap="pickImageFromAlbum">从相册或拍摄</view>
    <view class="rc-pick-grid">
      <image
        wx:for="{{pickerImages}}"
        wx:key="*this"
        class="tap-scale rc-pick-cell"
        src="{{item}}"
        mode="aspectFill"
        data-url="{{item}}"
        catchtap="pickLocalImage"
      />
    </view>
  </view>
</state-sheet>
</block>
