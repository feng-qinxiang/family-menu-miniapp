# 复制为 .env 后填写真实值。.env 必须加入 .gitignore，禁止入库。
# 这里只有键名和占位说明，不含任何真实凭据。

# ---- 必填 ----
# MySQL root 口令（强口令，勿用 123456）
DB_PASSWORD=change-me-strong-password
DB_NAME=family_menu_daily_db
DB_USERNAME=root

# ---- 微信小程序（登录 + 内容机审依赖）----
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ---- 订阅消息（可选；留空则整个功能关闭，小程序里也不显示"消息通知"开关）----
# 去小程序后台「订阅消息」申请模板，审核通过后把模板 ID 填这里。
# 申请时选字段为 thing1 / thing2 的模板（本代码按"事项 + 说明"两字段发送），
# 字段名不一致要改 SubscribeMessageService 里的 FIELD_SUBJECT / FIELD_DETAIL。
WECHAT_SUBSCRIBE_TEMPLATE_WISH=   # 家人许愿（"XX 想吃糖醋排骨"）
WECHAT_SUBSCRIBE_TEMPLATE_MEAL=   # 开饭提醒（"今天的菜都做好了"）
# 消息跳转的小程序版本：formal=正式版 / trial=体验版 / developer=开发版
WECHAT_SUBSCRIBE_STATE=formal

# ---- 首个管理员（openid 白名单，逗号分隔；启动时只升权不降权）----
# 获取方式：小程序登录后查 user_account.openid
ADMIN_OPENIDS=

# ---- 进不去后台时的临时钥匙（平时必须留空）----
# 短信网关未接入时，后台没有任何人能登录（验证码发不出去）。
# 两个都填上才生效，且服务端未配置时 /api/admin/auth/bootstrap 直接 404：
#   ADMIN_BOOTSTRAP_PHONE 要登录哪个管理员账号（该账号必须 is_admin=1、已绑定手机号、状态正常）
#   ADMIN_BOOTSTRAP_TOKEN 引导令牌，自己生成一串足够长的随机串（如 openssl rand -hex 32）
# 登录成功一次后就把它删掉并重启应用 —— 它不过期，等同于一把后台钥匙。
# 严禁写进代码、严禁提交到仓库。
ADMIN_BOOTSTRAP_PHONE=
ADMIN_BOOTSTRAP_TOKEN=

# ---- 短信网关（等用户开通；留空 = noop，验证码发不出去，只能用上面的引导登录进后台）----
# 目前支持 tencent（腾讯云短信）。填好下面 6 项重启即接入，无需改代码；缺项启动失败。
# SMS_PROVIDER=tencent
# SMS_TENCENT_SECRET_ID=         子账号 SecretId（只授 QcloudSMSFullAccess）
# SMS_TENCENT_SECRET_KEY=
# SMS_TENCENT_SDK_APP_ID=        1400 开头
# SMS_TENCENT_SIGN_NAME=         已审核的签名内容
# SMS_TENCENT_TEMPLATE_ID=       已审核的验证码模板（只含一个变量 {1}）

# ---- 上传链接签名（prod 必填）----
# 图片走 /uploads/** 直读，prod 下没有这个密钥应用会在启动时直接抛异常（不签名就等于
# 任何人拿到链接可永久访问，且换域名/清缓存没有抓手）。生成：openssl rand -hex 32
# ⚠ 换掉它会让所有已签发链接立刻失效（图片重新拉取即可恢复），所以定了就别常改。
UPLOAD_ACCESS_SECRET=

# ---- 域名与端口 ----
CORS_ALLOWED_ORIGINS=https://api.example.com
APP_PORT=9088

# ---- 可选 ----
LOG_LEVEL=info

# ---- 生产严禁开启（默认已关，留空即可；prod profile 下设为 true 会直接启动失败）----
# AUTH_DEV_OTP_ENABLED=true    固定验证码 246810，任意手机号可登录
# WECHAT_PAY_MOCK_ENABLED=true 免付款直接开通会员
# APP_SEED_DEMO_DATA=true      演示数据（种子账号、演示家庭/菜单/通知/社区帖子）
#                              打开后运营后台会出现一批"凭空冒出来"的账号与家庭，与小程序的真实数据混在一起
