/.idea/
/*.iml
# IDEA 在子模块里也会生成工程元数据（用 IDEA 打开 server/ 就会出现）
.idea/
*.iml
/node_modules/
/dist/
/coverage/
/target/
/server/target/
/miniapp/miniprogram_npm/
*.log
.DS_Store
Thumbs.db
*.class
*.jar
*.war
.env
.env.*
!.env.example
# 用户上传的图片/视频（运行时产物，不进仓库）
/uploads/
/server/uploads/
/project.private.config.json
/ui-preview.html
/.zcode/
/artifacts/ui-baseline/
/artifacts/_probe_shot.png
/artifacts/_ui_home_after*.png
# 本地工具目录。mvn.sh 是给 Git Bash 用的 Maven 绕过脚本（mvnw 在该环境下会报 classworlds 找不到），
# 需要随仓库分发，所以只忽略目录内其它内容。
/.tools/*
!/.tools/mvn.sh
/*.ps1
/artifacts/p2/
/artifacts/_p2_*.png
/artifacts/_stage.png

# 本地开发覆盖配置（Spring Boot 自动加载工作目录下的 config/，见 server/config/application.yml）
# 里面放的是「开发模式验证码」这类只应存在于本机的开关，绝不能进仓库
/server/config/

# 本地工具状态与开发者工具预览产物
/.workbuddy/
/preview-qr.png

# Claude Code 本地（个人）设置，不应共享
/.claude/settings.local.json

# 端到端测试证据截图（体积大、可随时重新生成）：仓库只保留报告 md
/artifacts/**/*.png
/artifacts/**/*.jpg
# 数据库备份（含全量业务数据，绝不进仓库）
/artifacts/**/*.sql
/demo-cleanup-backup-*.sql
